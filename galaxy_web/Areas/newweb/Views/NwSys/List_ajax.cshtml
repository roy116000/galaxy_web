@using MvcPaging;
@model IPagedList<galaxy_web.Models.sys_function_data>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />
            <col class="width4" />
            <col class="" />
            <col class="width6" />
            <col class="width6" />
            <col class="width15" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th class="center">icon </th>
                <th class="center">@Html.DisplayNameFor(model => model.First().label) </th>
                <th class="center">@Html.DisplayNameFor(model => model.First().inx) </th>
                <th class="center">@Html.DisplayNameFor(model => model.First().visible)</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
               
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" value="@item.function_id" /></td>
                    <td class="center"><span class="@Html.DisplayFor(modelItem => item.icon)"></span></td>
                    <td>@Html.DisplayFor(modelItem => item.label)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.inx)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.visible)</td>
                    <td class="center">@Html.ActionLink("編輯", action.Replace("List", "Edit"), new { id = item.function_id }, new { @class = "title" })｜
                        @Html.ActionLink("設定子菜單", action.Replace("List", "SubList"), new { id = item.function_id }, new { @class = "title" })

                    </td>
                </tr>
            }
        </tbody>
    </table>
@*    <div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount, new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action("TmpList_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw))
    </div>*@

</div>
