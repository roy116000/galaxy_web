@model galaxy_web.Models.sys_function_sub
@{
    string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}
<div class="maincontent">
    <div class="contentinner">
         <ul class="nav nav-pills">
            <li>@Html.ActionLink("回子菜單列表", "SubList", "NwSys", new {id=id },null)</li>
        </ul>
        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.function_sub_id)
            <div class="widgetcontent">
                <h4 class="widgettitle">基本資料</h4>

                    @Html.EditorFor(model => model.function_id) 

                    @Html.EditorFor(model => model.label) 

                    @Html.EditorFor(model => model.info) 

                    @Html.EditorFor(model => model.action) 

                    @Html.EditorFor(model => model.inx) 

                    @Html.EditorFor(model => model.show_visible) 

                    @Html.EditorFor(model => model.visible) 

                    <div class="control-group">
                        <label for="add_fun" class="control-label">新增一系列功能</label>
                        <div class="controls">
                        <input type="checkbox" value="true" name="add_fun" id="add_fun">
                        <span> (會用action名稱建立Add, AddSave, Edit, EditSave, ListDel)</span>
                        <input type="hidden" value="false" name="add_fun">
                        <span class="help-inline"></span>
                        </div>
                    </div>

                <div class="control-group">
                    <div class="stdformbutton">
                        <button class="btn btn-primary">儲存</button>
                        <button type="reset" class="btn">取消</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            rules: {
                label: "required"
            },
            messages: {
                label: "[label]必填!!"
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').addClass('error');
            }
        });

    })
</script>
