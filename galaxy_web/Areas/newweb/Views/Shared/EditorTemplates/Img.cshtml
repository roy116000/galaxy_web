@using System.Text.RegularExpressions;
@model string
@{
    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "control-label");

    IDictionary<string, object> htmlAttributes2 = new Dictionary<string, object>();
    htmlAttributes2.Add("type", "hidden");

    //string id = ViewData.ModelMetadata.PropertyName;

    string id = ViewData.TemplateInfo.HtmlFieldPrefix;

    //var iss = ViewData.TemplateInfo.HtmlFieldPrefix;

    string Img = !string.IsNullOrEmpty(Model) ? Model : "/images/nophoto/no_photo.jpg";
}

<div class="control-group">
    @Html.Label("", htmlAttributes)
    <div class="controls">
        <div class="fileupload fileupload-new" data-provides="fileupload">
            <div class="input-append">
                <div class="uneditable-input span3">
                    <i class="icon-file fileupload-exists"></i>
                    <span class="fileupload-preview"></span>
                </div>
                <span class="btn btn-file">
                    <span class="fileupload-new">Select file</span>
                    <span class="fileupload-exists">Change</span>

                    <input type="file" id="@(id)" name="@(id)" />
                    @*<input type="file" id="@ViewData.TemplateInfo.HtmlFieldPrefix" name="@ViewData.TemplateInfo.HtmlFieldPrefix" />*@

                </span>
                <a id="@(id)_c" href="#" class="btn fileupload-exists @(id)_c" data-dismiss="fileupload">Remove</a>
            </div>
            <h2 class="help-inline" style="vertical-align: middle"></h2>
        </div>
    </div>
</div>

<div class="control-group">
    <label class="control-label">圖片</label>
    <div class="editor-field" style="padding: 5px 5px;">
        <img class="@(id)_Del" src="@(Img)" style="width:30%">
    </div>
</div>

@*建立圖片預覽*@
<script>

    $('input[name="@(id)"]').change(function () {
        readURL(this, '@(id)');
    })

    function readURL(input, o) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {

                var num = $('input[name="@(id)"]').index(input);
                $('.@(id)_Del').eq(num).attr('src', e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    $('.@(id)_c').click(function () {

        $('input[name="@(id)"]').val('');

        var num = $('.@(id)_c').index(this);
        $('.@(id)_Del').eq(num).attr('src', '@(Img)')

    })

</script>

@*刪除圖片*@
<script>
    $('.@(id)_Del').click(function () {

        var num = $('.@(id)_Del').index(this);

        var src = $('.@(id)_Del').eq(num).attr('src');

        var model = '@(Model)';

        if (src != "" && model != "") {
            swal({
                title: '請問您確認刪除嗎?',
                text: "",
                //type: "success",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "是的，確定",
                cancelButtonText: "再考慮看看",
                closeOnConfirm: false,
                showLoaderOnConfirm: true,
            }, function () {

                $.post('@(Url.Action("ImgDel", "NwHome"))', { src: src }, function (result) {
                    var msg = result.msg;

                    if (msg != "") {

                        $('.@(id)_Del').eq(num).remove();

                        swal(msg);

                    }
                })

            })
        }

    });
</script>
