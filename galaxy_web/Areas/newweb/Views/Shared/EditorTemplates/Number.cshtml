@model int?
@{
    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "control-label");

    IDictionary<string, object> htmlAttributes2 = new Dictionary<string, object>();
    htmlAttributes2.Add("class", "span2 input-spinner");
    htmlAttributes2.Add("maxlength", "10");
    
    
    string id = ViewData.ModelMetadata.PropertyName;
}
<script type="text/javascript">jQuery(function () { jQuery("#@(id)").spinner({ min: 0, max: 9999999999, increment: 1 }); })</script>
<div class="control-group">
    @Html.Label("", htmlAttributes)
    <span class="field">
        @Html.TextBox("", Model.HasValue ? Model : 0, htmlAttributes2)
    </span>
</div>
