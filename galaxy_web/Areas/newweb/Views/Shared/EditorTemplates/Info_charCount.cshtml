@model String
@{
    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "control-label");

    IDictionary<string, object> htmlAttributes2 = new Dictionary<string, object>();
    htmlAttributes2.Add("class", "span5");
    htmlAttributes2.Add("placeholder", ViewData.ModelMetadata.Watermark); //浮水印
    htmlAttributes2.Add("rows", 4);

    int maxlength = 255;
    if (ViewData.ModelMetadata.AdditionalValues.ContainsKey("maxLenght"))
    {
        maxlength = (int)ViewData.ModelMetadata.AdditionalValues["maxLenght"];
        //maxlength = 1000;
    }
    htmlAttributes2.Add("maxlength", maxlength);
    
    string id = ViewData.ModelMetadata.PropertyName;
    
}
<script type="text/javascript">jQuery(function () { jQuery("#@(id)").autogrow(); })</script>
<script type="text/javascript">jQuery(function () { jQuery("#@(id)").charCount({allowed: @(maxlength), warning: 20, counterText: '可輸入字數：'});
})</script>

<div class="control-group">
    @Html.Label("",htmlAttributes)
    <span class="field">
    @Html.TextArea("", ViewData.TemplateInfo.FormattedModelValue.ToString(), htmlAttributes2)
    <span class="help-inline"></span>
    </span>
</div>
