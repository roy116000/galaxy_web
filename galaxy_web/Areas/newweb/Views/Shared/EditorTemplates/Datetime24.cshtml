@model DateTime?
@{
    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "control-label");

    IDictionary<string, object> htmlAttributes2 = new Dictionary<string, object>();
    htmlAttributes2.Add("class", "span2");
    //htmlAttributes2.Add("placeholder", ViewData.ModelMetadata.Watermark); //浮水印

    string value = "", value2 = "";
    
    if (Model.HasValue){ value=Model.Value.ToString("yyyy/MM/dd"); value2 = Model.Value.ToString("HH:mm");}

    string id = ViewData.ModelMetadata.PropertyName;
}
<script type="text/javascript">jQuery(function () { jQuery("#@(id)").datepicker(); })</script>
<div class="control-group">
    @Html.Label("",htmlAttributes)
    <div class="controls input-append">
    @Html.TextBox("", value, htmlAttributes2)
    <span class="add-on"><i class="icon-calendar"></i></span>
    </div>
</div>

<div class="control-group">
    <label for="start_date" class="control-label">@(ViewData.ModelMetadata.DisplayName.Replace("日期","時間"))</label>
    <div class="controls input-append">
    <input type="text" value="@(value2)" name="@(id.Replace("date","time"))" id="@(id.Replace("date","time"))" class="span2" placeholder="ex:18:00 24小時制">
    <span class="add-on"><i class="icon-time"></i></span>
    </div>
</div>
