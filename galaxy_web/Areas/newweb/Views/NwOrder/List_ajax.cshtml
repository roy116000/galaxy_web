@using MvcPaging;
@model IPagedList<galaxy_web.Areas.newweb.Controllers.NwOrderController._order>
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}


@foreach (var item in Model)
{
    var Order = item.order_data;
    var Sub = item.order_sub;

    int n = Array.IndexOf(Model.Select(m => m.order_data.order_id).ToArray(), Order.order_id);

    string c_name = item.company != null ? item.company.name : "";
        
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />
            <col class="width10" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
        </colgroup>

        @if (n == 0)
        {
            <thead>
                <tr>
                    <th class="center">
                        <div style="position: relative;">

                            <i data-toggle="dropdown" class="iconsweets-cog"></i>
                            <ul class="dropdown-menu" style="min-width: 100%">
                                <li><a onclick="cbHandel(999);" href="#">訂單作廢</a></li>
                            </ul>

                            @Html.Partial("template_select")
                        </div>

                        @*<input type="checkbox" name="del_id" class="checkall" />*@

                    </th>
                    <th class="center">供應商</th>
                    <th class="center">訂單單號</th>
                    <th class="center">寄送方</th>
                    <th class="center">寄送電話</th>
                    <th class="center">寄送地址</th>
                    <th class="center">訂購時間</th>
                    <th class="center">出貨時間</th>
                    <th class="center">申請退貨</th>
                    <th class="center">退貨完成</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
        }

        <tbody>
            <tr class="@NW.echoBool((item.order_data.status != 999 ? true : false), "unread", "visible")">
                <td class="center">
                    <input type="checkbox" name="block_id" class="block_check" value="@(item.order_data.order_id)" /></td>
                <td>@(c_name)</td>
                <td title="@(item.order_data.platform_sn)">@(item.order_data.order_sn)</td>
                <td title="@(item.order_data.send_name)">@(NW.word(item.order_data.send_name, 4, "..."))</td>
                <td title="@(item.order_data.send_tel)">@(item.order_data.send_tel)</td>
                <td title="@(Gs.getAddress(item.order_data.send_address, item.order_data.send_zip))">
                    @(NW.word(Gs.getAddress(item.order_data.send_address, item.order_data.send_zip), 25, "..."))
                </td>
                <td class="center" title="@(item.order_data.order_datetime)">@(NW.getDate(item.order_data.order_datetime))</td>
                <td class="center" title="@(item.order_data.goods_datetime)">@(NW.getDate(item.order_data.goods_datetime))</td>
                <td class="center" title="@(item.order_data.back_datetime)">@(NW.getDate(item.order_data.back_datetime))</td>
                <td class="center" title="@(item.order_data.backed_datetime)">@(NW.getDate(item.order_data.backed_datetime))</td>
                <td class="center">
                    @Html.ActionLink("編輯", "Edit", new { id = item.order_data.order_id }, new { @class = "title", target = "_blank" })
                    || <a onclick="Data('@(Order.order_id)')">明細</a>
                </td>
            </tr>

            <table class="table table-striped table-bordered table-hover table-condensed" id="S_@(Order.order_id)" style="display:none">
                <colgroup>
                    <col class="width4" />
                    <col class="width10" />
                    <col />
                    <col class="width10" />
                    <col class="width18" />
                    <col class="width8" />
                    <col class="width8" />
                    <col class="width8" />
                </colgroup>

                <thead>
                    <tr>
                        <th class="center">#</th>
                        <th class="center">商品貨號</th>
                        <th class="center">商品名稱</th>
                        <th class="center">商品樣式</th>
                        <th class="center">備註</th>
                        @*<th class="center">商品品牌</th>*@
                        <th class="center">購買數量</th>
                        <th class="center">成本</th>
                        <th class="center">小計</th>

                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td class="center">1</td>
                        <td class="center">@(Sub.item_no)</td>
                        <td>@(Sub.item_name)</td>
                        <td>@(Sub.style)</td>
                        <td>@(Sub.info)</td>
                        <td class="right">@(Sub.num)</td>
                        <td class="right">@(Sub.cost.ToString(NW.point))</td>
                        <td class="right">@((Sub.cost * Sub.num).ToString(NW.point))</td>
                    </tr>
                </tbody>
            </table>

        </tbody>
    </table>
        
        
}


<div class="pagination pagination-centered">

    @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount, new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "")).DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber()
            .AddRouteValue("kw", ViewBag.kw)
            .AddRouteValue("sD", ViewBag.sD)
            .AddRouteValue("eD", ViewBag.eD)
            .AddRouteValue("status", ViewBag.status)
            .AddRouteValue("cid", ViewBag.cid)
            .AddRouteValue("sort", ViewBag.sort)
            .AddRouteValue("inv_type", ViewBag.inv_type)
            )

</div>

<script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
@Html.Partial("template_list_fix")

<script>
    function Data(o) {
        $('#S_' + o).toggle();
    }
</script>
