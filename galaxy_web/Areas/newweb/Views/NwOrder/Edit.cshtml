@model galaxy_web.Areas.newweb.Controllers.NwOrderController._order
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    Dictionary<string, object> Class = new Dictionary<string, object>() { };
    Class.Add("class", "span10");

    List<ListItem> Goods = (List<ListItem>)ViewData["Goods"]; //物流公司
    List<ListItem> Inv = (List<ListItem>)ViewData["Inv"]; //發票-類型
    List<ListItem> InvAttr = (List<ListItem>)ViewData["InvAttr"]; //發票-歸屬

    Dictionary<int, string> Status_F = (Dictionary<int, string>)ViewData["Status_F"];

    bool isC = ViewBag.isC ?? true;

    //我們開給消費者發票資訊
    var cus_inv = (galaxy_web.Models.order_invoice)ViewData["cus_inv"];
}

<style>
    .dl-horizontal dt {
        /*text-align: left;*/
        width: 32%;
    }

    .dl-horizontal dd {
        text-align: left;
        margin-left: 40%;
    }
</style>

<div class="maincontent">
    <div class="contentinner">
        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "editprofileform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)

            <input type="hidden" name="order_id" value="@(Model.order_data.order_id)" />           
            <input type="hidden" name="index" />
            
            <div class="widgetcontent">

                <div class="row-fluid">

                    @*訂購資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">訂購資訊</h4>
                        <div class="widgetcontent bordered">

                            <dl class="dl-horizontal">
                                <dt>ERP單號：</dt>
                                <dd>@(Model.order_data.order_sn)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>平台單號：</dt>
                                <dd>@(Model.order_data.platform_sn)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>平台訂購時間：</dt>
                                <dd>
                                    @if (Model.order_data.create_datetime.HasValue)
                                    {
                                        @(Model.order_data.create_datetime.Value)                                 
                                    }
                                </dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>當前狀態：</dt>
                                <dd>
                                    @(Status_F.Where(m => m.Key == Model.order_data.status).Select(m => m.Value).SingleOrDefault() ?? null)
                                </dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>備註：</dt>
                                <dd>
                                    @(Model.order_sub.info)
                                </dd>
                            </dl>

                            @*<dl class="dl-horizontal">
                                <dt>接收訂單時間：</dt>
                                <dd>
                                    @if (Model.order_data.order_datetime.HasValue)
                                    {
                                        @(Model.order_data.order_datetime)
                                    }
                                </dd>
                            </dl>*@

                        </div>
                    </div>

                    @*訂購方資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">訂購方資訊</h4>
                        <div class="widgetcontent bordered">

                            <dl class="dl-horizontal">
                                <dt>姓名：</dt>
                                <dd>@(Model.order_data.order_name)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>電話：</dt>
                                <dd>@(Model.order_data.order_tel)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>郵遞區號：</dt>
                                <dd>@(Model.order_data.order_zip)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>地址：</dt>
                                <dd>@(Gs.getAddress(Model.order_data.order_address, Model.order_data.order_zip))</dd>
                            </dl>

                        </div>
                    </div>

                    @*收件方資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">收件方資訊</h4>
                        <div class="widgetcontent bordered">

                            <dl class="dl-horizontal">
                                <dt>姓名：</dt>
                                <dd>@(Model.order_data.send_name)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>電話：</dt>
                                <dd>@(Model.order_data.send_tel)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>郵遞區號：</dt>
                                <dd>@(Model.order_data.send_zip)</dd>
                            </dl>

                            <dl class="dl-horizontal">
                                <dt>地址：</dt>
                                <dd>@(Gs.getAddress(Model.order_data.send_address, Model.order_data.send_zip))</dd>
                            </dl>

                        </div>
                    </div>

                </div>

                <div class="row-fluid">

                    @*物流資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">物流資訊</h4>
                        <div class="widgetcontent bordered">

                            <dl class="dl-horizontal">
                                <dt>通知出貨：</dt>
                                <dd>@(Model.order_data.order_datetime)</dd>
                            </dl>

                            @if (Model.order_data.status == 1)
                            {
                                <dl class="dl-horizontal">
                                    <dt>宅配公司：</dt>
                                    <dd>@Html.SelectList("goods_id", Goods, Class)</dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>宅配單號：</dt>
                                    <dd>
                                        <input id="goods_sn" name="goods_sn" class="span10" autocomplete="off" /></dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>出貨時間：</dt>
                                    <dd>
                                        <input id="goods_datetime" name="goods_datetime" class="span10" type="datetime" autocomplete="off" /></dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt></dt>
                                    <dd>
                                        <button class="btn" onclick="go(2)">送出</button>
                                    </dd>
                                </dl>
                            }
                            else
                            {
                                
                                <dl class="dl-horizontal">
                                    <dt>宅配公司：</dt>
                                    <dd>
                                        @(Goods.Where(m => m.Value == Model.order_data.goods_id.ToString())
                                         .Select(m => m.DisplayText).FirstOrDefault() ?? null)
                                    </dd>
                                </dl>
                                
                                <dl class="dl-horizontal">
                                    <dt>宅配單號：</dt>
                                    <dd>
                                        @(Model.order_status.Where(m => m.status == 2 && m.status_old != 3).OrderByDescending(m => m.status_id)
                                        .Select(m => m.info).FirstOrDefault() ?? null)

                                    </dd>
                                </dl>
                                
                                <dl class="dl-horizontal">
                                    <dt>出貨時間：</dt>
                                    <dd>
                                        @(Model.order_data.goods_datetime)
                                    </dd>
                                </dl>
                                                              
                            }




                        </div>
                    </div>

                    @*退貨資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">退貨資訊</h4>
                        <div class="widgetcontent bordered">

                            <dl class="dl-horizontal">
                                <dt>申請退貨：</dt>
                                <dd>

                                    @(Model.order_data.back_datetime)
                                </dd>
                            </dl>

                            @if (Model.order_data.status == 3)
                            {
                                <dl class="dl-horizontal">
                                    <dt>是否退貨：</dt>
                                    <dd>
                                        @Html.CheckBox("isback")
                                    </dd>
                                </dl>
                                
                                <dl class="dl-horizontal">
                                    <dt></dt>
                                    <dd>
                                        註：不勾選直接儲存則為取消退貨
                                    </dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>退貨處理時間：</dt>
                                    <dd>
                                        <input id="backed_datetime" name="backed_datetime" class="span10" type="datetime" />
                                    </dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt></dt>
                                    <dd>
                                        <button class="btn" onclick="go(4)">送出</button>
                                    </dd>
                                </dl>
                            }
                            else
                            {
                                <dl class="dl-horizontal">
                                    <dt>是否退貨：</dt>
                                    <dd>
                                        @if (Model.order_status.Any(m => m.status == 3))
                                        {
                                            @(Model.order_status.Any(m => m.status == 4 && !string.IsNullOrEmpty(m.info)) ? "退貨成功" : "取消退貨")
                                        }
                                    </dd>
                                </dl>
                                
                                <dl class="dl-horizontal">
                                    <dt>退貨處理時間：</dt>
                                    <dd>
                                        @(Model.order_data.backed_datetime)
                                    </dd>
                                </dl>
                            }


                        </div>
                    </div>


                </div>

                <div class="row-fluid">

                    @*發票資訊*@
                    @if (Model.order_data.status > 1)
                    {

                        
                        <div class="span4" id="com_inv">
                            <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">廠商開立發票資訊</h4>
                            <div class="widgetcontent bordered">

                                @*@if (Model.order_data.status == 2 && Model.order_data.goods_datetime >= NW.Today.AddDays(10))*@
                                @if (Model.order_data.status == 2 || !isC)
                                {
                                    <dl class="dl-horizontal">
                                        <dt>歸屬：</dt>
                                        <dd>@Html.SelectList("invoice_flag", InvAttr, Class)</dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>類型：</dt>
                                        <dd>@Html.SelectList("attribution_id", Inv, Class)</dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>臺頭：</dt>
                                        <dd>
                                            <input id="title" name="title" class="span10" value="@(Model.order_invoice.Where(m => m.type == 0).Select(m => m.title).FirstOrDefault())" /></dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>號碼：</dt>
                                        <dd>
                                            <input id="no" name="no" class="span10" value="@(Model.order_invoice.Where(m => m.type == 0).Select(m => m.no).FirstOrDefault())" /></dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>開立時間：</dt>
                                        <dd>
                                            <input id="create_datetime" name="create_datetime" class="span10" type="datetime" value="@(NW.getDate(Model.order_invoice.Where(m => m.type == 0).Select(m => m.create_datetime).FirstOrDefault()))" /></dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt></dt>
                                        <dd>
                                            <button class="btn" onmouseover="exch(5)" onclick="go(5)">送出</button>
                                        </dd>
                                    </dl>
                                }
                                else
                                {
                                    <dl class="dl-horizontal">
                                        <dt>歸屬：</dt>
                                        <dd>
                                            @(NW.Invoice_Attr.Where(m => m.Key == Model.order_invoice.Where(k => k.type == 0).Select(k => k.attribution_id).FirstOrDefault()).Select(m => m.Value).FirstOrDefault() ?? null)
                                        </dd>
                                    </dl>
                                
@*<dl class="dl-horizontal">
                                    <dt>歸屬於：</dt>
                                    <dd>
                                        @(Model.order_invoice.attribution)
                                    </dd>
                                </dl>*@
                                
                                    <dl class="dl-horizontal">
                                        <dt>類型：</dt>
                                        <dd>
                                            @(NW.Invoice_Name.Where(m => m.Key == Model.order_invoice.Where(k => k.type == 0).Select(k => k.flag).FirstOrDefault()).Select(m => m.Value).FirstOrDefault() ?? null)
                                        </dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>臺頭：</dt>
                                        <dd>
                                            @(Model.order_invoice.Where(m => m.type == 0).Select(m => m.title).FirstOrDefault())</dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>號碼：</dt>
                                        <dd>
                                            @(Model.order_invoice.Where(m => m.type == 0).Select(m => m.no).FirstOrDefault())</dd>
                                    </dl>

                                    <dl class="dl-horizontal">
                                        <dt>開立時間：</dt>
                                        <dd>
                                            @(Model.order_data.invoice_datetime)</dd>
                                    </dl>
                                
                                }

                            </div>
                        </div>
                        
                                if (Model.order_data.status >= 2 && !isC)
                                {
                        <div class="span4" id="cus_inv">
                            <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">消費者發票紀錄資訊</h4>
                            <div class="widgetcontent bordered">

                                @*@if (Model.order_data.status == 2 && Model.order_data.goods_datetime >= NW.Today.AddDays(10))*@

                                <dl class="dl-horizontal">
                                    <dt>歸屬：</dt>
                                    <dd>@Html.SelectList("invoice_flag", InvAttr, Class)</dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>類型：</dt>
                                    <dd>@Html.SelectList("attribution_id", Inv, Class)</dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>臺頭：</dt>
                                    <dd>
                                        <input  name="title" class="span10" value="@(cus_inv.title)" /></dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>號碼：</dt>
                                    <dd>
                                        <input  name="no" class="span10" value="@(cus_inv.no)" /></dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt>開立時間：</dt>
                                    <dd>
                                        <input  name="create_datetime" class="span10" type="datetime" value="@(NW.getDate(cus_inv.create_datetime))" /></dd>
                                </dl>

                                <dl class="dl-horizontal">
                                    <dt></dt>
                                    <dd>
                                        <button class="btn" onmouseover="exch(6)" onclick="go(6)">送出</button>
                                    </dd>
                                </dl>



                            </div>
                        </div>                   
                                }
                    }
                </div>

                <div class="row-fluid">

                    <h4 class="widgettitle">訂購內容<a style="float: right" onclick="$('#oSub').toggle(300)">明細</a></h4>

                    <div id="oSub" style="display: none">
                        <table class="table table-striped">
                            <colgroup>
                                <col class="width6" />
                                <col class="width10" />
                                <col />
                                <col class="width10" />
                                <col class="width18" />
                                <col class="width8" />
                                <col class="width8" />
                                <col class="width8" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>貨號</th>
                                    @*<th>品牌</th>*@
                                    <th>品名</th>
                                    <th>樣式</th>
                                    <th>備註</th>
                                    <th class="right">成本</th>
                                    <th class="right">數量</th>
                                    <th class="right">小計</th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td>1</td>
                                    <td>@(Model.order_sub.item_no)</td>
                                    @*<td>牛頭牌</td>*@
                                    <td>@(Model.order_sub.item_name)</td>
                                    <td>@(Model.order_sub.style)</td>
                                    <td>@(Model.order_sub.info)</td>
                                    <td class="right">@(Model.order_sub.cost.ToString(NW.point))</td>
                                    <td class="right">@(Model.order_sub.num)</td>
                                    <td class="right">@((Model.order_sub.num * Model.order_sub.cost).ToString(NW.point))</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="row-fluid">

                    <h4 class="widgettitle">訂單狀態-紀錄<a style="float: right" onclick="$('#oRe').toggle(300)">明細</a></h4>


                    <table id="oRe" style="display: none" class="table table-striped">
                        <colgroup>
                            <col class="width6" />
                            <col class="width20" />
                            <col class="width20" />
                            <col class="width20" />
                            <col />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@(Html.DisplayNameFor(m => Model.order_status.FirstOrDefault().create_datetime))</th>
                                <th>@(Html.DisplayNameFor(m => Model.order_status.FirstOrDefault().status))</th>
                                <th>@(Html.DisplayNameFor(m => Model.order_status.FirstOrDefault().status_old))</th>
                                <th>@(Html.DisplayNameFor(m => Model.order_status.FirstOrDefault().info))</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.order_status)
                            {
                                int i = Array.IndexOf(Model.order_status.ToArray(), item) + 1;
                                string
                                    status = Status_F.Where(m => m.Key == item.status).Select(m => m.Value).SingleOrDefault() ?? null,
                                    status_old = Status_F.Where(m => m.Key == item.status_old).Select(m => m.Value).SingleOrDefault() ?? null;
                                
                                
                                <tr>
                                    <td>@(i)</td>
                                    <td>@(item.create_datetime)</td>
                                    <td>@(status)</td>
                                    <td>@(status_old)</td>
                                    <td>@(item.info)</td>
                                </tr>
                            }

                        </tbody>
                    </table>


                </div>

            </div>
        }
    </div>
</div>

<script>
    function go(o) {
        $('input[name="index"]').val(o);

        if (o == 2) {

            $('#goods_id, #goods_sn, #goods_datetime').attr('required', true);

        }
        else if (o == 4) {

            $('#backed_datetime').attr('required', true);
        }
        else if (o == 5) {

        } else if (o == 6) {

        } else { }


        return false;

    }

    function exch(i) {
        if (i == 6) {

            $('#cus_inv input').attr('disabled', false);
            $('#com_inv input').attr('disabled', true);
            $('#cus_inv select').attr('disabled', false);
            $('#com_inv select').attr('disabled', true);
        } else if (i == 5) {

            $('#cus_inv input').attr('disabled', true);
            $('#com_inv input').attr('disabled', false);
            $('#cus_inv select').attr('disabled', true);
            $('#com_inv select').attr('disabled', false);
        }
    }
</script>
