@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    List<ListItem> G = (List<ListItem>)ViewData["G"];
    var Company = (List<ListItem>)ViewData["Company"];

    bool isC = true;
    isC = ViewBag.isC ?? false;
}

<div class="maincontent">
    <div class="contentinner">

        <!--widgetsource-->

        <div id="mail">
            <form id="form1" action="@(Url.Action(action, controller))" method="post" enctype="multipart/form-data">

                <div>
                    <input type="hidden" value="@(ViewBag.inv_type)" name="inv_type">
                    <div style="float: right">
                        <span>

                            <input name="nation" value="@(ViewBag.nation)" type="hidden" />
                            <input name="status" value="@(ViewBag.status)" type="hidden" />
                            <input name="sort" value="@(ViewBag.sort)" type="hidden" />
                            <input type="text" name="kw" autocomplete="off" placeholder="搜尋相關..." value="@(ViewBag.kw)"/>
                            <input type="submit" value="查詢" class="btn btn-primary" />

                            <input name="type" type="hidden" />
                            <button type="button" onclick="if(confirm('匯出欄位需要縮減嗎？')){Type('2');}else{Type('1');}" class="btn">匯出</button>

                            @if (!isC)
                            {
                                <button type="button" onclick="Type('999')" class="btn  btn-danger">小華</button>
                            }
                            

@*匯入*@
                            <input hidden="hidden" type="file" name="Im" value="" />

                        </span>
                    </div>

                    <div>



                        @if (!isC)
                        {
                                                      
                            <span style="padding-right: 10px">廠商：
                        @Html.SelectList("cid", Company)
                            </span>
                        }


                        時間：
                        <input name="sD" style="max-width: 10%" type="datetime" value="@(ViewBag.sD)" />
                        ～
                        <input name="eD" style="max-width: 10%" type="datetime" value="@(ViewBag.eD)" />
                        &emsp;
                    </div>

                </div>
                <br />

            </form>

            <div>
                <div style="float: right">

                    @*<button type="button" class="btn btn-primary" onclick="$('input[name=Im]').click();">匯入訂單</button>


                    <a href="~/Content/files/order/訂單匯入範例.xlsx">
                        <input class="btn" type="button" value="範例下載" /></a>*@

                </div>

                <div>
                    
                    <ul class="nav nav-pills" style="margin-bottom: 0px">

                        @if (G != null)
                        {

                            foreach (var item in G)
                            {
                            <li @(item.IsChecked ? "class=active" : null) >
                                <a onclick="Go('@(item.Value)');">@(item.DisplayText)</a>
                                @*<a href="@Url.Action(action, new { status = item.Value })">@(item.DisplayText)</a>*@
                            </li>
                            }
                            //只有廠商看的到
                            if(!isC)
                            {
                            <li @((bool)ViewBag.active ? "class=active" : null) >
                                <a onclick="Go('50');">待開消費者發票</a>   
                            </li>
                            }
                        }
                    </ul>
                </div>

                <div>
                    <ul class="nav nav-pills" style="margin-bottom: 0px">  

                        <li @(ViewBag.sort == 1 ? "class=active" : null) ><a href="@Url.Action(action, controller, new { sort = 1 })"><span class="icon-arrow-up"></span>廠商字首排序</a></li>
                        <li @(ViewBag.sort == 2 ? "class=active" : null) ><a href="@Url.Action(action, controller, new { sort = 2 })"><span class="icon-arrow-up"></span>收件人字首排序</a></li>
                        <li @(ViewBag.sort == 3 ? "class=active" : null) ><a href="@Url.Action(action, controller, new { sort = 3 })"><span class="icon-arrow-down"></span>訂購日遞減</a></li>
                        <li @(ViewBag.sort == 4 ? "class=active" : null) ><a href="@Url.Action(action, controller, new { sort = 4 })"><span class="icon-arrow-down"></span>出貨日遞減</a></li>
   
                    </ul>
                </div>

@*                <a href="@Url.Action(action, controller, new { sort = 1 })" class="btn@(ViewBag.sort == 1 ? " btn-primary" : "")"><span class="icon-arrow-up"></span>廠商字首排序</a>
                <a href="@Url.Action(action, controller, new { sort = 2 })" class="btn@(ViewBag.sort == 2 ? " btn-primary" : "")"><span class="icon-arrow-up"></span>收件人字首排序</a>
                <a href="@Url.Action(action, controller, new { sort = 3 })" class="btn@(ViewBag.sort == 3 ? " btn-primary" : "")"><span class="icon-arrow-down"></span>訂購日遞減</a>
                <a href="@Url.Action(action, controller, new { sort = 4 })" class="btn@(ViewBag.sort == 4 ? " btn-primary" : "")"><span class="icon-arrow-down"></span>出貨日遞減</a>*@
            </div>

        </div>

        <div id="List_ajax">
            @Html.Partial(action + "_ajax")
        </div>
    </div>
</div>


