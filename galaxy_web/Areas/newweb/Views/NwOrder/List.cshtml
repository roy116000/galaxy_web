<script>

    function Go(o) {

        if (o == 50)
        {
            $('input[name="inv_type"]').val(1);
            $('input[name="status"]').val(5);
        } else {
            //$('input[name="type"]').val('0');
            $('input[name="inv_type"]').val(0);
            $('input[name="status"]').val(o);
        }
        $('#form1').submit();
    }

    function Type(o) {

        $('input[name="type"]').val(o);
        $('#form1').submit();

        $('input[name="type"]').val('0');
    }
</script>
