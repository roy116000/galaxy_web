                                    erp成本計算公式為：(成本+最終售價*1.1)*
                                    <input id="nnn1" value="0.5" type="number">
                                    =
                                    <input id="nnn2" value="@(Model.erp_cost)" type="number">
                                </div>
                            </div>
                            <script>
                                $(function () {
                                    var p = @(Model.erp_cost);
                                    var d = p * 2;
                                    $('#nnn1').keyup(function () {
                                        if (!isNaN($(this).val())) {
                                            if($(this).val() >= 0.5 && $(this).val() <= 0.7)
                                            {
                                                var p2 = d * $(this).val(); 
                                                $('#nnn2').val(p2);
                                            }    
                                        }else{
                                            ('#nnn2').val(p);
                                        }
                                    })

                                    $('#nnn2').keyup(function () {
                                        if (!isNaN($(this).val())) {
                                            var p2 = $(this).val() / d; 

                                            $('#nnn1').val(formatFloat(p2, 2));
                                        }else{
                                            ('#nnn1').val(0.5);
                                        }
                                    })

                                    function formatFloat(num, pos)
                                    {
                                        var size = Math.pow(10, pos);
                                        return Math.round(num * size) / size;
                                    }
                                })
                                
                            </script>
                            <style>
                                #nnn1, #nnn2 {
                                    width: 50px;
                                }
                            </style>
                            
