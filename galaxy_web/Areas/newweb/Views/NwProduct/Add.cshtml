<script>
    $(function () {
        $('#item_name, #sub_id, #company_id').attr('required', true);
        $('#cost, #price, #erp_cost, #sprice, #freight').attr('required', true);

    })
</script>


<script>
    $(function () {
        var cost = $('input[name="cost"]').val(); //成本
        //var freight = $('input[name="freight"]').val(); //運費
        var freight = 0;
        var sprice = $('input[name="sprice"]').val(); //商品定價
        var price = $('input[name="price"]').val(); //商品售價

        Calculate(cost, freight, sprice, price);
    });


    $('#cost, #price, #sprice, #freight').keyup(function () {

        var cost = $('input[name="cost"]').val(); //成本
        //var freight = $('input[name="freight"]').val(); //運費
        var freight = 0;
        var sprice = $('input[name="sprice"]').val(); //商品定價
        var price = $('input[name="price"]').val(); //商品售價


        //本次操作
        var id = $(this).attr('name');
        var o = $(this).val();
        if ($.isNumeric(o)) {

            switch (id) {
                case "cost":
                    cost = o;
                    break;

                case "freight":
                    freight = o;
                    break;

                case "sprice":
                    sprice = o;
                    break;

                case "price":
                    price = o;
                    break;
            }

        } else {
            swal('請輸入數字');
        }

        Calculate(cost, freight, sprice, price);
    })

    function Calculate(cost, freight, sprice, price) {

        cost = Number(cost); //成本
        freight = Number(freight); //運費
        sprice = Number(sprice); //商品定價 
        price = Number(price);//商品售價

        //商城售價
        var o = price + freight;

        $('.colcou').eq(0).html(o);

        ////商品折扣率
        //var s = (o / (sprice + freight)) * 100
        //if ($.isNumeric(s)) {
        //    $('.colcou').eq(1).html(s.toFixed(2) + '%');
        //} else {
        //    $('.colcou').eq(1).html('計算錯誤');
        //}

        //商城利潤
        var x = ((o - (cost + freight)) / (o)) * 100;
        if ($.isNumeric(x)) {
            $('.colcou').eq(1).html(x.toFixed(2) + '%');
        } else {
            $('.colcou').eq(1).html('計算錯誤');
        }

        //推薦人利潤
        var z = (x * 0.1);
        if ($.isNumeric(z)) {
            $('.colcou').eq(3).html(z.toFixed(2) + '%');
        } else {
            $('.colcou').eq(3).html('計算錯誤');
        }
    }

</script>
