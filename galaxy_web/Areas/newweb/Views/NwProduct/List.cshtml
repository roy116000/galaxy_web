@using MvcPaging;
@model IPagedList<galaxy_web.Models.product_data>
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    var G = (List<ListItem>)ViewData["G"];
    var Company = (List<ListItem>)ViewData["Company"];

    int PID = ViewBag.apower ?? 0;


}

<div class="maincontent">
    <div class="contentinner">

        <div id="mail">

            <div>

                <form id="form1" action="@(Url.Action(action, controller))" method="post" enctype="multipart/form-data">

                    <div style="float: right">

                        <span>

                            <input name="nation" type="hidden" value="@(ViewBag.nation)" />
                            <input name="type" type="hidden" />
                            <input name="sort" type="hidden" value="@(ViewBag.sort)" />
                            <input name="p" type="hidden" value="@(ViewBag.p)" />
                            <input name="status" value="@(ViewBag.status)" type="hidden" />
                            <input type="text" name="kw" autocomplete="off" placeholder="請輸入搜尋相關" value="@(ViewBag.kw)"/>
                            <input type="submit" value="查詢" class="btn btn-primary" />

                            <input name="type" type="hidden" />
                            <button type="button" onclick="Type('1')" class="btn">匯出</button>



                        </span>




                    </div>

                    <div>

                        @if (PID < 3)
                        {
                            <span style="padding-right: 10px">廠商：
                        @Html.SelectList("cid", Company)
                            </span>
                        }

                    </div>

                </form>

            </div>

            <br />

            <div>

                <div style="float: right">

                    <ul class="nav nav-pills" style="margin-bottom: 0px">

                        @if (G != null)
                        {
                            foreach (var item in G)
                            {
                            
                            <li @(item.IsChecked ? "class=active" : "")>
                                <a onclick="Go('@(item.Value)');" >@item.DisplayText</a>
                            </li>
                        
                            }
                        }
                    </ul>

                </div>

                <div>
                    <ul class="msghead_menu">
                        <li>

                            @if (PID > 2)
                            {
                                <a href="@Url.Action("Add", controller, new { id = 0, nation = ViewBag.nation })" class="btn"><span class="icon-pencil"></span>新增商品</a>
                            }
                            else
                            {
                                            
                                <div class="btn-group">

                                    <span class="btn dropdown-toggle" data-toggle="dropdown"><span class="icon-check"></span>選擇設定<span class="caret"></span></span>
                                    <ul class="dropdown-menu">
                                        <li><a onclick="cbHandel(0);" href="#"><span class="icon-ok-sign"></span>草稿區</a></li>
                                        <li><a onclick="cbHandel(3);" href="#"><span class="icon-ok-sign"></span>上架</a></li>
                                        <li><a onclick="cbHandel(4);" href="#"><span class="icon-ok-sign"></span>下架</a></li>
                                        <li><a onclick="cbHandel(999);" href="#"><span class="icon-ok-sign"></span>作廢</a></li>
                                    </ul>

                                </div>
                                
                                <a href="@Url.Action(action, controller, new { sort = 1 })" class="btn@(ViewBag.sort == 1 ? " btn-primary" : "")"><span class="icon-arrow-up"></span>廠商字首排序</a>
                                <a href="@Url.Action(action, controller, new { sort = 2 })" class="btn@(ViewBag.sort == 2 ? " btn-primary" : "")"><span class="icon-arrow-down"></span>毛利率遞減排序</a>
                                
                                <div class="btn-group">

                                    <span class="btn dropdown-toggle" data-toggle="dropdown"><span class="icon-cog"></span>平台設定<span class="caret"></span></span>
                                    <ul class="dropdown-menu">
                                        @foreach (var item in NW.platforms)
                                        { 
                                        <li><a onclick="cbHandel(@(item.Split(',')[0]));" href="#"><span class="icon-pencil"></span>@(item.Split(',')[1])</a></li>
                                        }
                                    </ul>

                                </div>
                                
                                <div class="btn-group">

                                    <span class="btn dropdown-toggle" data-toggle="dropdown"><span class="icon-th-list"></span>平台過濾<span class="caret"></span></span>
                                    <ul class="dropdown-menu">
                                        @foreach (var item in NW.platforms)
                                        { 
                                           <li><a onclick="$('input[name=p]').val(@(item.Split(',')[0]));$('#form1').submit();"><span class="icon-search"></span>@(item.Split(',')[1])</a></li>
                                        }
                                    </ul>

                                </div>
                                            
                                @Html.Partial("template_select")
                            }

                        </li>
                    </ul>
                </div>

            </div>

        </div>

        <!--#chat-->

        <div id="List_ajax">
            @Html.Partial(action + "_ajax", Model)
        </div>

        <script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
        @Html.Partial("template_list_fix")

    </div>
    <!--contentinner-->
</div>

<script>

    $('input[name="Im"]').change(function () {

        //格式
        var re = /(\.xlsx)$/i;

        var ext = $(this).val();

        //判斷格式
        if (!re.test(ext)) {

            swal('請上傳.xlsx格式');

            $('input[name="Im"]').val('');
            return false;

        } else {

            swal({
                title: "確定上傳 " + ext + " 嗎?",
                text: "",
                //type: "success",
                showCancelButton: true,
                //confirmButtonColor: "#DD6B55",
                confirmButtonText: "是的，確定",
                cancelButtonText: "再考慮看看",
                closeOnConfirm: false,
                showLoaderOnConfirm: true,
                //imageUrl: "/images/in6/未命名.png"
            }, function (isConfirm) {
                if (isConfirm) {

                    $('#form1').attr('action', '@(Url.Action("Import"))');
                    $('#form1').submit();
                } else {

                    $('input[name="Im"]').val('');
                    return false;
                }
            })
        }
    })

</script>

<script>
    function Go(o) {

        $('input[name="type"]').val('0');
        $('input[name="status"]').val(o);
        $('#form1').submit();
    }

    function Type(o) {

        $('input[name="type"]').val(o);
        $('#form1').submit();

        $('input[name="type"]').val('0');
    }

</script>

