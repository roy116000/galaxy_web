@using MvcPaging;
@model List<galaxy_web.Models.product_erp_group>
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    int i = 1;
                //string s = "";
}

<table class="table table-bordered mailinbox">
    <colgroup>
        <col class="width2" />

        <col class="width4" />
        <col class="width18" />
        <col class="width4" />
        <col class="width4" />
        <col class="width4" />
        @*<col class="width8" />*@
    </colgroup>
    <thead>
        <tr>
            <th class="center">#</th>
            <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().pre))</th>
            <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().name))</th>
            <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().inx))</th>
            <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().visible))</th>
            @*<th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().count))</th>*@
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                              
            <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                <td class="center">@(i++)</td>
                <td class="center">@Html.DisplayFor(m => item.pre)</td>
                <td>@Html.DisplayFor(m => item.name)</td>

                <td class="center">@Html.DisplayFor(m => item.inx)</td>
                <td class="center">@Html.DisplayFor(m => item.visible)</td>
                @*<td class="center">@Html.DisplayFor(m => item.count)</td>*@
                <td class="center">

                    @Html.ActionLink("編輯", action.Replace("List", "Edit").Replace("_ajax", ""), new { id = item.group_id }, new { @class = "title" })

                </td>
            </tr>
        }
    </tbody>
</table>

