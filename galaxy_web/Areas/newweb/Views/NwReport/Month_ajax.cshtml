@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    var Goods = (List<galaxy_web.Areas.newweb.Controllers.NwReportController._Month>)ViewData["Goods"]; //當月出貨單
    var Back = (List<galaxy_web.Areas.newweb.Controllers.NwReportController._Month>)ViewData["Back"]; //上個月退貨單
    var LBack = (List<galaxy_web.Areas.newweb.Controllers.NwReportController._Month>)ViewData["LBack"]; //當月訂當月退

    var List = new Dictionary<string, List<galaxy_web.Areas.newweb.Controllers.NwReportController._Month>>() { };
    List.Add("當月 - 出貨單", Goods);
    List.Add("上個月 - 退貨單", LBack);
    List.Add("當月 - 退貨單", Back);

    int num = 0;
    decimal total_all = 0;

    var All = new Dictionary<string, KeyValuePair<int, decimal>>() { };

    //int Goods_num = 0, Back_num = 0, LBack_num = 0;
    //decimal G_total = 0, B_total = 0, LB_total = 0;
    
}

@foreach (var item2 in List)
{
    int id = Array.IndexOf(List.Select(m => m.Key).ToArray(), item2.Key);
    
    <h4 class="widgettitle">@(item2.Key)<a style="float: right" onclick="$('#@(id)').toggle(300)">明細</a></h4>
    

    <div id="@(id)" style="display: none; height: auto; overflow: auto">
        <table class="table table-bordered mailinbox">
            <colgroup>
                <col class="width4" />
                <col class="width10" />
                <col class="width10" />
                <col class="width10" />
                <col />
                <col class="width10" />
                <col class="width8" />
                @*<col class="width8" />*@
                <col class="width8" />
                <col class="width8" />
                @*<col class="width8" />*@
            </colgroup>
            <thead>
                <tr>
                    <th class="center">#</th>
                    <th class="center">供應商</th>
                    <th class="center">訂購日期</th>
                    <th class="center">寄送方</th>
                    <th class="center">商品名稱</th>
                    <th class="center">商品貨號</th>
                    <th class="center">數量</th>
                    <th class="center">成本</th>
                    @*<th class="center">運費</th>*@
                    <th class="center">總計</th>
                </tr>
            </thead>
            <tbody>

                @if (item2.Value != null)
                {
                    foreach (var item in item2.Value)
                    {
                        // 
                        int i = Array.IndexOf(item2.Value.Select(m => m.order_data.order_id).ToArray(), item.order_data.order_id) + 1;
                        decimal cost = item.order_sub.cost;
                        decimal total = cost * item.order_sub.num + item.order_sub.freight;

                        num = num + 1; //筆數
                        total_all += total; //總計
                        
                        
                    
                    <tr class="@NW.echoBool(true, "unread", "visible")">
                        <td class="right">@(i)</td>
                        <td>@(item.company.name)</td>
                        <td>@(NW.getDate(item.order_data.order_datetime))</td>
                        <td>@(item.order_data.send_name)</td>
                        <td>@(item.order_sub.item_name)</td>
                        <td>@(item.order_sub.item_no)</td>
                        <td class="right">@(item.order_sub.num)</td>
                        <td class="right">@(cost.ToString(NW.point))</td>
                        @* <td class="right">@(item.order_sub.freight.ToString(NW.point))</td>*@
                        <td class="right">@(total.ToString(NW.point))</td>
                    </tr>
                    }

                    All.Add(item2.Key, new KeyValuePair<int, decimal>(num, total_all));

                    num = 0;
                    total_all = 0;
                }

            </tbody>
        </table>

    </div>
    

}

<br />
<table class="table table-bordered mailinbox">
    <colgroup>
        <col class="width4" />
        <col class="width8" />
        <col class="width8" />
        <col class="width8" />
        @*<col class="width6" />*@
    </colgroup>
    <thead>
        <tr>
            <th></th>
            @foreach (var item in All)
            {
                <th class="center">@(item.Key)</th>
            }

        </tr>
    </thead>
    <tbody>
        <tr class="@NW.echoBool(true, "unread", "visible")">
            <td class="center">筆數</td>

            @foreach (var item in All.Select(m => m.Value.Key))
            {
                <td class="center">@(item)</td>
            }

        </tr>
        <tr class="@NW.echoBool(false, "unread", "visible")">
            <td class="center">金額總計</td>
            @foreach (var item in All.Select(m => m.Value.Value).ToList())
            {
                <td class="center">@(item.ToString(NW.point))</td>
            }

        </tr>
    </tbody>
</table>
