@{
    string msg = ViewBag.msg;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>ERROR</title>
</head>

<!--↓--【CSS樣式】切這邊--↓-->
<style>
    body {
        padding: 0;
        margin: 0;
        background: #f8f8f8;
        background-size: cover;
    }

    .m1 {
        background: url(http://www.iclient.com.tw/warning/images/im5.jpg) top center no-repeat;
        width: 100%;
        height: 800px;
    }

        .m1 .a1 {
            width: 0%;
            height: auto;
            margin: 0 auto;
            padding: 60px 0 0 10%;
        }

            .m1 .a1 .b1 {
                height: 290px;
            }

            .m1 .a1 .b2 {
                width: 490px;
                height: 90px;
                font: bold 87px/87px Verdana, "微軟正黑體";
                color: #da0216;
                letter-spacing: -7px;
            }

            .m1 .a1 .b3 {
                width: 490px;
                height: 35px;
                font: bold 35px/35px Arial, "微軟正黑體";
                color: #555;
                padding: 10px 0 20px;
            }

            .m1 .a1 .b4 {
                width: 490px;
                height: 120px;
                font: 16px/24px Arial, "微軟正黑體";
                color: #555;
            }

                .m1 .a1 .b4 a {
                    background: #ff536b no-repeat scroll 30px 14px / auto 20px;
                    border: 1px solid #ff536b;
                    color: #fff;
                    display: inline-block;
                    font: bold 17px/48px "微軟正黑體";
                    height: 48px;
                    padding: 0 40px 0 40px;
                    /*text-align: left;*/
                    width: -moz-max-content;
                }

                    .m1 .a1 .b4 a:hover {
                        background: 30px 14px no-repeat #fff;
                        color: #ff536b;
                        background-size: auto 20px;
                    }
</style>
<!--↓--【HTML標籤】放這邊--↓-->
<body>

    <div class="m1">
        <div class="a1">
            <div class="b2">ERROR</div>

            @* @if (!string.IsNullOrEmpty(Code))
            {
                <div class="b3">錯誤代碼：<span style="color: #f00; font-size: xx-large">@(Code)</span></div>
            }*@

            <div class="b3"></div>
            <div class="b4" style="font-weight: bold; word-break: break-all; font-size: xx-large">
                @(msg)<br />
                <br />
                @*@(Request.Url.OriginalString.ToString())<br />*@
                <a style="cursor: pointer;" onclick="history.back()">回上一頁</a>
            </div>


        </div>
    </div>

</body>
</html>
