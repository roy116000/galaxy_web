@using h365_web.Models;
@model MvcPaging.IPagedList<h365_web.Models.order_data>
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "span2");
}

<script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
@Html.ValidationSummary(true)
<script type="text/javascript">
    function cbHandel(flag) {
        if ($("input[name='block_id']:checked").length == 0) { alert('請至少選擇一項'); return false; }
        var name = '刪除';
        switch (flag) { case 1: name = "啟用"; break; case 2: name = "作廢"; break; }
        if (confirm('確定要' + name + '？')) {
            var arrVal = new Array();
            $("input[name='block_id']:checked").each(function (i) {
                arrVal[i] = this.value;
            });
        }
        $('#cb_flag').val(flag);
        $('#cb_id').val(arrVal.toString());
        $('#frmCheckbox').submit();
    }
</script>
@using (Html.BeginForm(action + "Del", controller, FormMethod.Post, new { @id = "frmCheckbox" }))
{
    <input type="hidden" id="cb_flag" name="cb_flag" value="0" />
    <input type="hidden" id="cb_id" name="cb_id" value="" />
}

<!--pagetitle-->
<div class="maincontent">
    <div class="contentinner">
        <ul class="nav nav-pills">
        </ul>

        <!--widgetsource-->
        <div id="mail">
            <div class="msghead">
                @using (Html.BeginRouteForm("", FormMethod.Post))
                {
                    <div>
                        申請退貨日期：
                        <input type="text" value="@ViewBag.start_date" name="start_date" id="start_date" class="span2">
                        ～
                        <input type="text" value="@ViewBag.end_date" name="end_date" id="end_date" class="span2">
                        
                        @{List<ListItem> Flag_Invo = (List<ListItem>)ViewData["Flag_Invo"];}
                        發票狀態：@(Html.SelectList("Flag_Invo", Flag_Invo, htmlAttributes))

                        關鍵字查詢：
                        <input type="text" id="kw" name="kw" class="filekeyword" placeholder="搜尋姓名或電話" value="@ViewBag.kw" />
                        <input type="submit" value="查詢" class="btn btn-primary" />

                        @*@{List<ListItem> Name_Order = (List<ListItem>)ViewData["Name_Order"];}
                        訂購方：@(Html.SelectList("name_order", Name_Order, htmlAttributes))

                        @{List<ListItem> Name_Send = (List<ListItem>)ViewData["Name_Send"];}
                        收件方：@(Html.SelectList("name_send", Name_Send, htmlAttributes))*@

                    </div>
                   
                    
                                  
                }
                <span class="clearall"></span>
            </div>
            <!--msghead-->
        </div>
        <!--#chat-->

        @Html.Partial(action + "_ajax", Model)
        <!--list-->
    </div>
    <!--contentinner-->
</div>
<script type="text/javascript">$(function () { $('#start_date').datepicker(); $('#end_date').datepicker(); })</script>
