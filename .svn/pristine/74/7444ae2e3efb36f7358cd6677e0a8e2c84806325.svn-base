    public class health_part
    {
        [Key]
        public int part_id { get; set; }

        [DisplayName("分類標題")]
        public string name { get; set; }

        [DisplayName("啟用")]
        public Boolean visible { get; set; }

        [DisplayName("排序")]
        public int inx { get; set; }

        [DisplayName("create_datetime")]
        public DateTime? create_datetime { get; set; }

        [DisplayName("change_admin_id")]
        public string create_user { get; set; }

        [DisplayName("change_branch_id")]
        public string change_user { get; set; }

        [DisplayName("change_datetime")]
        public DateTime? change_datetime { get; set; }

        [NotMapped]
        [DisplayName("關聯數量")]
        public int counts { get; set; }

        [NotMapped]
        [DisplayName("關聯")]
        public string related_name { get; set; }


    }

