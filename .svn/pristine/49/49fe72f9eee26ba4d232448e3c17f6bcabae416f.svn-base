@using MvcPaging;
@model IPagedList<h365_web.Models.data_list>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
    
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width5" />
            <col class="width8" />
            <col class="width8" />
            <col />
            <col class="width16" />
            <col class="width8" />
            <col class="width12" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th class="center">請款月份 </th>
                <th class="center">處理狀態 </th>
                <th>請款人 </th>
                <th class="center">請款日期 </th>
                <th class="center">請款金額 </th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                string bills = "";
                switch (item.group_id)
                {
                    case 1:
                        bills = "-上";
                        break;
                    case 2:
                        bills = "-下";
                        break;
                }
                        
                <tr class="unread">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" /></td>
                    <td class="center">@(item.hits.ToString() + bills)</td>
                    <td class="center">
                        @switch (item.status_flag)
                        {
                            case 0: 
                            <span class="label" style="background-color: #d9534f;">未請款</span>
                                break;
                            case 1: 
                            <span class="label" style="background-color: #337ab7;">處理中</span>
                                break;
                            case 2:                                  
                            <span class="label label-success">請款完成</span>
                                break;
                        }

                    </td>
                    <td>@(item.create_user)</td>
                    <td class="center">
                        @if (item.create_datetime != null)
                        {
                            @(((DateTime)item.create_datetime).ToString("yyyy/MM/dd"))
                        }
                    </td>
                    <td class="center">$ @(item.cost.ToString("N0"))</td>
                    <td>
                  
                        @if (item.visible)
                        {
                            @Html.ActionLink("請款", "CBillsAdd", new { id = item.data_id, yymm = item.hits, bills_flag = item.group_id, sD = item.start_date, eD = item.end_date }) @: |
                        }
                        else
                        {
                            @:請款 |
                        }
                        @Html.ActionLink("檢視", "CBillsEdit", new { id = item.data_id, sD = item.start_date, eD = item.end_date }) | 
                        @Html.ActionLink("匯出請款", "BillsExport", new { id = item.data_id, yymm = item.hits, sD = item.start_date, eD = item.end_date })
                       
                    </td>
                </tr>
            }

        </tbody>
    </table>
    <div>@ViewBag.total</div>
    <div class="pagination pagination-centered">
        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber())
    </div>
</div>
<!--pagination-->
