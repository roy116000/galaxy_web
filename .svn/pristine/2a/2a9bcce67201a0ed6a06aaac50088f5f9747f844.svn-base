        [HttpPost, ValidateInput(false)]
        public ActionResult GroupAddSave(album_group album_group, VmImage imgs)
        {
            //var data = this._DB.album_group.Find(album_group.zz_id);
            //var data1 = this._DB.album_group.Where(m => m.zz_id.Equals(album_group.zz_id)).Select(m => m).SingleOrDefault();
            var data = new album_group { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.group_id = album_group.group_id;
                data.name = album_group.name;
                data.inx = album_group.inx;
                data.visible = album_group.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.album_group.Add(data);
                this._DB.SaveChanges();

                album_group.group_id = data.group_id;
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = album_group.group_id });
        }

