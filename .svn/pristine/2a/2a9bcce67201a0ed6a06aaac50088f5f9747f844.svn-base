                    sql = " Update album_group Set visible = 1 Where group_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = " Update album_group Set visible = 0 Where group_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From album_group Where group_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
