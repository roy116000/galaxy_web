using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using System.Data.Linq;

using h365_web.Models;
using MvcPaging;

namespace h365_web.Areas.newweb.Controllers
{
    public class NwActivityController : _BaseController
    {
        //
        // GET: /newweb/NwAlbum/

        #region "活動花絮列表"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.album_data
                           join m2 in _DB.album_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.album_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               s_img = m.album_image.OrderBy(x => x.img_inx).FirstOrDefault().s_img,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            var data2 = this._DB.album_group.OrderBy(m => m.inx).Select(m => new data_group()
            {
                group_id = m.group_id,
                name = m.name,
                counts = m.album_data.Count()
            });
            ViewData["album_group"] = data2;

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.album_data
                           join m2 in _DB.album_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.album_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               s_img = m.album_image.OrderBy(x => x.img_inx).FirstOrDefault().s_img,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult Edit(int id)
        {

            var data = this._DB.album_data.Find(id);

            //圖片
            var image = _DB.album_image.Where(m => m.album_id.Equals(id)).ToList();
            List<images_data> imgData = new List<images_data>();
            foreach (var item in image)
            {
                images_data imgs_data = new images_data();
                imgs_data.imgs_id = item.imgs_id;
                imgs_data.s_img = item.s_img;
                imgs_data.b_img = item.b_img;
                imgs_data.img_info = item.img_info;
                imgs_data.img_inx = item.img_inx;
                imgData.Add(imgs_data);
            }
            ViewData["uploadimage2"] = imgData;

            //下拉選單
            var gData = (from m in _DB.album_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(album_data album_data, VmImage imgs)
        {
            var data = this._DB.album_data.Find(album_data.album_id);
            //var data1 = this._DB.album_data.Where(m => m.album_id.Equals(album_data.album_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.album_id = album_data.album_id;
                data.group_id = album_data.group_id;
                data.title = album_data.title;
                data.cont = album_data.cont;
                data.inx = album_data.inx;
                data.hits = album_data.hits;
                data.start_date = album_data.start_date;
                data.end_date = album_data.end_date;
                data.visible = album_data.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = album_data.create_user;
                //data.create_datetime = album_data.create_datetime;

                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new album_image();
                        imgData.album_id = data.album_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.album_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.album_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.album_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.album_id = album_data.album_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = album_data.album_id });
        }

        public ActionResult Add(int id)
        {
            album_data data = new album_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);

            //圖片           
            ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.album_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;


            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(album_data album_data, VmImage imgs)
        {
            //var data = this._DB.album_data.Find(album_data.album_id);
            //var data1 = this._DB.album_data.Where(m => m.album_id.Equals(album_data.album_id)).Select(m => m).SingleOrDefault();
            var data = new album_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.album_id = album_data.album_id;
                data.group_id = album_data.group_id;
                data.title = album_data.title;
                data.cont = album_data.cont;
                data.inx = album_data.inx;
                data.hits = album_data.hits;
                data.start_date = album_data.start_date;
                data.end_date = album_data.end_date;
                data.visible = album_data.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.album_data.Add(data);
                this._DB.SaveChanges();

                album_data.album_id = data.album_id;

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new album_image();
                        imgData.album_id = data.album_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.album_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.album_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.album_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.album_id = album_data.album_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = album_data.album_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update album_data set visible = 1 Where album_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update album_data set visible = 0 Where album_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From album_image Where album_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From album_data Where album_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "分類列表"

        public ActionResult GroupList(string kw)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.album_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.album_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

