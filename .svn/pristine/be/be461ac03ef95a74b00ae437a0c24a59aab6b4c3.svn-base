        [HttpPost, ValidateInput(false)]
        public ActionResult TmpAddSave(zz_data zz_data, VmImage imgs)
        {
            //var data = this._DB.zz_data.Find(zz_data.zz_id);
            //var data1 = this._DB.zz_data.Where(m => m.zz_id.Equals(zz_data.zz_id)).Select(m => m).SingleOrDefault();
            var data = new zz_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                //data.zz_id = zz_data.zz_id;
                data.text = zz_data.text;
                data.text_max = zz_data.text_max;
                data.text_required = zz_data.text_required;
                data.text_date = zz_data.text_date;
                data.text_end_date = zz_data.text_end_date;
                data.text_mail = zz_data.text_mail;
                data.text_html = zz_data.text_html;
                data.text_num = zz_data.text_num;
                data.text_phone = zz_data.text_phone;
                data.text_area = zz_data.text_area;
                data.checkbox = zz_data.checkbox;
                data.checkbox2 = zz_data.checkbox2;
                data.radio = zz_data.radio;
                data.select1 = zz_data.select1;
                data.select2 = zz_data.select2;
                data.select3 = zz_data.select3;
                data.text_area_charCount = zz_data.text_area_charCount;
                data.text_tags = zz_data.text_tags;
                data.select_chosen = zz_data.select_chosen;
                data.select_chosen2 = zz_data.select_chosen2;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.zz_data.Add(data);
                this._DB.SaveChanges();

                zz_data.zz_id = data.zz_id;

                #region "圖片處理"
                if (imgs.img_id.Count() > 0)
                {
                    if (zz_data.zz_id != data.zz_id)
                    {

                        if (imgs.img_id[0] == 0)
                        {
                            //新增
                            var imgData = new zz_imgs
                            {
                                zz_id = zz_data.zz_id,
                                s_img = imgs.s_img[0].ToString(),
                                b_img = imgs.b_img[0].ToString(),
                                img_visible = true
                            };
                            if (imgs.s_img[0].ToString() != "" && imgs.s_img[0].ToString() != null)
                            {
                                _DB.zz_imgs.Add(imgData);
                                this._DB.SaveChanges();
                            }
                        }
                        else
                        {
                            //編輯
                            var imgData = _DB.zz_imgs.Find(imgs.img_id[0]);
                            if (imgs.s_img[0].ToString() == "" || imgs.s_img[0].ToString() == null)
                            {
                                _DB.zz_imgs.Remove(imgData);
                            }
                            else
                            {
                                imgData.zz_id = zz_data.zz_id;
                                imgData.s_img = imgs.s_img[0].ToString();
                                imgData.b_img = imgs.b_img[0].ToString();
                            }
                            _DB.SaveChanges();
                        }

                    }
                    else
                    {
                        //多圖
                        for (int i = 0; i < imgs.s_img.Count; i++)
                        {
                            if (imgs.img_id[i] == 0)
                            {
                                //新增
                                var imgData = new zz_imgs
                                {
                                    zz_id = zz_data.zz_id,
                                    s_img = imgs.s_img[i].ToString(),
                                    b_img = imgs.b_img[i].ToString(),
                                    img_info = imgs.img_info[i].ToString(),
                                    img_inx = imgs.img_inx[i],
                                    img_visible = true
                                };
                                if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                                {
                                    _DB.zz_imgs.Add(imgData);
                                }
                            }
                            else
                            {
                                var imgData = _DB.zz_imgs.Find(imgs.img_id[i]);


                                if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                                {
                                    _DB.zz_imgs.Remove(imgData);
                                }
                                else
                                {
                                    imgData.zz_id = zz_data.zz_id;
                                    imgData.s_img = imgs.s_img[i].ToString();
                                    imgData.b_img = imgs.b_img[i].ToString();
                                    imgData.img_info = imgs.img_info[i].ToString();
                                    imgData.img_inx = imgs.img_inx[i];
                                }
                                _DB.SaveChanges();
                            }
                        }


                    }

                }
                #endregion
            }

            //更新

            TempData["jgrowl"] = "資料新增成功!!";


            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = zz_data.zz_id });
        }

        [HttpPost]
        public ActionResult TmpListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);


            var data = (from xx in _DB.zz_data
                        where strArray.Contains(xx.zz_id)
                        select xx).ToList();

            foreach (var item in data)
            {
                zz_data vmD = _DB.zz_data.Find(item.zz_id);

                switch (cb_flag)
                {
                    case 1:
                        vmD.checkbox = true;
                        break;
                    case 2:
                        vmD.checkbox = false;
                        break;
                    case 0:
                        _DB.zz_data.Remove(vmD);
                        break;
                }
                _DB.SaveChanges();
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

