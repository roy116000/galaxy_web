        [HttpPost, ValidateInput(false)]
        public ActionResult CompanyAddSave(company_data company_data, VmImage imgs)
        {
            var data = new company_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                data.inv_sn = company_data.inv_sn;
                data.name = company_data.name;
                data.boss = company_data.boss;
                data.address = company_data.address;
                data.tel = company_data.tel;
                data.fax = company_data.fax;
                data.contact = company_data.contact;
                data.contact_tel = company_data.contact_tel;
                data.mail = company_data.mail;
                data.bills_flag = company_data.bills_flag;
                data.web = company_data.web;
                data.visible = company_data.visible;

                data.freight = company_data.freight;

                data.bills_datetime = DateTime.Today.AddMonths(-2);
                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.company_data.Add(data);
                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new company_image();
                        imgData.company_id = data.company_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.company_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.company_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.company_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.company_id = company_data.company_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

                company_data.company_id = data.company_id;

                #region "新增後台登入帳號"

                var data2 = new sys_admin_data { };

                data2.company_id = data.company_id;
                data2.power_id = 4;
                data2.uid = company_data.inv_sn;
                data2.pwd = "a1234";
                data2.visible = true;
                data2.start_date = data.create_datetime;
                data2.end_date = data.create_datetime.Value.AddYears(3);
                data2.name = company_data.name;
                data2.tel = company_data.tel;
                data2.phone = company_data.contact_tel;
                data2.mail = company_data.mail;
                data2.address = company_data.address;
                data2.create_user = data.create_user;
                data2.create_datetime = data.create_datetime;

                _DB.sys_admin_data.Add(data2);
                this._DB.SaveChanges();


                #endregion

            }

            //廠商新增成功後，寄信通知
            SendMessage(company_data.company_id);

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = company_data.company_id });
        }

        public ActionResult SendMail(int cid)
        {

            SendMessage(cid);

            return RedirectToAction("CompanyList", "NwAbout");
        }

        private void SendMessage(int company_id)
        {
            int mailflag = Convert.ToInt32(NW.MailFlag.管理者_廠商新增成功通知信);
            string subject = "";
            string body = "";

            var data = this._DB.mail_group.Where(m => m.visible && m.group_id == mailflag).FirstOrDefault();
            var data2 = this._DB.sys_admin_data.Where(m => m.company_id == company_id && m.visible).FirstOrDefault();

            string cmail = "";
            var company = this._DB.company_data.Where(m => m.company_id == company_id).FirstOrDefault();
            if (company != null) { cmail = company.mail; }
            bool ss = false;
            if (data != null && !string.IsNullOrEmpty(data2.company_data.mail))
            {
                subject = data.subject;
                body = data.body;
                body = body.Replace("${name}", data2.company_data.name).Replace("${account}", data2.uid).Replace("${password}", data2.pwd);

                ss = NW.sendMail(cmail, subject, body);
            }

            if (ss)
            {
                TempData["jgrowl"] = "信件寄出成功";
            }
            else
            {
                TempData["jgrowl"] = "信件寄出失敗，請確認信箱";
            }

        }

        [HttpPost]
        public ActionResult CompanyListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update sys_admin_data set visible = 1 Where company_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);
                    sql = "Update company_data set visible = 1 Where company_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update sys_admin_data set visible = 0 Where company_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);
                    sql = "Update company_data set visible = 0 Where company_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From sys_admin_data Where company_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);
                    sql = " Delete From company_data Where company_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "廠商首頁"

        public ActionResult CompanyInfo()
        {
            sys_admin_data admin = NW.admin(User.Identity.Name);

            return View(admin);
        }


        #endregion

    }
