        #region "修改密碼"
        
        public ActionResult PwdEdit()
        {
            ViewBag.jgrowl = TempData["jgrowl"];
            return View();
        }

        [HttpPost]
        public ActionResult PwdEditSave(sys_admin_data sys_admin_data, string pwd_c, string pwd_x)
        {
            if (pwd_c == pwd_x)
            {
                int nid = Convert.ToInt32(User.Identity.Name);

                var data = _DB.sys_admin_data.Where(m => m.admin_id.Equals(nid) && m.pwd.Contains(sys_admin_data.pwd)).FirstOrDefault();


                if (data == null)
                {
                    TempData["jgrowl"] = "查無此筆資料";
                }
                else
                {
                    data.pwd =pwd_c;
                    this._DB.SaveChanges();
                }
                TempData["jgrowl"] = "資料更新成功";
            }
            else {
                TempData["jgrowl"] = "查無此筆資料";
            }
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = sys_admin_data.admin_id });
        }

