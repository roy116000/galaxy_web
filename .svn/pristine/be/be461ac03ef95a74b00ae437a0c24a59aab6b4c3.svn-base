        [HttpPost, ValidateInput(false)]
        public ActionResult MailEditSave(mail_group mail_group)
        {
            var data = this._DB.mail_group.Find(mail_group.group_id);
            //var data1 = this._DB.news_group.Where(m => m.zz_id.Equals(news_group.zz_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.group_id = news_group.group_id;
                data.group_id = mail_group.group_id;
                data.name = mail_group.name;
                data.parent_id = mail_group.parent_id;
                data.inx = mail_group.inx;
                data.visible = mail_group.visible;

                data.subject = mail_group.subject;
                data.body = mail_group.body;
                data.cc = mail_group.cc;
                data.sign = mail_group.sign;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news_group.create_user;
                //data.create_datetime = news_group.create_datetime;

                this._DB.SaveChanges();
            }

            //更新
            TempData["jgrowl"] = "資料更新成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = mail_group.group_id });
        }

        public ActionResult MailAdd(int id)
        {
            mail_group data = new mail_group();
            data.inx = 0;
            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult MailAddSave(mail_group mail_group, VmImage imgs)
        {
            //var data = this._DB.news_group.Find(news_group.zz_id);
            //var data1 = this._DB.news_group.Where(m => m.zz_id.Equals(news_group.zz_id)).Select(m => m).SingleOrDefault();
            var data = new mail_group { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.group_id = news_group.group_id;
                data.group_id = mail_group.group_id;
                data.name = mail_group.name;
                data.parent_id = mail_group.parent_id;
                data.inx = mail_group.inx;
                data.visible = mail_group.visible;

                data.subject = mail_group.subject;
                data.body = mail_group.body;
                data.cc = mail_group.cc;
                data.sign = mail_group.sign;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.mail_group.Add(data);
                this._DB.SaveChanges();

                mail_group.group_id = data.group_id;
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = mail_group.group_id });
        }

        [HttpPost]
        public ActionResult MailListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";

            switch (cb_flag)
            {
                case 1: //啟用
                    sql = " Update mail_group Set visible = 1 Where group_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = " Update mail_group Set visible = 0 Where group_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From mail_group Where group_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

