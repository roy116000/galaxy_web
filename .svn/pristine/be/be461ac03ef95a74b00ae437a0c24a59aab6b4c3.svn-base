        public ActionResult CompanyList(string kw)
        {

            int currentPageIndex = 0;

            var Linq = this._DB.company_data.Where(m => m.company_id > 0);

            if (!String.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.name.Contains(kw));
            }

            IPagedList data = Linq.OrderBy(m => m.company_id).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

