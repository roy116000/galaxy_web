        public ActionResult TmpGroupList(string kw)
        {

            int currentPageIndex = 0;
            IPagedList data;
            if (String.IsNullOrEmpty(kw))
            {
                data = this._DB.zz_group.OrderBy(m => m.group_id).ToPagedList(currentPageIndex, ALL_PAGESIZE);
            }
            else
            {
                data = this._DB.zz_group.Where(m => m.title.Contains(kw)).OrderBy(m => m.group_id).ToPagedList(currentPageIndex, ALL_PAGESIZE);
            }
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

