        [HttpPost, ValidateInput(false)]
        public ActionResult CompanyEditSave(company_data company_data, VmImage imgs)
        {
            var data = this._DB.company_data.Find(company_data.company_id);

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                data.name = company_data.name;
                data.boss = company_data.boss;
                data.address = company_data.address;
                data.tel = company_data.tel;
                data.fax = company_data.fax;
                data.contact = company_data.contact;
                data.contact_tel = company_data.contact_tel;
                data.mail = company_data.mail;
                data.bills_flag = company_data.bills_flag;
                data.web = company_data.web;
                data.visible = company_data.visible;

                data.freight = company_data.freight;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;


                this._DB.SaveChanges();


                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new company_image();
                        imgData.company_id = data.company_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.company_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.company_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.company_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.company_id = company_data.company_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion




            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = company_data.company_id });
        }

