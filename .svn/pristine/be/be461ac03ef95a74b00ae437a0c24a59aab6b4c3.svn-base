        #region "網站設定"

        public ActionResult ConfigEdit()
        {
            var data = this._DB.about_data.Find(1);

            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult ConfigEditSave(about_data about_data)
        {
            var data = this._DB.about_data.Find(about_data.config_id);

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {

                //data.config_id = about_data.config_id;
                data.siteName = about_data.siteName;
                data.tel = about_data.tel;
                data.fax = about_data.fax;
                data.mail = about_data.mail;
                data.skype = about_data.skype;
                data.yahoo = about_data.yahoo;
                data.line = about_data.line;
                data.address = about_data.address;
                data.keyword = about_data.keyword;
                data.description = about_data.description;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = zz_data.create_user;
                //data.create_datetime = zz_data.create_datetime;
                this._DB.SaveChanges();
            }

            //更新

            TempData["jgrowl"] = "資料更新成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = about_data.config_id });
        }

