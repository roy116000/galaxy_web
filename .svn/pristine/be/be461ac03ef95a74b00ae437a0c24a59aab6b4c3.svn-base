        #region "信件管理列表"

        public ActionResult MailList(string kw)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.mail_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = 0
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        public ActionResult MailList_ajax(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;
            var tmpData = this._DB.mail_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = 0
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult MailEdit(int id)
        {

            var data = this._DB.mail_group.Find(id);

            ViewBag.jgrowl = TempData["jgrowl"];

