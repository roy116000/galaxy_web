        public ActionResult TmpEdit(int id)
        {

            var data = this._DB.zz_data.Find(id);

            //id = 2;

            if (id != 2)
            {
                //圖片
                var image = _DB.zz_imgs.Where(m => m.zz_id.Equals(id)).FirstOrDefault();
                images_data imgData = new images_data();
                if (image != null)
                {
                    imgData.imgs_id = image.imgs_id;
                    imgData.s_img = image.s_img;
                    imgData.b_img = image.b_img;
                }
                ViewData["UploadImage"] = imgData;
                ViewData["UploadImageX"] = imgData;
            }
            else
            {
                var image = _DB.news_image.Where(m => m.news_id.Equals(id)).ToList();
                List<images_data> imgData = new List<images_data>();
                foreach (var item in image)
                {
                    images_data imgs_data = new images_data();
                    imgs_data.imgs_id = item.imgs_id;
                    imgs_data.s_img = item.s_img;
                    imgs_data.b_img = item.b_img;
                    imgs_data.img_info = item.img_info;
                    imgs_data.img_inx = item.img_inx;
                    imgData.Add(imgs_data);
                }

                ViewData["UploadImage2"] = imgData;
            }

            //單選
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("0", "請選擇", false));
            ListItems.Add(new ListItem("1", "北部地區", false));
            ListItems.Add(new ListItem("2", "中部地區", true));
            ListItems.Add(new ListItem("3", "南部地區", false));
            ListItems.Add(new ListItem("4", "東部地區", false));
            ListItems.Add(new ListItem("5", "離島地區", false));

            ViewData["radio"] = ListItems;
            ViewData["select1"] = ListItems;
            ViewData["select_chosen"] = ListItems;

            //多選
            List<ListItem> ListItems2 = new List<ListItem> { };
            ListItems2.Add(new ListItem("0", "請選擇", false));
            ListItems2.Add(new ListItem("1", "北部地區", false));
            ListItems2.Add(new ListItem("2", "中部地區", true));
            ListItems2.Add(new ListItem("3", "南部地區", false));
            ListItems2.Add(new ListItem("4", "東部地區", true));
            ListItems2.Add(new ListItem("5", "離島地區", false));

            //欄位名稱[id]
            ViewData["checkbox2"] = ListItems2;
            ViewData["select_chosen2"] = ListItems2;

            //兩層
            List<ListItem> ListItems_chained = new List<ListItem> { };
            ListItems_chained.Add(new ListItem("0", "請選擇", false));
            ListItems_chained.Add(new ListItem("1", "北部地區", true));
            ListItems_chained.Add(new ListItem("2", "中部地區", false));
            ListItems_chained.Add(new ListItem("3", "南部地區", false));
            ListItems_chained.Add(new ListItem("4", "東部地區", false));
            ListItems_chained.Add(new ListItem("5", "離島地區", false));

            List<ListItem> ListItems_first = new List<ListItem> { };
            ListItems_first.Add(new ListItem("0", "請選擇", false, "0"));
            ListItems_first.Add(new ListItem("11", "台北市", false, "1"));
            ListItems_first.Add(new ListItem("12", "新北市", true, "1"));
            ListItems_first.Add(new ListItem("23", "台中市", false, "2"));
            ListItems_first.Add(new ListItem("24", "彰化縣", false, "2"));
            ListItems_first.Add(new ListItem("25", "南投市", false, "2"));

            ViewData["select2"] = ListItems_first;
            ViewData["select2_chained"] = ListItems_chained;

            //三層
