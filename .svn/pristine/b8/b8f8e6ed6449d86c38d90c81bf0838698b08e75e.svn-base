@model List<h365_web.Areas.newweb.Controllers.NwReportController.Order_All>
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}


<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width7" />
           @* <col class="width7" />*@
            <col class="width7" />
            <col class="width7" />
            <col class="width7" />
            <col class="width7" />
            <col class="width7" />
            <col class="width7" />
            <col class="width8" />
        </colgroup>
        <thead>
            <tr>
                @*<th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>*@
                <th class="center">月份</th>
               @* <th class="center">完成-金額總計</th>*@
                <th class="center">完成-訂單總計</th>
                <th class="center">完成-毛利總計</th>
                <th class="center">退貨-金額總計</th>
                <th class="center">退貨-訂單總數</th>
                <th class="center">作廢-金額總計</th>
                <th class="center">作廢-訂單總數</th>   
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {               
                <tr class="@NW.echoBool(true, "unread", "visible")">
                    <td class="center">@Html.DisplayFor(modelItem => item.mon)</td>
                  @*  <td class="center">@("$ " + item.finish_total.ToString("N0"))</td>*@
                    <td class="center">@Html.DisplayFor(modelItem => item.finish_num)</td>
                    <td class="center">@("$ " + item.gross_total.ToString("N0"))</td>
                    <td class="center">@("$ " + item.back_total.ToString("N0"))</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.back_num)</td>
                    <td class="center">@("$ " + item.clear_total.ToString("N0"))</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.clear_num)</td>
                    
                    
                    
                    
                    
                    <td class="center">
                        @if (item.clear_num != 0 || item.back_num != 0 || item.finish_num != 0)
                        {
                            if (action.IndexOf("List") != -1)
                            { 
                                @Html.ActionLink("觀看內容", action.Replace("List", "Add"), new { year = item.year, mon = item.mon }, new { @class = "title" })                       
                            }else
                            {
                                 @Html.ActionLink("回上一頁", action.Replace("Add", "List"), new { year = item.year}, new { @class = "title" })                               
                            }
                            
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @*<div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw))
    </div>*@

</div>
