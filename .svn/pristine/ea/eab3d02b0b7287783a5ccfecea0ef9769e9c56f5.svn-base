@model List<h365_web.Models.drugstore_data>
@{
    Layout = null;

}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.datetime.ToString("yyyy/MM/dd") + "店中店監控列表")</title>
    <style>
        body {
            margin: 0px;
            padding: 0px;
        }

            body div {
                margin: 0px;
                font-family: "新細明體";
                font-size: 15px;
            }

        .bgg {
            /*210*297  27.7 */
            width: 50.0cm;
            height: auto;
        }

        .bgg2 {
            /*210*297  27.7 */
            width: 25.0cm;
            height: auto;
        }

        .pixeltable {
            border: 1pt solid #000000;
        }

        .table {
            width: 100%;
            border: 1px solid #000000;
            border-collapse: collapse;
        }

        td, th {
            padding: 5px;
            text-align: left;
        }

        .center {
            text-align: center;
            background-color: #EEEE00;
        }

        .right {
            text-align: right;
        }

        .color {
            color: #0000CC;
        }

        .wrong {
            color: #CC0000;
        }

        .good {
            color: #008800;
        }

        .bold {
            font-weight: bold;
        }

        .h3 {
            line-height: 32px;
        }

        .c1 {
            width: 0.5%;
        }

        .c2 {
            width: 2%;
        }

        .c3 {
            width: 3%;
        }

        .c4 {
            width: 4%;
        }

        .c5 {
            width: 5%;
        }

        .c6 {
            width: 6%;
        }

        .c7 {
            width: 7%;
        }

        .c8 {
            width: 8%;
        }

        .c9 {
            width: 9%;
        }

        .c10 {
            width: 10%;
        }

        .c11 {
            width: 11%;
        }

        .c12 {
            width: 12%;
        }

        .c13 {
            width: 13%;
        }

        .c14 {
            width: 14%;
        }

        .c15 {
            width: 15%;
        }

        .c16 {
            width: 16%;
        }

        .c17 {
            width: 17%;
        }

        .c18 {
            width: 18%;
        }

        .c19 {
            width: 19%;
        }

        .c20 {
            width: 20%;
        }

        .c21 {
            width: 21%;
        }

        .c22 {
            width: 22%;
        }

        .c23 {
            width: 23%;
        }

        .c24 {
            width: 24%;
        }

        .c25 {
            width: 25%;
        }

        .c30 {
            width: 30%;
        }

        .c35 {
            width: 35%;
        }

        .c100 {
            width: 100%;
        }

        .info {
            font: bold 19px/30px 標楷體;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>
    <div class="bgg">
        <div class="h3">◎查詢日期：@(ViewBag.datetime.ToString("yyyy/MM/dd"))</div>
        <div class="h3">◎系統時間－@(DateTime.Now.ToString("HH:mm"))</div>
        <div class="h3">◎目前裝機數量：@(ViewBag.allnum)</div>
        <div class="h3">◎今日上線總數:@Model.Count()</div>

        <table class="table" border="1">
            <colgroup>
                <col class="c2" />
                <col class="c3" />
                <col class="c5" />
                <col class="c2" />
                <col class="c1" />


                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />

                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />

                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />

                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />

                <col class="c1" />
                <col class="c1" />
                <col class="c1" />
                <col class="c1" />


            </colgroup>
            <tr>
                <td class="center"><span class="color">藥局編號</span></td>
                <td class="center"><span class="color">藥局名稱</span></td>
                <td class="center"><span class="color">地址</span></td>
                <td class="center"><span class="color">聯絡人電話</span></td>
                <td class="center"><span class="color">聯絡人</span></td>

                <td class="center"><span class="color">9</span></td>
                <td class="center"><span class="color">10</span></td>
                <td class="center"><span class="color">11</span></td>
                <td class="center"><span class="color">12</span></td>
                <td class="center"><span class="color">13</span></td>
                <td class="center"><span class="color">14</span></td>
                <td class="center"><span class="color">15</span></td>
                <td class="center"><span class="color">16</span></td>
                <td class="center"><span class="color">17</span></td>
                <td class="center"><span class="color">18</span></td>
                <td class="center"><span class="color">19</span></td>
                <td class="center"><span class="color">20</span></td>
                <td class="center"><span class="color">21</span></td>
                <td class="center"><span class="color">22</span></td>
                <td class="center"><span class="color">23</span></td>
                <td class="center"><span class="color">0</span></td>
                <td class="center"><span class="color">1</span></td>
                <td class="center"><span class="color">2</span></td>
                <td class="center"><span class="color">3</span></td>
                <td class="center"><span class="color">4</span></td>
                <td class="center"><span class="color">5</span></td>
                <td class="center"><span class="color">6</span></td>
                <td class="center"><span class="color">7</span></td>
                <td class="center"><span class="color">8</span></td>

            </tr>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@(item.drugstore_id)&nbsp</td>
                    <td>@(item.name)&nbsp</td>
                    <td>@(item.address)&nbsp</td>
                    <td>@(item.contact_name)&nbsp</td>
                    <td>@(item.contact_phone)&nbsp</td>

                    <td><span @(item.j == "X" ? "class=wrong " : "class=good")>@(item.j)</span></td>
                    <td><span @(item.k == "X" ? "class=wrong " : "class=good")>@(item.k)</span></td>
                    <td><span @(item.l == "X" ? "class=wrong " : "class=good")>@(item.l)</span></td>
                    <td><span @(item.m == "X" ? "class=wrong " : "class=good")>@(item.m)</span></td>

                    <td><span @(item.n == "X" ? "class=wrong " : "class=good")>@(item.n)</span></td>
                    <td><span @(item.o == "X" ? "class=wrong " : "class=good")>@(item.o)</span></td>
                    <td><span @(item.p == "X" ? "class=wrong " : "class=good")>@(item.p)</span></td>
                    <td><span @(item.q == "X" ? "class=wrong " : "class=good")>@(item.q)</span></td>

                    <td><span @(item.r == "X" ? "class=wrong " : "class=good")>@(item.r)</span></td>
                    <td><span @(item.s == "X" ? "class=wrong " : "class=good")>@(item.s)</span></td>
                    <td><span @(item.t == "X" ? "class=wrong " : "class=good")>@(item.t)</span></td>
                    <td><span @(item.u == "X" ? "class=wrong " : "class=good")>@(item.u)</span></td>

                    <td><span @(item.v == "X" ? "class=wrong " : "class=good")>@(item.v)</span></td>
                    <td><span @(item.w == "X" ? "class=wrong " : "class=good")>@(item.w)</span></td>
                    <td><span @(item.x == "X" ? "class=wrong " : "class=good")>@(item.x)</span></td>
                    <td><span @(item.a == "X" ? "class=wrong " : "class=good")>@(item.a)</span></td>

                    <td><span @(item.b == "X" ? "class=wrong " : "class=good")>@(item.b)</span></td>
                    <td><span @(item.c == "X" ? "class=wrong " : "class=good")>@(item.c)</span></td>
                    <td><span @(item.d == "X" ? "class=wrong " : "class=good")>@(item.d)</span></td>
                    <td><span @(item.e == "X" ? "class=wrong " : "class=good")>@(item.e)</span></td>

                    <td><span @(item.f == "X" ? "class=wrong " : "class=good")>@(item.f)</span></td>
                    <td><span @(item.g== "X" ? "class=wrong " : "class=good")>@(item.g)</span></td>
                    <td><span @(item.h == "X" ? "class=wrong " : "class=good")>@(item.h)</span></td>
                    <td><span @(item.i == "X" ? "class=wrong " : "class=good")>@(item.i)</span></td>



                </tr>
        
            }
        </table>
        <br>

        <br>
    </div>

    <div class="bgg2">
        <div class="h3">◎@(ViewBag.datetime.ToString("yyyy/MM/dd"))未上線藥局
            <br>
            ◎今日未上線總數:@(ViewBag.offlineddatanum)</div>
        <table class="table" border="1">
            <colgroup>
                <col class="c1" />
                <col class="c3" />
                <col class="c5" />
                <col class="c2" />
                <col class="c1" />

            </colgroup>
            <tr>
                <td class="center"><span class="color">藥局編號</span></td>
                <td class="center"><span class="color">藥局名稱</span></td>
                <td class="center"><span class="color">地址</span></td>
                <td class="center"><span class="color">聯絡人電話</span></td>
                <td class="center"><span class="color">聯絡人</span></td>
            </tr>
            @foreach (var item in ViewBag.offlineddata)
            {
                <tr>

                    <td>@(item.drugstore_id)&nbsp</td>
                    <td>@(item.name)&nbsp</td>
                    <td>@(item.address)&nbsp</td>
                    <td>@(item.contact_name)&nbsp</td>
                    <td>@(item.contact_phone)&nbsp</td>


                </tr>
        
            }
        </table>

    </div>

</body>
</html>

