




<div id="order_detail" class="modal fade" aria-labelledby="myLargeModalLabel" >
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 id="order_title" class="modal-title">Modal title</h4>
      </div>
      <div class="modal-body">

        <div class="row-fluid">
                    <div class="span12 editprofileform">                        
                        <div class="">
                            <div id="List_ajax">
                                <table class="table table-striped">
                                    <colgroup>
                                        <col class="width12" />
                                        <col />
                                        <col class="width12" />
                                        <col class="width15" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>貨號</th>
                                            <th>商品</th>
                                          @*  <th>規格</th>*@
                                            <th>數量</th>                                            
                                        </tr>
                                    </thead>
                                    <tbody id="order_body">                                      
                                  
                                            <tr>
                                                <td>&nbsp;</td>
                                                <td>&nbsp;</td>
                                                <td>&nbsp;</td>
                                                <td>&nbsp;</td>
                                                
                                            </tr>                                        

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>


      </div>
      
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div>


<script>
    function getDetail(o) {
        
        $.post('@(Url.Action("getDetail","NwDrugBills"))', { oid: o }, function (data) {
           
            $('#order_title').html(data.title);
            $('#order_body').html(data.s);

            $('#order_detail').modal();

        }, 'json')
    }

</script>

