@model h365_web.Models.sys_admin_data
@{
    //string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
    h365_web.Models.drugstore_data data2 = (h365_web.Models.drugstore_data)ViewData["data2"];
    //h365_web.Models.sys_admin_data gData3 = (h365_web.Models.sys_admin_data)ViewData["gData3"];
}
<div class="maincontent">
    <div class="contentinner">

        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            <div class="widgetcontent">
                <h4 class="widgettitle">基本資料</h4>

                @*ID*@
                <div style="display:none" class="control-group">
                    @Html.LabelFor(model => model.admin_id, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @Model.admin_id
                    </div>
                </div>

                @*藥局*@
                <div class="control-group">
                    @Html.LabelFor(model => model.drugstore_id, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @data2.name
                    </div>
                </div>

                @*帳號*@
                <div class="control-group">
                    @Html.LabelFor(model => model.uid, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @Model.uid
                    </div>
                </div>



                @*@Html.EditorFor(model => model.pwd)*@


                @Html.EditorFor(model => model.name)

                @Html.EditorFor(model => model.pharmacist_sn)

                @Html.EditorFor(model => model.phone)

                @Html.EditorFor(model => model.mail)

                @Html.EditorFor(model => model.address)

                @Html.EditorFor(model => model.info)

                @Html.EditorFor(model => model.msg_visible)

                @Html.EditorFor(model => model.uploadimage)

                <div class="control-group">
                    <div class="stdformbutton">
                        <button class="btn btn-primary">儲存</button>
                        <button type="reset" class="btn">取消</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            rules: {
                pwd: "required",
                pwd_c: { equalTo: "#pwd_x", required: true }
            },
            messages: {
                pwd: "登入密碼，必需填寫",
                pwd_c: "新密碼與確認新密碼，必需相同"
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').addClass('error');
            }
        });

    })
</script>
