using h365_web.Models;
using MvcPaging;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Mvc;

namespace h365_web.Areas.newweb.Controllers
{
    public class NwMediaController : _BaseController
    {
        //
        // GET: /newweb/NwNews/

        #region "媒體發表列表"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.news2_data
                           join m2 in _DB.news2_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.news_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });


            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;


            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);



            var data2 = this._DB.news2_group.OrderBy(m => m.inx).Select(m => new data_group()
            {
                group_id = m.group_id,
                name = m.name,
                counts = m.news2_data.Count()
            });



            ViewData["news2_group"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];



            




            return View(data);



        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.news2_data
                           join m2 in _DB.news2_group on m.group_id equals m2.group_id into mm
                           //join m2 in _DB2.news2_data on m.news2_id equals m2.news2_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.news_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult Edit(int id)
        {

            var data = this._DB.news2_data.Find(id);

            //圖片
            var image = _DB.news2_image.Where(m => m.news_id.Equals(id)).FirstOrDefault();
            images_data imgData = new images_data();
            if (image != null)
            {
                imgData.imgs_id = image.imgs_id;
                imgData.s_img = image.s_img;
                imgData.b_img = image.b_img;
            }
            ViewData["uploadimage"] = imgData;

            //var image = _DB.news2_image.Where(m => m.news2_id.Equals(id)).ToList();
            //List<images_data> imgData = new List<images_data>();
            //foreach (var item in image)
            //{
            //    images_data imgs_data = new images_data();
            //    imgs_data.imgs_id = item.imgs_id;
            //    imgs_data.s_img = item.s_img;
            //    imgs_data.b_img = item.b_img;
            //    imgs_data.img_info = item.img_info;
            //    imgs_data.img_inx = item.img_inx;
            //    imgData.Add(imgs_data);
            //}
            //ViewData["uploadimage2"] = imgData;

            //下拉選單
            var gData = (from m in _DB.news2_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(news2_data news2_data, VmImage imgs)
        {
            var data = this._DB.news2_data.Find(news2_data.news_id);
            //var data1 = this._DB.news2_data.Where(m => m.news2_id.Equals(news2_data.news2_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.news2_id = news2_data.news2_id;
                data.group_id = news2_data.group_id;
                data.title = news2_data.title;
                data.cont = news2_data.cont;
                data.inx = news2_data.inx;
                data.hits = news2_data.hits;
                data.start_date = news2_data.start_date;
                data.end_date = news2_data.end_date;
                data.visible = news2_data.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news2_data.create_user;
                //data.create_datetime = news2_data.create_datetime;

                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new news2_image();
                        imgData.news_id = data.news_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.news2_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.news2_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.news2_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.news_id = news2_data.news_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = news2_data.news_id });
        }

        public ActionResult Add(int id)
        {
            news2_data data = new news2_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);

            //圖片
            ViewData["UploadImage"] = new images_data();
            //ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.news2_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;
            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(news2_data news2_data, VmImage imgs)
        {
            //var data = this._DB.news2_data.Find(news2_data.news2_id);
            //var data1 = this._DB.news2_data.Where(m => m.news2_id.Equals(news2_data.news2_id)).Select(m => m).SingleOrDefault();
            var data = new news2_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.news2_id = news2_data.news2_id;
                data.group_id = news2_data.group_id;
                data.title = news2_data.title;
                data.cont = news2_data.cont;
                data.inx = news2_data.inx;
                data.hits = news2_data.hits;
                data.start_date = news2_data.start_date;
                data.end_date = news2_data.end_date;
                data.visible = news2_data.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.news2_data.Add(data);
                this._DB.SaveChanges();

                news2_data.news_id = data.news_id;

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new news2_image();
                        imgData.news_id = data.news_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.news2_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.news2_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.news2_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.news_id = news2_data.news_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = news2_data.news_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update news2_data set visible = 1 Where news_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update news2_data set visible = 0 Where news_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From news2_image Where news_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From news2_data Where news_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "分類列表"

        public ActionResult GroupList(string kw)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.news2_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.news2_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

