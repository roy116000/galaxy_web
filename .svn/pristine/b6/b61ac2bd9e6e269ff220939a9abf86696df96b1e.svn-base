        [HttpPost, ValidateInput(false)]
        public ActionResult GroupAddSave(news2_group news2_group, VmImage imgs)
        {
            //var data = this._DB.news2_group.Find(news2_group.zz_id);
            //var data1 = this._DB.news2_group.Where(m => m.zz_id.Equals(news2_group.zz_id)).Select(m => m).SingleOrDefault();
