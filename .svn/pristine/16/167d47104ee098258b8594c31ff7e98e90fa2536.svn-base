        #region "商品關聯"

        public ActionResult TagList(int? gid, string kw, int? order_style)
        {
            int currentPageIndex = 0;

            int flag = 3;

            sys_admin_data admin = NW.admin(User.Identity.Name);

            var tmpData = (from m in _DB.product_data
                           join m2 in _DB.product_group on m.group_id equals m2.group_id into mm
                           where m.status_flag == flag && m.visible == true
                           orderby m.create_datetime
                           select new data_list()
                           {
                               data_id = m.product_id,
                               group_id = m.group_id,
                               title = m.item_name,
                               cont = m.item_no,
                               info = m.web_name,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               visible_index = m.visible_index,
                               item_no = m.item_no,
                               sprice = m.sprice,
                               cost = m.cost,
                               gross = Math.Round((((double)m.sprice - m.cost) / m.sprice) * 100, 2).ToString(),
                               company_id = m.company_id.ToString(),
                               g_name = mm.FirstOrDefault().name,
                               post_datetime = m.post_datetime,
                               status_flag = m.status_flag,
                               company = m.company_data.name,
                               order_style = m.order_style
                           });

            //大權限
            if (admin.power_id <= 2)
            {
                tmpData = (from m in _DB.product_data
                           join m2 in _DB.product_group on m.group_id equals m2.group_id into mm
                           where m.status_flag == flag && m.visible == true
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.product_id,
                               group_id = m.group_id,
                               title = m.item_name,
                               cont = m.item_no,
                               info = m.web_name,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               visible_index = m.visible_index,
                               item_no = m.item_no,
                               sprice = m.sprice,
                               cost = m.cost,
                               gross = Math.Round((((double)m.sprice - m.cost) / m.sprice) * 100, 2).ToString(),
                               g_name = mm.FirstOrDefault().name,
                               company_id = m.company_id.ToString(),
                               post_datetime = m.post_datetime,
                               status_flag = m.status_flag,
                               company = m.company_data.name,
                               order_style = m.order_style
                           });
            }

            if (!String.IsNullOrEmpty(kw))
            {
                var data3 = this._DB.company_data.Where(m => m.visible && m.name.Contains(kw)).ToList();
                string cid = "";
                foreach (var item in data3)
                {
                    cid += item.company_id.ToString() + ",";
                }

                string[] _cid = { };
                if (!string.IsNullOrEmpty(cid))
                {
                    cid = cid.TrimEnd(',');
                    _cid = cid.Split(',');
                }

                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw) || m.info.Contains(kw) || _cid.Contains(m.company_id));
            }



            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            if (order_style.HasValue)
            {
                if (order_style != 2)
                {
                    tmpData = tmpData.Where(m => m.order_style == order_style);
                }
            }
            ViewBag.order_style = order_style;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            List<data_group2> data2 = (from m in this._DB.product_group
                                       where m.parent_id.Equals(0)
                                       orderby m.inx, m.create_datetime descending
                                       select new data_group2()
                                       {
                                           group_id = m.group_id,
                                           name = m.name
                                       }).ToList();

            foreach (var rs in data2)
            {
                List<data_group> data22 = (from m in this._DB.product_group
                                           where m.parent_id.Equals(rs.group_id)
                                           orderby m.inx, m.create_datetime descending
                                           select new data_group()
                                           {
                                               group_id = m.group_id,
                                               name = m.name,
                                               counts = 0
                                           }).ToList();
                //大權限
                if (admin.power_id <= 2)
                {
                    data22 = (from m in this._DB.product_group
                              where m.parent_id.Equals(rs.group_id)
                              orderby m.inx, m.create_datetime descending
                              select new data_group()
                              {
                                  group_id = m.group_id,
                                  name = m.name,
                                  counts = 0
                              }).ToList();
                }
                if (data22.Count > 0)
                {
                    rs.data_group = data22;
                }
            }

            var ppdata = this._DB.product_price.Where(m => m.product_id == 0 && m.start_date <= DateTime.Now && m.end_date >= DateTime.Now).OrderByDescending(m => m.start_date).ToList();
            ViewData["product_price"] = ppdata;

            ViewData["product_group2"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

