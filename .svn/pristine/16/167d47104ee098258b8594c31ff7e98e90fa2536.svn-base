        #region"促銷專區"

        #region"新增修改"

        public ActionResult SalesAoE(int sid, int pid)
        {
            var data = this._DB.product_sales.Where(m => m.sales_id == sid && m.product_id == m.product_id).FirstOrDefault();
            if (sid != 0 && data == null) { TempData["jgrowl"] = "查無此筆紀錄"; return RedirectToAction("PEdit", new { id = pid }); }

            data = data != null ? data : new product_sales() { };
            if (data.sales_id == 0)
            {
                data.product_id = pid;
                data.price = 1;
                data.cost = 1;
                data.start_datetime = DateTime.Now.AddDays(1);
                data.end_datetime = data.start_datetime.Value.AddDays(1);
            }

            return View(data);
        }

        public ActionResult SalesAdd(int sid, int pid)
        {
            return SalesAoE(sid, pid);
        }

        public ActionResult SalesEdit(int sid, int pid)
        {
            return SalesAoE(sid, pid);
        }

