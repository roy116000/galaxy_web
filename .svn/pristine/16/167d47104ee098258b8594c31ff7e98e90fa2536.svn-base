                var ListItems = new List<ListItem> { };

                var Parent = this._DB.product_group.Where(m => m.parent_id == 0).OrderBy(m => m.inx).Select(m => m.group_id + "," + m.name).ToArray();
                ListItems.AddRange(NW.sList(Parent, data.parent_id.ToString()));
