using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using System.Data.Linq;

using h365_web.Models;
using MvcPaging;

using NPOI.SS.UserModel;

//using System.IO;
using ClosedXML.Excel;

using System.IO;

namespace h365_web.Areas.newweb.Controllers
{
    public class NwProductController : _BaseController
    {

        //public  static string[] Flag = { "0,草搞區", "1,審核中", "2,審核完成", "3,上架", "4,下架", "作廢", "申請退回" };
        public static string[] Flag = { "草搞區", "審核中", "審核完成", "上架", "下架" };

        #region"商品專區"

        public ActionResult PList(int? page, int? flag, int? gid, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;
            //flag = flag.HasValue ? flag : 3; //預設上架區

            var aData = NW.admin(User.Identity.Name); //登入資料
            ViewData["aData"] = aData;

            var linq = this._DB.product_data.Where(m => m.product_id > 0);
            if (flag.HasValue)
            {
                if (flag == 99)
                {
                    linq = linq.Where(m => m.visible == false);
                }
                else
                {
                    linq = linq.Where(m => m.status_flag == flag);
                }

            }


            #region"篩選條件"

            if (aData.power_id > 2) //權限
            {
                //Flag = new string[] { "0,草搞區", "1,審核中", "2,審核完成", "3,上架", "4,下架" };
                //Flag = new string[] { "草稿區", "送審" };
                linq = linq.Where(m => m.company_id == aData.company_id);
            }
            else
            {
                // Flag = new string[] { "草搞區", "審核中", "審核完成", "上架", "下架" };
            }

            Flag = new string[] { "草搞區", "審核中", "審核完成", "上架", "下架" };

            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                kw = kw.ToLower();

                //廠商
                var C = this._DB.company_data.Where(m => m.name.ToLower().Contains(kw) || m.inv_sn == kw).Select(m => m.company_id).ToArray();

                linq = linq.Where(m => m.item_name.Contains(kw) || m.web_name.Contains(kw) || m.item_no.Contains(kw) || m.product_id.ToString() == kw || C.Contains(m.company_id));

            }

            if (gid.HasValue)
            {
                ViewBag.gid = gid;
                linq = linq.Where(m => ("," + m.group_id + ",").Contains("," + gid + ","));
            }

            #endregion

            IPagedList data = linq.OrderByDescending(m => m.create_datetime).ThenByDescending(m => m.change_datetime).ToPagedList(currentPageIndex, 50);

            ViewData["gD"] = this._DB.product_group.Where(m => m.parent_id != 0).ToList();
            ViewData["cData"] = this._DB.company_data.Where(m => m.visible).ToList();

            #region"選單"

            #region"狀態"

            int num = 0;
            var af = (from a in Flag.Select(m => m)
                      select new data_group
                      {
                          name = a,
                      }).ToList()
                      .Select(m => new data_group()
                      {
                          counts = this._DB.product_data.Where(x => x.status_flag == num && (aData.power_id > 2 ? x.company_id == aData.company_id : true)).Count(),
                          group_id = num++,
                          name = m.name
                      }).ToList();


            var fal = new data_group() { group_id = 99, name = "作廢", counts = this._DB.product_data.Where(m => m.visible == false && (aData.power_id > 2 ? m.company_id == aData.company_id : true)).Count() };
            af.Add(fal);

            ViewData["F"] = af;
            ViewBag.flag = flag;

            //var ListItems = new List<ListItem> { };
            //ListItems.AddRange(NW.sList(Flag, flag.ToString()));
            //ViewData["fData"] = ListItems;

            #endregion

            #endregion

            ViewBag.jgrowl = TempData["jgrowl"];
            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

        #region"新增修改區"

        public ActionResult PAdd(int id)
        {
            var data = this._DB.product_data.Where(m => m.product_id == id).FirstOrDefault();
            if (data == null && id != 0) { return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "List").Replace("Edit", "List")); }
            else
            {
                #region"登入者"

                var aData = NW.admin(User.Identity.Name);
                ViewData["aData"] = aData;

                #endregion

                data = data != null ? data : new product_data();
                if (data.product_id == 0)
                {
                    data.visible = true;
                    data.visible_index = false;
                    data.price = 1; //建議售價
                    data.sprice = 1; //售價
                    data.inx = 0;
                    data.sales_eD = DateTime.Now;
                    data.sales_sD = data.sales_eD;
                    data.company_id = aData.company_id;
                    data.order_style = 1;
                    data.inventory_num = 999;
                    data.inx = 999;
                    data.once_num = 10;
                    data.sms_visible = true; //是否簡訊寄送
                }
                else
                {
                    data.img = NW.Path_Img(data.img, "product");
                }

                #region"廠商"

                var Company = this._DB.company_data.Where(m => m.company_id == data.company_id).FirstOrDefault();
                ViewBag.company_name = Company != null ? Company.name : "查無廠商";
                if (Company == null) { TempData["jgrowl"] = "查無廠商，無法建檔"; return RedirectToAction("PList"); };

                #endregion

                #region"下拉選單"

                List<ListItem> ListItems = new List<ListItem> { };

                #region"分類"

                string[] data_group = data.group_ids != null ? data.group_ids.Split(',') : new string[] { };
                var Group = this._DB.product_group.Where(m => m.visible && m.parent_id != 0).Select(m => new { m.group_id, m.name, m.parent_id }).OrderBy(m => m.group_id).ToLookup(m => (data_group).Contains(m.group_id.ToString()));
                var Y = Group[true].ToDictionary(m => m.group_id, m => m.name); //目前已有
                var N = Group[false].Select(m => m.group_id + "," + m.name + "," + m.parent_id).ToArray(); //選單列表
                ViewData["group_ids_s"] = Y;

                ListItems.Add(new ListItem("", "請選擇", false));
                ListItems.AddRange(NW.sList_chained2(N));
                ViewData["group_ids"] = ListItems;


                var group = this._DB.product_group.Where(m => m.parent_id == 0).OrderBy(m => m.inx).Select(m => m.group_id + "," + m.name).ToArray();
                ListItems = new List<ListItem> { };
                ListItems.Add(new ListItem("", "請選擇", false));
                ListItems.AddRange(NW.sList_chained1(group));
                ViewData["group_ids_chained"] = ListItems;

                #endregion

                #region"稅別"

                ListItems = new List<ListItem> { };
                ListItems.AddRange(NW.sList(NW.Flag_Tax, data.tax_flag.ToString()));
                ViewData["tax_flag"] = ListItems;

                #endregion

                #region"購物狀況"

                ListItems = new List<ListItem> { };
                ListItems.AddRange(NW.sList(NW.Flag_Order_Stype, data.order_style.ToString()));
                ViewData["order_style"] = ListItems;

                #endregion

                #region"症狀關聯"

                string[] data_tag = data.tag != null ? data.tag.Split(',') : new string[] { };
                var Tags = this._DB.tag_data.Where(m => m.visible).ToLookup(m => data_tag.Contains(m.tag_id.ToString()));
                var Tags_Y = Tags[true].ToDictionary(m => m.tag_id, m => m.tag_name);

                var Tags_N = Tags[false].Select(m => m.tag_id + "," + m.tag_name).ToArray();

                ListItems = new List<ListItem> { };
                ListItems.Add(new ListItem("", "請選擇", false));
                ListItems.AddRange(NW.sList(Tags_N));

                ViewData["tag_s"] = Tags_Y;
                ViewData["tag"] = ListItems;

                #endregion

                #region"產品狀態"

                ListItems = new List<ListItem> { };

                if (aData.power_id > 2)
                {
                    Flag = new string[] { "草稿區", "送審" };
                    //ListItems.AddRange(NW.sList(Flag, data.status_flag.ToString()));
                }
                else
                {
                    Flag = new string[] { "草搞區", "審核中", "審核完成", "上架", "下架" };
                }
                //else 
                //{
                //    ListItems.AddRange(NW.sList(Flag, data.status_flag.ToString()));
                //}

                ListItems.AddRange(NW.sList(Flag, data.status_flag.ToString()));

                ViewData["status_flag"] = ListItems;

                #endregion

                #endregion

                #region"成分"

                var ingredient = this._DB.product_ingredient.Where(m => m.product_id == data.product_id).FirstOrDefault();
                ingredient = ingredient != null ? ingredient : new product_ingredient();
                ViewData["ingredient"] = ingredient;

                #endregion

                #region"規格"

                var specification = this._DB.product_specification.Where(m => m.product_id == data.product_id).FirstOrDefault();
                specification = specification != null ? specification : new product_specification();
                ViewData["specification"] = specification;

                //配送
                ListItems = NW.sList(NW.Flag_Send, specification.send_flag.ToString());
                ViewData["send_flag"] = ListItems;

                //服用說明
                ListItems = NW.sList(NW.Taking, specification.taking);
                ViewData["taking_x"] = ListItems;

                //保存方式
                ListItems = NW.sList(NW.Preservation, specification.preservation);
                ViewData["preservation_x"] = ListItems;

                //素食
                ListItems = NW.sList(NW.Vegetarian, specification.vegetarian);
                ViewData["vegetarian_x"] = ListItems;

                //劑型
                ListItems = NW.sList(NW.Dosage_Form, specification.dosage_form);
                ViewData["dosage_form_x"] = ListItems;

                #endregion

                #region"促銷活動"

                var sData = this._DB.product_sales.Where(m => m.product_id == id).OrderByDescending(m => m.create_datetime).ToList();
                ViewData["sData"] = sData;

                #endregion

                #region"分潤機制"

                var Maori = this._DB.partner_maori.Where(m => m.product_id == data.product_id).FirstOrDefault();
                Maori = Maori != null ? Maori : new partner_maori() { };
                ViewData["Maori"] = Maori;

                #endregion

                if (data.status_flag > 1 && aData.power_id > 2)
                {
                    return View("_product_data", data);
                }
                else
                {

                    ViewBag.jgrowl = TempData["jgrowl"];
                    return View(data);

                }

            }

        }

        public ActionResult PEdit(int id)
        {
            return PAdd(id);
        }

        #endregion

        #region"儲存"

        [HttpPost, ValidateInput(false)]
        public ActionResult PEditSave(product_data product_data, product_ingredient product_ingredient, product_specification product_specification, HttpPostedFileBase img, partner_maori partner_maori, bool Maori_visible = true)
        {
            var data = this._DB.product_data.Where(m => m.product_id == product_data.product_id).FirstOrDefault();
            data = data != null ? data : new product_data();
            if (data.product_id == 0 && product_data.product_id != 0) { RedirectToAction(RouteData.Values["action"].ToString().Replace("Edit", "List").Replace("Save", "")); }
            else
            {

                data.visible = product_data.visible;
                data.group_ids = product_data.group_ids_s != null ? product_data.group_ids_s.Trim(',') : null; //分類
                data.web_name = product_data.web_name; //品牌
                data.item_name = product_data.item_name; //品名
                data.order_style = product_data.order_style; //購物狀況
                data.tax_flag = product_data.tax_flag; //稅別
                data.status_flag = product_data.status_flag; //狀態
                data.inventory_num = product_data.inventory_num; //庫存量
                data.inx = product_data.inx; //排序
                data.once_num = product_data.once_num; //單次購買數量
                data.sms_visible = product_data.sms_visible; //簡訊寄送

                #region"產品價格"


                data.price = product_data.price; //建議售價
                data.sprice = product_data.sprice; //售價
                data.cost = product_data.cost; //成本
                data.back_bonus = product_data.back_bonus; //紅利回饋


                data.sales_sD = product_data.sales_sD; //促銷起始
                data.sales_eD = product_data.sales_eD; //促銷結束
                data.sales_money = product_data.sales_money; //促銷價格
                data.sales_cost = product_data.sales_cost; //促銷成本

                #endregion

                #region"產品資訊"

                data.sold = product_data.sold; //販售數量
                data.info = product_data.info; //產品簡介
                data.introduce = product_data.introduce; //產品內容
                data.tag = product_data.tag != null ? product_data.tag.Trim(',') : null; //相關資訊

                #endregion

                #region"產品圖檔"

                if (img != null && img.ContentLength > 0 && NW.getFileType(img, 1)) //有無上傳
                {

                    string tmpPath = Server.MapPath("~/Content/images/product"); //存放路徑
                    if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); } //建資料夾

                    //string water = NW.getImgWater();
                    //string strFileName = water + "1" + Path.GetExtension(img.FileName);  //新的檔案名稱
                    //string strFilePath = tmpPath + "/" + img.FileName; //存放檔案路徑
                    //string strFilePath2 = tmpPath + "/" + strFileName; //存放檔案路徑
                    //img.SaveAs(strFilePath); //檔案存放在Server
                    //data.img = Images.Helps.ImageHelper.Rebmp(strFileName, strFilePath, strFilePath2, 500, 500); 

                    data.img = Images.Helps.ImageHelper.Rebmp(img, tmpPath, 500, 500);

                    //var Drug_Img = this._DB.pharmacist_data.Where(m => m.pharmacist_id == data.product_id).FirstOrDefault();
                    //if (Drug_Img != null)
                    //{
                    //    Drug_Img.b_img = Images.Helps.ImageHelper.Rebmp(strFileName, strFilePath, strFilePath2, 500, 500);  //取得group的寬/高

                    //}


                }

                #endregion

                #region"產品週期"

                data.Cycle_Visible = product_data.Cycle_Visible; //週期啟用
                data.Unit = product_data.Unit; //產品單位
                data.ProductTotle = product_data.ProductTotle; //產品總量
                data.Product_day = product_data.Product_day; //產品消耗
                data.Product_once = product_data.Product_once; //產品消耗次數
                data.Cycle_Totle = (data.ProductTotle != 0 && data.Product_day != 0 && data.Product_once != 0) ? data.ProductTotle / (data.Product_day * data.Product_once) : 0;

                #endregion

                #region"分潤"

                var Maori = this._DB.partner_maori.Where(m => m.product_id == data.product_id).FirstOrDefault();
                Maori = Maori != null ? Maori : new partner_maori() { };
                Maori.product_id = data.product_id;
                Maori.visible = Maori_visible;
                //Maori.netsourcer_num = partner_maori.netsourcer_num;
                Maori.drugstore_num = partner_maori.drugstore_num;
                Maori.salesman_num = partner_maori.salesman_num;
                Maori.partner_member_num = partner_maori.partner_member_num;
                Maori.partner_sales_num = partner_maori.partner_sales_num;

                if (Maori.maori_id == 0)
                {
                    Maori.create_user = User.Identity.Name;
                    Maori.create_datetime = DateTime.Now;

                    this._DB.partner_maori.Add(Maori);
                    this._DB.SaveChanges();
                }
                else
                {
                    Maori.change_user = User.Identity.Name;
                    Maori.change_datetime = DateTime.Now;

                    this._DB.SaveChanges();
                }




                #endregion


                if (data.product_id == 0)
                {

                    data.visible = true;
                    data.status_flag = 0; //進草搞區
                    data.item_no = product_data.item_no != null ? product_data.item_no : "NW" + data.company_id + DateTime.Now.ToString("MMddHHmmss"); //貨號
                    data.product_id = product_data.product_id;
                    data.create_user = User.Identity.Name;
                    data.create_datetime = DateTime.Now;
                    data.company_id = product_data.company_id; //廠商編號

                    this._DB.product_data.Add(data);

                    TempData["jgrowl"] = "資料新增成功";
                }
                else
                {
                    if (!data.post_datetime.HasValue && data.status_flag == 1)
                    {
                        data.post_user = User.Identity.Name;
                        data.post_datetime = DateTime.Now;
                    }

                    data.change_user = User.Identity.Name;
                    data.change_datetime = DateTime.Now;

                    TempData["jgrowl"] = "資料更新成功";
                }

                this._DB.SaveChanges();

                #region"產品成分"

                var ingredient = this._DB.product_ingredient.Where(m => m.product_id == data.product_id).FirstOrDefault();
                ingredient = ingredient != null ? ingredient : new product_ingredient();
                ingredient.ingredient_visible = product_ingredient.ingredient_visible; //成分啟用
                ingredient.summary_table = product_ingredient.summary_table; //成分表

                if (ingredient.ingredient_id == 0)
                {
                    ingredient.product_id = data.product_id; //產品編號

                    ingredient.create_user = User.Identity.Name;
                    ingredient.create_datetime = DateTime.Now;
                    this._DB.product_ingredient.Add(ingredient);
                }
                else
                {
                    ingredient.change_user = User.Identity.Name;
                    ingredient.change_datetime = DateTime.Now;
                }

                this._DB.SaveChanges();

                #endregion

                #region"產品規格"

                var specification = this._DB.product_specification.Where(m => m.product_id == data.product_id).FirstOrDefault();
                specification = specification != null ? specification : new product_specification();

                specification.specification_visible = product_specification.specification_visible; //啟用
                specification.send_flag = product_specification.send_flag; //寄送方式
                specification.taking = product_specification.taking_x != null ? string.Join(",", product_specification.taking_x) : null; //服用說明
                specification.preservation = product_specification.preservation_x != null ? string.Join(",", product_specification.preservation_x) : null; //保存方式
                specification.vegetarian = product_specification.vegetarian_x != null ? string.Join(",", product_specification.vegetarian_x) : null; //素食
                specification.dosage_form = product_specification.dosage_form_x != null ? string.Join(",", product_specification.dosage_form_x) : null; //劑型

                specification.piece = product_specification.piece; //產品單位
                specification.place_origin = product_specification.place_origin; //產地
                specification.barcode = product_specification.barcode; //國際條碼

                specification.pcontent = product_specification.pcontent; //產品規格
                specification.deadline = product_specification.deadline; //保存期限
                specification.company_name = product_specification.company_name; //廠商名稱
                specification.tel = product_specification.tel; //廠商電話
                specification.address = product_specification.address; //廠商地址
                specification.insurance_famous = product_specification.insurance_famous; //投保
                specification.log_famous = product_specification.log_famous; //食品
                specification.ingredients = product_specification.ingredients; //成分標示
                specification.precautions = product_specification.precautions; //注意事項


                if (specification.specification_id == 0)
                {
                    specification.product_id = data.product_id; //產品編號

                    specification.create_user = User.Identity.Name;
                    specification.create_datetime = DateTime.Now;
                    this._DB.product_specification.Add(specification);
                }
                else
                {
                    specification.change_user = User.Identity.Name;
                    specification.change_datetime = DateTime.Now;
                }

                this._DB.SaveChanges();

                #endregion

            }

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "Edit").Replace("Save", ""), new { id = data.product_id });
        }

        #endregion

        [HttpPost]
        public ActionResult PListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "作廢", "首頁顯示", "首頁停用", "送審" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update product_data set visible = 1 Where product_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update product_data set visible = 0 Where product_id in (" + cb_id + ")";
                    break;
                case 3: //首頁啟用
                    sql = "Update product_data set visible_index = 1 Where product_id in (" + cb_id + ")";
                    break;
                case 4: //首頁停用
                    sql = "Update product_data set visible_index = 0 Where product_id in (" + cb_id + ")";
                    break;
                case 5: //送審
                    sql = "Update product_data set status_flag = 1 , post_user = '" + User.Identity.Name + "' , post_datetime = cast('" + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "' as datetime ) Where product_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From product_image Where product_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From product_data Where product_id in (" + cb_id + ")";
                    break;

                #region""

                default:
                    cb_flag -= 999;
                    product_price product_price = this._DB.product_price.Find(cb_flag);
                    if (product_price != null)
                    {
                        foreach (string s in cb_id.Split(','))
                        {
                            int product_id = Convert.ToInt32(s);
                            product_data pdata = this._DB.product_data.Find(product_id);
                            product_price ppdata = this._DB.product_price.Where(m => m.product_id == product_id && m.group_name == product_price.group_name).FirstOrDefault();
                            if (pdata != null && ppdata == null)
                            {
                                double cal = pdata.sprice * product_price.price / 100;
                                int price = product_price.fix_price > 0 ? product_price.fix_price : Convert.ToInt32(Math.Floor(cal));

                                product_price data = new product_price { };
                                //data.price_id = product_price.price_id;
                                data.group_name = product_price.group_name;
                                data.subject = product_price.subject;
                                data.product_id = product_id;
                                data.product_name = pdata.web_name;
                                data.price = price;
                                data.stock = product_price.stock;
                                data.limit = product_price.limit;
                                data.start_date = product_price.start_date;
                                data.end_date = product_price.end_date;
                                data.countback_visible = product_price.countback_visible;

                                data.cost = pdata.cost;
                                data.org_cost = pdata.cost;
                                data.org_price = pdata.sprice;

                                //data.inx = product_price.inx;

                                // data.change_user = User.Identity.Name;
                                // data.change_datetime = DateTime.Now;
                                data.create_user = User.Identity.Name;
                                data.create_datetime = DateTime.Now;

                                this._DB.product_price.Add(data);
                                this._DB.SaveChanges();
                            }
                        }
                    }
                    cb_flag = 1;
                    break;

                #endregion

            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }


