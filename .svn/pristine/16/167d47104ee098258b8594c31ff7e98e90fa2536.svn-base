        #region"儲存"

        [HttpPost, ValidateInput(false)]
        public ActionResult SalesEditSave(product_sales product_sales)
        {
            var data = this._DB.product_sales.Where(m => m.sales_id == product_sales.sales_id && m.product_id == product_sales.product_id).FirstOrDefault();
            if (product_sales.sales_id != 0 && data == null) { }

            data = data != null ? data : new product_sales() { };

            data.price = product_sales.price; //售價
            data.cost = product_sales.cost; //成本
            data.visible_num = product_sales.visible_num;
            data.num = product_sales.num;
            data.visible_date = product_sales.visible_date;
            data.start_datetime = product_sales.start_datetime;
            data.end_datetime = product_sales.end_datetime;

            if (data.sales_id == 0)
            {
                data.product_id = product_sales.product_id;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                this._DB.product_sales.Add(data);
            }
            else
            {
                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
            }

            this._DB.SaveChanges();

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "Edit").Replace("Save", ""), new { sid = data.sales_id, pid = data.product_id });
        }


