        [HttpPost]
        public ActionResult GroupListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";

            switch (cb_flag)
            {
                case 1: //啟用
                    sql = " Update product_group Set visible = 1 Where group_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = " Update product_group Set visible = 0 Where group_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From product_group Where parent_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);
                    sql = " Delete From product_group Where group_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

