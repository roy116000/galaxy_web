        #region "分類列表"

        #region"列表"

        public ActionResult GroupSubList(int? page, int id, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var All = this._DB.product_group.Where(m => m.parent_id != 0);

            var linq = All.Where(m => m.parent_id == id);
            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                linq = linq.Where(m => m.name.Contains(kw));
            }

            var Product = this._DB.product_data.Where(m => m.product_id > 0);
            foreach (var item in linq.ToList())
            {

                var Pro = Product.Where(m => ("," + m.group_ids + ",").Contains("," + item.group_id + ",")).Select(m => m.item_name).ToArray();
                item.counts = Pro.Count(); //數量
                item.name_sub = string.Join(",", Pro); //內容
            }

            IPagedList data = linq.OrderByDescending(m => m.visible).ThenBy(m => m.inx).ToPagedList(currentPageIndex, 50);

            ViewBag.jgrowl = TempData["jgrowl"];
            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

