        #region"複製商品"

        [HttpPost]
        public ActionResult Copy(int pid)
        {
            var data = this._DB.product_data.Where(m => m.product_id == pid).FirstOrDefault();
            if (data != null)
            {
                var data_new = new product_data() { };
                data_new = data;
                data_new.item_no = data.item_no + "c";
                data_new.create_user = User.Identity.Name;
                data_new.create_datetime = DateTime.Now;
                data_new.check_user = null;
                data_new.check_datetime = null;
                data_new.post_user = null;
                data_new.post_datetime = null;


                this._DB.product_data.Add(data_new);
                this._DB.SaveChanges();

                TempData["jgrowl"] = "商品複製成功";
            }


            return View();
        }

