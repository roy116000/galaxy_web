        public ActionResult TagEdit(int id)
        {
            var data = this._DB.product_data.Find(id);
            int p_id = data.product_group == null ? 0 : data.product_group.parent_id;
            if (data.product_group != null)
            {
                if (data.product_group.parent_id == 0)
                {
                    p_id = data.group_id;
                }
            }

            ViewBag.title = data.item_name;

            //分類名稱
            var gname = this._DB.product_group.Where(m => m.group_id == data.group_id).FirstOrDefault();
            ViewBag.gname = gname.name;

            //圖片
            var image = _DB.product_image.Where(m => m.product_id.Equals(id)).FirstOrDefault();
            images_data imgData = new images_data();
            if (image != null)
            {
                imgData.imgs_id = image.imgs_id;
                imgData.s_img = image.s_img;
                imgData.b_img = image.b_img;
            }
            ViewData["uploadimage"] = imgData;

            //sys_admin_data admin = NW.admin(User.Identity.Name);
            var data2 = this._DB.company_data.Where(m => m.company_id == data.company_id).FirstOrDefault();
            ViewBag.company_name = data2.name;

            //tag用
            var tag = this._DB.tag_data.Where(m => m.visible).ToList();
            ViewData["tag"] = tag;

            //當前tag
            string tag_s = "- - -";
            if (!string.IsNullOrEmpty(data.tagz))
            {
                tag_s = data.tagz;
            }
            ViewBag.tag_s = tag_s;

            ViewBag.jgrowl = TempData["jgrowl"];

            //編輯器用
            NW.product_id = id.ToString();

            return View(data);
        }

