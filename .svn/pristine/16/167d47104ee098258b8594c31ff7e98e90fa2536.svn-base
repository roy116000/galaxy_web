        public ActionResult GroupList(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var All = this._DB.product_group.Where(m => m.group_id > 0);

            var linq = All.Where(m => m.parent_id == 0).OrderBy(m => m.inx).ToList();

            linq.ForEach(m => 
            {
                var S = All.Where(x => x.parent_id == m.group_id).Select(x => x.name).ToList();
                m.counts = S.Count();
                m.name_sub = string.Join(",", S);
            });

           

            IPagedList data = linq.OrderBy(m => m.inx).ToPagedList(currentPageIndex, 50);

            ViewBag.jgrowl = TempData["jgrowl"];
            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

