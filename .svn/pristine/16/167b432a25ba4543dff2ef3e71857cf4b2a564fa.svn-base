        [DisplayName("修改時間")]
        public DateTime? change_datetime { get; set; }

        [DisplayName("庫存量")]
        public int inventory_num { get; set; }

        [DisplayName("單次購買數量")]
        public int once_num { get; set; }

        [DisplayName("是否寄送簡訊")]
