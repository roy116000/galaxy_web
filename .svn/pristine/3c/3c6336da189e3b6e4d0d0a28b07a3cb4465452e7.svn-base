        #region "待請款"
        public ActionResult StayList(string kw)
        {
            int currentPageIndex = 0;

            //Export("303,304,305");

            var company_data = this._DB.drugstore_data.Where(m => m.visible).OrderBy(m => m.drugstore_id).ToList();

         


            //var company_data = this._DB.company_data.Where(m => m.visible && m.company_id==6).OrderBy(m => m.company_id).ToList();

            List<data_list> Linq = new List<data_list> { };

            foreach (var com in company_data)
            {
                List<data_list> data2 = getBills(com);
                Linq.AddRange(data2);

            }

            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.create_user.Contains(kw)).ToList();
            }

            IPagedList data = Linq.Where(m => m.cost != 0 && m.status_flag == 0).OrderByDescending(m => m.post_datetime).ToPagedList(currentPageIndex, 12);

            ViewBag.jgrowl = TempData["jgrowl"];
            ViewBag.kw = kw;
            

            return View(data);
        }

        public ActionResult StayList_ajax(int? page, string kw)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var company_data = this._DB.drugstore_data.Where(m => m.visible && m.drugstore_id != 0).OrderBy(m => m.drugstore_id).ToList();

            List<data_list> Linq = new List<data_list> { };

            foreach (var com in company_data)
            {
                List<data_list> data2 = getBills(com);
                Linq.AddRange(data2);

            }

            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.create_user.Contains(kw)).ToList();
            }

            IPagedList data = Linq.Where(m => m.cost != 0 && m.status_flag == 0).OrderByDescending(m => m.hits).ToPagedList(currentPageIndex, 12);

            ViewBag.kw = kw;

            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult StayEdit(int id, int cid, DateTime? sD, DateTime? eD)
        {
            var data = this._DB.order_bills2.Where(m => m.bills_id == id).FirstOrDefault();
        
            //sys_admin_data admin = NW.admin(User.Identity.Name);
            

            var data2 = this._DB.order_data2.Where(m => m.bills_id == id && m.drugstor_id == cid).OrderBy(m => m.goods_datetime).ToList();
            if (id != 0)
            {
                if (data == null) { return RedirectToAction("List"); }
            }
            else
            {
                data2 = this._DB.order_data2.Where(m => m.visible && m.drugstor_id == cid && m.flag >= 1 && m.bills_id == id && m.order_datetime >= sD && m.order_datetime < eD).OrderBy(m => m.goods_datetime).ToList();
            }


            ViewData["data2"] = data2;

            var company = this._DB.drugstore_data.Where(m => m.drugstore_id == cid).FirstOrDefault();
            ViewData["company"] = company;

            double cost_total = 0;

            double discount = 0;
            double cost = 0;
            int freight = 0;

            bills_money2 bm = getBillsMoney(data2);
            discount = bm.discount;
            cost = bm.cost;
            freight = bm.freight;

            cost_total = cost + discount + freight;
            ViewBag.ctotal = cost_total;


            return View(data);
        }

        //未用
        [HttpPost]
        public ActionResult StayEditSave(order_data2 order_data, int index)
        {
            var data = this._DB.order_data2.Find(order_data.order_id);

            switch (index)
            {
                case 0:    //金流資料
                    data.pay_id = order_data.pay_id;
                    data.pay_visible = order_data.pay_visible;
                    data.pay_note = order_data.pay_note;
                    if (order_data.pay_visible) { if (data.pay_datetime == null) { data.pay_datetime = DateTime.Now; } } else { data.pay_datetime = null; }
                    data.flag = order_data.pay_visible ? 1 : 0;
                    this._DB.SaveChanges();
                    TempData["jgrowl"] = "金流資訊儲存成功!!";
                    break;
                case 1:    //物流資料

                    if (data.pay_visible)
                    {
                        data.freight_name = order_data.freight_name;
                        data.freight_no = order_data.freight_no;
                        data.freight_datetime = order_data.freight_datetime;
                        data.goods_datetime = order_data.freight_datetime;
                        data.goods_info = "WEB填入";
                        if (!string.IsNullOrEmpty(data.freight_name)) { data.flag = 2; }
                        this._DB.SaveChanges();


                        DateTime dt = DateTime.Now;
                        foreach (var item in data.order_sub2)
                        {
                            var data2 = new order_goods2 { };
                            data2.order_id = data.order_id;
                            data2.sub_id = item.sub_id;
                            data2.name = data.freight_name;
                            data2.sn = data.freight_no;
                            data2.num = item.num;
                            data2.goods_datetime = data.goods_datetime;
                            data2.create_user = User.Identity.Name;
                            data2.create_datetime = dt;

                            _DB.order_goods2.Add(data2);
                            this._DB.SaveChanges();

                        }

                        TempData["jgrowl"] = "物流資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成，在處理物流資料";
                    }

                    break;
                case 2: //發票資料
                    if (data.pay_visible && data.flag == 2)
                    {
                        data.invoice_datetime = order_data.invoice_datetime;
                        data.invoice_no = order_data.invoice_no;
                        //data.invoice_note = order_data.invoice_note;
                        if (!string.IsNullOrEmpty(data.invoice_no)) { data.flag = 5; }
                        this._DB.SaveChanges();
                        TempData["jgrowl"] = "發票資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成或出貨完成，在處理發票資料";
                    }

                    break;
            }

            return RedirectToAction("Edit", new { @id = order_data.order_id });
        }

        public ActionResult StayAdd(int id, int yymm, int bills_flag, DateTime sD, DateTime eD)
        {
            order_bills2 data = new order_bills2();
            data.bills_datetime = DateTime.Now;
            data.invoice_datetime = DateTime.Now;
            data.company_id = id;
            string msg = "";

            //sys_admin_data admin = NW.admin(User.Identity.Name);
            var data2 = this._DB.order_data2.Where(m => m.visible && m.drugstor_id == id && m.flag >= 1 && m.bills_id == 0 && m.order_datetime >= sD && m.order_datetime < eD).OrderBy(m => m.goods_datetime).ToList();
            ViewData["data2"] = data2;

            foreach (var item in data2)
            {
                if (item.freight_datetime == null)
                {
                    msg = "目前尚有貨品未出貨，可填入預計出貨日期，如無法正常出貨請作廢該筆訂單，如還是要清帳，請直接點選清帳按鈕。";
                }
            }

            ViewBag.msg = msg;

            TempData["sD"] = sD;
            TempData["eD"] = eD;
            TempData["yymm"] = yymm;
            TempData["bills_flag"] = bills_flag;

            var company = this._DB.drugstore_data.Where(m => m.drugstore_id == id).FirstOrDefault();
            ViewData["company"] = company;

            double cost_total = 0;

            double discount = 0;
            double cost = 0;
            int freight = 0;

            bills_money2 bm = getBillsMoney(data2);
            discount = bm.discount;
            cost = bm.cost;
            freight = bm.freight;

            cost_total = cost + discount + freight;
            ViewBag.ctotal = cost_total;

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult StayAddSave(order_bills2 order_bills)
        {
            //var data = this._DB.product_data.Find(product_data.product_id);
            //var data1 = this._DB.product_data.Where(m => m.product_id.Equals(product_data.product_id)).Select(m => m).SingleOrDefault();
            var data = new order_bills2 { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                //DateTime sD = (DateTime)TempData["sD"];

                var admin = NW.admin(User.Identity.Name);
                data.company_id = order_bills.company_id;

                data.invoice_no = order_bills.invoice_no;
                data.invoice_datetime = order_bills.invoice_datetime;

                data.bills_datetime = order_bills.bills_datetime;

                data.yymm = (int)TempData["yymm"];
                data.bills_flag = (int)TempData["bills_flag"];
                data.sdate = (DateTime)TempData["sD"];
                data.edate = (DateTime)TempData["eD"];

                //0未請款 1處理中 2請款完成
                data.flag = 1;

                var company = this._DB.drugstore_data.Where(m => m.drugstore_id == order_bills.company_id).FirstOrDefault();
                data.create_user = admin.name;
                data.create_datetime = DateTime.Now;

                _DB.order_bills2.Add(data);
                this._DB.SaveChanges();

                order_bills.bills_id = data.bills_id;

                var data2 = this._DB.order_data2.Where(m => m.visible && m.drugstor_id == order_bills.company_id && m.flag >= 1 && m.bills_id == 0 && m.back_flag == null && m.order_datetime >= data.sdate && m.order_datetime < data.edate).OrderBy(m => m.goods_datetime).ToList();


                foreach (var item in data2)
                {
                    //cost_total += item.cost_total;
                    item.bills_id = data.bills_id;
                    this._DB.SaveChanges();
                }

                double cost_total = 0;
                double discount = 0;
                double cost = 0;
                int freight = 0;

                bills_money2 bm = getBillsMoney(data2);
                discount = bm.discount;
                cost = bm.cost;
                freight = bm.freight;

                cost_total = cost + discount + freight;

                data.total = cost_total;
                this._DB.SaveChanges();

            }

            return RedirectToAction("StayEdit", new { id = order_bills.bills_id, cid = order_bills.company_id });
        }

        [HttpPost]
        public ActionResult StayListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "作廢" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update order_data2 set visible = 1 Where order_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update order_data2 set visible = 0 Where order_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From order_data2 Where order_id in (" + cb_id + ")";
                    if (_DB.Database.ExecuteSqlCommand(sql) > 0)
                    {
                        sql = " Delete From order_sub2 Where order_id in (" + cb_id + ")";
                    }
                    else
                    {
                        sql = "";
                    }

                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            if (cb_flag != 2)
            {
                return RedirectToAction("Visible" + RouteData.Values["action"].ToString().Replace("Del", ""));
            }
            else
            {
                return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
            }
        }

        #endregion

        #region "請款中"
        public ActionResult List()
        {
            int currentPageIndex = 0;

            var Linq = this._DB.order_bills2.Where(m => m.flag == 1);


            Linq = Linq.OrderByDescending(m => m.create_datetime);

            IPagedList data = Linq.ToPagedList(currentPageIndex, 20);

            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? page)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_bills2.Where(m => m.flag == 1);

            Linq = Linq.OrderByDescending(m => m.create_datetime);

            IPagedList data = Linq.ToPagedList(currentPageIndex, 20);

            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult Edit(int id)
        {
            var data = this._DB.order_bills2.Find(id);
            if (data == null) { return RedirectToAction("List"); }

            var data2 = this._DB.order_data2.Where(m => m.bills_id == id).OrderBy(m => m.goods_datetime).ToList();
            ViewData["data2"] = data2;

            var company = this._DB.sys_admin_data.Where(m => m.drugstore_id == data.company_id).FirstOrDefault();
            ViewBag.cname = company.name;

            //ViewBag.receivingbankaccount = company.receivingbankaccount;
            //ViewBag.receivingbankcode = company.receivingbankcode;
            //ViewBag.bankunmber = company.bankunmber;
            //ViewBag.ranchunmber = company.ranchunmber;


            //請款
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("1", "處理中", 1 == data.flag));
            ListItems.Add(new ListItem("2", "確認請款", 2 == data.flag));
            ViewData["flag"] = ListItems;

            double cost_total = 0;

            double discount = 0;
            double cost = 0;
            int freight = 0;

            bills_money2 bm = getBillsMoney(data2);
            discount = bm.discount;
            cost = bm.cost;
            freight = bm.freight;

            cost_total = cost + discount + freight;
            ViewBag.ctotal = cost_total;

            ViewBag.jgrowl = TempData["jgrowl"];


            return View(data);
        }

        [HttpPost]
        public ActionResult EditSave(order_bills2 order_bills, int flag)
        {
            var data = this._DB.order_bills2.Find(order_bills.bills_id);
            //var data1 = this._DB.product_data.Where(m => m.product_id.Equals(product_data.product_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {

                //sys_admin_data admin = NW.admin(User.Identity.Name);
                //data.company_id = admin.company_id;

                data.invoice_no = order_bills.invoice_no;
                data.invoice_datetime = order_bills.invoice_datetime;

                data.bills_datetime = order_bills.bills_datetime;
                data.info = order_bills.info;

                //0未請款 1處理中 2請款完成
                data.flag = flag;



                data.check_user = User.Identity.Name;
                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;

                this._DB.SaveChanges();


                


                if (flag == 2)
                {

                    //暫時關掉
                    //var data2 = this._DB.company_data.Where(m => m.company_id == data.company_id).FirstOrDefault();

                    //string subject = "中時團購系統-請款完成通知信";
                    //string body = data2.name + " 您好，貴公司 " + data.yymm.ToString() + " 的款項已於" + data.change_datetime.Value.ToString("yyyy/MM/dd") + "完成請款，總金額：" + data.total.ToString("N0") + "。";

                    //body = string.Format(body, data2.name, order_bills.bills_id);

                    //NW.sendMail(data2.mail + ";" + data2.mail, subject, body);


                }

            }

            string action = "";
            switch (flag)
            {
                case 1:
                    action = "Edit";
                    TempData["jgrowl"] = "儲存成功！";
                    break;
                case 2:
                    action = "FinishEdit";
                    TempData["jgrowl"] = "請款完成！";
                    var company = this._DB.company_data.Where(m => m.company_id == data.company_id).FirstOrDefault();
                    if (company != null)
                    {
                        string bills = "";
                        switch (data.bills_flag)
                        {
                            case 1:
                                bills = "-上";
                                break;
                            case 2:
                                bills = "-下";
                                break;
                        }

                        string bills_name = data.yymm.ToString() + bills;
                        //轉所有訂單為已付款
                        var order_data = this._DB.order_data2.Where(m => m.bills_id == data.bills_id && m.visible && !string.IsNullOrEmpty(m.back_info) && !string.IsNullOrEmpty(m.back_flag)).ToList();
                        foreach (var item in order_data)
                        {
                            item.flag = 5;
                            item.pay_visible = true;
                            item.pay_note = "已月結清款";
                            item.invoice = data.invoice_no;
                            this._DB.SaveChanges();
                        }

                        //暫時關掉
                        //string subject = "中時團購系統-請款完成通知信";
                        //string body = company.name + " 您好，貴公司 " + bills_name + " 的款項已於" + data.change_datetime.Value.ToString("yyyy/MM/dd") + "完成請款，總金額：" + data.total.ToString("N0") + "。";
                        //NW.sendMail(company.mail + ";" + company.mail, subject, body);

                    }

                    break;
            }



            return RedirectToAction(action, new { @id = order_bills.bills_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "作廢" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update order_data2 set visible = 1 Where order_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update order_data2 set visible = 0 Where order_id in (" + cb_id + ")";
                    break;
                case 0: //刪除                    
                    sql = "Update order_data2 set bills_id = 0 Where bills_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);
                    sql = "Delete From order_bills2 Where bills_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

