        #region"訂單列表"

        public class _Order
        {
            public order_data_n O { get; set; }
            public List<order_sub_n> S { get; set; }
        }

        public IEnumerable<_Order> Select(DateTime? sD, DateTime? eD, string kw, int? flag)
        {
            var linq = this._DB.order_data_n.Where(m => m.order_id > 0);
            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                kw = kw.ToLower();

                linq = linq.Where(m => m.order_name.ToLower().Contains(kw) || m.send_name.ToLower().Contains(kw) ||
                    m.order_phone.Contains(kw) || m.send_phone.Contains(kw) || m.send_address.Contains(kw) || m.order_id.ToString() == kw);
            }

            if (flag.HasValue)
            {
                ViewBag.flag = flag;

                linq = linq.Where(m => m.flag == flag);
            }

            if (sD.HasValue)
            {
                ViewBag.sD = NW.getDate(sD);

                linq = linq.Where(m => m.order_datetime >= sD || m.pay_datetime >= sD || m.freight_datetime >= sD || m.finish_datetime >= sD);
            }

            if (eD.HasValue)
            {
                ViewBag.eD = NW.getDate(eD);

                eD = eD.Value.AddDays(1);
                linq = linq.Where(m => m.order_datetime < eD || m.pay_datetime < eD || m.freight_datetime < eD || m.finish_datetime < eD);
            }

            var data = (from a in linq
                        join b in this._DB.order_sub_n on a.order_id equals b.order_id into mm
                        select new _Order()
                        {
                            O = a,
                            S = mm.OrderByDescending(m => m.price * m.num).ToList()
                        });

            return data;
        }


        public ActionResult OrderList(int? page, DateTime? sD, DateTime? eD, string kw, int? flag)
        {


            var linq = Select(sD, eD, kw, flag);

            int IndexPage = page > 0 ? (int)page - 1 : 0;
            IPagedList data = linq.OrderByDescending(m => m.O.flag).ThenByDescending(m => m.O.order_datetime).ToPagedList(IndexPage, 20);


            #region"下拉選單"

            List<ListItem> ListItems = new List<ListItem>() { };

            ListItems = Gs.sList(NW.Name_flag, flag.ToString(), "全部");
            ViewData["Flag"] = ListItems;

            #endregion

            if (page > 0)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

        public ActionResult Export(DateTime? sD, DateTime? eD, string kw, int? flag)
        {
            string msg = "";
            string value = "";

            var data = Select(sD, eD, kw, flag).OrderBy(m => m.O.flag).ToList(); //匯出的資料
            if (!data.Any()) { msg = "無相關內容，故無法匯出"; }
            else
            {
                try
                {
                    string T = "'";
                    int rowIdx = 1;
                    int colIdx = 1;

                    XLWorkbook workbook = new XLWorkbook();
                    var sheet = workbook.Worksheets.Add("訂單明細");

                    string[] Cols = { "項次", "訂購平台(請參照平台名稱)", "訂單單號", "訂單狀況(成立/作廢/退貨/取消訂單/已出貨)", "訂購時間", "訂購人", "收件人", "訂購人電話", "收件人電話", "配送地址", "貨號(飛象)", "商品名稱", "數量", "樣式/規格", "數量", "送達時間", "備註", "出貨時間", "出貨單號", "物流公司" };
                    foreach (var item in Cols)
                    {
                        sheet.Cell(rowIdx, colIdx++).Value = T + item;
                    }

                    rowIdx = 2;
                    int oid = 0;
                    foreach (var item in data)
                    {

                        var O = item.O;

                        foreach (var item2 in item.S)
                        {
                            var C = this._DB.company_data.Where(m => m.company_id == O.company_id).FirstOrDefault();


                            string[] N = 
                        {
                            (Array.IndexOf(data.Select(m => m.O.order_id).ToArray(), O.order_id) + 1).ToString(),
                            NW.Name_flag[O.flag],
                            O.order_sn,
                            C != null ? C.name : "查無廠商",
                            item2.item_name,
                            item2.num.ToString(),
                            item2.price.ToString("N0"),
                            O.order_datetime.HasValue ? O.order_datetime.Value.ToString("yyyy.MM.dd HH:mm:ss") : "",
                            O.pay_datetime.HasValue ? O.pay_datetime.Value.ToString("yyyy.MM.dd HH:mm:ss") : "",
                            O.export_datetime.HasValue ? O.export_datetime.Value.ToString("yyyy.MM.dd HH:mm:ss") : "",
                            O.freight_datetime.HasValue ? O.freight_datetime.Value.ToString("yyyy.MM.dd HH:mm:ss") : "",

                            O.freight_no,
                            O.finish_datetime.HasValue ? O.finish_datetime.Value.ToString("yyyy.MM.dd HH:mm:ss") : ""
                        };

                            int num = 1;
                            foreach (var itemN in N)
                            {
                                sheet.Cell(rowIdx, num++).Value = T + itemN;
                            }

                            rowIdx++;
                        }



                        oid = O.order_id;
                    }

                    value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

                    workbook.SaveAs(value);
                    workbook.Dispose();

                    
                }
                catch
                {
                    msg = "匯出失敗，請與管理者聯繫";
                }
            }

            if (!string.IsNullOrEmpty(value))
            {
                return File(value, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".xlsx"));
            }
            else 
            {
                TempData["jgrowl"] = msg;
                return RedirectToAction("OrderList");
            }

            
        }

