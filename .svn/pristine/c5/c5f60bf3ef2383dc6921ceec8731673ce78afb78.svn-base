        public ActionResult Import(HttpPostedFileBase file) 
        {
            string msg = "";
            //匯入
            if (file != null && file.ContentLength > 0 && NW.getFileType(file, 3))
            {
                try
                {
                    //判斷Excel版本
                    IWorkbook excel = WorkbookFactory.Create(file.InputStream);

                    //資料列
                    NPOI.SS.UserModel.ISheet Sheet = excel.GetSheetAt(0);

                    //所有的資料列
                    for (int row = 1; row <= Sheet.LastRowNum; row++)
                    {
                        //不為空列
                        if (Sheet.GetRow(row) != null)
                        {
                            string order_flag = Sheet.GetRow(row).GetCell(3).ToString();

                            //已出貨
                            if (order_flag == "已出貨")
                            {
                                string order_sn = Sheet.GetRow(row).GetCell(3).ToString();
                                var data = this._DB.order_data_n.Where(m => m.order_sn == order_sn).FirstOrDefault();
                                if (data != null)
                                {
                                    data.freight_datetime = DateTime.Parse(Sheet.GetRow(row).GetCell(17).ToString()); //出貨時間
                                    data.freight_no = Sheet.GetRow(row).GetCell(18).ToString(); //出貨單號

                                    //出貨公司
                                    string freight_name = Sheet.GetRow(row).GetCell(19).ToString();
                                    if (!string.IsNullOrEmpty(freight_name))
                                    {
                                        var Freight = this._DB.freight_data.Where(m => m.name.Contains(freight_name)).FirstOrDefault();
                                        if (Freight != null)
                                        {
                                            data.freight_id = Freight.freight_id;
                                        }
                                    }

                                    data.flag = 3; //出貨完成

                                    this._DB.SaveChanges();
                                }

                            }
                        }
                    }

                    msg = "匯入成功";
                }
                catch
                {
                    msg = "匯入過程有誤";
                }
            }
            else 
            {
                msg = "請選擇Execl檔案";
            }

            return RedirectToAction("OrderList");
        }

        #endregion

    }
}
