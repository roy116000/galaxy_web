        public static string[] Type = { "圖片", "影片" };
        public static string[] Gift = { "商品", "獎勵金" };

        public ActionResult List(int? page, string kw, DateTime? sD, DateTime? eD)
        {
            ViewBag.jgrowl = TempData["jgrowl"];

            int cuxxpageindex = page.HasValue ? ((int)page.Value > 0 ? (int)page - 1 : 0) : 0;

            var linq = this._DB.pharmacist_activity.Where(m => m.activity_id > 0);

            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                linq = linq.Where(m => m.title.Contains(kw));
            }

            DateTime tD = DateTime.Today;
            sD = sD.HasValue ? sD : new DateTime(tD.Year, tD.Month, 1);
            eD = eD.HasValue ? eD : tD;
            ViewBag.sD = sD.Value.ToShortDateString();
            ViewBag.eD = eD.Value.ToShortDateString();
            eD = eD.Value.AddDays(1);

            //linq = linq.Where(m => sD <= m.start_datetime && eD > m.end_datetime);

            var data = linq.OrderByDescending(m => m.change_datetime).ThenByDescending(m => m.create_datetime).ToPagedList(cuxxpageindex, 30);

            if (cuxxpageindex > 0)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

        public ActionResult Add(int id)
        {
            ViewBag.jgrowl = TempData["jgrowl"];

            string Controller = RouteData.Values["controller"].ToString();
            string Action = RouteData.Values["action"].ToString();

            //var T = (from a in this._DB.sys_function_data.Where(m => m.controll == Controller)
            //        join b in this._DB.sys_function_sub on a.function_id equals b.function_id into mm
            //        select new
            //        {
            //            mm.Where(m => m.action == Action).FirstOrDefault().label
            //        }).ToList();

            //ViewBag.T = T.FirstOrDefault().label;


            var data = this._DB.pharmacist_activity.Where(m => m.activity_id == id).FirstOrDefault();
            if (id != 0 && data == null) { TempData["jgrowl"] = "查無資料"; return RedirectToAction(""); }

            data = data != null ? data : new pharmacist_activity() { };
            if (data.activity_id == 0)
            {
                data.start_datetime = H365.Today;
                data.end_datetime = H365.Today.AddMonths(5).AddDays(-1);
                data.visible = true;

            }
            else
            {
                data.type_img = NW.Path_Img(data.type_img, RouteData.Values["controller"].ToString().Replace("Nw", ""));
                data.type_url_img = NW.Path_Img(data.type_url_img, RouteData.Values["controller"].ToString().Replace("Nw", ""));

                #region"問題"

                var Q = this._DB.pharmacist_activity_data.Where(m => m.activity_id == data.activity_id).ToList();

                ViewData["Q"] = Q;

                #endregion
            }

            #region"選單"

            ViewData["type"] = NW.sList(Type, data.type.ToString());

            ViewData["gift"] = NW.sList(Gift, data.gift.ToString());

            #endregion

            ViewBag.id = data.activity_id;

            return View(data);
        }

        public ActionResult Edit(int id)
        {
            //var data = Add(id);

            return Add(id);
        }

        [ValidateInput(false), HttpPost]
        public ActionResult EditSave(pharmacist_activity pharmacist_activity, HttpPostedFileBase type_img, HttpPostedFileBase type_url_img)
        {
            var data = this._DB.pharmacist_activity.Where(m => m.activity_id == pharmacist_activity.activity_id).FirstOrDefault();
            if (data == null && pharmacist_activity.activity_id != 0) { TempData["jgrowl"] = "查無資料"; return RedirectToAction(RouteData.Values["action"].ToString().Replace("EditSave", "") + "List"); }
            else
            {
                data = data != null ? data : new pharmacist_activity() { };
                data.title = pharmacist_activity.title;
                data.type = pharmacist_activity.type;
                data.gift = pharmacist_activity.gift;
                data.gift_num = pharmacist_activity.gift_num;
                data.info = pharmacist_activity.info;
                data.cont = pharmacist_activity.cont;
                data.start_datetime = pharmacist_activity.start_datetime;
                data.end_datetime = pharmacist_activity.end_datetime;
                data.visible = pharmacist_activity.visible;
                data.type_url = pharmacist_activity.type_url;

                #region"圖片專區"

                if (type_img != null && type_img.ContentLength > 0 && NW.getFileType(type_img, 1)) //有無上傳
                {

                    string tmpPath = Server.MapPath("~/Content/images/" + RouteData.Values["controller"].ToString().Replace("Nw", "")); //存放路徑
                    if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); } //建資料夾

                    //var Group = this._DB.adv_group.Where(m => m.group_id == adv_data.group_id).FirstOrDefault();

                    data.type_img = Images.Helps.ImageHelper.Rebmp(type_img, tmpPath, 720, 0);
                }

                if (type_url_img != null && type_url_img.ContentLength > 0 && NW.getFileType(type_url_img, 1)) //有無上傳
                {

                    string tmpPath = Server.MapPath("~/Content/images/" + RouteData.Values["controller"].ToString().Replace("Nw", "")); //存放路徑
                    if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); } //建資料夾

                    //var Group = this._DB.adv_group.Where(m => m.group_id == adv_data.group_id).FirstOrDefault();

                    data.type_url_img = Images.Helps.ImageHelper.Rebmp(type_url_img, tmpPath, 720, 0);
                }

                #endregion

                if (data.activity_id == 0)
                {
                    data.create_user = User.Identity.Name;
                    data.create_datetime = DateTime.Now;
                    this._DB.pharmacist_activity.Add(data);

                    TempData["jgrowl"] = "新增成功";
                }
                else
                {
                    data.change_user = User.Identity.Name;
                    data.change_datetime = DateTime.Now;

                    TempData["jgrowl"] = "修改成功";
                }

                this._DB.SaveChanges();

                return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = data.activity_id });
            }
        }

        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            string DB = "pharmacist_activity";
            string Id = "activity_id";
            //this._DB.pharmacist_activity.Where(m => m.activity_id)

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update " + DB + " set visible = 1 Where " + Id + " in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update " + DB + " set visible = 0 Where " + Id + " in (" + cb_id + ")";
                    break;
                case 0: //刪除                  
                    sql = " Delete From  " + DB + " Where " + Id + " in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }


        [ValidateInput(false), HttpPost]
        public ActionResult QuestionEditSave(pharmacist_activity_data activity_data)
        {
            var data = this._DB.pharmacist_activity_data.Where(m => m.question_id == activity_data.question_id).FirstOrDefault();
            if (activity_data.question_id != 0 && data == null) { TempData["jgrowl"] = "查無資料"; }
            else
            {
                data = data != null ? data : new pharmacist_activity_data() { };

                data.activity_id = activity_data.activity_id;
                data.title = activity_data.title;
                data.answer1 = activity_data.answer1;
                data.fraction1 = activity_data.fraction1;
                data.answer2 = activity_data.answer2;
                data.fraction2 = activity_data.fraction2;
                data.inx = activity_data.inx;
                data.visible = activity_data.visible;

                if (data.question_id == 0)
                {
                    data.create_user = User.Identity.Name;
                    data.create_datetime = DateTime.Now;
                    this._DB.pharmacist_activity_data.Add(data);

                    TempData["jgrowl"] = "新增成功";
                }
                else
                {
                    data.change_user = User.Identity.Name;
                    data.change_datetime = DateTime.Now;

                    TempData["jgrowl"] = "修改成功";
                }

                this._DB.SaveChanges();

            }

            return RedirectToAction("Edit", new { id = activity_data.activity_id });

        }

