    public class NwMemberController : _BaseController
    {

        #region"會員列表"

        public ActionResult List(int? page, string kw, DateTime? sD, DateTime? eD, bool isExport = false)
        {


            var linq = this._DB.member_data.Where(m => m.member_id > 0);

            var set = (from a in linq
                       join b in this._DB.drugstore_data on a.drugstore_id equals b.drugstore_id into mm
                       select new
                       {
                           a = a,
                           b = mm
                       }).ToList().Select(m => new
                       {
                           a = m.a,
                           b = m.b.Any() ? m.b.FirstOrDefault() : new drugstore_data() { }
                       }).ToList().Select(m => new member_data()
                       {
                           member_id = m.a.member_id,
                           name = m.a.name,
                           phone = m.a.phone,
                           change_user = m.b.name,
                           create_datetime = m.a.create_datetime,
                           create_user = m.a.create_user,
                           visible = m.a.visible
                       });

            #region"搜尋"

            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;

                kw = kw.ToLower();
                set = set.Where(m =>
                    (!string.IsNullOrEmpty(m.name) ? m.name.ToLower().Contains(kw) : false)
                    || (!string.IsNullOrEmpty(m.phone) ? m.phone.Contains(kw) : false)
                    || (!string.IsNullOrEmpty(m.change_user) ? m.change_user.ToLower().Contains(kw) : false)
                    );
            }

            if (sD.HasValue)
            {
                ViewBag.sD = NW.getDate(sD);
                set = set.Where(m => m.create_datetime >= sD);
            }

            if (eD.HasValue)
            {
                ViewBag.eD = NW.getDate(eD);

                eD = eD.Value.AddDays(1);

                set = set.Where(m => m.create_datetime < eD);
            }
            #endregion

            if (isExport)
            {
                return Export(set);
            }

            int currIndex = page > 0 ? (int)page - 1 : 0;
            var data = set.OrderByDescending(m => m.visible).ThenByDescending(m => m.create_datetime).ToPagedList(currIndex, 50);

            if (page.HasValue)
            {
                return PartialView("List_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

        private ActionResult Export(IEnumerable<member_data> Get)
        {

            //string msg = "";
            string T = "'";

            XLWorkbook workbook = new XLWorkbook() { };
            var sheet = workbook.Worksheets.Add("明細");
            int colIdx = 1; //欄位
            int rowIdx = 2; //行數

            string[] cols = null;

            //需組裝的資料
            var data = Get.OrderByDescending(m => m.create_datetime).ToList();

            #region"總"

            colIdx = 8; //欄位
            rowIdx = rowIdx + 1; //行數

            cols = new string[] { "總數量" };
            foreach (var item in cols)
            {
                sheet.Cell(rowIdx, colIdx).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

                sheet.Cell(rowIdx, colIdx++).Value = item;
            }

            colIdx = 8; //欄位
            rowIdx = rowIdx + 1; //行數


            cols = new string[] 
            {
                data.Count().ToString(),
                //data.Select(m => m.total).DefaultIfEmpty(0).Sum().ToString("N0")
            };
            foreach (string item in cols)
            {
                //置右
                sheet.Cell(rowIdx, colIdx).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;

                sheet.Cell(rowIdx, colIdx++).Value = T + item;
            }

            #endregion

            #region"訂單明細"

            colIdx = 1;
            rowIdx = rowIdx + 2;

            cols = new string[] { "#", "會員姓名", "連絡電話", "註冊時間", "註冊方式", "綁定藥局", "啟用" };
            foreach (var item in cols)
            {
                //置中
                sheet.Cell(rowIdx, colIdx).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

                sheet.Cell(rowIdx, colIdx++).Value = item;
            }

            foreach (var item in data)
            {
                string[] N = 
                {

                    (Array.IndexOf(data.Select(m => m.member_id).ToArray(), item.member_id) + 1).ToString(),
                    item.name, 
                    item.phone, 
                    item.create_datetime.HasValue ? NW.getDate(item.create_datetime) : "",
                    item.create_user,
                    item.change_user,
                    item.visible ? "啟用中" : "關閉",

                };

                int num = 1;
                foreach (var item2 in N)
                {
                    sheet.Cell(rowIdx + 1, num).Value = T + item2;

                    if (new int[] { }.Contains(num))
                    {
                        //置中
                        sheet.Cell(rowIdx + 1, num).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                    }
                    else if (new int[] { 1, 8, 9, 10 }.Contains(num))
                    {
                        //置右
                        sheet.Cell(rowIdx + 1, num).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;
                    }

                    num++;
                }

                rowIdx++;
            }

            #endregion

            #region"增添色彩~"

            //sheet.Rows("1").Style.Font.FontSize = 20;
            sheet.Rows("3, 4").Style.Font.FontSize = 14;
            sheet.Rows("3, 4, 6").Style.Font.Bold = true;

            sheet.Rows("3, 6").Style.Fill.BackgroundColor = XLColor.Yellow;
            ////sheet.Rows("3,5,8").Style.Fill.color = ConsoleColor.White;
            //sheet.Rows("3,6").Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            //sheet.Column(1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            #endregion

            #region"自動伸縮欄寬"

            for (int i = 1; i <= cols.Length + 10; i++)
            {
                sheet.Column(i).AdjustToContents();

                //if (i != 3)
                //{
                //    sheet.Column(i).AdjustToContents();
                //}

            }

            #endregion

            string value = "";
            value = Server.MapPath("~/Content/files/export/" + "會員-" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");


            workbook.SaveAs(value);
            workbook.Dispose();

            return File(value, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Now.ToString("order_yyyyMMdd-HHmmss") + ".xlsx"));
        }


        #region"列表"

        public ActionResult xxList(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Member = this._DB.member_data.Where(m => m.member_id > 0 && m.group_id != 0);

            var Drug = this._DB.drugstore_data.Where(m => m.drugstore_id > 0).ToList();
            ViewData["Drug"] = Drug;

            var linq = Member.OrderByDescending(m => m.phone).Distinct();

            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                linq = linq.Where(m => m.name.Contains(kw));
            }

            var data = linq.OrderByDescending(m => m.drugstore_id).ThenByDescending(m => m.change_datetime).ToPagedList(currentPageIndex, 50);

            ViewBag.jgrowl = TempData["jgrowl"];

            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }

        }

        #endregion

        #region"新增修改"

        public ActionResult AoE(int id)
        {
            var data = this._DB.member_data.Where(m => m.member_id == id).FirstOrDefault();
            if (id != 0 && data == null) { return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "").Replace("Eidt", "") + "List"); }
            else
            {
                data = data != null ? data : new member_data();
                if (data.member_id == 0)
                {
                    data.visible = true;
                }

                #region"選單"
                List<ListItem> ListItems = new List<ListItem> { };



                //性別
                string[] Sex = { "女", "男" };
                ListItems.AddRange(NW.sList(Sex, data.sex));
                ViewData["sex"] = ListItems;

                //區號
                ViewData["zip"] = NW.zipData(0, data.zip);
                ViewData["zip_chained"] = NW.zipData(1, data.zip);

                #endregion


                ViewBag.jgrowl = TempData["jgrowl"];
                return View(data);
            }
        }

        public ActionResult Add(int id)
        {
            return AoE(id);
        }

        public ActionResult Edit(int id)
        {
            return AoE(id);
        }

        #endregion

        #region"儲存"

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(member_data member_data)
        {
            var data = this._DB.member_data.Where(m => m.member_id == member_data.member_id).FirstOrDefault();
            if (member_data.member_id != 0 && data == null) { return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "").Replace("Eidt", "").Replace("Save", "") + "List"); }
            else
            {
                data = data != null ? data : new member_data();
                data.name = member_data.name; //姓名
                data.password = member_data.password; //密碼
                data.birthday = member_data.birthday; //生日
                data.address = member_data.address; //地址
                data.zip = member_data.zip; //區域
                data.visible = member_data.visible; //啟用
                data.sex = member_data.sex; //性別
                data.mail = member_data.mail; //信箱
                data.group_id = member_data.group_id; //分類
                data.sn = member_data.sn;

                if (data.member_id == 0)
                {
                    data.phone = member_data.phone; //手機(帳號)
                    data.create_user = User.Identity.Name;
                    data.create_datetime = DateTime.Now;
                    this._DB.member_data.Add(data);

                    TempData["jgrowl"] = "新增成功";
                }
                else
                {
                    data.change_user = User.Identity.Name;
                    data.change_datetime = DateTime.Now;

                    TempData["jgrowl"] = "修改成功";
                }

                this._DB.SaveChanges();

                return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = data.member_id });
            }

        }

