        #region "分類列表"

        public ActionResult GroupList(string kw)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.member_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.member_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        public ActionResult GroupList_ajax(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;
            var tmpData = this._DB.member_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.member_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult GroupEdit(int id)
        {

            var data = this._DB.member_group.Find(id);

            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult GroupEditSave(member_group member_group)
        {
            var data = this._DB.member_group.Find(member_group.group_id);

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.group_id = member_group.group_id;
                data.name = member_group.name;
                data.inx = member_group.inx;
                data.visible = member_group.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = member_group.create_user;
                //data.create_datetime = member_group.create_datetime;

                this._DB.SaveChanges();
            }

            //更新
            TempData["jgrowl"] = "資料更新成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = member_group.group_id });
        }

        public ActionResult GroupAdd(int id)
        {
            member_group data = new member_group();
            data.inx = 0;
            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult GroupAddSave(member_group member_group, VmImage imgs)
        {
            //var data = this._DB.member_group.Find(member_group.zz_id);
            //var data1 = this._DB.member_group.Where(m => m.zz_id.Equals(member_group.zz_id)).Select(m => m).SingleOrDefault();
            var data = new member_group { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.group_id = member_group.group_id;
                data.name = member_group.name;
                data.inx = member_group.inx;
                data.visible = member_group.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.member_group.Add(data);
                this._DB.SaveChanges();

                member_group.group_id = data.group_id;
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = member_group.group_id });
        }

        [HttpPost]
        public ActionResult GroupListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";

            switch (cb_flag)
            {
                case 1: //啟用
                    sql = " Update member_group Set visible = 1 Where group_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = " Update member_group Set visible = 0 Where group_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From member_group Where group_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region"真實帳戶列表"
        public ActionResult RealM()
        {
            var data = new member_real();

            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult RealMAdd(product_price product_price, HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {

                    // 建立一個工作簿 Office 2007 flag = 0 訂單資料

                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {

                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            if (sheet.GetRow(row).GetCell(0) != null)
                            {

                                string card_no = sheet.GetRow(row).GetCell(0).ToString();//卡號
                                string name = (sheet.GetRow(row).GetCell(1) != null ? sheet.GetRow(row).GetCell(1).ToString() : "");//姓名
                                string phone = (sheet.GetRow(row).GetCell(2) != null ? sheet.GetRow(row).GetCell(2).ToString() : "");//電話
                                string sn = (sheet.GetRow(row).GetCell(3) != null ? sheet.GetRow(row).GetCell(3).ToString() : "");//店別代碼
                                string market = (sheet.GetRow(row).GetCell(4) != null ? sheet.GetRow(row).GetCell(4).ToString() : "");//店別名稱
                                string mail = (sheet.GetRow(row).GetCell(5) != null ? sheet.GetRow(row).GetCell(5).ToString() : "");//信箱
                                string new_sn = (sheet.GetRow(row).GetCell(6) != null ? sheet.GetRow(row).GetCell(6).ToString() : "");//新分店代碼
                                string new_market = (sheet.GetRow(row).GetCell(7) != null ? sheet.GetRow(row).GetCell(7).ToString() : "");//新店別名稱

                                var member = this._DB.member_real.Where(m => m.card_no == card_no).FirstOrDefault();
                                if (member != null)
                                {
                                    member.name = name;
                                    member.phone = phone;
                                    member.sn = sn;
                                    member.market = market;
                                    member.mail = mail;
                                    member.new_sn = new_sn;
                                    member.new_market = new_market;

                                    this._DB.SaveChanges();
                                }
                                else
                                {
                                    member_real data = new member_real { };
                                    data.card_no = card_no;
                                    data.name = name;
                                    data.phone = phone;
                                    data.sn = sn;
                                    data.market = market;
                                    data.mail = mail;
                                    data.new_sn = new_sn;
                                    data.new_market = new_market;

                                    //this._DB.product_price.Add(data);
                                    this._DB.member_real.Add(data);
                                    this._DB.SaveChanges();
                                }


                            }

                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功！";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }

            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }


            return RedirectToAction("RealM", "NwMember");
        }
        #endregion

    }
}
