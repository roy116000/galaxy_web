    public class NwInvoiceController : _BaseController
    {
        //
        // GET: /newweb/NwNews/

        private static double gRound(double value, int digit = 0)
        {
            return Math.Round(value, digit, MidpointRounding.AwayFromZero);
        }

        //無條件捨去
        private static double gFloor(double value)
        {
            return Math.Floor(value);
        }

        public class Invoice 
        {
            public int order_id { get; set; }
            public string web_name { get; set; }
            public string item_name { get; set; }
            public DateTime? finish_datetime { get; set; }
            public string order_name { get; set; }
            public string send_name { get; set; }
            public int total { get; set; }
            public double bouns { get; set; }

        }

        #region"發票詳細明細(當月日期, 藥局ID)-公式"

        public static List<order_data> Invoice_order(DateTime nD, int drug_id)
        {
            _dbContext db = new _dbContext();

            DateTime sD = nD.AddMonths(-1); //上個月

            var Maori = db.partner_maori.FirstOrDefault(); //分潤表
            double Maori_Drug = (double)Maori.drugstore_num / 100; //藥局分潤


            var data = new List<order_data> { }; //儲存訂單
           
            var Drug = db.drugstore_data.Where(m => m.drugstore_id == drug_id).FirstOrDefault(); //藥局資料


            var M = (from a in db.partner_money.Where(m => m.id == Drug.admin_id && (m.money_date >= sD && m.money_date < nD) && m.order_id != 0)
                     join b in db.order_data on a.order_id equals b.order_id into mm
                     join c in db.order_sub on a.order_id equals c.order_id into mm2
                     join d in db.product_data on mm2.FirstOrDefault().product_id equals d.product_id into mm3
                     join e in db.solt_data on a.order_id equals e.order_id into mm4
                     select new Invoice()
                     {
                         order_id = a.order_id,
                         bouns = a.money,
                         order_name = mm.FirstOrDefault().order_name,
                         send_name = mm.FirstOrDefault().send_name,
                         finish_datetime = mm.FirstOrDefault().finish_datetime,
                         item_name = mm3.FirstOrDefault().item_name,
                         web_name = mm3.FirstOrDefault().web_name,
                         total = mm.Where(m => m.order_name.IndexOf("XX") == -1).FirstOrDefault() != null ? mm.Where(m => m.order_name.IndexOf("XX") == -1).FirstOrDefault().total - mm.Where(m => m.order_name.IndexOf("XX") == -1).FirstOrDefault().bonus - (mm4.FirstOrDefault() != null ? mm4.FirstOrDefault().prize : 0) : 0
                     }).ToList().Select(m => new order_data()
                     {
                         order_id = m.order_id,
                         cost_total = m.bouns,
                         order_name = m.order_name,
                         send_name = m.send_name,
                         finish_datetime = m.finish_datetime,
                         pro_web_name = m.web_name,
                         pro_item_name = m.item_name,
                         total = m.total
                     }).ToList();
                                    
                   

            int id = 0;
            M.ForEach(m => { 

                if (m.order_id == id) 
                {
                    m.total = 0;
                };

                id = m.order_id; 
            });

            data.AddRange(M);
                                  

            return data;
        }

        #endregion

        #region"計算當月發票"

        public ActionResult Output(DateTime? yymm)
        {
            string msg = "";
            if (yymm == null) { msg = "請填寫匯出日期"; TempData["jgrowl"] = msg; return RedirectToAction("List", "NwInvoice"); } //沒填日期時
            string cler_date_YYMM = yymm.Value.ToString("yyyy/MM" + "月"); //結算月份
            string yyyy = yymm.Value.ToString("yyyy"); //年
            int MM = Convert.ToInt32(yymm.Value.ToString("MM")); //月份

            DateTime eD = new DateTime(yymm.Value.AddMinutes(-1).Year, yymm.Value.AddMinutes(-1).Month, 21);//當月 (3月是產2月的發票)
            //DateTime eD = (DateTime)yymm.Value.AddDays(-10); //當月 (3月是產2月的發票)
            DateTime sD = eD.AddMonths(-1); //上個月

            //當月---(商品出貨日+10天、啟用、付錢、沒退貨問題)
            var Drug_s = this._DB.order_data.Where(m => m.back_flag == 0 && m.flag >=2 && m.visible && (m.goods_datetime >= sD && m.goods_datetime < eD)).OrderBy(m => m.order_id).ToList();
            foreach (var item in Drug_s) 
            {
                if (item.send_drug_id != 0) //有寄送藥局的
                {
                    item.drugstore_id = item.send_drug_id;
                }
            }

            var Drug = Drug_s.Select(m => m.drugstore_id).Distinct().ToArray(); //有產出的藥局
            if (Drug.Count() == 0) { msg = "此月份無任何銷售，故無發票產出"; TempData["jgrowl"] = msg; return RedirectToAction("List", "NwInvoice"); } //沒有的話
            
            foreach (var item in Drug)
            {

                //撈發票詳細明細(當月、藥局ID)
                var in_data = Invoice_order((DateTime)yymm, item);

                //銷售金額
                int price_total = in_data.Select(m2 => m2.total).DefaultIfEmpty(0).Sum();
                //銷售分潤
                int aa = (int)in_data.Select(m2 => m2.cost_total).DefaultIfEmpty(0).Sum();
                int price_cost = (int)gFloor(in_data.Select(m2 => m2.cost_total).DefaultIfEmpty(0).Sum());
                //需匯款金額
                int price_pay = price_total - price_cost;
                //if (price_pay != 0)
                //{
                    var Drug_data = this._DB.drugstore_data.Where(m => m.drugstore_id == item).FirstOrDefault();
                    var Invo_yes = this._DB.order_invoice2.Where(m => m.drug_uid == Drug_data.uid && m.clearing_date == cler_date_YYMM).FirstOrDefault();                     
                    if (Invo_yes != null)
                    {
                        //如果有寄送日期，就不能更改
                        if (Invo_yes.invoice_datetime == null)
                        {
                            //結算日期
                            Invo_yes.order_datetime = yymm;
                            //銷售金額
                            Invo_yes.price_total = price_total;
                            //銷售分潤
                            Invo_yes.price_cost = price_cost;
                            //匯款金額
                            Invo_yes.price_pay = price_pay;

                            Invo_yes.change_user = User.Identity.Name;
                            Invo_yes.change_datetime = DateTime.Now;
                        }

                    }
                    else
                    {
                        order_invoice2 data2 = new order_invoice2();

                        //藥局帳號
                        data2.drug_uid = Drug_data.uid;
                        //藥局名字
                        data2.name = Drug_data.name;
                        //結算月份
                        data2.clearing_date = cler_date_YYMM;
                        //結算日期
                        data2.order_datetime = yymm;
                        //銷售金額
                        data2.price_total = price_total;
                        //銷售分潤
                        data2.price_cost = price_cost;
                        //匯款金額
                        data2.price_pay = price_pay;

                        data2.create_user = User.Identity.Name;
                        data2.create_datetime = DateTime.Now;
                        _DB.order_invoice2.Add(data2);
                    //}                                                        
                }
                    this._DB.SaveChanges();
            }
                msg = cler_date_YYMM + "-發票產出成功";
          
            TempData["jgrowl"] = msg;
            return RedirectToAction("List", "NwInvoice", new { kw_time = yymm });

        }

         #endregion

        #region "開藥局發票列表"

        public IPagedList Public_Invo(int currentPageIndex, IQueryable<order_invoice2> Linq, string kw, DateTime? kw_time)
        {

            #region"搜尋"

            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.name.Contains(kw));
                ViewBag.kw = kw;
            }
            if (kw_time.HasValue)
            {
                string time = kw_time.Value.ToString("yyyy/MM月");

                Linq = Linq.Where(m => m.clearing_date == time);

                ViewBag.yymm = kw_time.Value.ToString("yyyy.MM");
            }


            #endregion

            IPagedList data = Linq.OrderByDescending(m => m.price_cost).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            //if (data.TotalItemCount == 0) { TempData["jgrowl"] = "無發票"; };

            #region"傳至前台"

            var Time = this._DB.order_invoice_time.ToList(); //發票設定日期
            ViewData["Time"] = Time;

            #endregion

            ViewBag.jgrowl = TempData["jgrowl"];

            return data;
        }

        public ActionResult List(int? page, string kw, DateTime? kw_time)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_invoice2.Where(m => m.flag < 2); //撈出未完成的發票

            IPagedList data = Public_Invo(currentPageIndex, Linq, kw, kw_time);

            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }
        }

        public ActionResult Edit(int id)
        {
            var data = this._DB.order_invoice2.Find(id);
            var Drug = this._DB.drugstore_data.Where(m => m.uid == data.drug_uid).FirstOrDefault();

            //var indata = this._DB.order_invoice2.Find(data.invoice_id);
            ViewData["invoice_data"] = data;

            DateTime date = Convert.ToDateTime(data.clearing_date); //發票結算月份
            //DateTime sD = new DateTime(date.AddMonths(-1).Year, date.AddMonths(-1).Month, 1); 
            DateTime nD = new DateTime(date.Year, date.Month, 1); //當月
            //ViewBag.Datetime = sD.ToString("yyyy/MM/dd") + " ～ " + eD.ToString("yyyy/MM/dd");
          
            //撈發票詳細明細
            var in_data = Invoice_order(nD, Drug.drugstore_id);
            ViewData["in_data"] = in_data;

            #region"下拉選單"
            List<ListItem> ListItems = new List<ListItem>();

            //發票種類     藥局資料沒有值就預設三聯,有值就設預設   有修改就依修改顯示  (以內容搜尋求"0","1")
            string type = data.invoice_type == null ? Array.IndexOf(NW.Invoice_type, Drug.invoice_type == null ? "三聯" : Drug.invoice_type).ToString() : Array.IndexOf(NW.Invoice_type, data.invoice_type).ToString();
            //ListItems.Add(new ListItem("", "請選擇", false));
            ListItems.AddRange(NW.sList(NW.Invoice_type, type));
            ViewData["invoice_type"] = ListItems;
            #endregion


            if (data.invoice_datetime == null)
            {
                //稅籍單位
                data.taxes = Drug.taxes;
                //統一編號
                data.uniform_numbers = Drug.uniform_numbers;
                //發票抬頭
                data.invoice_title = Drug.invoice_title;
                //寄送地址
                data.invoice_address = Drug.invoice_address;
            }
                     
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult EditSave(order_invoice2 order_invoice2)
        {
            var data = this._DB.order_invoice2.Find(order_invoice2.invoice_id);

            var mdata = this._DB.member_data.Find(data.invoice_id);

            int type = Convert.ToInt32(order_invoice2.invoice_type);
            
            data.invoice_type = NW.Invoice_type[type];

            data.taxes = order_invoice2.taxes;
            data.invoice_title = order_invoice2.invoice_title;
            data.uniform_numbers = order_invoice2.uniform_numbers;
            data.invoice_address = order_invoice2.invoice_address;
            data.invoice_no = order_invoice2.invoice_no;
            data.invoice_datetime = order_invoice2.invoice_datetime;
            data.pay_datetime = order_invoice2.pay_datetime;
            data.return_datetime = order_invoice2.return_datetime;
         
            this._DB.SaveChanges();
            
            if (data.return_datetime != null) { data.flag = 2; this._DB.SaveChanges(); }
            
            TempData["jgrowl"] = "發票修改成功";

            ViewBag.jgrowl = TempData["jgrowl"];

            return RedirectToAction("Edit", new { @id = order_invoice2.invoice_id });
        }

