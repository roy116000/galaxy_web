        #endregion

        #region"設定發票時間"

        public ActionResult Time(DateTime? yymm, string year)
        {
            //年分
            string yyyy = "";
            if (yymm != null)
            {
                yyyy = yymm.Value.ToString("yyyy");
                ViewBag.yyyy = yyyy;
            }
            else {
                ViewBag.yyyy = year;
            }
           
            var data = this._DB.order_invoice_time.Where(m => m.year == yyyy || m.year == year).ToList();
            if (data.Count == 0 && !string.IsNullOrEmpty(yyyy))
                {

                    
                    for (int a = 1; a <= 12; a++)
                    {
                        order_invoice_time data2 = new order_invoice_time { };

                        data2.year = yyyy;
                        data2.month = a;
                        data2.day = 10;

                        data2.create_user = User.Identity.Name;
                        data2.create_datetime = DateTime.Now;

                        this._DB.order_invoice_time.Add(data2);
                        this._DB.SaveChanges();

                        data.Add(data2);
                    }                                                       
                }
          
            return View(data);
        }

        public ActionResult TimeSave(List<int> item_day, string year)
        {
            var data = this._DB.order_invoice_time.Where(m => m.year == year).ToList();
            if (data.Count != 0)
            {
                int a = 0;
                foreach (var item in data)
                {
                    item.day = item_day[a];
                    item.change_user = User.Identity.Name;
                    item.change_datetime = DateTime.Now;
                    this._DB.SaveChanges();

                    a++;
                    
                }           
            }

           return RedirectToAction("Time", new { year = year });
          
        }
        #endregion

        public static order_invoice2 order_invoice2(string type, string kw_name, DateTime? kw_time)
        {
            _dbContext db = new _dbContext();

            //目前有完成的所有發票
            var Linq = db.order_invoice2.Where(m => m.invoice_id > 0);

            switch (type)
            {
                case "2":
                    Linq = Linq.Where(m => m.flag > 0);
                    break;

            }

            if (!string.IsNullOrEmpty(kw_name))
            {
                Linq = Linq.Where(m => m.name.Contains(kw_name));
            }
            if (kw_time.HasValue)
            {
                string time = kw_time.Value.ToString("yyyy/MM月");
                Linq = Linq.Where(m => m.clearing_date == time);
            }

            return new order_invoice2();
        }
    }
