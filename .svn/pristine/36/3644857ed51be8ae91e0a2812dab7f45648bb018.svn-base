        //匯出發票明細
        [HttpPost]
        public ActionResult Export(int id)
        {
            string value = "";
            var data = this._DB.order_invoice2.Where(m => m.invoice_id == id).FirstOrDefault();
            if (data != null)
            {
                var Drug = this._DB.drugstore_data.Where(m => m.uid == data.drug_uid).FirstOrDefault(); //藥局資訊
                if(Drug != null)
                {

                    DateTime nD = new DateTime(data.order_datetime.Value.Year, data.order_datetime.Value.Month, 1); //當月

                    //DateTime sD = new DateTime(eD.AddMonths(-1).Year, eD.AddMonths(-1).Month, 13); //上個月

                string[] cols = "商品交貨日期,訂單編號,訂購方,收件方,商品名稱,銷貨金額,銷貨分潤".Split(',');

                var data2 = Invoice_order(nD, Drug.drugstore_id);

                XLWorkbook workbook = new XLWorkbook();
                var sheet = workbook.Worksheets.Add("發票明細");
                int colIdx = 1;
                int rowIdx = 2;

                //標頭
                foreach (string colName in cols)
                {
                    sheet.Cell(1, colIdx++).Value = colName;
                }

                //純文字格式
                string p = "'";

                //內容
                foreach (var item in data2)
                {
                    var data_sub = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                    if(data_sub != null)
                    {
                        List<string> data_content = new List<string>();
                        data_content.Add(item.finish_datetime != null ? item.finish_datetime.Value.ToString("yyyy/MM/dd") : "");
                        data_content.Add(item.order_id.ToString());
                        data_content.Add(item.order_name);
                        data_content.Add(item.send_name);
                        data_content.Add(data_sub.item_name);
                        data_content.Add(item.total.ToString("N0"));
                        data_content.Add(item.cost_total.ToString("N0"));
                        data_content.Add(item.back_datetime != null ? item.back_datetime.Value.ToString("yyyy/MM/dd") : "");

                        int num = 1;
                        foreach (var item2 in data_content)
                        {
                            sheet.Cell(rowIdx, num).Value = item2;
                            num++;
                        }
                        rowIdx++;
                    }

                }

                int total = data2.DefaultIfEmpty().Sum(m => m.total);
                double cost_total = gFloor(data2.DefaultIfEmpty().Sum(m => m.cost_total));
                sheet.Cell(rowIdx + 1, 6).Value = "銷貨金額合計";
                sheet.Cell(rowIdx + 2, 6).Value = total.ToString("N0");
                sheet.Cell(rowIdx + 1, 7).Value = "銷貨分潤合計";
                sheet.Cell(rowIdx + 2, 7).Value = cost_total.ToString("N0");
                sheet.Cell(rowIdx + 1, 8).Value = "匯款金額";
                sheet.Cell(rowIdx + 2, 8).Value = (total - cost_total).ToString("N0");

                //自動伸縮欄寬
                for (int i = 1; i <= cols.Length; i++)
                {
                    sheet.Column(i).AdjustToContents();
                }

                value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

                workbook.SaveAs(value);
                workbook.Dispose();

                }
            }
            return File(value, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".xlsx"));
           
        }

        //匯入發票
        [HttpPost]
        public ActionResult InvoiceAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {
                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row).GetCell(0) != null) // 驗證是不是空白列
                        {
                            string oid = sheet.GetRow(row).GetCell(0).ToString();
                            string invoice_no = sheet.GetRow(row).GetCell(1).ToString();

                            int order_id = Convert.ToInt32(oid);
                            var data = this._DB.order_data.Where(m => m.order_id == order_id).FirstOrDefault();

                            if (!string.IsNullOrEmpty(invoice_no))
                            {
                                data.invoice_no = invoice_no;
                                data.invoice_datetime = DateTime.Now;
                                data.flag = 5;
                                this._DB.SaveChanges();
                            }

                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("InvoiceList");
        }

        private string Export2(string id)
        {
            string value = "";
            string[] cols = "".Split(',');
            List<order_data> data;

            //DateTime eD = DateTime.Today.AddDays(-10);
            cols = "訂單單號,發票號碼,商品名稱,稅別,統一編號,公司名稱,發票格式,銷售額,稅額,總額".Split(',');

            DateTime eD = DateTime.Today;

            List<int> oid = new List<int> { };
            var Linq1 = this._DB.order_data.Where(m => m.visible == true && m.flag == 2 && m.goods_datetime != null && m.back_flag == null);

            int view_day = 10;
            foreach (var item in Linq1)
            {
                TimeSpan Total = eD.Subtract((DateTime)item.goods_datetime); //日期相減

                if (Total.Days > view_day)
                {
                    oid.Add(item.order_id);
                }
            }

            Linq1 = Linq1.Where(m => oid.Contains(m.order_id));

            sys_admin_data admin = NW.admin(User.Identity.Name);
            if (admin.power_id > 2) { Linq1 = Linq1.Where(m => m.company_id == admin.company_id); }

            //測試用
            //var Linq1 = this._DB.order_data.Where(m => m.order_id>0);
            if (!string.IsNullOrEmpty(id))
            {
                //文字陣列轉數字陣列
                int[] arrID = id.Split(',').Select((string s) => { int i; int.TryParse(s, out i); return i; }).ToArray();
                Linq1 = Linq1.Where(m => arrID.Contains(m.order_id));
            }
            Linq1 = Linq1.OrderBy(m => m.order_id);
            data = Linq1.ToList();

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("待開發票列表");
            int colIdx = 1;
            int rowIdx = 2;


            foreach (string colName in cols)
            {
                if (colIdx == 8)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.DodgerBlue;
                }
                else if (colIdx == 9)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.PaleGreen;
                }
                else if (colIdx == 10)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.CandyPink;
                }
                else
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.PastelYellow;
                }

                sheet.Cell(1, colIdx++).Value = colName;
            }

            string p = "'";
            double money = 0;
            foreach (var item in data)
            {
                sheet.Cell(rowIdx, 1).Value = p + item.order_id.ToString(); //訂單單號
                sheet.Cell(rowIdx, 2).Value = p;                           //發票號碼

                //無統編，不需計算稅額
                if (string.IsNullOrEmpty(item.inv_sn))
                {

                    sheet.Cell(rowIdx, 5).Value = p;
                    sheet.Cell(rowIdx, 6).Value = p;
                    sheet.Cell(rowIdx, 7).Value = p + "2聯";
                    sheet.Cell(rowIdx, 8).Value = p + (item.total - item.freight).ToString("N0");
                    sheet.Cell(rowIdx, 9).Value = p + "0";
                    sheet.Cell(rowIdx, 10).Value = p + (item.total - item.freight).ToString("N0");

                    foreach (var subitem in item.order_sub.OrderBy(m => m.sub_id))
                    {
                        if (!string.IsNullOrEmpty(subitem.style_name))
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem.product_data.item_name + "-" + subitem.style_name;
                        }
                        else
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem.product_data.item_name;
                        }

                        switch (subitem.product_data.tax_flag)
                        {
                            case 0:
                                sheet.Cell(rowIdx, 4).Value = p + "應稅";           //稅別
                                break;
                            case 1:
                                sheet.Cell(rowIdx, 4).Value = p + "免稅";           //稅別
                                break;
                        }

                        if (subitem.product_id == 101 || subitem.product_id == 102)
                        {

                            sheet.Cell(rowIdx, 8).Value = p + item.bonus.ToString("N0");
                            sheet.Cell(rowIdx, 9).Value = p + "0";
                            sheet.Cell(rowIdx, 10).Value = p + item.bonus.ToString("N0");
                        }

                        rowIdx++;
                    }

                    if (item.freight != 0)
                    {

                        sheet.Cell(rowIdx, 3).Value = p + "運費";
                        sheet.Cell(rowIdx, 4).Value = p + "應稅";
                        sheet.Cell(rowIdx, 8).Value = p + item.freight.ToString("N0");
                        sheet.Cell(rowIdx, 9).Value = p + "0";
                        sheet.Cell(rowIdx, 10).Value = p + item.freight.ToString("N0");
                        rowIdx++;
                    }

                }
                else
                {
                    money = item.total - item.freight;
                    money = Math.Round(money / 1.05, MidpointRounding.AwayFromZero);

                    sheet.Cell(rowIdx, 5).Value = p + item.inv_sn;
                    sheet.Cell(rowIdx, 6).Value = p + item.inv_title;
                    sheet.Cell(rowIdx, 7).Value = p + "3聯";
                    sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                    sheet.Cell(rowIdx, 9).Value = p + (item.total - item.freight - money).ToString("N0");
                    sheet.Cell(rowIdx, 10).Value = p + (item.total - item.freight).ToString("N0");


                    foreach (var subitem2 in item.order_sub.OrderBy(m => m.sub_id))
                    {
                        if (!string.IsNullOrEmpty(subitem2.style_name))
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem2.product_data.item_name + "-" + subitem2.style_name;
                        }
                        else
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem2.product_data.item_name;
                        }

                        switch (subitem2.product_data.tax_flag)
                        {
                            case 0:
                                sheet.Cell(rowIdx, 4).Value = p + "應稅";           //稅別
                                break;
                            case 1:
                                sheet.Cell(rowIdx, 4).Value = p + "免稅";           //稅別
                                break;
                        }

                        if (subitem2.product_id == 101 || subitem2.product_id == 102)
                        {
                            money = Math.Round(item.bonus / 1.05, MidpointRounding.AwayFromZero);

                            sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                            sheet.Cell(rowIdx, 9).Value = p + (item.bonus - money).ToString("N0");
                            sheet.Cell(rowIdx, 10).Value = p + item.bonus.ToString("N0");
                        }

                        rowIdx++;
                    }

                    if (item.freight != 0)
                    {

                        money = Math.Round(item.freight / 1.05, MidpointRounding.AwayFromZero);

                        sheet.Cell(rowIdx, 3).Value = p + "運費";
                        sheet.Cell(rowIdx, 4).Value = p + "應稅";
                        sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                        sheet.Cell(rowIdx, 9).Value = p + (item.freight - money).ToString("N0");
                        sheet.Cell(rowIdx, 10).Value = p + item.freight.ToString("N0");

                        rowIdx++;
                    }

                }

            }

            sheet.Cell(rowIdx, 9).Style.Fill.BackgroundColor = XLColor.CoralPink;
            sheet.Cell(rowIdx, 10).Style.Fill.BackgroundColor = XLColor.CoralPink;
            sheet.Cell(rowIdx, 9).Value = p + "總額";
            sheet.Cell(rowIdx, 10).Value = p + data.Sum(m => m.total - m.bonus).ToString("N0");

            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }


            value = Server.MapPath("~/Content/files/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }

        #endregion

        #region "開藥局發票列表 - 完成"

        public ActionResult FinishList(int? page, string kw, DateTime? kw_time)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_invoice2.Where(m => m.flag > 0); //目前有完成的所有發票

            IPagedList data = Public_Invo(currentPageIndex, Linq, kw, kw_time);

            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }
        }

        public ActionResult FinishEdit(int id)
        {
            var data = this._DB.order_invoice2.Find(id);
            var Drug = this._DB.drugstore_data.Where(m => m.uid == data.drug_uid).FirstOrDefault();

            DateTime date = Convert.ToDateTime(data.clearing_date);
            DateTime sD = new DateTime(date.AddMonths(-1).Year, date.AddMonths(-1).Month, 20);
            DateTime eD = new DateTime(date.Year, date.Month, 19);

            //撈發票詳細明細
            var in_data = Invoice_order( eD.AddDays(-6), Drug.drugstore_id);
            ViewData["in_data"] = in_data;

            var mdata = this._DB.member_data.Find(data.invoice_id);
            ViewData["member_data"] = mdata;

            ViewBag.jgrowl = TempData["jgrowl"];


            return View(data);
        }

        public ActionResult FinishEditSave(order_invoice2 order_invoice2)
        {
            var data = this._DB.order_invoice2.Find(order_invoice2.invoice_id);

            var mdata = this._DB.member_data.Find(data.invoice_id);

            data.taxes = order_invoice2.taxes;
            data.uniform_numbers = order_invoice2.uniform_numbers;
            data.invoice_title = order_invoice2.invoice_title;
            data.invoice_address = order_invoice2.invoice_address;
            
            data.invoice_datetime = order_invoice2.invoice_datetime;
            data.return_datetime = order_invoice2.return_datetime;

            this._DB.SaveChanges();

            TempData["jgrowl"] = "發票修改成功";

            ViewBag.jgrowl = TempData["jgrowl"];


            return RedirectToAction("Edit", new { @id = order_invoice2.invoice_id });
        }

        //匯入發票
        [HttpPost]
        public ActionResult FinishAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {
                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row).GetCell(0) != null) // 驗證是不是空白列
                        {
                            string oid = sheet.GetRow(row).GetCell(0).ToString();
                            string invoice_no = sheet.GetRow(row).GetCell(1).ToString();

                            int order_id = Convert.ToInt32(oid);
                            var data = this._DB.order_data.Where(m => m.order_id == order_id).FirstOrDefault();

                            if (!string.IsNullOrEmpty(invoice_no))
                            {
                                data.invoice_no = invoice_no;
                                data.invoice_datetime = DateTime.Now;
                                data.flag = 5;
                                this._DB.SaveChanges();
                            }

                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("InvoiceList");
        }

