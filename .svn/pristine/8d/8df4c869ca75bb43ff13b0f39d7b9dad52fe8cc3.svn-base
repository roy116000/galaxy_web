@using MvcPaging;
@model IPagedList<h365_web.Models.zz_group>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
    }

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="con1 width4" />
            <col class="con0" />
            <col class="con0 width8" />
            <col class="con1 width10" />
            <col class="con1 width10" />
        </colgroup>
        <thead>
            <tr>
                <th class="aligncenter">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th>@Html.DisplayNameFor(model => model.First().title) </th>
                <th>@Html.DisplayNameFor(model => model.First().inx) </th>
                <th>@Html.DisplayNameFor(model => model.First().visible)</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
               
                <tr class="unread">
                    <td class="aligncenter">v
                        <input type="checkbox" name="block_id" class="block_check" value="@item.group_id" /></td>
                    <td>@Html.DisplayFor(modelItem => item.title)</td>
                    <td class="right">@Html.DisplayFor(modelItem => item.inx)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.visible)</td>
                    <td>@Html.ActionLink("編輯", action.Replace("List","Edit").Replace("_ajax",""), new { id = item.group_id }, new { @class = "title" })</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination pagination-centered">
       
	@Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount, new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform"}).Options(o => o.Action("TmpList_ajax").DisplayTemplate("BootstrapPagination")
			.MaxNrOfPages(10)
			.AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw))
    </div>
 
</div>
<!--pagination-->
