@model h365_web.Models.education_group
@{
    string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}
<div class="maincontent">
    <div class="contentinner">

        @using (Html.BeginForm(action.Replace("Add", "").Replace("Edit", "") + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.group_id)
            <div class="widgetcontent">
                <h4 class="widgettitle">衛教分類資料</h4>

                @Html.EditorFor(model => model.name)

                @Html.EditorFor(m => m.img)

                @Html.EditorFor(model => model.inx)

                @Html.EditorFor(model => model.visible)

                <div class="control-group">
                    <div class="stdformbutton">
                        <button class="btn btn-primary">儲存</button>
                        <button type="button" onclick="location.href = '@Url.Action(action.Replace("Add", "List").Replace("Edit", "List"))'" class="btn">回列表</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            rules: {
                name: "required"
            },
            messages: {
                name: "分類標題，必需填寫！"
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').addClass('error');
            }
        });

    })
</script>
