@using h365_web.Models;
@model MvcPaging.IPagedList<h365_web.Models.drugstore_data>
@{
    //string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
   
}

<script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
@Html.ValidationSummary(true)
<script type="text/javascript">
    function cbHandel(flag) {
        if ($("input[name='block_id']:checked").length == 0) { alert('請至少選擇一項'); return false; }
        var name = '刪除';
        switch (flag) { case 1: name = "啟用"; break; case 2: name = "作廢"; break; }
        if (confirm('確定要' + name + '？')) {
            var arrVal = new Array();
            $("input[name='block_id']:checked").each(function (i) {
                arrVal[i] = this.value;
            });
        }
        $('#cb_flag').val(flag);
        $('#cb_id').val(arrVal.toString());
        $('#frmCheckbox').submit();
    }
</script>

@using (Html.BeginForm(action + "Del", controller, FormMethod.Post, new { @id = "frmCheckbox" }))
{
    <input type="hidden" id="cb_flag" name="cb_flag" value="0" />
    <input type="hidden" id="cb_id" name="cb_id" value="" />
}

<!--pagetitle-->
<div class="maincontent">
    <div class="contentinner">
        <ul class="nav nav-pills">
        </ul>

        <!--widgetsource-->
        <div id="mail">
            <div class="msghead">
                @using (Html.BeginRouteForm("", FormMethod.Get))
                {
                    <div>
                        報表日期：
                    <input type="text" value="@ViewBag.start_date" name="start_date" id="start_date" class="span2">
                        ～
                    <input type="text" value="@ViewBag.end_date" name="end_date" id="end_date" class="span2">

                        @*付款方式：@Html.SelectList(List_pay_id, ListItems_pay_id, htmlAttributes)*@
                    </div>
                    <div style="height: 1em;"></div>
                    <div>
                        @*訂單狀態：@Html.SelectList(List_flag, ListItems_flag, htmlAttributes)*@
                        @*付款狀態：@Html.SelectList(List_pay_visible, ListItems_pay_visible, htmlAttributes)&emsp; *@
                        藥局資訊：<input type="text" id="kw" name="kw" class="filekeyword" placeholder="搜尋藥局名稱或電話" value="@ViewBag.kw" />
                    </div>
                    <ul class="msghead_menu">
                        <li>
                            <div class="btn-group">
                                <span class="btn dropdown-toggle" data-toggle="dropdown"><span class="icon-check"></span>選擇設定<span class="caret"></span></span>
                                <ul class="dropdown-menu">
                                    <li><a onclick="cbHandel(2);" href="#"><span class="icon-ban-circle"></span>作廢</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="right newfilebtn">
                            <input type="submit" value="查詢" class="btn btn-primary" /></li>
                    </ul>
                }
                <span class="clearall"></span>
            </div>
            <!--msghead-->
            <br />
        </div>
        <!--#chat-->

        @Html.Partial(action + "_ajax", Model)
        <!--list-->
    </div>
    <!--contentinner-->
</div>
<script type="text/javascript">$(function () { $('#start_date').datepicker(); $('#end_date').datepicker(); })</script>
