        #region "訂單列表"
        public ActionResult List(string kw, int? flag, bool? pay_visible, DateTime? start_date, DateTime? end_date, int? pay_id)
        {
            int currentPageIndex = 0;

            //Export("303,304,305");

            var Linq = this._DB.order_data2.Where(m => m.visible == true && m.pay_id == 4);


            foreach (var item in Linq.ToList())
            {
                var data22 = this._DB.pharmacist_data.Where(m => m.pharmacist_id == item.member_id).FirstOrDefault();
                string aa = data22.name;
                item.sn = aa;
            }

     


            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw));
            }

            if (flag.HasValue)
            {
                Linq = Linq.Where(m => m.flag == flag);
            }

            if (pay_visible.HasValue)
            {
                Linq = Linq.Where(m => m.pay_visible == pay_visible);
            }

            if (pay_id.HasValue)
            {
                Linq = Linq.Where(m => m.pay_id == pay_id);
            }

            if (!start_date.HasValue) { start_date = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); };
            if (!end_date.HasValue) { end_date = DateTime.Today; }

            DateTime linq_eD = end_date.Value.AddDays(1);

            Linq = Linq.Where(m => m.order_datetime >= start_date && m.order_datetime < linq_eD);

            Linq = Linq.OrderByDescending(m => m.order_id);




            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);
            //IPagedList data = Linq.ToPagedList(currentPageIndex, 2);

            List<ListItem> ListItems_falg = new List<ListItem> { };
            ListItems_falg.Add(new ListItem("", "全部", false));
            for (int i = 0; i <= 5; i++)
            {
                ListItems_falg.Add(new ListItem(i.ToString(), NW.flagName(i), flag.HasValue ? flag.Value == i : false));
            }
            ViewData["flag"] = ListItems_falg;


            List<ListItem> ListItems_pay_visible = new List<ListItem> { };
            ListItems_pay_visible.Add(new ListItem("", "全部", false));
            ListItems_pay_visible.Add(new ListItem("false", "未付款", pay_visible.HasValue ? pay_visible.Value : false));
            ListItems_pay_visible.Add(new ListItem("true", "已付款", pay_visible.HasValue ? pay_visible.Value : false));
            ViewData["pay_visible"] = ListItems_pay_visible;

            List<ListItem> ListItems_pay_id = new List<ListItem> { };
            ListItems_pay_id.Add(new ListItem("", "全部", false));
            ListItems_pay_id.Add(new ListItem("3", "信用卡", pay_id.HasValue ? pay_id == 3 : false));
            ListItems_pay_id.Add(new ListItem("4", "貨到付款", pay_id.HasValue ? pay_id == 4 : false));
            
            ViewData["pay_id"] = ListItems_pay_id;


            ViewBag.kw = kw;
            ViewBag.vflag = flag;
            ViewBag.vpay_visible = pay_visible;
            ViewBag.start_date = start_date.Value.ToString("yyyy/MM/dd"); ViewBag.end_date = end_date.Value.ToString("yyyy/MM/dd");
            ViewBag.vpay_id = pay_id;

            var data2 = Linq.ToList();
            int total = 0;
            foreach (var item in data2)
            {
                total += item.order_sub2.Sum(m => m.num * m.price) + item.freight;
            }
            ViewBag.total = "總筆數： " + data.TotalItemCount.ToString() + " 筆、總金額：" + total.ToString("N0") + " 元";

            ViewBag.jgrowl = TempData["jgrowl"];

            var marData = this._DB.news4_data.Where(m => m.visible).ToList();
            ViewData["marData"] = marData;



            return View(data);
        }

        public ActionResult List_ajax(string kw, int? flag, bool? pay_visible, DateTime? start_date, DateTime? end_date, int? page, int? pay_id)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_data2.Where(m => m.visible == true && m.pay_id == 4);

            foreach (var item in Linq.ToList())
            {
                var data22 = this._DB.sys_admin_data.Where(m => m.admin_id == item.member_id).FirstOrDefault();
                string aa = data22.name;
                item.sn = aa;
            }



            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw));
            }

            if (flag.HasValue)
            {
                Linq = Linq.Where(m => m.flag == flag);
            }

            if (pay_visible.HasValue)
            {
                Linq = Linq.Where(m => m.pay_visible == pay_visible);
            }

            if (pay_id.HasValue)
            {
                Linq = Linq.Where(m => m.pay_id == pay_id);
            }

            if (!start_date.HasValue) { start_date = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); };
            if (!end_date.HasValue) { end_date = DateTime.Today; }

            Linq = Linq.Where(m => m.order_datetime >= start_date && m.order_datetime <= end_date);

            Linq = Linq.OrderByDescending(m => m.order_id);

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);
            //IPagedList data = Linq.ToPagedList(currentPageIndex, 2);

            List<ListItem> ListItems_falg = new List<ListItem> { };
            ListItems_falg.Add(new ListItem("", "全部", false));
            for (int i = 0; i <= 5; i++)
            {
                ListItems_falg.Add(new ListItem(i.ToString(), NW.flagName(i), flag.HasValue ? flag.Value == i : false));
            }
            ViewData["flag"] = ListItems_falg;


            List<ListItem> ListItems_pay_visible = new List<ListItem> { };
            ListItems_pay_visible.Add(new ListItem("", "全部", false));
            ListItems_pay_visible.Add(new ListItem("false", "未付款", pay_visible.HasValue ? pay_visible.Value : false));
            ListItems_pay_visible.Add(new ListItem("true", "已付款", pay_visible.HasValue ? pay_visible.Value : false));
            ViewData["pay_visible"] = ListItems_pay_visible;


            ViewBag.kw = kw;
            ViewBag.vflag = flag;
            ViewBag.vpay_visible = pay_visible;
            ViewBag.start_date = start_date.Value.ToString("yyyy/MM/dd"); ViewBag.end_date = end_date.Value.ToString("yyyy/MM/dd");
            ViewBag.vpay_id = pay_id;

            var marData = this._DB.news4_data.Where(m => m.visible).ToList();
            ViewData["marData"] = marData;

            var data2 = Linq.ToList();
            int total = 0;
            foreach (var item in data2)
            {
                total += item.order_sub2.Sum(m => m.num * m.price) + item.freight;
            }
            ViewBag.total = "總筆數： " + data.TotalItemCount.ToString() + " 筆、總金額：" + total.ToString("N0") + " 元";
            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult Edit(int id)
        {
            var data = this._DB.order_data2.Find(id);

            var mdata = this._DB.pharmacist_data.Find(data.member_id);
            ViewData["sys_admin_data"] = mdata;

            var pdata = this._DB.order_pay2.Where(m => m.pay_visible == true && m.pay_id == 4).OrderBy(m => m.pay_id).ToList();
            List<ListItem> ListItems_pay_id = new List<ListItem> { };
            //ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in pdata)
            {
                ListItems_pay_id.Add(new ListItem(item.pay_id.ToString(), item.pay_name, item.pay_id == data.pay_id));
            }
            ViewData["pay_id"] = ListItems_pay_id;

            List<ListItem> ListItems_pay_visible = new List<ListItem> { };
            ListItems_pay_visible.Add(new ListItem("false", "未付款", data.pay_visible));
            ListItems_pay_visible.Add(new ListItem("true", "已付款", data.pay_visible));
            ViewData["pay_visible"] = ListItems_pay_visible;

            List<ListItem> ListItems_freight_name = new List<ListItem> { };
            ListItems_freight_name.Add(new ListItem("", "請選擇", false));
            foreach (var item in NW.FreightName)
            {
                ListItems_freight_name.Add(new ListItem(item, item, item == data.freight_name));
            }
            ViewData["freight_name"] = ListItems_freight_name;

            var fdata = this._DB.order_goods2.Where(m => m.order_id == id).OrderBy(m => m.goods_datetime).Select(m => new NW.order_goods_tmp { name = m.name, sn = m.sn, goods_datetime = m.goods_datetime }).Distinct().ToList();
            ViewData["order_goods_tmp"] = fdata;

            var cdata = this._DB.order_charge2.Where(m => m.order_id == id).OrderBy(m => m.freight_id).ToList();
            ViewData["order_charge_tmp"] = cdata;

            var idata = this._DB.order_druginvoice.Where(m => m.order_id == id).OrderBy(m => m.invoice_datetime).Select(m => new NW.order_invoice_tmp { invoice = m.invoice, tax = m.tax, invoice_datetime = m.invoice_datetime }).Distinct().ToList();
            ViewData["order_invoice_tmp"] = idata;
   

            #region"發票資訊"

            data.invoice_datetime = data.invoice_datetime == null ? DateTime.Now : data.invoice_datetime;

            #endregion

            ViewBag.jgrowl = TempData["jgrowl"];


            return View(data);
        }

        [HttpPost]
        public ActionResult EditSave(order_data2 order_data, int index)
        {
            var data = this._DB.order_data2.Find(order_data.order_id);

            switch (index)
            {
                case 0:    //金流資料
                    data.pay_id = order_data.pay_id;
                    data.pay_visible = order_data.pay_visible;
                    data.pay_note = order_data.pay_note;
                    if (order_data.pay_visible) { if (data.pay_datetime == null) { data.pay_datetime = DateTime.Now; } } else { data.pay_datetime = null; }
                    data.flag = order_data.pay_visible ? 1 : 0;
                    this._DB.SaveChanges();
                    TempData["jgrowl"] = "金流資訊儲存成功!!";
                    break;
                case 1:    //物流資料

                    if (data.pay_visible)
                    {

                        data.freight_name = order_data.freight_name;
                        data.freight_no = order_data.freight_no;
                        data.freight_datetime = order_data.freight_datetime;                    

                        if (!string.IsNullOrEmpty(data.freight_name)) { data.flag = 2; }

                        var checkfdata = this._DB.order_goods2.Where(m => m.order_id == data.order_id).ToList();
                        var subdata = this._DB.order_sub2.Where(m => m.order_id == data.order_id).ToList();

                        if (checkfdata.Count() == 0)
                        {
                            foreach (var item in subdata)
                            {
                                var fdata = new order_goods2();
                                fdata.order_id = item.order_id;
                                fdata.sn = data.freight_no;
                                fdata.sub_id = item.sub_id;
                                fdata.name = data.freight_name;
                                fdata.num = item.num;
                                fdata.goods_datetime = DateTime.Now;
                                fdata.create_user = "1";
                                fdata.create_datetime = DateTime.Now;
                                this._DB.order_goods2.Add(fdata);
                                this._DB.SaveChanges();

                            }
                        }
                        else {

                            foreach (var item in checkfdata)
                            {

                                item.name = data.freight_name;
                                item.sn = data.freight_no;
                                item.goods_datetime = DateTime.Now;
                                item.create_user = "1";
                                item.create_datetime = DateTime.Now;
                                this._DB.SaveChanges();
                            }

                        }


                        this._DB.SaveChanges();
                        TempData["jgrowl"] = "物流資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成，在處理物流資料";
                    }

                    break;
                case 3: //發票資料
                    if (data.pay_visible)
                    {
                        data.invoice_datetime = order_data.invoice_datetime;
                        data.invoice_no = order_data.invoice_no;
                        data.invoice_note = order_data.invoice_note;
                        if (!string.IsNullOrEmpty(data.invoice_no)) { data.flag = 5; }
                        this._DB.SaveChanges();
                        TempData["jgrowl"] = "發票資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成，在處理發票資料";
                    }

                    break;
            }

            return RedirectToAction("Edit", new { @id = order_data.order_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "作廢", "回復", "作廢" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update order_data2 set visible = 1 Where order_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update order_data2 set visible = 0 Where order_id in (" + cb_id + ")";
                    break;
                case 4: //停用 得來速訂單
                    sql = "Update order_data2 set visible = 0 Where order_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From order_data2 Where order_id in (" + cb_id + ")";
                    if (_DB.Database.ExecuteSqlCommand(sql) > 0)
                    {
                        sql = " Delete From order_sub2 Where order_id in (" + cb_id + ")";
                    }
                    else
                    {
                        sql = "";
                    }

                    break;
                case 3:

                    backExport(cb_id);
                    TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
                    return RedirectToAction("InvoiceList");
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";

            if (cb_flag == 4)
            {
                return RedirectToAction("Drivethru" + RouteData.Values["action"].ToString().Replace("Del", ""));
            }

            if (cb_flag != 2)
            {
                return RedirectToAction("Visible" + RouteData.Values["action"].ToString().Replace("Del", ""));
            }
            else
            {
                return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
            }
        }

        //回復成匯出訂單
        private void backExport(string cb_id)
        {
            if (!string.IsNullOrEmpty(cb_id))
            {
                string sql = "Update order_data2 set export_datetime=null, export_info='重置：" + DateTime.Now.ToString() + "' Where order_id in (" + cb_id + ")";
                _DB.Database.ExecuteSqlCommand(sql);
            }
        }

