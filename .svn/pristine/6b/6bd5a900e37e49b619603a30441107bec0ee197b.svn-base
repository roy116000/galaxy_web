        [HttpPost]
        public ActionResult GoodsListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "回復待出貨" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    //sql = "Update driver_data set visible = 1 Where driver_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update order_data2 set export_datetime = null, export_info = null Where order_id in (" + cb_id + ")";
                    break;
                case 0: //刪除                  
                    //sql = " Delete From driver_data Where driver_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        //匯入出貨單
        [HttpPost]
        public ActionResult GoodsAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                //string water = NW.getImgWater();
                //string tmpPath = Server.MapPath("~/Content/files/inport");
                //if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); }

                ////新的檔案名稱
                //string strFileName = water + Path.GetExtension(file_name.FileName);
                ////存放檔案路徑
                //string strFilePath = tmpPath + "/" + strFileName;
                ////檔案存放在Server
                //file_name.SaveAs(strFilePath);

                try
                {
                    // 建立一個工作簿 Office 2007 flag = 0 訂單資料

                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    ////2007
                    //XSSFWorkbook workbook = new XSSFWorkbook(FileUpload1.FileContent);
                    ////2003
                    //HSSFWorkbook workbook = new HSSFWorkbook(FileUpload1.FileContent);


                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            //test
                            int aa = sheet.GetRow(row).LastCellNum;

                            //出貨資料
                            if (sheet.GetRow(row).LastCellNum == 5)
                            {
                                if (sheet.GetRow(row).GetCell(0) != null)
                                {
                                    int order_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[0]);
                                    int sub_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[1]);
                                    if (order_id > 0 && sub_id > 0)
                                    {
                                        if (!arrOrder_id.Contains(order_id)) { arrOrder_id.Add(order_id); }

                                        string name = (sheet.GetRow(row).GetCell(1) != null) ? sheet.GetRow(row).GetCell(1).ToString() : "";
                                        string sn = (sheet.GetRow(row).GetCell(2) != null) ? sheet.GetRow(row).GetCell(2).ToString() : "";
                                        DateTime? goods_datetime;
                                        int num = Convert.ToInt32(sheet.GetRow(row).GetCell(4).NumericCellValue);
                                        var data = this._DB.order_goods2.Where(m => m.order_id == order_id && m.sub_id == sub_id).FirstOrDefault();
                                        if (data == null)
                                        {
                                            //正常出貨:出貨日不為空值，出貨數不為0
                                            //取消出貨:出貨日不為空，出貨數量為0
                                            //延後出貨:出貨日為空值，出貨數量不為0
                                            if ((sheet.GetRow(row).GetCell(3) != null))
                                            {
                                                goods_datetime = Convert.ToDateTime(sheet.GetRow(row).GetCell(3).ToString());
                                                data = new order_goods2 { order_id = order_id, sub_id = sub_id, name = name, sn = sn, num = num, goods_datetime = goods_datetime, create_user = this.User.Identity.Name, create_datetime = create_datetime };
                                                this._DB.order_goods2.Add(data);
                                                this._DB.SaveChanges();
                                            }
                                            else
                                            {

                                            }
                                        }
                                    }
                                }
                            }
                            //for (int c = 0; c <= sheet.GetRow(row).LastCellNum; c++) // 使用For 走訪資料欄
                            //{
                            //    if (sheet.GetRow(row).GetCell(c) != null)
                            //    {
                            //        string x2 = sheet.GetRow(row).GetCell(c).ToString();

                            //    }
                            //}
                        }
                    }
                    //更新訂單主黨
                    foreach (int oid in arrOrder_id)
                    {
                        if (oid > 0)
                        {
                            var linq = from m in this._DB.order_sub2
                                       join n in this._DB.order_goods2
                                       on m.sub_id equals n.sub_id into mm
                                       from n in mm.DefaultIfEmpty()
                                       where m.order_id == oid
                                       select new
                                       {
                                           m.sub_id,
                                           m.product_id,
                                           m.item_name,
                                           GoodsNum = n.num.ToString() ?? "NA"
                                       };
                            var data2 = linq.ToList().Where(m => m.GoodsNum == null).FirstOrDefault();
                            if (data2 == null)
                            {
                                var data3 = this._DB.order_data2.Where(m => m.order_id == oid).FirstOrDefault();
                                if (data3 != null)
                                {
                                    var data4 = this._DB.order_goods2.Where(m => m.order_id == oid).Max(m => m.goods_datetime);
                                    if (data4.HasValue)
                                    {
                                        data3.flag = 2;
                                        data3.goods_datetime = data4.Value;
                                        data3.goods_info = this.User.Identity.Name;
                                        this._DB.SaveChanges();
                                    }
                                }
                            }
                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("GoodsList");
        }

        //匯入費用單
        [HttpPost]
        public ActionResult GoodsAdd2Save(HttpPostedFileBase file_name2)
        {

            if (file_name2 != null && file_name2.ContentLength > 0 && NW.getFileType(file_name2, 3))
            {

                try
                {
                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name2.InputStream);

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);

                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            //費用資料
                            if (sheet.GetRow(row).LastCellNum == 5)
                            {
                                if (sheet.GetRow(row).GetCell(0) != null)
                                {
                                    int order_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[0]);
                                    int freight_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[1]);
                                    if (order_id > 0)
                                    {
                                        if (!arrOrder_id.Contains(order_id)) { arrOrder_id.Add(order_id); }

                                        string name = (sheet.GetRow(row).GetCell(1) != null) ? sheet.GetRow(row).GetCell(1).ToString() : "";
                                        string sn = (sheet.GetRow(row).GetCell(2) != null) ? sheet.GetRow(row).GetCell(2).ToString() : "";
                                        DateTime charge_datetime = DateTime.Today;
                                        int num = Convert.ToInt32(sheet.GetRow(row).GetCell(3).NumericCellValue);
                                        double total = Convert.ToDouble(sheet.GetRow(row).GetCell(4).NumericCellValue);
                                        var data = this._DB.order_charge2.Where(m => m.order_id == order_id && m.freight_id == freight_id && m.item_sn == sn).FirstOrDefault();
                                        if (data == null)
                                        {
                                            data = new order_charge2 { order_id = order_id, freight_id = freight_id, charge_name = name, item_sn = sn, num = num, total = total, charge_datetime = charge_datetime, create_user = this.User.Identity.Name, create_datetime = create_datetime };
                                            this._DB.order_charge2.Add(data);
                                            this._DB.SaveChanges();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("GoodsList");
        }

