        [HttpPost]
        public ActionResult ExportListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "選擇匯出", "全部匯出", "作廢" };
            string msg = "匯出失敗，請洽系統工程師，謝謝!!";
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);
            string sql = "";

            string FileName = Export(cb_id);
            if (!string.IsNullOrEmpty(FileName))
            {
                sql = "Update order_data2 set export_datetime = getDate(), export_info='網站匯入：" + this.User.Identity.Name + "' Where visible=1 and export_datetime is null  and (flag=1 or (flag=0 and pay_id=4))";
                //1為全部匯出
                if (cb_flag != 1) { sql += " And order_id in (" + cb_id + ")"; }

                if (sql != "")
                {
                    _DB.Database.ExecuteSqlCommand(sql);
                }
                return File(FileName, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Today.ToString("yyyyMMdd") + "待出貨訂單列表.xlsx"));
            }
            else
            {
                return Content(msg);
            }

            //TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
        }

        private string Export(string id)
        {
            string value = "";
            string[] cols = "".Split(',');
            List<order_data2> data;

            cols = "轉單日期,最晚出貨日,交易序號,訂購人,收件人姓名,店家商品料號,商品名稱,商品規格,數量,金額小計,購物車備註,買家確認日,收件人地址,收件人電話(日),收件人電話(夜),收件人行動電話,發票寄送地址,付款別,物流設定,收件人郵遞區號,商品編號,訂單編號,店家出貨日,商品類型,訂單狀態,入帳日,會員編號,會員信箱,原售價,含稅成本,發票統編,發票抬頭,收貨時段備註,店別".Split(',');
            var Linq1 = this._DB.order_data2.Where(m => m.visible == true && m.export_datetime == null && (m.flag == 1 || (m.flag == 0 && m.pay_id == 4)) && !string.IsNullOrEmpty(m.sn));
            //測試用
            //var Linq1 = this._DB.order_data.Where(m => m.order_id>0);
            if (!string.IsNullOrEmpty(id))
            {
                //文字陣列轉數字陣列
                int[] arrID = id.Split(',').Select((string s) => { int i; int.TryParse(s, out i); return i; }).ToArray();
                Linq1 = Linq1.Where(m => arrID.Contains(m.order_id));
            }
            Linq1 = Linq1.OrderBy(m => m.order_id);
            data = Linq1.ToList();

            //var marData = this._DB.news4_data.Where(m => m.visible).ToList();
            string msn = "";

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("訂單列表");
            int colIdx = 1;
            int rowIdx = 2;


            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            string p = "'";

            foreach (var item in data)
            {
                var mData = this._DB.pharmacist_data.Where(m => m.pharmacist_id == item.member_id).FirstOrDefault();
                string name = mData.name;
                string freight_flag_name = item.freight_flag_name;

                if (!string.IsNullOrEmpty(freight_flag_name))
                {
                    foreach (string ss in freight_flag_name.Split(','))
                    {
                        var arr = ss.Split(':');
                        int iFright_id = 0;
                        string Fright_sn = "81006001";
                        switch (arr[0])
                        {
                            case "冷藏運費": iFright_id = 1; Fright_sn = "81006005"; break;
                            case "冷凍運費": iFright_id = 2; Fright_sn = "81006008"; break;
                        }

                        var idata = new order_sub2 { order_id = item.order_id };
                        idata.item_name = arr[0];
                        idata.item_no = Fright_sn;
                        idata.price = Convert.ToInt32(arr[1]);
                        idata.num = 1;
                        idata.freight_id = iFright_id;
                        idata.freight_visible = true;
                        item.order_sub2.Add(idata);
                    }
                }

                item.order_sub2 = item.order_sub2.OrderBy(m => m.freight_id).ToList();
                foreach (var subitem in item.order_sub2)
                {
                    string ffname = "";
                    int num = subitem.num;
                    msn = !string.IsNullOrEmpty(item.sn) ? item.sn : "";

                    //var market = marData.Where(m => m.sn == msn).FirstOrDefault();
                    //string marname = market != null ? market.title.Replace(" ","") : "生鮮購";                    

                    if (subitem.freight_id >= 0 && subitem.freight_id < 3) { ffname = NW.FFName[subitem.freight_id]; }
                    if (item.pay_datetime.HasValue)
                    {
                        sheet.Cell(rowIdx, 1).Value = p + item.pay_datetime.Value.ToString("yyyy/MM/dd HH:mm");
                        sheet.Cell(rowIdx, 2).Value = p + item.pay_datetime.Value.AddDays(3).ToString("yyyy/MM/dd HH:mm");
                    }
                    else
                    {
                        sheet.Cell(rowIdx, 1).Value = p + item.order_datetime.Value.ToString("yyyy/MM/dd HH:mm");
                        sheet.Cell(rowIdx, 2).Value = p + item.order_datetime.Value.AddDays(3).ToString("yyyy/MM/dd HH:mm");
                    }

                    if (!string.IsNullOrEmpty(item.sn))
                    {
                        DateTime sdt1 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 8, 0, 0, 0, 0);
                        DateTime edt1 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 17, 0, 0, 0, 0);

                        DateTime sdt2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 17, 0, 0, 0, 0);
                        DateTime edt2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 8, 0, 0, 0, 0);
                        // DateTime gd2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 15, 0, 0);

                        DateTime gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 21, 0, 0, 0, 0);

                        if (item.order_datetime >= sdt1 && item.order_datetime < edt1)
                        {
                            sheet.Cell(rowIdx, 2).Value = p + gd.ToString("yyyy/MM/dd HH:mm");

                        }
                        else if (item.order_datetime >= sdt2 && item.order_datetime < edt2)
                        {
                            gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 15, 0, 0, 0, 0);

                        }
                        else
                        {
                            gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 15, 0, 0, 0, 0);
                        }

                        sheet.Cell(rowIdx, 2).Value = p + gd.ToString("yyyy/MM/dd HH:mm");

                    }

                    if (!string.IsNullOrEmpty(item.sn))
                    {
                        sheet.Cell(rowIdx, 3).Value = p + "D" + item.order_id.ToString() + "-" + subitem.freight_id.ToString();
                    }
                    else
                    {
                        sheet.Cell(rowIdx, 3).Value = p + item.order_id.ToString() + "-" + subitem.freight_id.ToString();
                    }


                    sheet.Cell(rowIdx, 4).Value = p + name;
                    sheet.Cell(rowIdx, 5).Value = p + item.send_name;

                    //有-的處理 控制匯出匯入
                    if (subitem.item_no.IndexOf("-") > -1)
                    {
                        string[] arrT = subitem.item_no.Split('-');
                        subitem.item_no = arrT[0];
                        num *= Convert.ToInt32(arrT[1]);
                    }

                    sheet.Cell(rowIdx, 6).Value = p + subitem.item_no;
                    sheet.Cell(rowIdx, 7).Value = p + subitem.item_name;
                    sheet.Cell(rowIdx, 8).Value = p + subitem.style_name;
                    sheet.Cell(rowIdx, 9).Value = p + num;
                    sheet.Cell(rowIdx, 10).Value = p + subitem.num * subitem.price;

                    sheet.Cell(rowIdx, 11).Value = p + item.info;
                    sheet.Cell(rowIdx, 12).Value = p;
                    sheet.Cell(rowIdx, 13).Value = p + item.send_zip + item.send_city + item.send_canton + item.send_address;
                    sheet.Cell(rowIdx, 14).Value = p;
                    sheet.Cell(rowIdx, 15).Value = p;

                    sheet.Cell(rowIdx, 16).Value = p + item.send_tel;
                    //sheet.Cell(rowIdx, 17).Value = p + mData.zip + mData.zip_data.city + mData.zip_data.canton + mData.address;
                    //sheet.Cell(rowIdx, 17).Value = p  + mData.address;
                    sheet.Cell(rowIdx, 17).Value = p + "";
                    sheet.Cell(rowIdx, 18).Value = p + NW.payName(item.pay_id);
                    sheet.Cell(rowIdx, 19).Value = p + ffname;
                    sheet.Cell(rowIdx, 20).Value = p + item.send_zip;

                    sheet.Cell(rowIdx, 21).Value = p + subitem.item_no;
                    sheet.Cell(rowIdx, 22).Value = p + item.order_id.ToString() + "-" + subitem.sub_id.ToString();
                    sheet.Cell(rowIdx, 23).Value = p;
                    sheet.Cell(rowIdx, 24).Value = p;
                    sheet.Cell(rowIdx, 25).Value = p + "備貨中";

                    sheet.Cell(rowIdx, 26).Value = p;
                    sheet.Cell(rowIdx, 27).Value = p + mData.pharmacist_id.ToString();
                    sheet.Cell(rowIdx, 28).Value = p + mData.mail;

                    var pData = this._DB.product_data.Where(m => m.product_id == subitem.product_id).FirstOrDefault();
                    if (pData != null)
                    {
                        sheet.Cell(rowIdx, 29).Value = p + (pData.sprice * subitem.num).ToString();
                        sheet.Cell(rowIdx, 30).Value = p + (pData.cost * subitem.num).ToString();
                    }

                    //統編(發票統編)、發票抬頭、收貨時段備註
                    sheet.Cell(rowIdx, 31).Value = p + item.inv_sn;
                    sheet.Cell(rowIdx, 32).Value = p + item.inv_title;
                    sheet.Cell(rowIdx, 33).Value = p + item.send_time + "," + item.send_time2;

                    sheet.Cell(rowIdx, 34).Value = p + msn;

                    rowIdx += 1;

                }
            }

            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }

            value = Server.MapPath("~/Content/files/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }

        //待出貨列表
        public ActionResult GoodsList(string kw)
        {
            int currentPageIndex = 0;

            var Linq = this._DB.order_data2.Where(m => m.visible == true && m.export_datetime != null && (m.flag == 1 || (m.flag == 0 && m.pay_id == 4)));

            foreach (var item in Linq.ToList())
            {
                var data22 = this._DB.pharmacist_data.Where(m => m.pharmacist_id == item.member_id).FirstOrDefault();
                string aa = data22.name;
                item.sn = aa;
            }

            Linq = Linq.OrderByDescending(m => m.order_id);

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            var marData = this._DB.news4_data.Where(m => m.visible).ToList();
            ViewData["marData"] = marData;

            return View(data);
        }

        public ActionResult GoodsList_ajax(int? gid, int? page, string kw)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_data2.Where(m => m.visible == true && m.export_datetime != null && (m.flag == 1 || (m.flag == 0 && m.pay_id == 4)));

