        //匯入發票
        [HttpPost]
        public ActionResult InvoiceAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {
                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            //出貨資料
                            if (sheet.GetRow(row).LastCellNum == 4)
                            {
                                if (sheet.GetRow(row).GetCell(0) != null)
                                {
                                    int order_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[0]);
                                    int sub_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString().Split('-')[1]);
                                    if (order_id > 0 && sub_id > 0)
                                    {
                                        if (!arrOrder_id.Contains(order_id)) { arrOrder_id.Add(order_id); }

                                        DateTime invoice_datetime = Convert.ToDateTime(sheet.GetRow(row).GetCell(1).ToString()); ;
                                        string invoice = (sheet.GetRow(row).GetCell(1) != null) ? sheet.GetRow(row).GetCell(2).ToString() : "";
                                        string tax = (sheet.GetRow(row).GetCell(2) != null) ? sheet.GetRow(row).GetCell(3).ToString() : "";
                                        var data = this._DB.order_druginvoice.Where(m => m.order_id == order_id && m.sub_id == sub_id).FirstOrDefault();
                                        if (data == null)
                                        {
                                            data = new order_druginvoice { order_id = order_id, sub_id = sub_id, invoice = invoice, tax = tax, invoice_datetime = invoice_datetime, create_user = this.User.Identity.Name, create_datetime = create_datetime };
                                            this._DB.order_druginvoice.Add(data);
                                            this._DB.SaveChanges();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    //更新訂單主黨
                    foreach (int oid in arrOrder_id)
                    {
                        if (oid > 0)
                        {
                            var linq = from m in this._DB.order_sub2
                                       join n in this._DB.order_druginvoice
                                       on m.sub_id equals n.sub_id into mm
                                       from n in mm.DefaultIfEmpty()
                                       where m.order_id == oid
                                       select new
                                       {
                                           m.sub_id,
                                           m.product_id,
                                           m.item_name,
                                           invoice = n.invoice.ToString() ?? "NA"
                                       };
                            var data2 = linq.ToList().Where(m => m.invoice == null).FirstOrDefault();
                            if (data2 == null)
                            {
                                var data3 = this._DB.order_data2.Where(m => m.order_id == oid).FirstOrDefault();
                                if (data3 != null)
                                {
                                    var data4 = this._DB.order_druginvoice.Where(m => m.order_id == oid).Max(m => m.invoice_datetime);
                                    if (data4.HasValue)
                                    {
                                        data3.flag = 5;
                                        data3.invoice_datetime = data4.Value;
                                        data3.invoice_note = this.User.Identity.Name;
                                        //貨到付款
                                        if (data3.pay_id == 4)
                                        {
                                            data3.pay_visible = true;
                                            data3.pay_note = "交易成功!!出貨日：" + data3.goods_datetime.Value.ToString("yyyy-MM-dd HH:ss");
                                        }
                                        this._DB.SaveChanges();
                                    }
                                }
                            }
                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("InvoiceList");
        }


