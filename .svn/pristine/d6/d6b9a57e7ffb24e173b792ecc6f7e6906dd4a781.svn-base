@model h365_web.Models.order_data
@{
    string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    string List_pay_id = "pay_id";
    List<ListItem> ListItems_pay_id = new List<ListItem>();

    if (ViewData[List_pay_id] != null) { ListItems_pay_id = (List<ListItem>)ViewData[List_pay_id]; }

    string List_pay_visible = "pay_visible";
    List<ListItem> ListItems_pay_visible = new List<ListItem>();

    if (ViewData[List_pay_visible] != null) { ListItems_pay_visible = (List<ListItem>)ViewData[List_pay_visible]; }

    string List_freight_name = "freight_name";
    List<ListItem> ListItems_freight_name = new List<ListItem>();

    if (ViewData[List_freight_name] != null) { ListItems_freight_name = (List<ListItem>)ViewData[List_freight_name]; }

    IDictionary<string, object> htmlAttributes = new Dictionary<string, object>();
    htmlAttributes.Add("class", "span6");

    int sTotal = 0;
    int Save_solt = 0;

    h365_web.Models.member_data member_data = (h365_web.Models.member_data)ViewData["member_data"];

    List<NW.order_goods_tmp> order_goods_tmp = (List<NW.order_goods_tmp>)ViewData["order_goods_tmp"];
    List<NW.order_invoice_tmp> order_invoice_tmp = (List<NW.order_invoice_tmp>)ViewData["order_invoice_tmp"];

    List<h365_web.Models.order_charge> order_charge_tmp = (List<h365_web.Models.order_charge>)ViewData["order_charge_tmp"];

    List<h365_web.Models.product_data> product = (List<h365_web.Models.product_data>)ViewData["product"];

    var solt_data = (List<h365_web.Models.solt_data>)ViewData["solt_data"];

}

<div class="maincontent">
    <div class="contentinner">
        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "editprofileform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.order_id)
            <input type="hidden" id="index" name="index" value="0" />
            <div class="widgetcontent">

                <div class="row-fluid">

                    @*訂單資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">訂單資訊</h4>
                        <div class="widgetcontent bordered">
                            <p>
                                <label>訂單單號：</label><span class="label label-info">@(Model.order_id)</span>
                            </p>
                            <p>
                                <label>前台單號：</label>@(Model.order_sn)
                            </p>
                            <p>
                                <label>訂購時間：</label>@(Model.order_datetime)
                            </p>
                            <p>
                                <label>訂單狀態：</label><span class="label label-@(Model.flag > 0 ? "success" : "default")">@((Model.finish_datetime != null && Model.goods_datetime == null) ? NW.Name_flag[1] : NW.Name_flag[Model.flag])</span>
                            </p>
                        </div>
                    </div>

                    @*訂購資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">訂購資訊</h4>
                        <div class="widgetcontent bordered">
                            <p>
                                <label>訂購人姓名：</label>@(Model.order_name != null ? Model.order_name : "- - -")
                            </p>
                            <p>
                                <label>訂購人電話：</label>@(Model.order_phone)
                            </p>
                            <p>
                                <label>收款藥師：</label>@(ViewBag.getphar)
                            </p>
                            <p>
                                <label>交貨藥師：</label>@(ViewBag.goodsphar)
                            </p>

                        </div>
                    </div>

                    @*收件人資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">收件人資訊</h4>
                        <div class="widgetcontent bordered">
                            <p>
                                <label>收件方姓名：</label>@(Model.send_name)
                            </p>
                            <p>
                                <label>收件方電話：</label>@(Model.send_tel)
                            </p>
                            <p>
                                <label>收件方地址：</label>@(Model.zip_city) - @(Model.send_address)
                            </p>
                            <p>
                                <label>收件日期：</label>@(Model.goods_datetime != null ? Model.goods_datetime.ToString() : "- - -")
                            </p>

                        </div>
                    </div>

                </div>

                <div class="row-fluid">

                    @*金流資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">金流資訊</h4>
                        <div class="widgetcontent bordered">

                            <p>
                                <label>付款方式：</label>@Html.SelectList(List_pay_id, ListItems_pay_id, htmlAttributes)
                            </p>
                            <p>
                                <label>付款成功：</label>@Html.SelectList(List_pay_visible, ListItems_pay_visible, htmlAttributes)
                            </p>
                            <p>
                                <label>交易說明：</label>@(Model.pay_id == 3 ? "授權碼" : "- - -") @(Model.pay_approvecode)
                            </p>
                            <p>
                                <label>交易訊息：</label><textarea name="pay_note" id="pay_note" class="span8" rows="2">@(Model.pay_note)</textarea>
                            </p>
                            <p>
                                <label>備註說明：</label>@(Model.info)&nbsp;
                            </p>

                            <p>
                                <label></label>
                                <div class="stdformbutton">
                                    @if (Model.pay_datetime == null)
                                    {
                                        <a class="btn btn-primary" onclick="submit(0);">儲存金流資訊</a>
                                    }
                                </div>
                            </p>
                        </div>
                    </div>

                    @*物流資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">物流資訊</h4>
                        <div class="widgetcontent bordered">
                            @*<p>
                                <label>運費：</label>@(Model.freight_flag_name)&nbsp;
                            </p>*@
                            <p>
                                <label>物流狀態：</label><span class="label label-warning">@((Model.goods_datetime != null ? "已出貨" : "未出貨"))</span>&nbsp;
                            </p>
                            @Html.EditorFor(model => model.freight_datetime)
                            @Html.EditorFor(model => model.freight_name)
                            @Html.EditorFor(model => model.freight_no)

                            <div style="max-width: 300px; word-wrap: break-word; word-break: normal; background-color: blue; color: white">宅配單號設定說明:填入一組宅配單號後輸入Enter建即可在輸入第二組宅配單號請勿以任何符號分隔宅配單號</div>

                            <div>
                                <label>&nbsp;</label>
                                <table class="table table-bordered mailinbox">
                                    <colgroup>
                                        <col class="width30" />
                                        <col class="width30" />
                                        <col />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>貨運日期</th>
                                            <th>貨運公司</th>
                                            <th>貨運號碼</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order_goods_tmp)
                                        {
                                            <tr>
                                                <td>@(NW.getDate(item.goods_datetime))</td>
                                                <td>@(item.name)</td>
                                                <td>@(item.sn)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if ((Model.finish_datetime != null && Model.goods_datetime == null) || (Model.pay_datetime != null && Model.goods_datetime == null) || (Model.order_flag == 0 && Model.send_drug_id != 0 && Model.goods_datetime == null))
                            {
                                                                                     
                                <div class="stdformbutton" style="text-align: center;">
                                    &nbsp;
                                    <a class="btn btn-primary" onclick="submit(1);">儲存物流資訊</a>
                                </div>
                                
                            }
                        </div>
                    </div>

                    @*匯出資訊*@
                    <div class="span4">
                        <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">匯出資訊</h4>
                        <div class="widgetcontent bordered">
                            <p>
                                <label>匯出人：</label>&nbsp;
                                @(ViewBag.user)
                            </p>
                            <p>
                                <label>匯出時間：</label>&nbsp;
                                @(Model.export_datetime)
                            </p>
                        </div>
                    </div>

                    @*發票資訊*@
                    @if (Model.pay_id == 3)
                    { 
                        <div class="span4">
                            <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">發票資訊</h4>
                            <div class="widgetcontent bordered">
                                @Html.EditorFor(model => model.invoice_no)

                                @Html.EditorFor(m => m.invoice_datetime)

                                @if (Model.pay_datetime != null && Model.finish_datetime <= DateTime.Today.AddDays(-7) && Model.back_datetime == null && Model.invoice_no == null)
                                { 
                                    <div class="stdformbutton" style="text-align: center;">
                                        &nbsp;
                                    <a class="btn btn-primary" onclick="submit(3);">儲存發票資訊</a>
                                    </div>
                                }

                            </div>
                        </div>

                    }

                    @*訂單完成*@
                    @if (Model.goods_datetime != null && Model.pay_datetime != null && Model.finish_datetime == null)
                    { 
                        <div class="span4">
                            <h4 class="widgettitle nomargin" style="margin-bottom: 0px;">訂單完成</h4>
                            <div class="widgetcontent bordered">

                                <div class="stdformbutton">
                                    <a class="btn btn-primary" onclick="submit(2);">轉為訂單完成</a>
                                </div>
                            </div>
                        </div>
                    }

                </div>

                <div class="row-fluid">
                    <div class="span12 editprofileform">
                        <h4 class="widgettitle">訂購內容</h4>
                        <div class="">
                            <div id="List_ajax">
                                <table class="table table-striped">
                                    <colgroup>
                                        <col class="width12" />
                                        <col class="width25" />
                                        <col />
                                        <col class="width12" />
                                        <col class="width12" />
                                        <col class="width12" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>貨號</th>
                                            <th>品牌</th>
                                            <th>品名</th>
                                            <th class="right">價格</th>
                                            <th class="right">數量</th>
                                            <th class="right">小計</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.order_sub)
                                        {
                                            var data = product.Where(m => m.product_id == item.product_id).FirstOrDefault();
                                            //品牌
                                            item.style_name = data != null ? data.web_name : "";
                                            
                                            //健康紅利
                                            var solt = solt_data.Where(m => m.order_id == Model.order_id).FirstOrDefault();
                                            if (solt != null)
                                            {
                                                Save_solt = solt.prize;
                                            }
                                            
                                            <tr>
                                                <td>@(item.item_no)</td>
                                                <td>@(NW.word(item.style_name, 17, "..."))</td>
                                                <td>@(item.item_name)</td>
                                                <td class="right">@(item.price)</td>
                                                <td class="right">@(item.num)</td>
                                                <td class="right">@(item.num * item.price) </td>
                                            </tr>
                                            
                                            //價格
                                            sTotal += item.num * item.price;
                                        }
                                        <tr>
                                            <td colspan="4"></td>
                                            <td class="right">小計</td>
                                            <td class="right">@(sTotal)</td>
                                        </tr>
                                        <tr>
                                            <td colspan="4"></td>
                                            <td class="right">紅利</td>
                                            <td class="right">@(Model.bonus)</td>
                                        </tr>
                                        <tr>
                                            <td colspan="4"></td>
                                            <td class="right">健康紅利</td>
                                            <td class="right">@(Save_solt)</td>
                                        </tr>
                                        <tr>
                                            <td colspan="4"></td>
                                            <td class="right">總計</td>
                                            <td class="right">NT @((sTotal - Model.bonus - Save_solt).ToString("n0"))</td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">$(function () { $("#freight_datetime").datepicker(); })</script>
<script type="text/javascript">$(function () { $("#invoice_datetime").datepicker(); })</script>
<script type="text/javascript">
    $(function () {
        // With Form Validation
        //$("#form1").validate();

    })

    function submit(o) {
        if (o == 1) {
            $("#form1").validate({
                rules: {
                    freight_datetime: "required",
                    freight_no: "required"

                },
                messages: {
                    freight_datetime: "出貨時間，必須填寫！",
                    freight_no: "必須填寫！"
                },
                highlight: function (label) {
                    jQuery(label).closest('.control-group').addClass('error');
                }
            });
        }
        $('#index').val(o);
        $('#form1').submit();
    }
</script>

<script>
    function submitx(o) {
        $('#index').val(o);
        $('#form1').submit();
    }
</script>


<style>
    #freight_datetime {
        width: 100px;
        height: 36px;
    }

    #freight_name {
        width: 48.7179%;
    }

    #invoice_datetime {
        width: 100px;
        height: 36px;
    }
</style>
