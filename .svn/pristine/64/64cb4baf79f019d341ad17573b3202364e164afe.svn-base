@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    var data = (List<h365_web.Areas.newweb.Controllers.NwReportController.drugstore>)ViewData["where"];
    int total = ViewBag.total;
}

<!--pagetitle-->
<div class="maincontent">
    <div class="contentinner">

        <!--widgetsource-->
        <div id="mail">


            <h2>目前總店家數：@(total)</h2>


            @*@Html.Partial("template_select")*@

        </div>
        <!--#chat-->
        <form action="@(Url.Action("DrugstoreswhereListDel", controller, new { total = ViewBag.total }))" method="post">
            <div>
                @*<input type="text" name="kw" placeholder="請輸入關鍵字" value="@(ViewBag.kw)"/>*@</br></br>
                            <input type="submit" value="匯出" class="btn btn-primary" />
            </div>
        </form>
        @*先跑View，再跑資料*@
        <div id="List_ajax">
            <table class="table table-bordered mailinbox">
                <colgroup>
                    <col class="width8" />
                    <col class="width8" />
                    <col class="width5" />
                    <col class="width5" />
                    <col class="width5" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="center">排名</th>
                        <th class="center">縣市</th>
                        <th class="center">地區</th>
                        <th class="center">店家數</th>
                        <th class="center">地區比</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in data)
                    {                
                        <tr class="@NW.echoBool(true, "unread", "visible")">
                            <td class="center">@Html.DisplayFor(modelItem => item.rank)</td>
                            <td class="center">@Html.DisplayFor(modelItem => item.city)</td>
                            <td class="center">@Html.DisplayFor(modelItem => item.canton)</td>
                            <td class="center">@Html.DisplayFor(modelItem => item.num)</td>
                            <td class="center">@(((decimal)(item.num * 100) / total).ToString("N2"))%</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
        @*@Html.Partial(action + "_ajax")*@

    </div>
    <!--contentinner-->
</div>
