    [NWAuthorize]
    [NWCustomError(ExceptionType = typeof(System.Data.DataException), View = "NwError")]
    public class _BaseController : Controller
    {

        private _dbContext _db_;
        protected _dbContext _DB
        {
            get
            {
                if (_db_ == null)
                {
                    _db_ = new _dbContext();
                }
                return _db_;
            }
        }


        //共用參數區
        //分頁數
        protected const int ALL_PAGESIZE = 20;

       
        //最新消息
        protected const int NEWS_IMAGE_SW = 190;
        protected const int NEWS_IMAGE_SH = 143;
        protected const int NEWS_IMAGE_BW = 450;
        protected const int NEWS_IMAGE_BH = 370;

        protected override void HandleUnknownAction(string actionName)
        {

            try
            {

                this.View(actionName).ExecuteResult(this.ControllerContext);

            }
            catch (InvalidOperationException ieox)
            {

                ViewData["error"] = "Unknown Action: \"" + Server.HtmlEncode(actionName) + "\"";

                ViewData["exMessage"] = ieox.Message;

                this.View("Error").ExecuteResult(this.ControllerContext);

            }

        }
    }

