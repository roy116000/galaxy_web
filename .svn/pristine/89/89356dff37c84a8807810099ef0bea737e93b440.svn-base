        #region "訂單列表"

        private IPagedList Order(int currentPageIndex, IQueryable<order_data> Linq, string kw, string mname, int? flag, bool? pay_visible, DateTime? start_date, DateTime? end_date, int? pay_id)
        {
            #region"下拉選單"

            List<ListItem> ListItems = new List<ListItem> { }; //flag
            ListItems.Add(new ListItem("", "全部", false));
            ListItems.AddRange(NW.sList(NW.Name_flag, flag.ToString()));
            ViewData["flag"] = ListItems;

            List<ListItem> ListItems_pay_visible = new List<ListItem> { }; //pay_visible
            ListItems_pay_visible.Add(new ListItem("", "全部", false));
            ListItems_pay_visible.Add(new ListItem("false", "未付款", pay_visible.HasValue ? pay_visible.Value : false));
            ListItems_pay_visible.Add(new ListItem("true", "已付款", pay_visible.HasValue ? pay_visible.Value : false));
            ViewData["pay_visible"] = ListItems_pay_visible;

            List<ListItem> ListItems_pay_id = new List<ListItem> { }; //pay_id
            ListItems_pay_id.Add(new ListItem("", "全部", false));
            ListItems_pay_id.Add(new ListItem("1", "藥師收款", pay_id.HasValue ? pay_id == 1 : false));
            ListItems_pay_id.Add(new ListItem("3", "信用卡", pay_id.HasValue ? pay_id == 3 : false));
            ViewData["pay_id"] = ListItems_pay_id;

            #endregion

            #region"搜尋"

            sys_admin_data admin = NW.admin(User.Identity.Name);
            if (admin.power_id > 2) { Linq = Linq.Where(m => m.company_id == admin.company_id && m.flag >= 1); }

            if (!start_date.HasValue) { start_date = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); };
            if (!end_date.HasValue) { end_date = DateTime.Today; }

            DateTime linq_eD = end_date.Value.AddDays(1);

            Linq = Linq.Where(m => m.order_datetime >= start_date && m.order_datetime < linq_eD);

            //關鍵字
            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw) || m.order_id.ToString() == kw);
                ViewBag.kw = kw;
            }
            if (!string.IsNullOrEmpty(mname))
            {
                string member_id = "";

                var member = this._DB.member_data.Where(m => m.name == mname || m.phone == mname).ToList();
                if (member.Count != 0)
                {
                    foreach (var mem in member)
                    {
                        member_id += mem.member_id.ToString() + ",";
                    }

                    if (!string.IsNullOrEmpty(member_id))
                    {
                        member_id = member_id.TrimEnd(',');
                        string[] member_index = member_id.Split(',');

                        Linq = Linq.Where(m => member_index.Contains(m.member_id.ToString()));
                    }
                }
                ViewBag.mname = mname;
            }

            if (flag.HasValue)
            {
                Linq = Linq.Where(m => m.flag == flag);
                ViewBag.vflag = flag;
            }

            if (pay_visible.HasValue)
            {
                Linq = Linq.Where(m => m.pay_visible == pay_visible);
                ViewBag.vpay_visible = pay_visible;
            }

            if (pay_id.HasValue)
            {
                Linq = Linq.Where(m => m.pay_id == pay_id);
                ViewBag.vpay_id = pay_id;
            }

            #endregion

            //品牌+品名+健康紅利
            Product_Name(Linq.ToList());

            #region"Total"

            int Total = 0, Solt_Num = 0, Solt_Price = 0;

            foreach (var item in Linq.ToList())
            {
                var Solt = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                if (Solt != null)  //有健康紅利?
                {
                    //Total = Total - Solt.prize; //-健康紅利
                    Solt_Num++; //張數++
                    Solt_Price += Solt.prize; //健康紅利總和               
                }

                item.total = item.discount != 0 ? item.discount : item.total; //有折讓?
                Total += item.total - item.bonus - item.solt_price; //價格(售價-紅利-健康紅利)             
            }

            ViewBag.total = "目前總筆數： " + Linq.Count() + " 筆、總金額：" + Total.ToString("N0") + "元、折價卷數量" + Solt_Num + "張、折扣金額：" + Solt_Price.ToString("N0") + "元";

            #endregion

            IPagedList data = Linq.OrderByDescending(m => m.order_id).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.start_date = (start_date != null ? start_date : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)).Value.ToString("yyyy/MM/dd");
            ViewBag.end_date = (end_date != null ? end_date : DateTime.Today).Value.ToString("yyyy/MM/dd");

            return data;
        }


        public ActionResult Edit(int id)
        {
            var data = this._DB.order_data.Find(id);
            var product = this._DB.product_data.Where(m => m.visible).ToList();
            ViewData["product"] = product;
            var solt_data = this._DB.solt_data.Where(m => m.visible && m.order_id != 0).ToList();
            ViewData["solt_data"] = solt_data;

            string user_export = "";
            if (data.export_info != null)
            {
                string[] aa = data.export_info.Split('：');
                int bb = Convert.ToInt32(aa[1]);
                var User_export = this._DB.sys_admin_data.Where(m => m.admin_id == bb).FirstOrDefault();
                user_export = User_export != null ? User_export.name : "查無匯出人";
            }
            ViewBag.user = user_export;

            var mdata = this._DB.member_data.Find(data.member_id);
            ViewData["member_data"] = mdata;

            #region"郵遞區號"

            var zip = this._DB.zip_data.Where(m => m.zip == data.send_zip).FirstOrDefault();
            data.zip_city = zip != null ? zip.city + zip.canton : "未填郵遞區號";

            #endregion

            #region"金流"
            var pdata = this._DB.order_pay.Where(m => m.pay_visible == true).OrderBy(m => m.pay_id).ToList();
            List<ListItem> ListItems_pay_id = new List<ListItem> { };
            //ListItems.Add(new ListItem("", "請選擇", false));

            string purse = data.purse != 0 ? "-個人帳戶" : "";
            foreach (var item in pdata)
            {
                if (item.pay_id == 7) { purse = ""; }
                else
                {
                    if (data.purse != 0) { purse = "-個人帳戶"; }
                }

                if (NW.admin(User.Identity.Name).power_id > 2 && item.pay_id == 1 && data.device == "消費者APP")
                {
                    item.pay_name = "貨到付款";
                }
                ListItems_pay_id.Add(new ListItem(item.pay_id.ToString(), item.pay_name + purse, item.pay_id == data.pay_id));
            }
            ViewData["pay_id"] = ListItems_pay_id;

            List<ListItem> ListItems_pay_visible = new List<ListItem> { };
            ListItems_pay_visible.Add(new ListItem("false", "未付款", data.pay_visible));
            ListItems_pay_visible.Add(new ListItem("true", "已付款", data.pay_visible));
            ViewData["pay_visible"] = ListItems_pay_visible;
            #endregion

            #region"物流"
            List<ListItem> ListItems_freight_name = new List<ListItem> { };
            ListItems_freight_name.Add(new ListItem("", "請選擇", false));

            int i = 1;
            foreach (var item in NW.FreightName)
            {
                ListItems_freight_name.Add(new ListItem(i.ToString() + ":" + item, i.ToString() + ":" + item, i.ToString() + ":" + item == data.freight_name));
                i++;
            }
            ViewData["freight_name"] = ListItems_freight_name;


            var fdata = this._DB.order_goods.Where(m => m.order_id == id).OrderBy(m => m.goods_datetime).Select(m => new NW.order_goods_tmp { name = m.name, sn = m.sn, goods_datetime = m.goods_datetime }).Distinct().ToList();
            ViewData["order_goods_tmp"] = fdata;
            #endregion

            #region"發票資訊"

            data.invoice_datetime = data.invoice_datetime == null ? DateTime.Now : data.invoice_datetime;

            #endregion

            var cdata = this._DB.order_charge.Where(m => m.order_id == id).OrderBy(m => m.freight_id).ToList();
            ViewData["order_charge_tmp"] = cdata;

            var idata = this._DB.order_invoice.Where(m => m.order_id == id).OrderBy(m => m.invoice_datetime).Select(m => new NW.order_invoice_tmp { invoice = m.invoice, tax = m.tax, invoice_datetime = m.invoice_datetime }).Distinct().ToList();
            ViewData["order_invoice_tmp"] = idata;

            //收款藥師
            var getphar = this._DB.sys_admin_data.Where(m => m.drugstore_id == data.drugstore_id && m.admin_id == data.admin_id).FirstOrDefault();
            ViewBag.getphar = getphar != null ? getphar.name : "- - -";

            //交貨藥師
            var goodsphar = this._DB.sys_admin_data.Where(m => m.drugstore_id == data.drugstore_id && m.admin_id == data.goods_admin_id).FirstOrDefault();
            ViewBag.goodsphar = goodsphar != null ? goodsphar.name : "- - -";


            ViewBag.jgrowl = TempData["jgrowl"];


            return View(data);
        }

        [HttpPost]
        public ActionResult EditSave(order_data order_data, int index)
        {
            var data = this._DB.order_data.Find(order_data.order_id);
            var data_sub = this._DB.order_sub.Where(m => m.order_id == data.order_id).FirstOrDefault();
            var product = this._DB.product_data.Where(m => m.product_id == data_sub.product_id).FirstOrDefault();

            switch (index)
            {
                case 0:    //金流資料
                    data.pay_id = order_data.pay_id;
                    data.pay_visible = order_data.pay_visible;
                    data.pay_note = order_data.pay_note;
                    if (order_data.pay_visible) { if (data.pay_datetime == null) { data.pay_datetime = DateTime.Now; } } else { data.pay_datetime = null; }
                    data.flag = order_data.pay_visible ? 1 : 0;
                    this._DB.SaveChanges();
                    TempData["jgrowl"] = "金流資訊儲存成功!!";

                    NW.SendMessage(data, Convert.ToInt32(NW.MailFlag.管理者_付款成功_通知出貨)); //通知廠商用    
                    break;

                case 1: //物流資料

                    if (data.pay_visible || (data.device == "消費者APP" && data.send_drug_id != 0))
                    {
                        //物流公司
                        data.freight_name = order_data.freight_name;
                        data.freight_no = order_data.freight_no;
                        //出貨時間
                        data.freight_datetime = order_data.freight_datetime;
                        data.goods_datetime = order_data.freight_datetime;

                        var P = this._DB.product_data.Where(m => m.product_id == data_sub.product_id).FirstOrDefault();
                        if (P != null)
                        {
                            P.inventory_num = P.inventory_num - data_sub.num;
                        }

                        //匯出時間
                        if (data.export_info == null)
                        {
                            data.export_datetime = order_data.freight_datetime;
                            data.export_info = "編輯內頁匯入：" + User.Identity.Name;
                        }

                        data.goods_info = "WEB填入";
                        if (data.finish_datetime != null) { data.flag = 5; }
                        else if (!string.IsNullOrEmpty(data.freight_name)) { data.flag = 2; }

                        this._DB.SaveChanges();


                        DateTime dt = DateTime.Now;
                        foreach (var item in data.order_sub)
                        {
                            var data2 = new order_goods { };
                            data2.order_id = data.order_id;
                            data2.sub_id = item.sub_id;
                            data2.name = data.freight_name;
                            data2.sn = data.freight_no;
                            data2.num = item.num;
                            data2.goods_datetime = data.goods_datetime;
                            data2.create_user = User.Identity.Name;
                            data2.create_datetime = dt;

                            _DB.order_goods.Add(data2);
                            this._DB.SaveChanges();

                            if (data2.sn != null && product.sms_visible)
                            {
                                //寄簡訊
                                NW.Get365(data.order_id);
                            }

                        }
                        TempData["jgrowl"] = "物流資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成，在處理物流資料";
                    }

                    break;
                case 2: //訂單完成
                    if (data.pay_visible && data.flag < 5)
                    {
                        data.finish_datetime = DateTime.Now;

                        if (data.finish_datetime != null) { data.flag = 5; }
                        this._DB.SaveChanges();
                        TempData["jgrowl"] = "轉為訂單成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請先確定付款完成或出貨完成，才能轉為訂單成功";
                    }

                    break;

                case 3: //發票資料
                    if (data.pay_visible && data.finish_datetime != null && data.back_datetime == null)
                    {

                        //發票號碼
                        data.invoice_no = order_data.invoice_no;
                        //發票時間
                        data.invoice_datetime = order_data.invoice_datetime;

                        #region"發票備份"

                        order_invoice data_invo = new order_invoice { };
                        data_invo.order_id = data.order_id;
                        data_invo.sub_id = data_sub.sub_id;
                        data_invo.tax = "應稅";
                        data_invo.invoice = data.invoice_no;
                        data_invo.invoice_datetime = data.invoice_datetime;
                        data_invo.create_user = User.Identity.Name;
                        data_invo.create_datetime = DateTime.Now;

                        this._DB.order_invoice.Add(data_invo);

                        #endregion

                        this._DB.SaveChanges();

                        TempData["jgrowl"] = "發票資訊儲存成功!!";
                    }
                    else
                    {
                        TempData["jgrowl"] = "請確定商品交付日已經過7天，在處理發票資料";
                    }

                    break;
            }

            return RedirectToAction("Edit", new { @id = order_data.order_id });
        }



