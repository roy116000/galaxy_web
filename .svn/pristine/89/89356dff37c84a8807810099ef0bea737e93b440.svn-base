        #endregion



        #region"共用區"

        //品牌+品名+健康紅利
        public void Product_Name(List<order_data> Linq)
        {
            foreach (var item in Linq)
            {
                var sub_data = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault(); //訂單明細

                var Pro_data = new product_data() { };
                if (sub_data != null)
                {
                    Pro_data = this._DB.product_data.Where(m => m.product_id == sub_data.product_id).FirstOrDefault(); //商品  
                }


                item.pro_web_name = Pro_data != null ? Pro_data.web_name : "查無品牌"; //品牌
                item.info = Pro_data != null ? Pro_data.item_name : "查無品名"; //品名

                var solt_data = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault(); //有使用折價卷
                if (solt_data != null)
                {
                    item.visible_info = solt_data.number; //序號
                    item.solt_price = solt_data.prize; //紅利
                }
            }
        }

