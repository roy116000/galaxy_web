        public ActionResult BackEdit(int id)
        {

            #region"主體"

            var data = this._DB.order_data.Where(m => m.order_id == id).FirstOrDefault();

            data.back_datetime = data.back_datetime != null ? data.back_datetime : DateTime.Today; //退款申請時間

            #endregion

            #region"下拉選單"

            List<ListItem> LIstItems = new List<ListItem> { };

            //退款方式
            var Pay_Flag = this._DB.order_pay.Where(m => m.pay_type == 2).ToDictionary(m => m.pay_id.ToString(), m => m.pay_name);
            LIstItems.AddRange(NW.sList_Dic(Pay_Flag, data.back_money_type.ToString()));
            ViewData["back_money_type"] = LIstItems;

            //商品回收狀況
            LIstItems = new List<ListItem> { };
            LIstItems.Add(new ListItem("0", "評估", data.back_flag == 0));
            LIstItems.Add(new ListItem("1", "商品正常", data.back_flag == 1));
            LIstItems.Add(new ListItem("2", "商品異常", data.back_flag == 2));
            ViewData["back_flag"] = LIstItems;

            #endregion

            #region"傳值"

            //收款藥師
            var getphar = this._DB.sys_admin_data.Where(m => m.drugstore_id == data.drugstore_id && m.admin_id == data.admin_id).FirstOrDefault();
            ViewBag.getphar = getphar != null ? getphar.name : "- - -";

            //交貨藥師
            var goodsphar = this._DB.sys_admin_data.Where(m => m.drugstore_id == data.drugstore_id && m.admin_id == data.goods_admin_id).FirstOrDefault();
            ViewBag.goodsphar = goodsphar != null ? goodsphar.name : "- - -";

            var Solt = this._DB.solt_data.Where(m => m.order_id == data.order_id).FirstOrDefault();
            ViewBag.total = (data.total - data.bonus - (Solt != null ? Solt.prize : 0));

            #endregion

            return View(data);
        }

        public ActionResult BackEditSave(order_data Data_Edit, int index)
        {

            //DateTime sD = DateTime.Now.AddDays(-7); //7天前
            var data = this._DB.order_data.Where(m => m.order_id == Data_Edit.order_id).FirstOrDefault();
            if (data != null)
            {
                switch (index)
                {
                    case 0:
                        data.flag = 3; //退貨狀態
                        data.back_money_type = Data_Edit.back_money_type; //退款方式
                        data.back_datetime = Data_Edit.back_datetime; //申請退貨時間         
                        data.back_info = Data_Edit.back_info; //退貨原因        

                        this._DB.SaveChanges();

                        NW.SendMessage(data, Convert.ToInt32(NW.MailFlag.管理者_退貨通知信)); //通知廠商退貨

                        break;

                    case 1:
                        data.flag = 4; //退貨狀態
                        data.back_freight_no = Data_Edit.back_freight_no; //退貨單號

                        data.back_flag = 1; //商品狀態
                        data.discount = Data_Edit.discount; //折讓金額

                        data.backok_datetime = Data_Edit.backok_datetime; //回收時間

                        this._DB.SaveChanges();

                        break;
                    case 3:
                        data.flag = 5;
                        //發票號碼
                        data.invoice_no = Data_Edit.invoice_no;
                        //發票時間
                        data.invoice_datetime = Data_Edit.invoice_datetime;

                        #region"發票備份"

                        var Data_sub = this._DB.order_sub.Where(m => m.order_id == data.order_id).FirstOrDefault();
                        order_invoice data_invo = new order_invoice { };
                        data_invo.order_id = data.order_id;
                        data_invo.sub_id = Data_sub != null ? Data_sub.sub_id : 0;
                        data_invo.tax = "應稅";
                        data_invo.invoice = data.invoice_no;
                        data_invo.invoice_datetime = data.invoice_datetime;
                        data_invo.create_user = User.Identity.Name;
                        data_invo.create_datetime = DateTime.Now;

                        this._DB.order_invoice.Add(data_invo);

                        #endregion

                        this._DB.SaveChanges();

                        break;
                }
            }

            return RedirectToAction("BackEdit", new { @id = Data_Edit.order_id });
        }

        #endregion

        #region "發票管理列表-寄送區-待開"

        //有無發票資料
        private List<order_data> Invoice_Send(string id, int? type = 0)
        {
            //商品交付日+7天-(當天-7天)
            DateTime eD = DateTime.Today.AddDays(-7);

            //發票資料
            var Invo_data = this._DB.order_invoice;
            int[] aa = { };

            if (!string.IsNullOrEmpty(id))
            {
                var str_nums = NW.str_nums(id);
                aa = Invo_data.Where(m => str_nums.Contains(m.order_id)).Select(m => m.order_id).ToArray();
            }
            else
            {
                aa = Invo_data.Select(m => m.order_id).ToArray();
            }

            //所有寄送的訂單-未開發票的
            var Linq = this._DB.order_data.Where(m => m.visible && (m.device == "消費者APP" && m.pay_id == 3) && m.finish_datetime <= eD && m.back_flag == null).ToLookup(m => aa.Contains(m.order_id));
            //已有發票資料的
            var invo_yes = Linq[true].ToList();
            //無發票資料的
            var invo_no = Linq[false].ToList();

            //已有發票的
            if (type == 1)
            {
                invo_no = invo_yes;
            }

            return invo_no;

        }

        public ActionResult Invoiceoutput(DateTime? cler_date)
        {
            string msg = "";
            if (cler_date == null) { msg = "請填寫匯出日期"; TempData["jgrowl"] = msg; return RedirectToAction("InvoiceList", "NwOrder"); }
            string cler_date_YYMM = cler_date.Value.ToString("yyyy/MM" + "月");

            DateTime sDD = new DateTime(cler_date.Value.AddMonths(-1).Year, cler_date.Value.AddMonths(-1).Month, 1);
            DateTime eDD = new DateTime(cler_date.Value.Year, cler_date.Value.Month, 1);

            //撈出所有完成的訂單
            var Linq = this._DB.order_data.Where(m => m.visible == true && m.flag == 5);
            Linq = Linq.OrderByDescending(m => m.order_id);

            //有銷售的藥局
            var ddd = Linq.Select(n => n.drugstore_id).Distinct().ToList();
            var drugstore = this._DB.drugstore_data.Where(m => m.visible && m.uid != null && ddd.Contains(m.drugstore_id)).ToList();

            if (ddd == null) { msg = "此月份無任何銷售，故無發票產出"; TempData["jgrowl"] = msg; return RedirectToAction("InvoiceList", "NwOrder"); }

            var check_invo = this._DB.order_invoice2.Where(m => m.clearing_date == cler_date_YYMM).FirstOrDefault();
            if (check_invo != null)
            {
                msg = cler_date_YYMM + "-發票已產出過，故不再產出";
            }
            else
            {
                order_invoice2 data2 = new order_invoice2();
                foreach (var item in drugstore)
                {

                    //算各個藥局的金額(當月)
                    int total = Linq.Where(m => m.drugstore_id == item.drugstore_id && (m.finish_datetime >= sDD && m.finish_datetime < eDD)).Select(m2 => m2.total).DefaultIfEmpty(0).Sum();

                    if (total != 0)
                    {
                        //藥局名字
                        data2.name = item.name;
                        //藥局帳號
                        data2.drug_uid = item.uid;
                        //結算日期
                        data2.clearing_date = cler_date_YYMM;
                        //訂單月份
                        data2.order_datetime = sDD;
                        //金額
                        data2.price_total = total;
                        data2.create_user = User.Identity.Name;
                        data2.create_datetime = DateTime.Now;

                        _DB.order_invoice2.Add(data2);
                        this._DB.SaveChanges();

                        msg = cler_date_YYMM + "-發票產出成功";
                    }
                    else
                    {
                        msg = "此月份無任何銷售，故無發票產出";
                    }
                }
            }

            TempData["jgrowl"] = msg;

            return RedirectToAction("InvoiceList", "NwOrder");
        }

        public ActionResult InvoiceList(string kw, DateTime? kw_time)
        {
            int currentPageIndex = 0;

            #region"主體"

            var Linq = Invoice_Send("");
            foreach (var item in Linq)
            {
                var Order_sub = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                if (Order_sub != null)
                {
                    var Order_Pro = this._DB.product_data.Where(m => m.product_id == Order_sub.product_id).FirstOrDefault();
                    //品牌
                    item.pro_web_name = Order_Pro != null ? Order_Pro.web_name : "";
                    //品名
                    item.info = Order_Pro != null ? Order_Pro.item_name : "";

                    //有使用折價卷
                    var solt_data = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                    if (solt_data != null)
                    {
                        item.visible_info = solt_data.number;
                        item.solt_price = solt_data.prize;
                    }
                }
            }

            #endregion

            #region"搜尋"

            //關鍵字
            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw) || m.order_id.ToString() == kw).ToList();
            }

            #endregion

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            if (data.TotalItemCount == 0) { TempData["jgrowl"] = "無發票"; };

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult InvoiceList_ajax(int? gid, int? page, string kw)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            #region"主體"

            var Linq = Invoice_Send("");
            foreach (var item in Linq)
            {
                var Order_sub = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                if (Order_sub != null)
                {
                    var Order_Pro = this._DB.product_data.Where(m => m.product_id == Order_sub.product_id).FirstOrDefault();
                    //品牌
                    item.pro_web_name = Order_Pro != null ? Order_Pro.web_name : "";
                    //品名
                    item.info = Order_Pro != null ? Order_Pro.item_name : "";

                    //有使用折價卷
                    var solt_data = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                    if (solt_data != null)
                    {
                        item.visible_info = solt_data.number;
                        item.solt_price = solt_data.prize;
                    }
                }
            }

            #endregion

            #region"搜尋"

            //關鍵字
            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw) || m.order_id.ToString() == kw).ToList();
            }

            #endregion

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            if (data.TotalItemCount == 0) { TempData["jgrowl"] = "無發票"; };

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return PartialView(RouteData.Values["action"].ToString(), data);
        }

