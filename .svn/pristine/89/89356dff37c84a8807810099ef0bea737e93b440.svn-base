        #region "待匯出列表"

        public ActionResult xxExportList(int? page, string kw)
        {
            ViewBag.jgrowl = TempData["jgrowl"];

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var Linq = this._DB.order_data.Where(m => m.visible && !m.export_datetime.HasValue);

            //信用卡(一定要付款)、貨到付款(藥局)
            Linq = Linq.Where(m => (m.pay_id == 3 && m.pay_visible) || (m.order_flag == 0 && m.pay_id == 1 && m.send_drug_id != 0));

            //Linq = Linq.Where(m => ((m.flag == 1 && m.pay_visible) || (m.flag == 5 && m.order_flag == 0) || (m.send_drug_id != 0 && m.pay_id == 1 && m.order_flag == 0)));

            //var Linq = this._DB.order_data.Where(m => m.visible == true && m.export_datetime == null && (m.flag == 1 || m.flag == 5 || (m.order_flag == 0 && m.send_drug_id != 0)) );

            sys_admin_data admin = NW.admin(User.Identity.Name); //店家
            if (admin.power_id > 2) { Linq = Linq.Where(m => m.company_id == admin.company_id); }

            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                kw = kw.ToLower();
                Linq = Linq.Where(m => m.send_name.ToLower().Contains(kw) || m.send_tel.Contains(kw) || m.order_id.ToString() == kw);
            }

            Linq = Linq.OrderByDescending(m => m.order_id);
            foreach (var item in Linq.ToList())
            {
                //訂單明細
                var sub_data = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                //商品
                var pro_data = this._DB.product_data.Where(m => m.product_id == sub_data.product_id).FirstOrDefault();
                if (sub_data != null)
                {

                    item.info = sub_data.item_name;
                    item.pro_web_name = pro_data.web_name;

                    //有使用折價卷
                    var solt_data = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                    if (solt_data != null)
                    {
                        item.visible_info = solt_data.number;
                        item.solt_price = solt_data.prize;
                    }
                }
            }

            var C = this._DB.company_data.Where(m => m.visible).ToList();
            ViewData["C"] = C;

            Session["export"] = Linq.Count();
            ViewBag.total = "總筆數：" + Linq.Count() + ", 總金額：" + Linq.Select(m => m.total).DefaultIfEmpty(0).Sum();

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString(), data);
            }
            else
            {
                return View(data);
            }

        }

        public ActionResult xxExportList_ajax(int? gid, int? page, string kw)
        {

            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            //var Linq = this._DB.order_data.Where(m => m.visible == true && m.flag == 1 && m.export_datetime == null);
            var Linq = this._DB.order_data.Where(m => m.visible == true && m.export_datetime == null && (m.flag == 1 || m.flag == 5 || (m.order_flag == 0 && m.send_drug_id != 0)));

            sys_admin_data admin = NW.admin(User.Identity.Name);
            if (admin.power_id > 2) { Linq = Linq.Where(m => m.company_id == admin.company_id); }

            if (!string.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.send_name.Contains(kw) || m.send_tel.Contains(kw) || m.order_id.ToString() == kw);
            }

            Linq = Linq.OrderByDescending(m => m.order_id);
            foreach (var item in Linq.ToList())
            {
                //訂單明細
                var sub_data = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                //商品
                var pro_data = this._DB.product_data.Where(m => m.product_id == sub_data.product_id).FirstOrDefault();
                if (sub_data != null)
                {

                    item.info = sub_data.item_name;
                    item.pro_web_name = pro_data.web_name;

                    //有使用折價卷
                    var solt_data = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                    if (solt_data != null)
                    {
                        item.visible_info = solt_data.number;
                        item.solt_price = solt_data.prize;
                    }
                }
            }

            IPagedList data = Linq.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            var C = this._DB.company_data.Where(m => m.visible).ToList();
            ViewData["C"] = C;

            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        [HttpPost]
        public ActionResult ExportListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "選擇匯出", "全部匯出", "作廢" };
            string msg = "匯出失敗，請洽系統工程師，謝謝!!";
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);
            string sql = "";

            string FileName = Export(cb_id);
            if (!string.IsNullOrEmpty(FileName))
            {
                int Admin_id = Convert.ToInt32(this.User.Identity.Name);
                var Company_Data = this._DB.drugstore_data.Where(m => m.admin_id == Admin_id).FirstOrDefault();
                if (Company_Data != null)
                {
                    sql = "Update order_data set export_datetime = getDate(), export_info='網站匯出：" + Company_Data.admin_id + "' Where visible=1 and export_datetime is null  and (flag=1 or flag =5 or (order_flag = 0 and send_drug_id != 0))";

                    //if (Company_Data.power_id <= 2)
                    //{
                    //    sql = "Update order_data set export_datetime = getDate(), export_info='網站匯出：" + Company_Data.admin_id + "' Where visible=1 and export_datetime is null  and (flag=1 or flag =5 or (order_flag = 0 and send_drug_id != 0))";

                    //}
                    //else 
                    //{
                    //    sql = "Update order_data set export_datetime = getDate(), export_info='網站匯出：" + Company_Data.admin_id + "' Where visible=1 and export_datetime is null  and (flag=1 or flag =5 or (order_flag = 0 and send_drug_id != 0))  and company_id = " + Company_Data.company_id + " ";

                    //}
                    //1為全部匯出
                    if (cb_flag != 1) { sql += " And order_id in (" + cb_id + ")"; }

                    if (sql != "")
                    {
                        _DB.Database.ExecuteSqlCommand(sql);
                    }
                }
                return File(FileName, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Today.ToString("yyyyMMdd") + ".xlsx"));
            }
            else
            {
                return Content(msg);
            }

            //TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
        }

        private string Export(string id)
        {
            sys_admin_data aData = NW.admin(User.Identity.Name);

            string value = "";
            string[] cols = "".Split(',');
            List<order_data> data;

            cols = "訂單貨號,購買日期,收件人,收件人電話,配送地址,商品名稱,數量,成本,商品貨號,訂單備註,訂單狀態,退貨管理,出貨日期(請用純文字格式ex:'2015/04/13),物流代號(請參考物流公司對照表),貨運單號,出貨備註(非必填，最多30字)".Split(',');

            //var Linq1 = this._DB.order_data.Where(m => m.visible && !m.export_datetime.HasValue);

            //信用卡(一定要付款)、貨到付款(藥局)
            //Linq1 = Linq1.Where(m => (m.pay_datetime.HasValue) || (m.order_flag == 0 && m.pay_id == 1 && m.send_drug_id != 0));

            var linq = this._DB.order_data.Where(m => m.visible);


            linq = linq.Where(m => !m.goods_datetime.HasValue);
            linq = linq.Where(m => !m.finish_datetime.HasValue);

            if (aData.power_id > 2)
            {
                linq = linq.Where(m => m.company_id == aData.company_id);
            }

            linq = linq.Where(m => m.pay_datetime.HasValue);

            //var Linq1 = this._DB.order_data.Where(m => m.visible == true && m.export_datetime == null && ((m.flag == 1 || m.flag == 5 || (m.order_flag == 0 && m.send_drug_id != 0)) || (m.flag == 0 && m.pay_id == 4)));

            if (!string.IsNullOrEmpty(id))
            {
                //文字陣列轉數字陣列
                int[] arrID = id.Split(',').Select((string s) => { int i; int.TryParse(s, out i); return i; }).ToArray();
                linq = linq.Where(m => arrID.Contains(m.order_id));
            }
            linq = linq.OrderBy(m => m.order_id);
            data = linq.ToList();

            //var marData = this._DB.news4_data.Where(m => m.visible).ToList();
            string msn = "";

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("訂單列表");
            int colIdx = 1;
            int rowIdx = 2;


            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            sheet.Cell(1, 13).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            sheet.Cell(1, 14).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            sheet.Cell(1, 15).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            sheet.Cell(1, 16).Style.Fill.BackgroundColor = XLColor.PaleTurquoise;

            string p = "'";

            foreach (var item in data)
            {
                var mData = this._DB.order_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                string name = mData.order_name;
                string freight_flag_name = item.freight_flag_name;

                if (!string.IsNullOrEmpty(freight_flag_name))
                {
                    foreach (string ss in freight_flag_name.Split(','))
                    {
                        var arr = ss.Split(':');
                        int iFright_id = 0;
                        string Fright_sn = "81006001";
                        switch (arr[0])
                        {
                            case "冷藏運費": iFright_id = 1; Fright_sn = "81006005"; break;
                            case "冷凍運費": iFright_id = 2; Fright_sn = "81006008"; break;

                        }

                        var idata = new order_sub { order_id = item.order_id };
                        idata.item_name = arr[0];
                        idata.item_no = Fright_sn;
                        //idata.price = Convert.ToInt32(arr[1]);
                        idata.num = 1;
                        idata.freight_id = iFright_id;
                        idata.freight_visible = true;
                        //item.order_sub.Add(idata);
                    }
                }

                item.order_sub = item.order_sub.OrderBy(m => m.freight_id).ToList();
                foreach (var subitem in item.order_sub)
                {
                    string ffname = "";
                    int num = subitem.num;
                    msn = !string.IsNullOrEmpty(item.order_sn) ? item.order_sn : "";

                    //var market = marData.Where(m => m.sn == msn).FirstOrDefault();
                    //string marname = market != null ? market.title.Replace(" ","") : "生鮮購";                    

                    if (subitem.freight_id >= 0 && subitem.freight_id < 3) { ffname = NW.FFName[subitem.freight_id]; }

                    //訂單編號
                    sheet.Cell(rowIdx, 1).Value = p + item.order_id;

                    //購買日期
                    sheet.Cell(rowIdx, 2).Value = p + ((DateTime)item.order_datetime).ToString("yyyy/MM/dd");

                    if (!string.IsNullOrEmpty(item.order_sn))
                    {
                        DateTime sdt1 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 8, 0, 0, 0, 0);
                        DateTime edt1 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 17, 0, 0, 0, 0);

                        DateTime sdt2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 17, 0, 0, 0, 0);
                        DateTime edt2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 8, 0, 0, 0, 0);
                        // DateTime gd2 = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 15, 0, 0);

                        DateTime gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 21, 0, 0, 0, 0);

                        if (item.order_datetime >= sdt1 && item.order_datetime < edt1)
                        {
                            sheet.Cell(rowIdx, 2).Value = p + gd.ToString("yyyy/MM/dd HH:mm");

                        }
                        else if (item.order_datetime >= sdt2 && item.order_datetime < edt2)
                        {
                            gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.AddDays(1).Day, 15, 0, 0, 0, 0);

                        }
                        else
                        {
                            gd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.Today.Day, 15, 0, 0, 0, 0);
                        }

                        sheet.Cell(rowIdx, 2).Value = p + gd.ToString("yyyy/MM/dd HH:mm");

                    }

                    //收件人-藥局
                    sheet.Cell(rowIdx, 3).Value = p + item.send_name;

                    //收件人電話
                    sheet.Cell(rowIdx, 4).Value = p + item.order_phone;

                    //配送地址
                    //sheet.Cell(rowIdx, 5).Value = p + item.send_zip + item.send_city + item.send_canton + item.send_address;
                    var zip = this._DB.zip_data.Where(m => m.zip == item.send_zip).FirstOrDefault();
                    zip = zip != null ? zip : new zip_data();
                    sheet.Cell(rowIdx, 5).Value = p + "(" + item.send_zip + ")" + zip.city + zip.canton + item.send_address;

                    //商品名稱
                    sheet.Cell(rowIdx, 6).Value = p + subitem.item_name;

                    //數量
                    sheet.Cell(rowIdx, 7).Value = p + subitem.num.ToString();

                    //成本
                    sheet.Cell(rowIdx, 8).Value = p + (subitem.product_id != 101 && subitem.product_id != 102 ? subitem.cost.ToString("N0") : "");

                    //商品貨號
                    sheet.Cell(rowIdx, 9).Value = p + subitem.item_no;

                    //訂單備註
                    sheet.Cell(rowIdx, 10).Value = p + item.info;

                    //訂單狀態
                    sheet.Cell(rowIdx, 11).Value = p + (item.flag == 2 ? "已出貨" : "未出貨");

                    //退貨管理
                    sheet.Cell(rowIdx, 12).Value = p;

                    //出貨日期(請用純文字格式ex:'2015/04/13)
                    sheet.Cell(rowIdx, 13).Style.Fill.BackgroundColor = XLColor.PastelYellow;

                    //物流代號(請參考物流公司對照表)
                    sheet.Cell(rowIdx, 14).Style.Fill.BackgroundColor = XLColor.PastelYellow;

                    //貨運單號
                    sheet.Cell(rowIdx, 15).Style.Fill.BackgroundColor = XLColor.PastelYellow;

                    //出貨備註(非必填，最多30字)
                    sheet.Cell(rowIdx, 16).Style.Fill.BackgroundColor = XLColor.PaleTurquoise;

                    rowIdx += 1;

                }
            }

            //自動伸縮欄寬
            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }

            //物流公司分頁
            sheet = workbook.Worksheets.Add("物流公司對照表");
            colIdx = 1;
            rowIdx = 2;

            string[] colname = { "物流代號", "物流公司名稱" };
            foreach (string cn in colname)
            {
                sheet.Cell(1, colIdx++).Value = cn;
            }
            //sheet.Cell(1, 1).Value = "物流代號";
            //sheet.Cell(1, 2).Value = "物流公司名稱";

            foreach (string fname in NW.FreightName)
            {
                sheet.Cell(rowIdx, 1).Value = p + (rowIdx - 1).ToString();
                sheet.Cell(rowIdx, 2).Value = p + fname;

                rowIdx++;
            }

            for (int a = 1; a <= colname.Length; a++)
            {
                sheet.Column(a).AdjustToContents();
            }

            value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");


            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }

