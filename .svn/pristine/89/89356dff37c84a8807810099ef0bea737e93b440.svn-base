        [HttpPost]
        public ActionResult GoodsListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "回復待出貨" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    //sql = "Update driver_data set visible = 1 Where driver_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update order_data set export_datetime = null, export_info = null Where order_id in (" + cb_id + ")";
                    break;
                case 0: //刪除                  
                    //sql = " Delete From driver_data Where driver_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        //匯入出貨單
        [HttpPost]
        public ActionResult GoodsAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                //string water = NW.getImgWater();
                //string tmpPath = Server.MapPath("~/Content/files/inport");
                //if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); }

                ////新的檔案名稱
                //string strFileName = water + Path.GetExtension(file_name.FileName);
                ////存放檔案路徑
                //string strFilePath = tmpPath + "/" + strFileName;
                ////檔案存放在Server
                //file_name.SaveAs(strFilePath);

                try
                {
                    // 建立一個工作簿 Office 2007 flag = 0 訂單資料

                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    ////2007
                    //XSSFWorkbook workbook = new XSSFWorkbook(FileUpload1.FileContent);
                    ////2003
                    //HSSFWorkbook workbook = new HSSFWorkbook(FileUpload1.FileContent);


                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            //出貨資料
                            if (sheet.GetRow(row).GetCell(0) != null)
                            {
                                //int order_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString());
                                //int sub_id = Convert.ToInt32(sheet.GetRow(row).GetCell(0).ToString());                                

                                string order_sn = sheet.GetRow(row).GetCell(0).ToString();
                                if (!string.IsNullOrEmpty(order_sn))
                                {

                                    DateTime? goods_datetime = Convert.ToDateTime(sheet.GetRow(row).GetCell(12).ToString());
                                    string freight_code = sheet.GetRow(row).GetCell(13).ToString();
                                    //string freight_name = "";
                                    string freight_no = sheet.GetRow(row).GetCell(14).ToString();
                                    string goods_info = sheet.GetRow(row).GetCell(15).ToString();

                                    var data = this._DB.order_data.Where(m => m.order_sn == order_sn).FirstOrDefault();
                                    var data2 = this._DB.order_sub.Where(m => m.order_id == data.order_id).FirstOrDefault();

                                    if (data != null)
                                    {
                                        if (!string.IsNullOrEmpty(freight_no))
                                        {

                                            var P = this._DB.product_data.Where(m => m.product_id == data2.product_id).FirstOrDefault();
                                            if (P != null)
                                            {
                                                P.inventory_num = P.inventory_num - data2.num;
                                            }

                                            int fno = Convert.ToInt32(freight_code);
                                            string zzz = NW.FreightName[fno - 1];

                                            data.goods_datetime = goods_datetime;
                                            data.freight_datetime = goods_datetime;
                                            data.freight_name = freight_code + ":" + NW.FreightName[fno - 1];
                                            data.freight_no = freight_no;
                                            data.goods_info = goods_info;

                                            if (!string.IsNullOrEmpty(freight_code) && data.finish_datetime == null) { data.flag = 2; }
                                            else
                                            {
                                                data.flag = 5;
                                            }
                                            this._DB.SaveChanges();

                                            var data3 = new order_goods
                                            {
                                                order_id = data.order_id,
                                                sub_id = data2.sub_id,
                                                name = zzz,
                                                sn = data.order_sn,
                                                num = data2.num,
                                                goods_datetime = goods_datetime,
                                                create_user = this.User.Identity.Name,
                                                create_datetime = create_datetime
                                            };

                                            this._DB.order_goods.Add(data3);
                                            this._DB.SaveChanges();
                                        }

                                    }


                                }


                                //if (order_id > 0 && sub_id > 0)
                                //{
                                //    if (!arrOrder_id.Contains(order_id)) { arrOrder_id.Add(order_id); }

                                //    string name = (sheet.GetRow(row).GetCell(1) != null) ? sheet.GetRow(row).GetCell(1).ToString() : "";
                                //    string sn = (sheet.GetRow(row).GetCell(2) != null) ? sheet.GetRow(row).GetCell(2).ToString() : "";
                                //    DateTime? goods_datetime;
                                //    int num = Convert.ToInt32(sheet.GetRow(row).GetCell(4).NumericCellValue);
                                //    var data = this._DB.order_goods.Where(m => m.order_id == order_id && m.sub_id == sub_id).FirstOrDefault();
                                //    if (data == null)
                                //    {
