        private IPagedList Order_Fininsh(int currentPageIndex, DateTime? start_date, DateTime? end_date)
        {
            var Linq = this._DB.order_data.Where(m => m.visible == true);

            sys_admin_data admin = NW.admin(User.Identity.Name);
            if (admin.power_id > 2) { Linq = Linq.Where(m => m.company_id == admin.company_id && m.flag >= 2); }
            else { Linq = Linq.Where(m => m.flag == 5); }

            #region"搜尋"
            if (start_date != null)
            {
                Linq = Linq.Where(m => m.finish_datetime >= start_date);
                ViewBag.start_date = start_date.Value.ToShortDateString();
            }
            if (end_date != null)
            {
                Linq = Linq.Where(m => m.finish_datetime <= end_date);
                ViewBag.end_date = end_date.Value.ToShortDateString();
            }
            #endregion

            //品牌+品名+健康紅利
            Product_Name(Linq.ToList());

            IPagedList data = Linq.OrderByDescending(m => m.order_id).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            return data;
        }

