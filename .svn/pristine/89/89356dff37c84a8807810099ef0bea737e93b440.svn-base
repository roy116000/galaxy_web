        //匯出發票
        private string Export2(string id, int? type = 0)
        {
            string value = "";
            string[] cols = "".Split(',');
            List<order_data> data;

            //DateTime eD = DateTime.Today.AddDays(-10);
            //cols = "訂單單號,發票號碼,商品名稱,稅別,統一編號,公司名稱,發票格式,銷售額,稅額,總額".Split(',');
            cols = "訂單單號,發票號碼,商品名稱,稅別,銷售額,稅額,總額".Split(',');

            //商品交付日+7
            DateTime eD = DateTime.Today.AddDays(-7);

            var Linq1 = Invoice_Send(id, type);

            //List<int> oid = new List<int> { };
            //var Linq1 = this._DB.order_data.Where(m => m.visible == true && m.order_flag == 1 && m.finish_datetime >=eD && m.back_flag == null);
            //var aa = Linq1.ToList();

            ////int view_day = 10;
            ////foreach (var item in Linq1)
            ////{
            ////    TimeSpan Total = eD.Subtract((DateTime)item.goods_datetime); //日期相減

            ////    if (Total.Days > view_day)
            ////    {
            ////        oid.Add(item.order_id);
            ////    }
            ////}

            //Linq1 = Linq1.Where(m => oid.Contains(m.order_id));

            //sys_admin_data admin = NW.admin(User.Identity.Name);
            //if (admin.power_id > 2) { Linq1 = Linq1.Where(m => m.company_id == admin.company_id); }

            ////測試用
            ////var Linq1 = this._DB.order_data.Where(m => m.order_id>0);
            if (!string.IsNullOrEmpty(id))
            {
                //文字陣列轉數字陣列
                int[] arrID = id.Split(',').Select((string s) => { int i; int.TryParse(s, out i); return i; }).ToArray();
                Linq1 = Linq1.Where(m => arrID.Contains(m.order_id)).ToList();
            }
            //Linq1 = Linq1.OrderBy(m => m.order_id);

            data = Linq1.ToList();

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("待開發票列表");
            int colIdx = 1;
            int rowIdx = 2;

            //標頭
            foreach (string colName in cols)
            {
                if (colIdx == 8)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.DodgerBlue;
                }
                else if (colIdx == 9)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.PaleGreen;
                }
                else if (colIdx == 10)
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.CandyPink;
                }
                else
                {
                    sheet.Cell(1, colIdx).Style.Fill.BackgroundColor = XLColor.PastelYellow;
                }

                sheet.Cell(1, colIdx++).Value = colName;
            }

            string p = "'";
            double money = 0;
            foreach (var item in data)
            {
                //健康紅利
                int bouns_solt = 0;
                var solt = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                if (solt != null)
                {
                    bouns_solt = solt.prize;
                }

                sheet.Cell(rowIdx, 1).Value = p + item.order_id.ToString(); //訂單單號
                sheet.Cell(rowIdx, 2).Value = p;                           //發票號碼


                //無統編，不需計算稅額
                if (string.IsNullOrEmpty(item.inv_sn))
                {
                    sheet.Cell(rowIdx, 2).Value = p + item.invoice_no;
                    //sheet.Cell(rowIdx, 5).Value = p;
                    //sheet.Cell(rowIdx, 6).Value = p;
                    //sheet.Cell(rowIdx, 7).Value = p + "2聯";
                    sheet.Cell(rowIdx, 5).Value = p + (item.total - item.bonus - bouns_solt).ToString("N0");
                    sheet.Cell(rowIdx, 6).Value = p + "0";
                    sheet.Cell(rowIdx, 7).Value = p + (item.total - item.bonus - bouns_solt).ToString("N0");

                    foreach (var subitem in item.order_sub.OrderBy(m => m.sub_id))
                    {

                        sheet.Cell(rowIdx, 3).Value = p + (subitem.product_data != null ? subitem.product_data.web_name + "-" + subitem.product_data.item_name : "查無商品");

                        sheet.Cell(rowIdx, 4).Value = p + "應稅";           //稅別
                        //switch (subitem.product_data.tax_flag)
                        //{
                        //    case 0:
                        //        sheet.Cell(rowIdx, 4).Value = p + "應稅";           //稅別
                        //        break;
                        //    case 1:
                        //        sheet.Cell(rowIdx, 4).Value = p + "免稅";           //稅別
                        //        break;
                        //}

                        //if (subitem.product_id == 101 || subitem.product_id == 102)
                        //{

                        //    sheet.Cell(rowIdx, 8).Value = p + item.bonus.ToString("N0");
                        //    sheet.Cell(rowIdx, 9).Value = p + "0";
                        //    sheet.Cell(rowIdx, 10).Value = p + item.bonus.ToString("N0");
                        //}

                        rowIdx++;
                    }

                    if (item.freight != 0)
                    {

                        sheet.Cell(rowIdx, 3).Value = p + "運費";
                        sheet.Cell(rowIdx, 4).Value = p + "應稅";
                        sheet.Cell(rowIdx, 8).Value = p + item.freight.ToString("N0");
                        sheet.Cell(rowIdx, 9).Value = p + "0";
                        sheet.Cell(rowIdx, 10).Value = p + item.freight.ToString("N0");
                        rowIdx++;
                    }

                }
                else
                {
                    //銷售額(應稅)
                    money = item.total - item.freight - bouns_solt;
                    money = Math.Round(money / 1.05, MidpointRounding.AwayFromZero);

                    sheet.Cell(rowIdx, 5).Value = p + item.inv_sn;
                    sheet.Cell(rowIdx, 6).Value = p + item.inv_title;
                    sheet.Cell(rowIdx, 7).Value = p + "3聯";
                    //銷售額
                    sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                    //稅額
                    sheet.Cell(rowIdx, 9).Value = p + (item.total - item.freight - money).ToString("N0");
                    //總額
                    sheet.Cell(rowIdx, 10).Value = p + (item.total - item.freight).ToString("N0");


                    foreach (var subitem2 in item.order_sub.OrderBy(m => m.sub_id))
                    {
                        if (!string.IsNullOrEmpty(subitem2.style_name))
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem2.product_data.item_name + "-" + subitem2.style_name;
                        }
                        else
                        {
                            sheet.Cell(rowIdx, 3).Value = p + subitem2.product_data.item_name;
                        }

                        switch (subitem2.product_data.tax_flag)
                        {
                            case 0:
                                sheet.Cell(rowIdx, 4).Value = p + "應稅";           //稅別
                                break;
                            case 1:
                                sheet.Cell(rowIdx, 4).Value = p + "免稅";           //稅別
                                break;
                        }

                        //if (subitem2.product_id == 101 || subitem2.product_id == 102)
                        //{
                        //    money = Math.Round(item.bonus / 1.05, MidpointRounding.AwayFromZero);

                        //    sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                        //    sheet.Cell(rowIdx, 9).Value = p + (item.bonus - money).ToString("N0");
                        //    sheet.Cell(rowIdx, 10).Value = p + item.bonus.ToString("N0");
                        //}

                        rowIdx++;
                    }

                    if (item.freight != 0)
                    {

                        money = Math.Round(item.freight / 1.05, MidpointRounding.AwayFromZero);

                        sheet.Cell(rowIdx, 3).Value = p + "運費";
                        sheet.Cell(rowIdx, 4).Value = p + "應稅";
                        sheet.Cell(rowIdx, 8).Value = p + money.ToString("N0");
                        sheet.Cell(rowIdx, 9).Value = p + (item.freight - money).ToString("N0");
                        sheet.Cell(rowIdx, 10).Value = p + item.freight.ToString("N0");

                        rowIdx++;
                    }

                }

            }

            sheet.Cell(rowIdx, 6).Style.Fill.BackgroundColor = XLColor.CoralPink;
            sheet.Cell(rowIdx, 7).Style.Fill.BackgroundColor = XLColor.CoralPink;
            sheet.Cell(rowIdx, 6).Value = p + "總額";
            sheet.Cell(rowIdx, 7).Value = p + data.Sum(m => m.total - m.bonus).ToString("N0");

            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }


            value = Server.MapPath("~/Content/files/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }
        //匯入發票
        [HttpPost]
        public ActionResult InvoiceAddSave(HttpPostedFileBase file_name)
        {

            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {
                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });

                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        if (sheet.GetRow(row).GetCell(0) != null) // 驗證是不是空白列
                        {
                            string oid = sheet.GetRow(row).GetCell(0).ToString();
                            string invoice_no = sheet.GetRow(row).GetCell(1).ToString();
                            string invoice_tax = sheet.GetRow(row).GetCell(3).ToString();

                            int order_id = Convert.ToInt32(oid);
                            var data = this._DB.order_data.Where(m => m.order_id == order_id).FirstOrDefault();
                            var data2 = this._DB.order_sub.Where(m => m.order_id == order_id).FirstOrDefault();

                            if (!string.IsNullOrEmpty(invoice_no))
                            {
                                data.invoice_no = invoice_no;
                                data.invoice_datetime = DateTime.Now;
                                //data.flag = 5;

                                order_invoice data3 = new order_invoice { };
                                data3.order_id = data.order_id;
                                data3.sub_id = data2.sub_id;
                                data3.invoice = invoice_no;
                                data3.tax = invoice_tax;
                                data3.invoice_datetime = DateTime.Now;
                                data3.create_user = User.Identity.Name;
                                data3.create_datetime = DateTime.Now;
                                this._DB.order_invoice.Add(data3);

                                this._DB.SaveChanges();
                            }

                        }
                    }

                    TempData["jgrowl"] = "資料匯入成功";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("InvoiceList");
        }

