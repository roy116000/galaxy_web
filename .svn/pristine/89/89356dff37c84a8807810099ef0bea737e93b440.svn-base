        public ActionResult xxGoodsList(string kw)
        {
            int currentPageIndex = 0;

            var Linq = this._DB.order_data.Where(m => m.visible == true && m.export_datetime != null && m.goods_datetime == null && (m.flag == 1 || m.flag == 5 || (m.order_flag == 0 && m.send_drug_id != 0)));

            sys_admin_data admin = NW.admin(User.Identity.Name);
            if (admin.power_id > 2) { Linq = Linq.Where(m => m.company_id == admin.company_id); }

            Linq = Linq.OrderByDescending(m => m.order_id);
            foreach (var item in Linq.ToList())
            {
                //訂單明細
                var sub_data = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault();
                //商品
                var pro_data = this._DB.product_data.Where(m => m.product_id == sub_data.product_id).FirstOrDefault();
                if (sub_data != null)
                {

                    item.info = sub_data.item_name;
                    item.pro_web_name = pro_data.web_name;

                    //有使用折價卷
