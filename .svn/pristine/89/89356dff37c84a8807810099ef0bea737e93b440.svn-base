        #region"退貨列表"

        //目前頁數, Linq, 關鍵字, 起始時間, 結束時間, 發票狀態
        private IPagedList Order_Back(int currentPageIndex, IQueryable<order_data> Linq, string kw, DateTime? start_date, DateTime? end_date, string Flag_Invo)
        {

            #region"下拉選單"

            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇狀態", false));
            ListItems.Add(new ListItem("0", "審核中", Flag_Invo == "0"));
            ListItems.Add(new ListItem("1", "未開發票", Flag_Invo == "1"));
            ListItems.Add(new ListItem("2", "已開發票", Flag_Invo == "2"));
            ListItems.Add(new ListItem("3", "無折讓", Flag_Invo == "3"));
            ViewData["Flag_Invo"] = ListItems;

            #endregion

            #region"搜尋"

            var Admin = NW.admin(User.Identity.Name);
            if (Admin.power_id > 2)
            {
                Linq = Linq.Where(m => m.company_id == Admin.company_id);
            }
            if (!string.IsNullOrEmpty(Flag_Invo))
            {
                switch (Flag_Invo)
                {
                    case "0":
                        Linq = Linq.Where(m => m.backok_datetime == null);
                        break;
                    case "1":
                        DateTime dd = new DateTime(2010, 1, 1);
                        Linq = Linq.Where(m => m.back_flag != 0 && (m.invoice_datetime != null ? m.invoice_datetime : dd) < m.back_datetime);
                        break;
                    case "2":
                        Linq = Linq.Where(m => m.back_flag != 0 && m.invoice_datetime > m.back_datetime);
                        break;
                    case "3":
                        Linq = Linq.Where(m => m.back_flag == 0 && m.backok_datetime != null);
                        break;
                }

            }
            if (!string.IsNullOrEmpty(kw)) //關鍵字
            {
                Linq = Linq.Where(m => m.order_id.ToString().Contains(kw) || m.order_name.Contains(kw) || m.order_phone.Contains(kw) || m.send_name.Contains(kw) || m.send_tel.Contains(kw));
                ViewBag.kw = kw;
            }
            if (start_date.HasValue) //申請退貨時間-起始
            {
                Linq = Linq.Where(m => m.back_datetime >= start_date);

            }
            if (end_date.HasValue) //申請退貨時間-結束
            {
                Linq = Linq.Where(m => m.back_datetime <= end_date);

            }

            var Flag = Linq.ToLookup(m => m.back_flag == 0);
            ViewBag.total = "目前筆數：" + Linq.Count() + "筆, 正常：" + Flag[true].Count() + "筆, 異常：" + Flag[false].Count() + "筆";

            #endregion

            //品牌+品名+健康紅利
            Product_Name(Linq.ToList());

            IPagedList data = Linq.OrderByDescending(m => m.back_datetime).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.start_date = (start_date != null ? start_date : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)).Value.ToString("yyyy/MM/dd");
            ViewBag.end_date = (end_date != null ? end_date : DateTime.Today).Value.ToString("yyyy/MM/dd");

            return data;
        }

