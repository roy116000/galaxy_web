        [HttpPost]
        public ActionResult InvoiceListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "選擇匯出", "全部匯出", "作廢" };
            string msg = "匯出失敗，請洽系統工程師，謝謝!!";
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            if (cb_flag == 1) { cb_id = ""; }

            string FileName = Export2(cb_id);

            if (!string.IsNullOrEmpty(FileName))
            {
                return File(FileName, "application/vnd.ms-excel", Server.UrlPathEncode(DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx"));

