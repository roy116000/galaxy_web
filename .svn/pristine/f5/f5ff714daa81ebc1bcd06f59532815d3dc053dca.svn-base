        //
        // GET: /newweb/NwNews/

        #region "產業新聞"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.industry_data
                           join m2 in _DB.industry_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.news_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;


            var aa = tmpData.ToList();

            //IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);
            IPagedList data = tmpData.ToPagedList(0, 20);


            var data2 = this._DB.industry_group.OrderBy(m => m.inx)
                        .Select(m => new data_group()
                        {
                            group_id = m.group_id,
                            name = m.name,
                            counts = m.industry_data.Count()
                        });

            ViewData["news_group"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.industry_data
                           join m2 in _DB.industry_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.news_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult Edit(int id)
        {

            var data = this._DB.industry_data.Find(id);
            data.img = NW.Path_Img(data.img, "industrynews");
            //下拉選單
            var gData = (from m in _DB.industry_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(industry_data industry_data, HttpPostedFileBase img)
        {
            var data = this._DB.industry_data.Find(industry_data.news_id);
            //var data1 = this._DB.news_data.Where(m => m.news_id.Equals(news_data.news_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                #region"圖片專區"

                if (img != null && img.ContentLength > 0 && NW.getFileType(img, 1)) //有無上傳
                {

                    string tmpPath = Server.MapPath("~/Content/images/industrynews"); //存放路徑
                    if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); } //建資料夾

                    //var Group = this._DB.adv_group.Where(m => m.group_id == adv_data.group_id).FirstOrDefault();

                    data.img = Images.Helps.ImageHelper.Rebmp(img, tmpPath, 400, 300);
                }

                #endregion

                // data.news_id = news_data.news_id;
                data.group_id = industry_data.group_id;
                data.title = industry_data.title;
                data.cont = industry_data.cont;
                data.cont2 = industry_data.cont2;
                data.inx = industry_data.inx;
                data.hits = industry_data.hits;
                data.start_date = industry_data.start_date;
                data.end_date = industry_data.end_date;
                data.visible = industry_data.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news_data.create_user;
                //data.create_datetime = news_data.create_datetime;

                this._DB.SaveChanges();

                

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = industry_data.news_id });
        }

        public ActionResult Add(int id)
        {
            industry_data data = new industry_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);

            //圖片
            ViewData["UploadImage"] = new images_data();
            //ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.industry_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;


            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(industry_data industry_data, HttpPostedFileBase img)
        {
            //var data = this._DB.news_data.Find(news_data.news_id);
            //var data1 = this._DB.news_data.Where(m => m.news_id.Equals(news_data.news_id)).Select(m => m).SingleOrDefault();
            var data = new industry_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                #region"圖片專區"

                if (img != null && img.ContentLength > 0 && NW.getFileType(img, 1)) //有無上傳
                {

                    string tmpPath = Server.MapPath("~/Content/images/industrynews"); //存放路徑
                    if (!Directory.Exists(tmpPath)) { Directory.CreateDirectory(tmpPath); } //建資料夾

                    //var Group = this._DB.adv_group.Where(m => m.group_id == adv_data.group_id).FirstOrDefault();

                    data.img = Images.Helps.ImageHelper.Rebmp(img, tmpPath, 400, 300);
                }

                #endregion

                // data.news_id = news_data.news_id;
                data.group_id = industry_data.group_id;
                data.title = industry_data.title;
                data.cont = industry_data.cont;
                data.cont2 = industry_data.cont2;
                data.inx = industry_data.inx;
                data.hits = industry_data.hits;
                data.start_date = industry_data.start_date;
                data.end_date = industry_data.end_date;
                data.visible = industry_data.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.industry_data.Add(data);
                this._DB.SaveChanges();

                industry_data.news_id = data.news_id;

                
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = industry_data.news_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update industry_data set visible = 1 Where news_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update industry_data set visible = 0 Where news_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From industry_image Where news_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From industry_data Where news_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "分類列表"

        public ActionResult GroupList(string kw)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.industry_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.industry_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

