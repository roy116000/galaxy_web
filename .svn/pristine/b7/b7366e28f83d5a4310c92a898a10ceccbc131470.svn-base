using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.ComponentModel;
using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

using System.Web.Mvc;

namespace h365_web.Models
{
    //加盟後台-訂單用

    public class order_data_n
    {
        [Key]
        [DisplayName("編號")]
        public int order_id { get; set; }

        [DisplayName("廠商編號")]
        public int company_id { get; set; }

        [DisplayName("訂購人編號")]
        public int admin_id { get; set; }

        [DisplayName("狀態")]
        public int flag { get; set; }

        [DisplayName("總售價")]
        public decimal total { get; set; }

        [DisplayName("總成本")]
        public decimal cost_total { get; set; }

        [DisplayName("啟用")]
        public bool visible { get; set; }

        [DisplayName("啟用備註")]
        public string visible_info { get; set; }

        [DisplayName("訂單序號")]
        public string order_sn { get; set; }

        [DisplayName("訂購方姓名")]
        public string order_name { get; set; }

        [DisplayName("訂購方電話")]
        public string order_phone { get; set; }

        [DisplayName("訂購方性別")]
        public int order_sex { get; set; }

        [DisplayName("寄送方姓名")]
        public string send_name { get; set; }

        [DisplayName("寄送方電話")]
        public string send_phone { get; set; }

        [DisplayName("寄送方性別")]
        public int send_sex { get; set; }

        [DisplayName("寄送方郵遞")]
        public int send_zip { get; set; }

        [DisplayName("寄送方地址")]
        public string send_address { get; set; }

        [DisplayName("訂購時間")]
        public DateTime? order_datetime { get; set; }

        [DisplayName("訂購備註")]
        public string order_info { get; set; }

        [DisplayName("付款時間")]
        public DateTime? pay_datetime { get; set; }

        [DisplayName("付款備註")]
        public string pay_info { get; set; }

        [DisplayName("匯出時間")]
        public DateTime? export_datetime { get; set; }

        [DisplayName("匯出備註")]
        public string export_info { get; set; }

        [DisplayName("出貨時間")]
        public DateTime? freight_datetime { get; set; }

        [DisplayName("出貨編號")]
        public int freight_id { get; set; }

        [DisplayName("出貨單號")]
        public string freight_no { get; set; }

        [DisplayName("退貨時間")]
        public DateTime? back_datetime { get; set; }

        [DisplayName("退貨備註")]
        public string back_info { get; set; }

        [DisplayName("退貨金額")]
        public decimal back_total { get; set; }

        [DisplayName("退貨完成時間")]
        public DateTime? backed_datetime { get; set; }

        [DisplayName("退貨完成備註")]
        public string backed_info { get; set; }

        [DisplayName("發票時間")]
        public DateTime? invoice_datetime { get; set; }

        [DisplayName("發票號碼")]
        public string invoice_no { get; set; }

        [DisplayName("訂單完成時間")]
        public DateTime? finish_datetime { get; set; }

        [DisplayName("裝置")]
        public string device { get; set; }

        [DisplayName("IP")]
        public string ip { get; set; }

    }

    public class order_sub_n
    {
        [Key]
        public int sub_id { get; set; }

        [DisplayName("訂單編號")]
        public int order_id { get; set; }

        [DisplayName("商品編號")]
        public int product_id { get; set; }

        [DisplayName("商品名稱")]
        public string item_name { get; set; }

        [DisplayName("售價")]
        public decimal price { get; set; }

        [DisplayName("成本")]
        public decimal cost { get; set; }

        [DisplayName("數量")]
        public int num { get; set; }

        [DisplayName("建立者")]
        public string create_user { get; set; }

        [DisplayName("建立時間")]
        public DateTime? create_datetime { get; set; }

    }

    //物流
    public class freight_data 
    {
        [Key]
        public int freight_id { get; set; }

        public string name { get; set; }

        public bool visible { get; set; }

        public int inx { get; set; }

        public string create_user { get; set; }

        public DateTime? create_datetime { get; set; }

        public string change_user { get; set; }

        public DateTime? change_datetime { get; set; }
    }

}