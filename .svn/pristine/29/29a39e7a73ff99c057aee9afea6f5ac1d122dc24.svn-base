        public ActionResult GroupAdd(int id)
        {
            news_group data = new news_group();
            data.inx = 0;
            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult GroupAddSave(news_group news_group, VmImage imgs)
        {
            //var data = this._DB.news_group.Find(news_group.zz_id);
