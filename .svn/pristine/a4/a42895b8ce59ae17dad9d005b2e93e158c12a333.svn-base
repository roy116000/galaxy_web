        #region"新增修改"

        public health_symptom_data P_AoE(int id)
        {
            var data = this._DB.health_symptom_data.Where(m => m.symptom_id == id).FirstOrDefault(); //分類資料
            data = data != null ? data : new health_symptom_data { };
            if (data.symptom_id == 0)
            {
                data.visible = true;
                data.inx = 0;
            }


            var ListItems = new List<ListItem> { };

            #region"部位-複選"

            var Group_All = this._DB.health_symptom_group.Where(m => m.visible).ToLookup(m => ("," + data.group_id + ",").Contains("," + m.group_id.ToString() + ","));
            ViewData["group_id_s"] = Group_All[true].ToDictionary(m => m.group_id, m => m.name);

            var group_No = Group_All[false].Select(m => m.group_id + "," + m.name).ToArray();
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            ListItems.AddRange(NW.sList(group_No));
            ViewData["group_id"] = ListItems;

            #endregion

            #region"關聯"

            ListItems = new List<ListItem> { };

            string[] S_Tag = !string.IsNullOrEmpty(data.tag) ? data.tag.Split(',') : new string[]{};

            var Tags = this._DB.tag_data.Where(m => m.visible).OrderBy(m => m.tag_name.Length).ToLookup(m => S_Tag.Contains(m.tag_id.ToString()));

            var Y = Tags[true].ToDictionary(m => m.tag_id, m => m.tag_name);
            ViewData["tag_s"] = Y;

            var N = Tags[false].Select(m => m.tag_id + "," + m.tag_name).ToArray();
            ListItems.Add(new ListItem("", "請選擇", false));
            ListItems.AddRange(NW.sList(N));
            ViewData["tag"] = ListItems;

            #endregion

            ViewBag.jgrowl = TempData["jgrowl"];
            return data;
        }

        public ActionResult Add(int id)
        {
            var data = P_AoE(id);

            return View(data);
        }

        public ActionResult Edit(int id)
        {

            var data = P_AoE(id);

            return View(data);
        }

        #endregion

        #region"儲存"

        public health_symptom_data P_Save(health_symptom_data health_symptom_data)
        {
            var data = this._DB.health_symptom_data.Where(m => m.symptom_id == health_symptom_data.symptom_id).FirstOrDefault();
            data = data != null ? data : new health_symptom_data { };

            data.title = health_symptom_data.title;
            data.inx = health_symptom_data.inx;
            data.visible = health_symptom_data.visible;
            data.group_id = health_symptom_data.group_id_s != null ? health_symptom_data.group_id_s.Trim(',') : null;

            data.cont = health_symptom_data.cont; //概述
            data.tag = health_symptom_data.tag_s != null ? health_symptom_data.tag_s.Trim(',') : null; //關聯;

            data.d1_title = health_symptom_data.d1_title;
            data.d1_content = health_symptom_data.d1_content;

            //data.d2_title = health_symptom_data.d2_title;
            //data.d2_content = health_symptom_data.d2_content;
            //data.d3_title = health_symptom_data.d3_title;
            //data.d3_content = health_symptom_data.d3_content;
            //data.d4_title = health_symptom_data.d4_title;
            //data.d4_content = health_symptom_data.d4_content;
            //data.d5_title = health_symptom_data.d5_title;
            //data.d5_content = health_symptom_data.d5_content;
            //data.d6_title = health_symptom_data.d6_title;
            //data.d6_content = health_symptom_data.d6_content;
            //data.d7_title = health_symptom_data.d7_title;
            //data.d7_content = health_symptom_data.d7_content;



            if (data.symptom_id == 0)
            {
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;
                this._DB.health_symptom_data.Add(data);

                TempData["jgrowl"] = "資料新增成功!!";
            }
            else
            {
                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;

                TempData["jgrowl"] = "資料更新成功";
            }

            this._DB.SaveChanges();

            return data;
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(health_symptom_data health_symptom_data)
        {
            var data = P_Save(health_symptom_data);

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = data.symptom_id });
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(health_symptom_data health_symptom_data)
        {
            var data = P_Save(health_symptom_data);

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = data.symptom_id });
        }

