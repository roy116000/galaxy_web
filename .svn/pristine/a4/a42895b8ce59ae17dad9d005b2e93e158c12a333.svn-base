            var data = new author_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.news_id = news_data.news_id;
                data.group_id = author_data.group_id;
                data.title = author_data.title;
                if (!string.IsNullOrEmpty(author_data.info))
                {
                    if (author_data.info.Length > 255)
                    {
                        author_data.info = author_data.info.Substring(0, 254);
                    }
                }
                data.info = author_data.info;
                data.cont = author_data.cont;
                data.cont2 = author_data.cont2;
                data.inx = author_data.inx;
                //data.hits = author_data.hits;
                data.start_date = author_data.start_date;
                data.end_date = author_data.end_date;
                data.visible = author_data.visible;

                data.tags = author_data.tags;

                data.place = author_data.place;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.author_data.Add(data);
                this._DB.SaveChanges();

                author_data.author_id = data.author_id;

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new author_image();
                        imgData.author_id = data.author_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.author_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.author_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.author_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.author_id = author_data.author_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = author_data.author_id });
        }

        [HttpPost]
        public ActionResult AuthorListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update author_data set visible = 1 Where author_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update author_data set visible = 0 Where author_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From author_image Where author_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From author_data Where author_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #endregion


        

    }
}
