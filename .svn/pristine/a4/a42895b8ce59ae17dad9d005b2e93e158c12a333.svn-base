        public ActionResult AuthorList(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.author_data
                           join m2 in _DB.author_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.author_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               create_user = m.place,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.create_user.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            var data2 = this._DB.news_group.OrderBy(m => m.inx)
                        .Select(m => new data_group()
                        {
                            group_id = m.group_id,
                            name = m.name,
                            counts = m.news_data.Count()
                        });

            ViewData["news_group"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult AuthorList_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.author_data
                           join m2 in _DB.author_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.author_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult AuthorEdit(int id)
        {

            var data = this._DB.author_data.Find(id);

            //圖片
            var image = _DB.author_image.Where(m => m.author_id.Equals(id)).ToList();
            List<images_data> imgData = new List<images_data>();
            foreach (var item in image)
            {
                images_data imgs_data = new images_data();
                imgs_data.imgs_id = item.imgs_id;
                imgs_data.s_img = item.s_img;
                imgs_data.b_img = item.b_img;
                imgs_data.img_info = item.img_info;
                imgs_data.img_inx = item.img_inx;
                imgData.Add(imgs_data);
            }
            ViewData["uploadimage2"] = imgData;

            //下拉選單
            var gData = (from m in _DB.author_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AuthorEditSave(author_data author_data, VmImage imgs)
        {
            var data = this._DB.author_data.Find(author_data.author_id);
            //var data1 = this._DB.news_data.Where(m => m.news_id.Equals(news_data.news_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.news_id = news_data.news_id;
                data.group_id = author_data.group_id;
                data.title = author_data.title;

                if (!string.IsNullOrEmpty(author_data.info))
                {
                    if (author_data.info.Length > 255)
                    {
                        author_data.info = author_data.info.Substring(0, 254);
                    }
                }

                data.info = author_data.info;
                data.cont = author_data.cont;
                data.cont2 = author_data.cont2;
                data.inx = author_data.inx;
                //data.hits = author_data.hits;
                data.start_date = author_data.start_date;
                data.end_date = author_data.end_date;
                data.visible = author_data.visible;

                data.tags = author_data.tags;

                data.place = author_data.place;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news_data.create_user;
                //data.create_datetime = news_data.create_datetime;

                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new author_image();
                        imgData.author_id = data.author_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.author_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.author_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.author_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.author_id = author_data.author_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = author_data.author_id });
        }

        public ActionResult AuthorAdd(int id)
        {
            author_data data = new author_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(5);

            //圖片
            //ViewData["UploadImage"] = new images_data();
            ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.author_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;


            data.visible = true;
            return View(data);
        }

