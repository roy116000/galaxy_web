        #region"器官系列表"

        #region"列表"

        public IPagedList P_Organ_List(int? page, string kw, int? gid)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var linq = this._DB.health_symptom_group.Where(m => m.group_id > 0);
            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                linq = linq.Where(m => m.name.Contains(kw));
            }
            if (gid.HasValue)
            {
                ViewBag.gid = gid;
                linq = linq.Where(m => ("," + m.part_id + ",").Contains("," + gid + ","));
            }

            foreach (var item in linq.ToList())
            {
                var A = this._DB.health_part.Where(m => ("," + item.part_id + ",").Contains("," + m.part_id.ToString() + ",")).ToList();

                item.counts = A.Count(); //數量
                item.related_name = string.Join("、", A.Select(m => m.name)); //相關的名字
            }

            IPagedList data = linq.OrderBy(m => m.create_datetime).ToPagedList(currentPageIndex, 50);

            #region"選單"

            var ListItems = new List<ListItem> { };
            var gData = this._DB.health_part.Where(m => m.visible).OrderBy(m => m.name.Length).ThenBy(m => m.part_id).ToList();
            foreach (var item in gData)
            {
                item.counts = this._DB.health_symptom_group.Where(m => ("," + m.part_id + ",").Contains("," + item.part_id + ",")).Count();                  
            }
           
            string[] a = gData.Select(m => m.part_id + "," + m.name + " 【" + m.counts + "】").ToArray();
            ListItems.Add(new ListItem("", "請選擇", false));
            ListItems.AddRange(NW.sList(a, gid.ToString()));

            ViewData["gData"] = ListItems;

            #endregion

            ViewBag.jgrowl = TempData["jgrowl"];
            return data;
        }

        public ActionResult OrganList(string kw, int? gid)
        {
            var data = P_Organ_List(null, kw, gid);

            return View(data);
        }

        public ActionResult OrganList_ajax(int? page, string kw, int? gid)
