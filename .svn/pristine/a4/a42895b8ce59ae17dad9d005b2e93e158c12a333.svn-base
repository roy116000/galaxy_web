        public ActionResult List(int? page, int? gid, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var G = this._DB.health_symptom_group.Where(m => m.visible).ToList();
            ViewData["G"] = G;
            

            var linq = this._DB.health_symptom_data.Where(m => m.symptom_id > 0);

            //#region"選單"

            //var ListItems = new List<ListItem> { };
            //var gData = G.Where(m => m.visible).OrderBy(m => m.name.Length).ThenBy(m => m.group_id).ToList();
            //foreach (var item in gData)
            //{
            //    item.counts = linq.Where(m => ("," + m.group_id + ",").Contains("," + item.group_id + ",")).Count();
            //}

            //string[] a = gData.Select(m => m.group_id + "," + m.name + " 【" + m.counts + "】").ToArray();
            //ListItems.Add(new ListItem("", "請選擇", false));
            //ListItems.AddRange(NW.sList(a, gid.ToString()));

            //ViewData["gData"] = ListItems;

            //#endregion

           
            if (gid.HasValue)
            {
                ViewBag.gid = gid;
                linq = linq.Where(m => ("," + m.group_id + ",").Contains("," + gid + ","));
            }
            if (!string.IsNullOrEmpty(kw))
            {
                ViewBag.kw = kw;
                linq = linq.Where(m => m.title.Contains(kw) || m.d1_title.Contains(kw) || m.d1_content.Contains(kw));
            }
        
            var data = linq.OrderBy(m => m.symptom_id).ToPagedList(currentPageIndex, 50);
                     
            ViewBag.jgrowl = TempData["jgrowl"];

            if (page.HasValue)
            {
                return PartialView(RouteData.Values["action"].ToString() + "_ajax", data);
            }
            else
            {
                return View(data);
            }
        }
    
