        #region"文章列表"

        public ActionResult NewsList(int? gid, string kw)
        {
            int currentPageIndex = 0;

            #region"主體"

            var Linq = this._DB.health_news.Where(m => m.news_id > 0);
            foreach (var item in Linq.ToList())
            {
                if (item.parent_ids != null)
                {

                    string parents = "," + item.parent_ids + ",";
                    var Parent = this._DB.health_data.Where(m => parents.Contains("," + m.health_id.ToString() + ",")).ToDictionary(m => m.health_id, m => m.title);
                    string[] P_Values = Parent.Values.ToArray(); //Dictionary to ToArray
                    if (P_Values.Count() > 0)
                    {
                        item.parent_idx = P_Values.Aggregate((m, n) => m + "," + n);  //累加填寫     
                    }
                }


            }

            #endregion

            #region"搜尋"

            if (gid.HasValue) //分類
            {
                Linq = Linq.Where(m => ("," + m.parent_ids + ",").Contains("," + gid.ToString() + ","));
            }

            if (!string.IsNullOrEmpty(kw)) //關鍵字
            {
                Linq = Linq.Where(m => m.title.Contains(kw));
            }

            #endregion

            #region"下拉選單"

            //選單
            List<ListItem> Listitems = new List<ListItem> { };
            Listitems.Add(new ListItem("", "全部", false));
            var Part = this._DB.health_data.Where(m => m.visible).ToDictionary(m => m.health_id, m => m.title);
            foreach (var item in Part)
            {
                var data2 = this._DB.health_news.Where(m => ("," + m.parent_ids + ",").Contains("," + item.Key + ",")).ToList();
                Listitems.Add(new ListItem(item.Key.ToString(), item.Value + " ～" + data2.Count(), item.Key == gid));
            }
            ViewData["gData"] = Listitems;

            #endregion

            IPagedList data = Linq.OrderBy(m => m.news_id).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.gid = gid;

            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult NewsList_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            #region"主體"

            var Linq = this._DB.health_news.Where(m => m.news_id > 0);
            foreach (var item in Linq.ToList())
            {
                if (item.parent_ids != null)
                {
                    string parents = "," + item.parent_ids + ",";
                    var Parent = this._DB.health_data.Where(m => parents.Contains("," + m.health_id.ToString() + ",")).ToDictionary(m => m.health_id, m => m.title);
                    string[] P_Values = Parent.Values.ToArray(); //Dictionary to ToArray
                    if (P_Values.Count() > 0)
                    {
                        item.parent_idx = P_Values.Aggregate((m, n) => m + "," + n);  //累加填寫      
                    }
                }

            }

            #endregion

            #region"搜尋"

            if (gid.HasValue) //分類
            {
                Linq = Linq.Where(m => ("," + m.parent_ids + ",").Contains("," + gid.ToString() + ","));
            }

            if (!string.IsNullOrEmpty(kw)) //關鍵字
            {
                Linq = Linq.Where(m => m.title.Contains(kw));
            }

            #endregion

            #region"下拉選單"

            //選單
            List<ListItem> Listitems = new List<ListItem> { };
            Listitems.Add(new ListItem("", "全部", false));
            var Part = this._DB.health_data.Where(m => m.visible).ToDictionary(m => m.health_id, m => m.title);
            foreach (var item in Part)
            {
                var data2 = this._DB.health_news.Where(m => ("," + m.parent_ids + ",").Contains("," + item.Key + ",")).ToList();
                Listitems.Add(new ListItem(item.Key.ToString(), item.Value + " ～" + data2.Count(), item.Key == gid));
            }
            ViewData["gData"] = Listitems;

            #endregion

            IPagedList data = Linq.OrderBy(m => m.news_id).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.gid = gid;

            ViewBag.jgrowl = TempData["jgrowl"];

            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public void Public(int id, health_news data)
        {

            #region"下拉選單"

            if (data.parent_ids != null) //選擇症狀
            {
                var parent = this._DB.health_data.Where(m => ("," + data.parent_ids + ",").Contains("," + m.health_id.ToString() + ",")).ToDictionary(m => m.health_id, m => m.title);
                ViewData["parent"] = parent;

            }

            List<ListItem> ListItems = new List<ListItem> { };

            //分類用-多
            var data3 = this._DB.health_data.Where(m => m.visible).ToLookup(m => ("," + data.parent_ids + ",").Contains("," + m.health_id.ToString() + ",")); //過濾已經有新增的

            var Parts = data3[false].OrderBy(m => m.title.Length).Select(m => m.health_id + "," + m.title).ToArray();
            ListItems.Add(new ListItem("", "請選擇", false));
            ListItems.AddRange(NW.sList(Parts, data.parent_id.ToString()));
            ViewData["parent_id"] = ListItems;

            //文章分區
            ListItems = NW.sList(NW.news_flag, data.flag.ToString());
            ViewData["flag"] = ListItems;

            //Tag
            var tag = this._DB.tag_data.Where(m => m.visible).ToList();
            ViewData["tag"] = tag;

            //作者
            var author = this._DB.author_data.Where(m => m.visible).Select(m => m.author_id + "," + m.title).ToArray();
            ListItems = new List<ListItem> { };
            ListItems.AddRange(NW.sList(author, data.author_id.ToString()));
            ViewData["author_id"] = ListItems;

            #endregion

            #region"圖片"

            //圖片
            var image = _DB.news_image.Where(m => m.news_id.Equals(id)).FirstOrDefault();
            images_data imgData = new images_data();
            if (image != null)
            {
                imgData.imgs_id = image.imgs_id;
                imgData.s_img = image.s_img;
                imgData.b_img = image.b_img;
            }
            ViewData["uploadimage"] = imgData;

            #endregion

        }

        public ActionResult NewsAdd(int id)
        {
            health_news data = new health_news(); //新的文章
            if (data == null) { TempData["jgrowl"] = "查無資料"; return RedirectToAction("NewsList"); }
            else
            {
                data.visible = true;
                data.start_date = DateTime.Today;
                data.end_date = data.start_date.Value.AddYears(3).AddDays(-1);

                Public(id, data);
            }

            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        [ValidateInput(false)] //避開Html的偵測---非常重要
        public ActionResult NewsAddSave(health_news health_news, VmImage imgs)
        {
            var data = health_news; //先轉data

            string Str = health_news.parent_ids != null ? health_news.parent_ids.Trim(',') : null; //選擇症狀?

            data.parent_id = Convert.ToInt32((Str != null ? Str.Split(',')[0] : "0")); //選擇症狀(第一)
            data.parent_ids = Str; //選擇症狀()     
            data.create_user = User.Identity.Name; //建立人 
            data.create_datetime = DateTime.Now; //建立時間

            this._DB.health_news.Add(data);
            this._DB.SaveChanges();

            TempData["jgrowl"] = "資料新增成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Add", "Edit").Replace("Save", ""), new { id = health_news.news_id });

        }

        public ActionResult NewsEdit(int id)
        {
            var data = this._DB.health_news.Where(m => m.news_id == id).FirstOrDefault();
            if (data == null) { TempData["jgrowl"] = "查無資料"; return RedirectToAction("NewsList"); }
            else
            {
                Public(id, data);
            }

            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult NewsEditSave(health_news health_news, VmImage imgs)
        {
            var data = this._DB.health_news.Find(health_news.news_id);
            if (data == null) { TempData["jgrowl"] = "查無資料"; return RedirectToAction("NewsList"); }
            else
            {
                string Str = health_news.parent_ids != null ? health_news.parent_ids.Trim(',') : null; //選擇症狀?

                data.parent_id = Convert.ToInt32((Str != null ? Str.Split(',')[0] : "0")); //選擇症狀(第一)
                data.parent_ids = Str; //選擇症狀()            
                data.title = health_news.title; //名稱
                data.inx = health_news.inx;  //排序
                data.visible = health_news.visible;  //啟用
                data.change_user = User.Identity.Name; //更改人
                data.change_datetime = DateTime.Now; //更改時間
                data.cont = health_news.cont; //內容
                data.start_date = health_news.start_date; //啟用時間
                data.end_date = health_news.end_date;//到期時間
                data.flag = health_news.flag;//文章分區
                data.author_id = health_news.author_id; //作者
                data.tag = health_news.tag; //Tag
                data.change_user = User.Identity.Name; //修改人
                data.change_datetime = DateTime.Now; //修改時間
                //更新
                TempData["jgrowl"] = "資料更新成功";
            }

            this._DB.SaveChanges();

            #region "圖片處理"

            for (int i = 0; i < imgs.img_id.Count; i++)
            {
                if (imgs.img_id[i] == 0)
                {
                    var imgData = new news_image();
                    imgData.news_id = data.news_id;
                    imgData.s_img = imgs.s_img[i].ToString();
                    imgData.b_img = imgs.b_img[i].ToString();
                    imgData.img_info = imgs.img_info[i].ToString();
                    imgData.img_inx = imgs.img_inx[i];
                    imgData.img_visible = true;

                    if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                    {
                        //新增
                        _DB.news_image.Add(imgData);
                    }
                }
                else
                {
                    //編輯
                    var imgData = _DB.news_image.Find(imgs.img_id[i]);
                    if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                    {
                        _DB.news_image.Remove(imgData);
                    }
                    else
                    {
                        imgData.news_id = health_news.news_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                    }
                    //_DB.SaveChanges();
                }
            }
            _DB.SaveChanges();

            #endregion

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = health_news.news_id });
        }

        [HttpPost]
        public ActionResult NewsListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };

            string sql = "";
            string Table = "health_news"; //修改的資料表
            string ID = "news_id"; //設定的ID欄位
            //var test = this._DB.health_news.FirstOrDefault().news_id;

            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update " + Table + " set visible = 1 Where " + ID + " in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update " + Table + " set visible = 0 Where " + ID + " in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    sql = " Delete From  " + Table + " Where " + ID + " in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

