@using MvcPaging;
@model IPagedList<h365_web.Models.company_data>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />   
            <col class="width14" />         
            <col />   
            <col class="width10" />         
            <col class="width12" />
            <col class="width14" />            
            <col class="width5" />
            <col class="width10" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>                
                <th>@Html.DisplayNameFor(model => model.First().name) </th>
                <th>@Html.DisplayNameFor(model => model.First().address) </th>
                <th>@Html.DisplayNameFor(model => model.First().contact) </th>
                <th>@Html.DisplayNameFor(model => model.First().contact_tel) </th>
                <th>@Html.DisplayNameFor(model => model.First().mail)</th>                
                
                <th class="center">@Html.DisplayNameFor(model => model.First().visible)</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {            
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" value="@item.company_id" /></td>
                    <td>@Html.DisplayFor(modelItem => item.name)</td>
                    <td>@Html.DisplayFor(modelItem => item.address)</td>  
                    <td>@Html.DisplayFor(modelItem => item.contact)</td>                  
                    <td>@Html.DisplayFor(modelItem => item.contact_tel)</td>
                    <td>@Html.DisplayFor(modelItem => item.mail)</td>
                     
                    <td class="center">@Html.DisplayFor(modelItem => item.visible)</td>                   
                    <td>@Html.ActionLink("編輯", action.Replace("List", "Edit").Replace("_ajax",""), new { id = item.company_id }, new { @class = "title" }) | 
                        @Html.ActionLink("寄信通知", "SendMail","NwAbout", new { cid = item.company_id }, new { @class = "title" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw))
    </div>

</div>
<!--pagination-->
