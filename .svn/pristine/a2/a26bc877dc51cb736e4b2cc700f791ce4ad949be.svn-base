@using MvcPaging;
@model IPagedList<h365_web.Models.data_list>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />
            <col class="width10" />
            <col />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width15" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th>@Html.DisplayNameFor(model => model.First().g_name) </th>
                <th>前台顯示名稱 </th>
                <th class="center">@Html.DisplayNameFor(model => model.First().hits) </th>
                <th class="center">@Html.DisplayNameFor(model => model.First().visible)</th>
                <th class="center">@Html.DisplayNameFor(model => model.First().inx) </th>
                 <th class="center">@Html.DisplayNameFor(model => model.First().visible_index) </th>
               <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {               
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" value="@item.data_id" /></td>
                    <td>@Html.DisplayFor(modelItem => item.g_name)</td>
                    <td id="pp@(item.data_id)" title="楓康品名：@(item.title)">@Html.DisplayFor(modelItem => item.info)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.hits)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.visible)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.inx)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.visible_index)</td>
                    <td>@Html.ActionLink("編輯", action.Replace("List", "Edit").Replace("_ajax",""), new { id = item.data_id }, new { @class = "title" }) &nbsp;&nbsp;
                      @if (item.cont.IndexOf("-")==-1){
                      <span class="btn-group cursour">
                          <span class="label label-info dropdown-toggle" data-toggle="dropdown">設定 <span class="iconfa-caret-down"></span></span>
                          <ul class="dropdown-menu">
                              <li><a onclick="copy(@(item.data_id));" class="cursour">複製商品</a></li>
                              <li class="divider"></li>
                              <li><a onclick="combo(@(item.data_id));" class="cursour">新增單品組合</a></li>
                          </ul>
                      </span>
                      }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw)
            .AlwaysAddFirstPageNumber().AddRouteValue("gid", ViewBag.gid))
    </div>

</div>
<!--pagination-->
