        [HttpPost, ValidateInput(false)]
        public ActionResult TagAddSave(tag_data tag_data,int med_id)
        {
            //var data = this._DB.news_data.Find(news_data.news_id);
            //var data1 = this._DB.news_data.Where(m => m.news_id.Equals(news_data.news_id)).Select(m => m).SingleOrDefault();
            var data = new tag_data { };

            var data2 = this._DB.tag_data.Where(m => m.tag_name == tag_data.tag_name).FirstOrDefault();
            
            if (data2 != null)
            {
                data2.inx = tag_data.inx;
                data2.visible = tag_data.visible;
                data2.change_user = User.Identity.Name;
                data2.change_datetime = DateTime.Now;

                this._DB.SaveChanges();

                //修改
                TempData["jgrowl"] = "關聯修改成功!!";

            }
            else
            {
                // data.news_id = news_data.news_id;
                data.tag_name = tag_data.tag_name;
                data.inx = tag_data.inx;
           
                data.visible = tag_data.visible;

                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.tag_data.Add(data);
                this._DB.SaveChanges();

                //新增
                TempData["jgrowl"] = "關聯新增成功!!";
                      
            }

           
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = med_id});
        }

