using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using System.Data.Linq;

using h365_web.Models;
using MvcPaging;
using System.IO;



namespace h365_web.Areas.newweb.Controllers
{
    public class NwMedicinesController : _BaseController
    {
        //
        // GET: /newweb/NwNews/

        #region "藥品列表"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.medicines_main
                           join m2 in _DB.medicines_group on m.group_id equals m2.group_id into mm
                           orderby m.main_id, m.create_datetime descending
                           select new zzmedicines_main()
                           {
                               main_id = m.main_id,
                               group_id = m.group_id,
                               name = m.name,
                               name_en = m.name_en,
                               atc_code = m.atc_code,
                               sn = m.sn,
                               visible = m.visible
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name_en.ToUpper().Contains(kw.ToUpper()) || m.sn.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;


            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            var data2 = this._DB.medicines_group.OrderBy(m => m.inx)
                        .Select(m => new data_group()
                        {
                            group_id = m.group_id,
                            name = m.name,
                            counts = m.medicines_main.Count()
                        });

            ViewData["medicines_group"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.medicines_main
                           join m2 in _DB.medicines_group on m.group_id equals m2.group_id into mm
                           orderby m.main_id, m.create_datetime descending
                           select new zzmedicines_main()
                           {
                               main_id = m.main_id,
                               group_id = m.group_id,
                               name = m.name,
                               name_en = m.name_en,
                               atc_code = m.atc_code,
                               sn = m.sn,
                               visible = m.visible
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw) || m.sn.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult Edit(int id)
        {

            var data = this._DB.medicines_main.Find(id);
            string sn = data.sn, atc_code = data.atc_code;

            int p_id = data.medicines_group == null ? 0 : data.medicines_group.group_id;

            //圖片
            var image = _DB.medicines_image.Where(m => m.main_id.Equals(id)).FirstOrDefault();
            images_data imgData = new images_data();
            if (image != null)
            {
                imgData.imgs_id = image.imgs_id;
                imgData.s_img = image.s_img;
                imgData.b_img = image.b_img;
            }
            ViewData["uploadimage"] = imgData;

            //medicines_data
            var data2 = this._DB.medicines_data.Where(m => m.visible && m.sn == sn && m.atc_code == atc_code).FirstOrDefault();
            
            if (image != null)
            {
                data2.img_url = image.s_img;
            }
            ViewData["data2"] = data2;

            //medicines_approve
            var data3 = this._DB.medicines_approve.Where(m => m.visible && m.sn == sn && m.atc_code == atc_code).FirstOrDefault();
            ViewData["data3"] = data3;

            string barcode = "- - -";
            if(!string.IsNullOrEmpty(data3.barcode)){

                barcode = data3.barcode;
            }
            ViewBag.barcode = barcode;
            
            //
            string[] check_name_s = {"形狀","顏色","適應症(藥師)","適應症(民眾)","副作用","注意事項" };
            string[] check_data_s = { "", "", "", "", "", "" };
            string check_s = "- - -";
             
            for (int a = 0; a < check_name_s.Count(); a++)
            {
                string check_name = check_name_s[a];
                var check = this._DB.medicines_check.Where(m => m.visible && m.check_name == check_name && m.main_id == id).FirstOrDefault();

                if (check != null)
                {
                    check_s = check.check_info;
                }
                check_data_s[a] = check_s;
                check_s = "- - -";
            }

            ViewBag.shape = check_data_s[0];
            ViewBag.color = check_data_s[1];
            ViewBag.pharmacist = check_data_s[2];
            ViewBag.people = check_data_s[3];
            ViewBag.side_effect = check_data_s[4];
            ViewBag.notes = check_data_s[5];    


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(int main_id, string shape, string color, string pharmacist, string people, string side_effect, string notes, string literature, VmImage imgs,string img_s)
        {
            var data = this._DB.medicines_main.Find(main_id);

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
         
                string[] check_name_s = {"形狀","顏色","適應症(藥師)","適應症(民眾)","副作用","注意事項" };
                string[] check_data_s = {shape, color, pharmacist, people, side_effect, notes};

                var data2 = new medicines_check { };

                for (int a = 0; a < check_data_s.Count(); a++ )
                {
                    if (check_data_s[a] != "")
                    {
                        string check_data = check_data_s[a];
                        var data3 = this._DB.medicines_check.Where(m =>m.visible == false && m.check_info == check_data && m.main_id == main_id).FirstOrDefault();

                        if(data3 == null){
                            //對應ID
                        data2.main_id = main_id;
                            //狀態名稱
                        data2.check_name = check_name_s[a];
                            //狀態
                        data2.check_info = check_data_s[a];
                            //文獻來源
                        data2.literature = literature;
                            //未啟用
                        data2.visible = false;
                            //建立者
                        data2.create_user = User.Identity.Name;
                            //建立時間
                        data2.create_datetime = DateTime.Now;                       

                        _DB.medicines_check.Add(data2);
                        this._DB.SaveChanges();

                        }
                    }
                }
                
                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new medicines_image();
                        imgData.main_id = data.main_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.medicines_image.Add(imgData);                        
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.medicines_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.medicines_image.Remove(imgData);

                            data2.check_name = "圖片";

                            data2.check_info = imgs.b_img[0];
                            //建立者
                            data2.create_user = User.Identity.Name;
                            //建立時間
                            data2.create_datetime = DateTime.Now;  
                        }
                        else
                        {

                            imgData.main_id = main_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];


                        }
                        _DB.SaveChanges();
                    }
                }

                _DB.SaveChanges();

                #endregion

         
                //如有新增圖片-(額外增加)
                if(imgs.s_img[0] != img_s){
                    
                    //藥品ID
                    data2.main_id = main_id;
                    
                    data2.check_name = "圖片";
                    //圖片大圖
                    data2.check_info = imgs.b_img[0];
                    //文獻來源
                    data2.literature = literature;
                    //啟用
                    data2.visible = true;
                    //建立者
                    data2.create_user = User.Identity.Name;
                    //建立時間
                    data2.create_datetime = DateTime.Now;

                    _DB.medicines_check.Add(data2);
                    this._DB.SaveChanges();
                
                }

            }

            //更新
            TempData["jgrowl"] = "資料送審成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = main_id });
        }

        public ActionResult Add(int id)
        {
            news_data data = new news_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);

            //圖片
            ViewData["UploadImage"] = new images_data();
            //ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.medicines_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;


            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(news_data news_data, VmImage imgs)
        {
            //var data = this._DB.news_data.Find(news_data.news_id);
            //var data1 = this._DB.news_data.Where(m => m.news_id.Equals(news_data.news_id)).Select(m => m).SingleOrDefault();
            var data = new news_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.news_id = news_data.news_id;
                data.group_id = news_data.group_id;
                data.title = news_data.title;
                data.cont = news_data.cont;
                data.cont2 = news_data.cont2;
                data.inx = news_data.inx;
                data.hits = news_data.hits;
                data.start_date = news_data.start_date;
                data.end_date = news_data.end_date;
                data.visible = news_data.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.news_data.Add(data);
                this._DB.SaveChanges();

                news_data.news_id = data.news_id;

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new news_image();
                        imgData.news_id = data.news_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.news_image.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.news_image.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.news_image.Remove(imgData);
                        }
                        else
                        {
                            imgData.news_id = news_data.news_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = news_data.news_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update news_data set visible = 1 Where news_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update news_data set visible = 0 Where news_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From news_image Where news_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From news_data Where news_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

