	//轉成陣列
	public static string[] dotToArrString(string s, int num = 3)
	{
		string[] arrRN = new string[num]; ;
		if (!string.IsNullOrEmpty(s))
		{
			string[] arr = s.Split(',');
			for (int i = 0; i < arr.Length; i++)
			{
				string[] arr2 = arr[i].Split(':');
				switch (arr2[0])
				{
					case "0":
					case "常溫運費":
						arrRN[0] = arr2[1];
						break;
					case "1":
					case "冷藏運費":
						arrRN[1] = arr2[1];
						break;
					case "2":
					case "冷凍運費":
						arrRN[2] = arr2[1];
						break;
				}
			}
		}


		return arrRN;
	}

	public static int[] dotToArrInt(string s, int num = 3)
	{
		int[] arrRN = new int[num]; ;
		if (!string.IsNullOrEmpty(s))
		{
			string[] arr = s.Split(',');
			for (int i = 0; i < arr.Length; i++)
			{
				string[] arr2 = arr[i].Split(':');
				switch (arr2[0])
				{
					case "0":
					case "常溫運費":
						arrRN[0] = Convert.ToInt32(arr2[1]);
						break;
					case "1":
					case "冷藏運費":
						arrRN[1] = Convert.ToInt32(arr2[1]);
						break;
					case "2":
					case "冷凍運費":
						arrRN[2] = Convert.ToInt32(arr2[1]);
						break;
				}
			}
		}


		return arrRN;
	} 

	public static List<gather_data> build_gather(product_data product_data, product_gather product_gather)
	{
		List<gather_data> r = new List<gather_data>();
		gather_data data = new gather_data() { };

		if (product_gather.visible && product_gather.one_visible && product_gather.num2 != 1)
		{
			data = new gather_data() { id = product_data.product_id, name = product_data.item_name, num = 1, price = product_data.price, sprice = product_data.sprice, cost = product_data.cost, back_bonus = product_data.back_bonus, post_company_cost = product_data.post_company_cost };
			r.Add(data);
		}


		if (product_gather != null && product_gather.visible)
		{
			if (product_gather.price2 != 0)
			{
				data = new gather_data() { id = product_gather.product_id, name = product_gather.name2, num = product_gather.num2, price = product_gather.price2, sprice = product_gather.sprice2, cost = product_gather.cost2, back_bonus = product_gather.back_bonus2, post_company_cost = product_gather.post_company_cost2 };
				r.Add(data);
			}

			if (product_gather.price3 != 0)
			{
				data = new gather_data() { id = product_gather.product_id, name = product_gather.name3, num = product_gather.num3, price = product_gather.price3, sprice = product_gather.sprice3, cost = product_gather.cost3, back_bonus = product_gather.back_bonus3, post_company_cost = product_gather.post_company_cost3 };
				r.Add(data);
			}

			if (product_gather.price4 != 0)
			{
				data = new gather_data() { id = product_gather.product_id, name = product_gather.name4, num = product_gather.num4, price = product_gather.price4, sprice = product_gather.sprice4, cost = product_gather.cost4, back_bonus = product_gather.back_bonus4, post_company_cost = product_gather.post_company_cost4 };
				r.Add(data);
			}

			if (product_gather.price5 != 0)
			{
				data = new gather_data() { id = product_gather.product_id, name = product_gather.name5, num = product_gather.num5, price = product_gather.price5, sprice = product_gather.sprice5, cost = product_gather.cost5, back_bonus = product_gather.back_bonus5, post_company_cost = product_gather.post_company_cost5 };
				r.Add(data);
			}

			if (product_gather.price6 != 0)
			{
				data = new gather_data() { id = product_gather.product_id, name = product_gather.name6, num = product_gather.num6, price = product_gather.price6, sprice = product_gather.sprice6, cost = product_gather.cost6, back_bonus = product_gather.back_bonus6, post_company_cost = product_gather.post_company_cost6 };
				r.Add(data);
			}

		}

		return r;
	}

