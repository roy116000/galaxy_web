    //撈出RadioBoxList,CheckBoxList
    public static List<ListItem> sList_Dic(Dictionary<string, string> str, string str_data = null)
    {
        List<ListItem> ListItems = new List<ListItem>();
        int num = 0;

        if (str_data == null)
        {
            foreach (var item in str)
            {
                //string[] bb = item.Split(',');
                if (item.Key != null)
                {
                    ListItems.Add(new ListItem(item.Key, item.Value, false));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), item.Value, false));
                }

                num++;
            }
        }
        else
        {

            string[] str_num = str_data.Trim(',').Split(',').ToArray();
            if (str_num.Count() == 1)
            {
                str_data = "," + str_data + ",";
            }

            foreach (var item in str)
            {
                //string[] bb = item.Split(',');
                if (item.Key != null)
                {
                    ListItems.Add(new ListItem(item.Key, item.Value, str_data.Contains("," + item.Key + ",")));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), item.Value, str_data.Contains("," + num.ToString() + ",")));
                }

                num++;
            }
        }


        return ListItems;
    }
   
	//將陣列轉成字串，方便儲存
	public static string Strs(string[] strs)
	{
		string data_str = null;
		if (strs != null)
		{
			//將陣列轉成字串，儲存用
			foreach (var item in strs)
			{
				data_str += item + ",";

			}
			data_str = "," + data_str;
		}
				 
		return data_str;
	}

	#region"比對後-資料庫的數字字串轉成顯示的文字字串，type= 1 等於(需比對資料)全部-1)"
	public static string Strs_Comparison(string Strs, string[] Comparison, int type = 0)
	{
        string Strs_Return = "";
        if (Strs != null)
        {
            
            //先去頭去尾
            Strs = Strs.Trim(',');
            //轉陣列
            var Strs_Array = Strs.Split(',').ToArray();
            if (Strs_Array.Count() > 1)
            {
                string Strs_Completed = "";
                foreach (var item in Strs_Array)
                {
                    int Strs_Num = Convert.ToInt32(item) - type;

                    Strs_Completed += Comparison[Strs_Num] + ",";
                }
                Strs_Return = Strs_Completed.Trim(',');
            }

        }

        //回傳轉換完成的文字字串
        return Strs_Return;

	}
	#endregion

	#region"轉數字陣列"

	public static List<int> str_nums(string str)
	{
        str = str.Trim(',');

		List<int> str_num = new List<int>();
        foreach (var item in str.Split(','))
		{
			str_num.Add(Convert.ToInt32(item));
		}

        str_num.Sort();
          

		return str_num;
	}

