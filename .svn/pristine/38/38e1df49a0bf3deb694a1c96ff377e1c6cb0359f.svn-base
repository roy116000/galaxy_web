    #region 取子分類標籤
    public static List<string> get_tag(List<product_group2> product_group2)
    {
        bool 重複;
        List<string> tag = new List<string>();
        if (product_group2.Count() != 0)
        {
            foreach (var item in product_group2)
            {
                if (!string.IsNullOrEmpty(item.s_img))
                {
                    foreach (var item2 in item.s_img.Split(','))
                    {
                        tag.Add(item2);
                    }
                
                }
            }
        }
        //string[] gettag = new string[tag.Count()];
        //int i =0;
        //foreach (var item in tag)
        //{
        //    gettag[i] = item;
        //    i++;
        //}
        //去除重複元素
        for (int i = tag.Count - 1; i >= 0; --i)    
        {
            if (tag.IndexOf(tag[i]) != i)
                tag.RemoveAt(i);  
        }

        return tag;
    }


