	#region "寄信"


	//public enum MailFlag : int { 消費者_購物通知信 = 1, 管理者_購物通知信, 消費者_付款成功通知信, 管理者_付款成功_通知出貨, 消費者_付款失敗通知信, 管理者_付款失敗通知信 };
	public enum MailFlag : int { 消費者_購物通知信 = 1, 管理者_購物通知信, 消費者_付款成功通知信, 管理者_付款成功_通知出貨, 消費者_付款失敗通知信, 管理者_付款失敗通知信, 管理者_廠商新增成功通知信, 廠商_付款成功_通知出貨, 管理者_退貨通知信 = 11 };

    //寄信給廠商-(廠商ID、)
    //public static void SendMessage(int company_id, string store_name, string name, DateTime pay_date, order_sub order_sub, int mailflag)
    public static void SendMessage(order_data Order_data, int Mail_Flag)
    {
        _dbContext db = new _dbContext();
        //int mailflag = Convert.ToInt32(NW.MailFlag.管理者_付款成功_通知出貨);
        string subject = "";
        string body = "";
        string cmail = "";

        var data = db.mail_group.Where(m => m.visible && m.group_id == Mail_Flag).FirstOrDefault();  //信的種類
        var company = db.company_data.Where(m => m.company_id == Order_data.company_id).FirstOrDefault(); //廠商
        if (company != null) { cmail = company.mail + ";"; }
        bool ss = false;
        if (data != null && !string.IsNullOrEmpty(cmail))
        {
            var Solt = db.solt_data.Where(m => m.order_id == Order_data.order_id).FirstOrDefault();
            cmail += data.cc;
            subject = data.subject;
            //int total = Order_sub.price * Order_sub.num; //售價
            int total = Order_data.total - Order_data.bonus - (Solt != null ? Solt.prize : 0) - Order_data.discount; //價格(售價-健康紅利-紅利-折讓)
            body = data.body;

            if (Mail_Flag == Convert.ToInt32(NW.MailFlag.管理者_付款成功_通知出貨))
            {
                var Drugstore = db.drugstore_data.Where(m => m.drugstore_id == (Order_data.send_drug_id != 0 ? Order_data.send_drug_id : Order_data.drugstore_id)).FirstOrDefault();
                //(藥局、付款時間)
                body = body.Replace("${store_name}", Drugstore.name).Replace("${pay_datetime}", Order_data.pay_datetime.Value.ToString("yyyy/MM/dd HH:mm:ss"));
            }
            else if (Mail_Flag == Convert.ToInt32(NW.MailFlag.管理者_退貨通知信))
            {
                //(廠商名稱、寄送地址、申請退貨時間)
                body = body.Replace("${company_name}", company.name).Replace("${send_address}", Order_data.send_address).Replace("${back_datetime}", Order_data.back_datetime.Value.ToString("yyyy/MM/dd"));           
            }

            //商品明細
            var Order_sub = db.order_sub.Where(m => m.order_id == Order_data.order_id).FirstOrDefault();
            //(訂單編號、訂購方、商品名稱、商品數量、價格)
            body = body.Replace("${order_id}", Order_data.order_id.ToString()).Replace("${name}", Order_data.order_name).Replace("${product_name}", Order_sub.item_name).Replace("${product_num}", Order_sub.num.ToString()).Replace("${product_total}", total.ToString("N0"));

            ss = NW.sendMail(cmail, subject, body);
        }
    }

	public static bool sendMail(string mailTo, string Subject, string Body) {
		//return sendMail("tfseshop@sinon.com.tw","台灣楓康購-系統通知信", mailTo, Subject,Body);
		return sendMail("shop@netsourcer.com.tw", "健康資訊站-系統通知信", mailTo, Subject, Body);
	}

    //寄件信箱、寄件人、寄給誰、主旨、內容
	public static bool sendMail(string mailFrom, string mailFromName, string mailTo, string Subject, string Body) {
		bool isSuccess = false;

		try
		{
			SmtpClient smtp = new SmtpClient();
			MailMessage mail = new MailMessage();
			mail.From = new MailAddress(mailFrom, mailFromName);  // 寄件者
			int i = 0;
			foreach (var ss in mailTo.Split(';')) {
				var m = ss.Replace("\r\n","");
				if (i == 0) { 
					mail.To.Add(new MailAddress(m));    //收件者-信箱
				} else {
					mail.CC.Add(new MailAddress(m));
				}
				i += 1;
			}
			mail.Subject = Subject; // 主旨
			mail.Body = Body; // 內文
			mail.IsBodyHtml = true;
			mail.SubjectEncoding = UTF8Encoding.UTF8;
			mail.BodyEncoding = UTF8Encoding.UTF8;

			smtp.Send(mail);
			isSuccess = true;
		}
		catch {
			isSuccess = false;
		}

		return isSuccess;
	}
	
	//mail發送
	public static string xsendMail(string mailto, string aFrom, string subject, string body)
	{
		//收、寄、主旨、內容
		try
		{
			string smtp = System.Web.Configuration.WebConfigurationManager.ConnectionStrings["mailsmtp"].ToString();

			string[] arr = Split(smtp, ",");

			SmtpClient SmtpServer = new SmtpClient(arr[0].ToString());
			SmtpServer.Port = 25;
			SmtpServer.Credentials = new System.Net.NetworkCredential(arr[3].ToString(), arr[4].ToString());
			SmtpServer.EnableSsl = true;


			MailMessage mail = new MailMessage();
			mail.From = new MailAddress(aFrom);
			mail.To.Add(mailto);
			mail.Subject = subject;
			mail.Body = body;
			mail.IsBodyHtml = true;
			mail.SubjectEncoding = UTF8Encoding.UTF8;
			mail.BodyEncoding = UTF8Encoding.UTF8;

			SmtpServer.Send(mail);
		}
		catch (Exception ex)
		{
			throw ex;
		}

		return "";
	}


