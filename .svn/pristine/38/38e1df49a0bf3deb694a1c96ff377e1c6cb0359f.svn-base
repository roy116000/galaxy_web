	//時間
	public static object spliteDate(object str, int i)
	{
		string spl = "";
		switch (i)
		{
			case 1:
				spl = string.Format("{0:yyyy/MM/dd}", str);
				break;
			case 2:
				spl = string.Format("{0:yyMMdd}", str);
				break;
		}
		return spl;

	}

	//取代
	public static string ReplaceAt(string input, string newChar) {
		if (input == null) {
			throw new System.ArgumentNullException();
		}

		char[] chars = input.ToCharArray();

		if (chars.Length > 1)
		{
			switch (chars.Length)
			{
				case 1:
					chars[0] = Convert.ToChar(input);
					break;
				case 2:
					chars[1] = Convert.ToChar(newChar);
					break;
				default:
					for (var i = 1; i < chars.Length-1; i++)
					{
						chars[i] = Convert.ToChar(newChar);
					};
					chars[0] = chars[0];
					chars[chars.Length - 1] = chars[chars.Length - 1];
					break;
			}        
		}
		return new string(chars);
	}
	  
	//去除Html
	public static string splitHtml(string html)
	{
		string split = html;

		if (split == null) { return split; }

		Regex regex = new System.Text.RegularExpressions.Regex("<[^>]*>");
		split = regex.Replace(split, "");

		return split;
	}

	//縮字
	public static string word(string key, int count, string mode)
	{
		string split = splitHtml(key);
		string[] input = { " ", "　", "\r", "\n", "\r\n", "&nbsp;", "&#12288;", "&hellip;" };

		if (split == null) { return split; }

		foreach (string xx in input)
		{
			split = split.Replace(xx, "");
		}

		Encoding big5 = Encoding.GetEncoding("big5");
		byte[] b = big5.GetBytes(split);

		count *= 2;

		if (b.Length <= count)
		{
			return split;
		}
		else
		{
			string res = big5.GetString(b, 0, count);
			if (!big5.GetString(b).StartsWith(res))
			{
				res = big5.GetString(b, 0, count - 1);
			}
			if (string.IsNullOrEmpty(split))
			{
				mode = "";
			}
			return res += mode;
		}
	}

	//個資隱藏
	public static string hideword(string word, int y, int total=0)
	{
		if (string.IsNullOrEmpty(word)) { word = ""; }
		int number = word.Length;
		string first = word;
		if (number > y) {
			first = word.Substring(0, y);
			int num = (number - y);
			if (total > 0 && total < num) { num = total; }
			for (int i = 0; i < (num); i++ )
			{
				first += "O";
			}
		}
		return first;
	}

	//YouTube
	public static string get_youtube(string str)
	{
		int count;
		string[] youtb = Split(str, "/");
		count = youtb.Length - 1;

		if (youtb[count].Substring(0, 8) == "watch?v=")
		{
			return Split(str, "watch?v=")[1];
		}
		else
		{
			return youtb[count];
		}
	}

	//亂數
	public static string myCode(int textLength)
	{
		const string Chars = "ABCDEFGHIJKLMNPOQRSTUVWXYZ0123456789";
		Random random = new Random();
		var result = new string(
			Enumerable.Repeat(Chars, textLength)
			.Select(x => x[random.Next(x.Length)]).ToArray()
			);
		return result;
	}

	//縣市專用
	public static List<ListItem> zipData(int sys, int zip)
	{
		_dbContext db = new _dbContext();
		List<ListItem> ListItems = new List<ListItem> { };
		ListItems.Add(new ListItem("", "請選擇", false));

		if (sys == 1)
		{
			var data2 = db.zip_data.Where(m => m.zip == zip).FirstOrDefault();
			if (data2 != null) { zip = data2.city_id; }

			//縣市
			var Data = (from m in db.zip_data
						where m.visible == true
						group m by m.city_id into g
						select new { city_id = g.FirstOrDefault().city_id, city = g.FirstOrDefault().city });
			foreach (var item in Data)
			{
				ListItems.Add(new ListItem(item.city_id.ToString(), item.city, item.city_id == zip));
			}
		}
		else {
			//鄉鎮區
			var Data = (from m in db.zip_data
						where m.visible == true
						select new { zip = m.zip, canton = m.canton, city_id = m.city_id });
			foreach (var item in Data) {
				ListItems.Add(new ListItem(item.zip.ToString(), item.canton, item.zip == zip, item.city_id.ToString()));
			}
		}
	  

		return ListItems;
	}
   


