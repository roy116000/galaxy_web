    #region"圖片路徑"

    public static string Path_Img(string img, string con = null, string url = null)
    {
        string Http = HttpContext.Current.Request.Url.Scheme + "://" + HttpContext.Current.Request.Url.Authority + "/"; //網址

        string path = Http + (con == null ? "Content/images/product/" : "Content/images/" + con + "/"); //圖片路徑

        //string path = NW.WEB_URL + (con == null ? "Content/images/product/" : "/Content/images/" + con + "/"); //圖片路徑

        string img_s = "";
        if (img != null)
        {
            img_s = img.IndexOf("images") != -1 ? img : path + img;

            //有無前置網址
            img_s = (!string.IsNullOrEmpty(url) && img.IndexOf("http://") == -1) ? url + img_s : img_s;
        }
        else
        {
            img_s = NW.WEB_URL + "images/no_photo.jpg";
        }



        return img_s;
    }

    #endregion

    #region"日期循環"

    public static IEnumerable<DateTime> EachDay(DateTime from, DateTime thru)
    {
        for (var day = from.Date; day.Date <= thru.Date; day = day.AddDays(1))
            yield return day;
    }

    #endregion

    #region"模組"

    public static List<ListItem> sList(string[] str, string str_data = null)
    {
        List<ListItem> ListItems = new List<ListItem>();
        int num = 0;

        if (str_data == null)
        {
            //ListItems.Add(new ListItem("-1", "未分類", true));
            foreach (var item in str)
            {
                string[] bb = item.Split(',');
                if (bb.Count() > 1)
                {
                    ListItems.Add(new ListItem(bb[0], bb[1], false));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), bb[0], false));
                }

                num++;
            }
        }
        else
        {
            string[] str_num = str_data.Trim(',').Split(',').ToArray();
            if (str_num.Count() == 1)
            {
                str_data = "," + str_data + ",";
            }


            //ListItems.Add(new ListItem("-1", "未分類", str_data == "-1"));
            foreach (var item in str)
            {
                string[] bb = item.Split(',');
                if (bb.Count() > 1)
                {
                    ListItems.Add(new ListItem(bb[0], bb[1], str_data.Contains("," + bb[0] + ",")));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), bb[0], str_data.Contains("," + num.ToString() + ",")));
                }

                num++;
            }
        }


        return ListItems;
    }

