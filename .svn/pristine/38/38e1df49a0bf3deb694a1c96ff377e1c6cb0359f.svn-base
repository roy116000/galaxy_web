    #region 以MD5亂數產生序號

    public static string MD5(string s)
	{
		string r = "";

		MD5CryptoServiceProvider md5Hasher = new MD5CryptoServiceProvider();

		byte[] myData = md5Hasher.ComputeHash(Encoding.Default.GetBytes(s));

		r = BitConverter.ToString(myData).Replace("-", string.Empty);
		r = r.ToLower();
		return r;
	}

	#endregion

