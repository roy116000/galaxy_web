	public static string HtmlPack(string cont)
	{
		string r = cont;
	   
		string html = cont;
		HtmlDocument doc = new HtmlDocument();
		doc.LoadHtml(html);

		HtmlNodeCollection nodes = doc.DocumentNode.SelectNodes("//img");
		if (nodes != null)
		{
			foreach (HtmlNode node in nodes)
			{
				HtmlAttributeCollection attrs = node.Attributes;
				if (attrs != null)
				{
					foreach (HtmlAttribute attr in attrs)
					{
						if (attr.Name.ToLower() == "style")
						{
							//attrs.Remove(attr);
							string style_attr = attr.Name+"=\"" + attr.Value+"\"";

							r = r.Replace(style_attr, "");

							break;
						}
					}
				}
			}

		}

		return r;
	}
   
    //float to int 
    public static double Math_gRound(double value, int digit = 0)
    {
        return Math.Round(value, digit, MidpointRounding.AwayFromZero);
    }

    public static List<ListItem> drugsalesData(int sys, int sid)
    {
        _dbContext db = new _dbContext();
        List<ListItem> ListItems = new List<ListItem> { };
        ListItems.Add(new ListItem("", "請選擇", false));

        if (sys == 1)
        {
            var data2 = db.drugstore_sales.Where(m => m.sales_id == sid).FirstOrDefault();
            if (data2 != null) { sid = data2.dealer_id; }

            //縣市
            var Data = (from m in db.drugstore_dealer
                        where m.visible == true
                        //group m by m.city_id into g
                        select new { pid = m.dealer_id, name = m.name });
            foreach (var item in Data)
            {
                ListItems.Add(new ListItem(item.pid.ToString(), item.name, item.pid == sid));
            }
        }
        else
        {
            //鄉鎮區
            var Data = (from m in db.drugstore_sales
                        where m.visible == true
                        select new { sales_id = m.sales_id, name = m.name, pid = m.dealer_id });
            foreach (var item in Data)
            {
                ListItems.Add(new ListItem(item.sales_id.ToString(), item.name, item.sales_id == sid, item.pid.ToString()));
            }
        }


        return ListItems;
    }

