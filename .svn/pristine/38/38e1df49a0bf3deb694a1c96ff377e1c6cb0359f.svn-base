    ////藥局合約審核
    public enum pay_flag : int { 簽約未完成 = 0, 已開發, 已裝機, 完成簽約 };

    public static int partnerID(int power_id, int admin_id)
    {
        int pid = 0;
        _dbContext db = new _dbContext();
        switch (power_id)
        {
            //加盟商
            case 4:
                var partner = db.partner_data.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (partner != null) { pid = partner.partner_id; }
                break;

            //加盟業務
            case 5:
                var sales = db.partner_sales.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (sales != null) { pid = sales.sales_id; }
                break;

            //加盟主
            case 6:
                var member = db.partner_member.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (member != null) { pid = member.member_id; }

                break;

            //藥局
            case 8:
                var drug = db.drugstore_data.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (drug != null) { pid = drug.drugstore_id; }

                break;

            //推廣業務
            case 9:
                var drug_sales = db.drugstore_sales.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (drug_sales != null) { pid = drug_sales.sales_id; }

                break;

            //藥局經銷商
            case 10:
                var drug_dealer = db.drugstore_dealer.Where(m => m.admin_id == admin_id).FirstOrDefault();
                if (drug_dealer != null) { pid = drug_dealer.dealer_id; }

                break;

        }


        return pid;

    }

    //藥局合約
