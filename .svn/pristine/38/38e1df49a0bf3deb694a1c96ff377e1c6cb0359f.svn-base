    public static List<ListItem> sList_chained2(string[] str, string str_data = null)
    {
        List<ListItem> ListItems = new List<ListItem>();
        int num = 0;

        if (str_data == null)
        {
            //ListItems.Add(new ListItem("-1", "未分類", true));
            foreach (var item in str)
            {
                string[] bb = item.Split(',');
                if (bb.Count() > 1)
                {
                    ListItems.Add(new ListItem(bb[0], bb[1], false, bb[2]));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), bb[0], false));
                }

                num++;
            }
        }
        else
        {
            string[] str_num = str_data.Trim(',').Split(',').ToArray();
            if (str_num.Count() == 1)
            {
                str_data = "," + str_data + ",";
            }


            //ListItems.Add(new ListItem("-1", "未分類", str_data == "-1"));
            foreach (var item in str)
            {
                string[] bb = item.Split(',');
                if (bb.Count() > 1)
                {
                    ListItems.Add(new ListItem(bb[0], bb[1], str_data.Contains("," + bb[0] + ","), bb[2]));
                }
                else
                {
                    ListItems.Add(new ListItem(num.ToString(), bb[0], str_data.Contains("," + num.ToString() + ",")));
                }

                num++;
            }
        }


        return ListItems;
    }


    //廣告-模組---帶分類近來
    public static List<adv_data> Filter_Adv(int gid)
    {
        _dbContext _DB = new _dbContext { };

        DateTime tD = DateTime.Today;
        var Adv_List = new List<adv_data> { }; //要回傳的

        //var Adv_All = _DB.adv_data.Where(m => m.visible && m.group_id == gid && (m.start_date <= tD && m.end_date >= tD)).ToLookup(m => m.drugstore_id != null);
        //var Adv_All = _DB.adv_data.Where(m => m.visible && m.group_id == gid && (m.start_date <= tD && m.end_date >= tD)).ToLookup(m => !string.IsNullOrEmpty(m.drugstore_id));

        var Adv_All = _DB.adv_data.Where(m => m.visible && m.group_id == gid && m.start_date <= tD).OrderByDescending(m => m.start_date).ToLookup(m => !string.IsNullOrEmpty(m.drugstore_id));

        var Cookie = HttpContext.Current.Request.Cookies["HealthInfo"];
        if (Cookie != null)
        {
            string uid = Cookie["uid"].ToString();
            if (uid != null)
            {
                var aData = _DB.drugstore_data.Where(m => m.visible && m.uid == uid).FirstOrDefault(); //藥局資訊
                if (aData != null)
                {
                    List<adv_data> Adv_Only = Adv_All[true].Where(m => ("," + m.drugstore_id + ",").Contains("," + aData.drugstore_id + ",")).ToList();
                    Adv_List.AddRange(Adv_Only);
                }
            }
        }


        var Adv = Adv_All[false].OrderByDescending(m => m.adv_id).ToList(); //沒有有指定藥局的
        Adv_List.AddRange(Adv);

        return Adv_List.OrderByDescending(m => m.start_date).ToList();
    }

    #endregion

    #region"格式確認"

    public static Boolean checkMail(string mail) //格式確認-信箱
    {
        bool ismail = false;

        string pattern = @"^([\w-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4})$";

        ismail = NW.isRegex(mail, pattern);

        return ismail;

    }

    public static Boolean checkphone(string phone) //格式確認-電話號碼
    {
        bool isphone = false;

        string pattern = @"^09[\d]{8}$";

        isphone = NW.isRegex(phone, pattern);

        return isphone;

    }

    public static Boolean CheckPwd(string pwd, string pwd2) //確認密碼用
    {
        bool isphone = false;

        isphone = pwd == pwd2 ? true : false;

        return isphone;
    }

    #endregion

    //取某月最後一天
    public static DateTime LastDayOfMonth(DateTime datetime)
    {

        return datetime.AddDays(1 - datetime.Day).AddMonths(1).AddDays(-1);
    }
}

public static class MyExtensions
	{
	/// <summary>
	/// Returns the last few characters of the string with a length
	/// specified by the given parameter. If the string's length is less than the
	/// given length the complete string is returned. If length is zero or
	/// less an empty string is returned
	/// </summary>
	/// <param name="s">the string to process/// <param name="length">Number of characters to return/// <returns></returns>
		public static string Right(this string s, int length)
		{
			length = Math.Max(length, 0);
 
			if (s.Length > length)
			{
				return s.Substring(s.Length - length, length);
			}
			else
			{
			return s;
			}
		}
	}

