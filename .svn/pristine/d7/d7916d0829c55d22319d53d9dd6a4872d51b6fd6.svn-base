@model h365_web.Models.order_bills2
@{
    string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    h365_web.Models.drugstore_data company = (h365_web.Models.drugstore_data)ViewData["company"];

    List<h365_web.Models.order_data2> order_data = (List<h365_web.Models.order_data2>)ViewData["data2"];

    double sTotal = ViewBag.ctotal;
}
                                               <form name="BackPoint" id="BackPoint" action="@Url.Action("ClearEditSave","NwDrugBills")" method="post">
                                                <input id="order_id" name="order_id" value="" style="display:none"/>
                                                   <input id="index" name="index" value="99" style="display:none"/>
                                                    </form>

<div class="maincontent">
    <div class="contentinner">
        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.bills_id)
            <input type="hidden" id="index" name="index" value="0" />
                        
            
            <div class="widgetcontent">


                <div class="control-group">
                    <label for="" class="control-label">帳款所屬藥局</label>
                    <span class="field">
                        <span class="label label-info" style="font-size: 150%;">@(company.name)</span>
                    </span>
                </div>

@*                <div class="control-group">
                    <label for="" class="control-label">收款行帳號</label>
                    <span class="field">
                        @if (!string.IsNullOrEmpty(company.receivingbankaccount))
                        {
                        <span class="label label-info" style="font-size: 150%;">@(company.receivingbankaccount)</span>
                        }
                        else
                        { 
                            <span class="label label-info" style="font-size: 150%;">目前無資料</span>                        
                        }

                    </span>
                </div>

                <div class="control-group">
                    <label for="" class="control-label">收款行代號</label>
                    <span class="field">
                        @if (!string.IsNullOrEmpty(company.receivingbankcode))
                        {
                        <span class="label label-info" style="font-size: 150%;">@(company.receivingbankcode)</span>
                        }
                        else
                        { 
                            <span class="label label-info" style="font-size: 150%;">目前無資料</span>                        
                        }

                    </span>
                </div>

                <div class="control-group">
                    <label for="" class="control-label">銀行別</label>
                    <span class="field">
                        @if (!string.IsNullOrEmpty(company.bankunmber))
                        {
                        <span class="label label-info" style="font-size: 150%;">@(company.bankunmber)</span>
                        }
                        else
                        { 
                            <span class="label label-info" style="font-size: 150%;">目前無資料</span>                        
                        }

                    </span>
                </div>

                <div class="control-group">
                    <label for="" class="control-label">分行別</label>
                    <span class="field">
                        @if (!string.IsNullOrEmpty(company.ranchunmber))
                        {
                        <span class="label label-info" style="font-size: 150%;">@(company.ranchunmber)</span>
                        }
                        else
                        { 
                            <span class="label label-info" style="font-size: 150%;">目前無資料</span>
                        }

                    </span>
                </div>*@

                <div class="control-group">
                    @Html.LabelFor(model => model.bills_datetime, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @if (Model != null)
                        {
                            @:@(((DateTime)Model.bills_datetime).ToString("yyyy/MM/dd"))
                        }
                        &nbsp;&nbsp;
                    </div>
                </div>

                <div class="control-group">
                    @Html.LabelFor(model => model.invoice_datetime, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @if (Model != null)
                        {
                            @:@(((DateTime)Model.invoice_datetime).ToString("yyyy/MM/dd"))
                        }
                        &nbsp;&nbsp;
                    </div>
                </div>

                <div class="control-group">
                    @Html.LabelFor(model => model.invoice_no, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @if (Model != null)
                        {
                            @:@(Model.invoice_no)
                        }
                        &nbsp;&nbsp; 
                    </div>
                </div>

                <div class="control-group">
                    @Html.LabelFor(model => model.info, new { @class = "control-label" })
                    <div class="field" style="padding: 5px 5px;">
                        @if (Model != null)
                        {
                            @:@(Model.info)
                       }
                        &nbsp;&nbsp;
                    </div>
                </div>


                <div class="control-group">
                    <label for="" class="control-label">請款總額</label>
                    <span class="field">
                        @*<span class="label label-success" style="font-size: 150%;">@((order_data.Where(m => string.IsNullOrEmpty(m.back_money_type) && string.IsNullOrEmpty(m.back_type)).Sum(m => m.cost_total) + order_data.Where(m => !string.IsNullOrEmpty(m.back_money_type) && !string.IsNullOrEmpty(m.back_type)).Sum(m => m.discount)).ToString("N0"))</span>*@
                        <span class="label label-success" style="font-size: 150%;">@(sTotal.ToString("N0"))</span>
                    </span>


                </div>

                <div class="row-fluid">
                    <div class="span12 editprofileform">
                        <h4 class="widgettitle">當月訂單</h4>
                        <div class="">
                            <div id="List_ajax">
                                <table class="table table-striped">
                                    <colgroup>
                                        <col class="width12" />
                                        <col class="width12" />
                                        <col class="width12" />
                                        <col class="width8" />
                                        <col class="width8" />
                                        <col class="width7" />
                                        <col class="width7" />
                                        <col class="width12" />
                                        <col class="width10" />
                                        <col />
                                        <col class="width5" />

                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>訂單單號</th>
                                            <th>訂貨日期</th>
                                            <th>出貨日期</th>
                                            <th>貨運公司</th>
                                            <th>宅配單號</th>
                                            <th>訂單金額</th>
                                            <th>商品成本</th>
                                            <th>運費成本</th>
                                            <th>總成本</th>                                            
                                            <th>編輯出貨狀態</th>
                                            <th>作廢</th>
                                            
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in order_data)
                                        {                                                                         
      
                                            
                                            if (string.IsNullOrEmpty(item.back_money_type) && string.IsNullOrEmpty(item.back_type))
                                            {
                                                //sTotal += item.cost_total;
                                            <tr>
                                                <td>@(item.order_sn)</td>
                                                <td>@(item.order_datetime.Value.ToString("yyyy/MM/dd"))</td>

                                               @if(item.goods_datetime !=null) {<td>@(((DateTime)item.goods_datetime).ToString("yyyy/MM/dd"))</td>}
                                                else{
                                               <td>尚未出貨</td>
                                               }

                                                
                                                <td>@(item.freight_name)</td>
                                                <td>@(item.freight_no)</td>
                                                <td>@(item.total)</td>                                   
                                                
                                                                                           
                                                <td>@(item.cost_total)</td>
                                                <td>@(item.freight)</td>                

                                                <td>@((item.cost_total + item.freight).ToString("N2"))</td>
                                                
                                                @*<td><a onclick="getDetail('@(item.order_id)');" style="cursor:pointer;" data-toggle="modal" >[明細]</a></td>*@
                                                <td><a href="@Url.Action("ClearEdit", "NwDrugBills", new { id = item.order_id})" style="cursor:pointer;" data-toggle="modal" >[編輯出貨狀態]</a></td>
              
                                                 <td><a id="@item.order_id" onclick="Back(this.id)" style="cursor:pointer;" data-toggle="modal" >[作廢]</a></td>
                                                 </tr>  
                                            }
                                            else
                                            {
                                                //sTotal += item.discount;
                                            <tr>
                                                <td>@(item.order_sn)</td>
                                                                @if(item.goods_datetime !=null) {<td>@(((DateTime)item.goods_datetime).ToString("yyyy/MM/dd"))</td>}
                                                else{
                                               <td>尚未出貨</td>
                                               }
                                                <td>@(item.freight_name)</td>
                                                <td>@(item.freight_no)</td>
                                                 <td>@(item.total-item.bonus)</td>
                                                <td>@(item.bonus)</td>
                                                <td>0</td>
                                                <td>@(item.discount.ToString("N0"))</td> 
                                                <td>@(item.total + item.freight).ToString("N2")</td>
                                                <td>@(item.freight)</td>                                               
                                                @*<td><a onclick="getDetail('@(item.order_id)');" style="cursor:pointer;" data-toggle="modal" >[明細]</a></td>*@                                               
                                                 <td><a href="@Url.Action("ClearEdit", "NwDrugBills", new { id = item.order_id,clear_money = 1})" style="cursor:pointer;" data-toggle="modal" >[編輯出貨狀態]</a></td>
               
                                                <td><a id="@item.order_id" onclick="Back(this.id)" style="cursor:pointer;" data-toggle="modal" >[作廢]</a></td>
                                            </tr>  
                                            }


                                        }

                                        <tr>
                                            <td colspan="4"></td>
                                            <td style="color: red;">總額</td>
                                            <td style="color: red;">@(sTotal.ToString("N0"))</td>
                                            <td >&nbsp;</td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">$(function () { $("#create_datetime").datepicker(); })</script>
<script type="text/javascript">$(function () { $("#invoice_datetime").datepicker(); })</script>

@Html.Partial("template_order_detail")



<script>

    function Back(o) {
        var cmsg = "確定取消【"+ o +"】訂單嗎？";

        //alert(o);
        //alert($('#order_id').attr('value'))
        if (confirm(cmsg)) {

        

            $('#order_id').attr('value', o);
          

            $('#BackPoint').submit();
        }
    }
    </script>

