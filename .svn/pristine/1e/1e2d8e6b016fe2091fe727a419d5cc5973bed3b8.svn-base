    public class partner_maori
    {
        [Key]
        public int maori_id { get; set; }

        [DisplayName("倍率")]
        public double netsourcer_num { get; set; }

        [DisplayName("藥師毛利額")]
        public int drugstore_num { get; set; }

        [DisplayName("加盟業務毛利額")]
        public int partner_sales_num { get; set; }

        [DisplayName("加盟主毛利額")]
        public int partner_member_num { get; set; }

        [DisplayName("推廣業務毛利額")]
        public int salesman_num { get; set; }

        [DisplayName("排序")]
        public int inx { get; set; }

        [DisplayName("啟用獨立配置")]
        public bool visible { get; set; }

        [DisplayName("第一周期_起")]
        public int cycle1_start { get; set; }

        [DisplayName("第一周期_末")]
        public int cycle1_end { get; set; }

        [DisplayName("第二周期_起")]
        public int cycle2_start { get; set; }

        [DisplayName("第二周期_末")]
        public int cycle2_end { get; set; }

        [DisplayName("加盟簽約金")]
        public int contract_price { get; set; }

        [DisplayName("合約期間")]
        public int contract_date { get; set; }

        [DisplayName("create_user")]
        public string create_user { get; set; }

        [DisplayName("create_datetime")]
        public DateTime? create_datetime { get; set; }

        [DisplayName("change_user")]
        public string change_user { get; set; }

        [DisplayName("change_datetime")]
        public DateTime? change_datetime { get; set; }

        [DisplayName("商品編號")]
        public int product_id { get; set; }


    }

