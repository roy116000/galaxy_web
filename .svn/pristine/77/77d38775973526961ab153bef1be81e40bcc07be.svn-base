@using MvcPaging;
@model IPagedList<h365_web.Models.order_data>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}

<div id="List_ajax">
    @*<div style="text-align: left; font-size:20px; padding-bottom:20px">@ViewBag.total</div>*@
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width6" />
            <col class="width6" />
            <col class="width10" />
            <col class="width12" />
            <col />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width10" />
            <col class="width6" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th class="center">單號 </th>
                <th class="center">訂購方</th>
                <th class="center">統一發票</th>
                <th class="center">品名</th>
                <th class="center">@Html.DisplayNameFor(model => model.First().order_datetime) </th>
                <th class="center">到貨時間</th>
                <th class="center">交貨時間</th>
                <th class="center">@Html.DisplayNameFor(model => model.First().flag) </th>
                

                <th class="center">@Html.DisplayNameFor(model => model.First().total) </th>
                <th class="center">&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                item.total = item.order_sub.Sum(m => m.price * m.num) + item.freight;

                string date = item.order_datetime.Value.ToString("yyyy-MM-dd");
                string Name_Company = item.company_data != null ? item.company_data.name : "查無廠商";   
                           
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" value="@item.order_id" /></td>
                    <td class="center"><span class="label label-info" title="前台單號：@(item.order_sn), 所屬廠商：@(Name_Company)">@Html.DisplayFor(modelItem => item.order_id)</span></td>                   
                    <td class="center">@Html.DisplayFor(modelItem => item.order_name)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.invoice_no)</td>
                    <td class="center" title="@(item.pro_web_name + " - " + item.info)">@NW.word(item.info, 12, "...")</td>
                    <td class="center">@date</td>
                    <td class="center">@NW.getDate(item.goods_datetime)</td> 
                    <td class="center">@NW.getDate(item.finish_datetime)</td>
                    @*<td class="center"><span class="label label-@(item.flag > 0 ? "success" + item.flag : "default")">@NW.Name_flag[item.flag]</span></td>*@
                    <td class="center"><span class="label label-@(item.flag > 0 ? "success" + item.flag : "default")" title="@(item.order_flag == 0 ? "店取" : "寄送")">@((item.finish_datetime != null && item.goods_datetime == null) ? NW.Name_flag[1] : NW.Name_flag[item.flag])</span></td>
                      
                                
                    <td class="right"  style="@((item.solt_price != 0 || item.bonus != 0) ? "color:#4169E1" : "")" >$ @((item.total - item.solt_price - item.bonus).ToString("N0"))</td>

                    <td class="center">@Html.ActionLink("編輯", "Edit", new { id = item.order_id }, new { @class = "title" })</td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="pagination pagination-centered">
        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber()
            .AddRouteValue("start_date", ViewBag.start_date)
            .AddRouteValue("end_date", ViewBag.end_date)
            .AddRouteValue("flag", ViewBag.vflag)
            .AddRouteValue("pay_visible", ViewBag.vpay_visible)
            .AddRouteValue("kw", ViewBag.kw)
            .AddRouteValue("pay_id", ViewBag.vpay_id)
            )
    </div>
</div>
<!--pagination-->


<style>
    .label-default {
        background-color: red;
    }

    .label-success1 {
        background-color:#DB8F00 ;
    }

    .label-success2 {
        background-color: green;
    }

    .label-success5 {
        background-color:#0033FF;
    }
</style>
