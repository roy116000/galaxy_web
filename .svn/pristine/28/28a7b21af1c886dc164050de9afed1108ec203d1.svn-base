using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using System.Data.Linq;

using h365_web.Models;
using MvcPaging;

namespace h365_web.Areas.newweb.Controllers
{
    public class NwQuestionController : _BaseController
    {
        //
        // GET: /newweb/NwNews/

        #region "問題列表"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;


            var tmpData = (from m in _DB.question_data
                           join m2 in _DB.question_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.question_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            var data2 = this._DB.question_group.OrderBy(m => m.inx)
                .Select(m => new data_group()
                {
                    group_id = m.group_id,
                    name = m.name,
                    counts = m.question_data.Count
                });


            ViewData["question_group"] = data2;

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.question_data
                           join m2 in _DB.question_group on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.question_id,
                               group_id = m.group_id,
                               title = m.title,
                               cont = m.cont,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult Edit(int id)
        {

            var data = this._DB.question_data.Find(id);

            //下拉選單
            var gData = (from m in _DB.question_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(question_data question_data, VmImage imgs)
        {
            var data = this._DB.question_data.Find(question_data.question_id);
            //var data1 = this._DB.question_data.Where(m => m.question_id.Equals(question_data.question_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.question_id = question_data.question_id;
                data.group_id = question_data.group_id;
                data.title = question_data.title;
                data.cont = question_data.cont;
                data.inx = question_data.inx;
                data.hits = question_data.hits;
                data.start_date = question_data.start_date;
                data.end_date = question_data.end_date;
                data.visible = question_data.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = question_data.create_user;
                //data.create_datetime = question_data.create_datetime;

                this._DB.SaveChanges();

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = question_data.question_id });
        }

        public ActionResult Add(int id)
        {
            question_data data = new question_data();
            data.inx = 0;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);

            //下拉選單
            var gData = (from m in _DB.question_group where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;


            data.visible = true;
            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(question_data question_data, VmImage imgs)
        {
            //var data = this._DB.question_data.Find(question_data.question_id);
            //var data1 = this._DB.question_data.Where(m => m.question_id.Equals(question_data.question_id)).Select(m => m).SingleOrDefault();
            var data = new question_data { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                // data.question_id = question_data.question_id;
                data.group_id = question_data.group_id;
                data.title = question_data.title;
                data.cont = question_data.cont;
                data.inx = question_data.inx;
                data.hits = question_data.hits;
                data.start_date = question_data.start_date;
                data.end_date = question_data.end_date;
                data.visible = question_data.visible;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;

                _DB.question_data.Add(data);
                this._DB.SaveChanges();

                question_data.question_id = data.question_id;
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = question_data.question_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update question_data set visible = 1 Where question_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update question_data set visible = 0 Where question_id in (" + cb_id + ")";
                    break;
                case 0: //刪除                
                    sql = " Delete From question_data Where question_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "分類列表"

        public ActionResult GroupList(string kw)
        {
            int currentPageIndex = 0;
            var tmpData = this._DB.question_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.question_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        public ActionResult GroupList_ajax(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;
            var tmpData = this._DB.question_group.OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime)
                    .Select(m => new data_group()
                    {
                        group_id = m.group_id,
                        name = m.name,
                        inx = m.inx,
                        visible = m.visible,
                        counts = m.question_data.Count()
                    });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


