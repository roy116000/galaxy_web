@{    
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

}
<div class="maincontent">
    <div class="contentinner">

        @using (Html.BeginForm("EquipmentEdit", controller, FormMethod.Post, new { @class = "stdform", @id = "form1", target = "_blank" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)  
            
            <div class="widgetcontent">
                <h4 class="widgettitle">查詢條件</h4>

                @*@Html.EditorFor(model => model.member_group)*@
                起始日
                <input type="text" value="" name="start_date" id="start_date" class="span2">
                結束日      
                <input type="text" value="" name="end_date" id="end_date" class="span2">

                @*<div class="control-group">
                    <div class="stdformbutton">*@
                <button type="button" class="btn" onclick="gotosubmit()">檢視</button>
                <button type="button" class="btn" onclick="exp()">匯出</button>
                @*</div>*@
                @*</div>*@
            </div>
        }
        @using (Html.BeginForm("EquipmentEditSave", controller, FormMethod.Post, new { @class = "stdform", @id = "form2", target = "_blank" }))
        {           
            <input type="hidden" id="start" name="start" value="0" />
            <input type="hidden" id="end" name="end" value="0" />     
               
        }
    </div>
</div>
<script type="text/javascript">

    function exp() {
        $('#start').val($('input[name = start_date]').val());
        $('#end').val($('input[name = end_date]').val());
        $('#form2').submit();
    }


</script>
<script type="text/javascript">

    function gotosubmit() {

        $('#form1').submit();

    }


</script>

<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            rules: {
                start_date: "required",
                end_date: "required",
            },
            messages: {
                start_date: "請選擇日期！",
                end_date: "請選擇日期！",
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').removeClass('success').addClass('error');
            }
        });

    })
</script>
<script type="text/javascript">
    $(function () {
        $('#start_date').datepicker();
        $('#end_date').datepicker();
    })


</script>

