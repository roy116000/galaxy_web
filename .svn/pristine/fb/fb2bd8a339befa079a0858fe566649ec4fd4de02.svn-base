@using MvcPaging;
@model IPagedList<h365_web.Models.education_group>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    //var gData = (List<ListItem>)ViewData["gData"];
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />
            <col class="width15" />                      
            
            <col class="width10"/>
            <col class="width5" />
            <col class="width5" />
            <col class="width5" />
        </colgroup>
        <thead>
            <tr>
                <th class="center"><input type="checkbox" name="del_id" class="checkall" /></th>
                <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().name))</th>               
                
                <th class="center">相關資料</th>
                <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().inx))</th>
                <th class="center">@(Html.DisplayNameFor(m => m.FirstOrDefault().visible))</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                //var g = gData.Where(m => m.Value == item.group_id).FirstOrDefault();
                //string g_name = g != null ? g.DisplayText : "";
                string url = Url.Action("List" , new { gid = item.group_id});
                
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center"><input type="checkbox" name="block_id" class="block_check" value="@(item.group_id)" /></td>
                    <td>@Html.DisplayFor(m => item.name)</td>
                   
                    <td class="center"><a href="@(Url.Action("List", new {gid = item.group_id}))" target="_blank">相關資料</a></td>
                    <td class="center">@Html.DisplayFor(m => item.inx)</td>
                    <td class="center">@Html.DisplayFor(m => item.visible)</td>
                    <td class="center">@Html.ActionLink("編輯", action.Replace("List", "Edit").Replace("_ajax", ""), new { id = item.group_id }, new { @class = "title", target = "_blank" })</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount, new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "")).DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw)
            .AlwaysAddFirstPageNumber().AddRouteValue("gid", ViewBag.gid))

    </div>

</div>
