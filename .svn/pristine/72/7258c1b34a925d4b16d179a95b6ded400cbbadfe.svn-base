@using MvcPaging;
@model IPagedList<h365_web.Models.data_list>
@Html.Partial("template_list_fix")
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();
}

<div id="List_ajax">
    <table class="table table-bordered mailinbox">
        <colgroup>
            <col class="width4" />
            <col />
            <col class="width20" />
            <col class="width8" />
            <col class="width8" />
            <col class="width8" />
            <col class="width12" />
        </colgroup>
        <thead>
            <tr>
                <th class="center">
                    <input type="checkbox" name="del_id" class="checkall" /></th>
                <th>活動名稱 </th>
                <th class="center">前台促銷用語</th>
                <th class="center">起始日期 </th>
                <th class="center">結束日期 </th>
                <th class="center">產品數量 </th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
              if (item.start_date <= DateTime.Today && item.end_date >= DateTime.Today) { item.visible = true; }
                            
                <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                    <td class="center">
                        <input type="checkbox" name="block_id" class="block_check" value="@item.group_id" /></td>
                    <td>@Html.DisplayFor(modelItem => item.title)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.title)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.start_date)</td>
                    <td class="center">@Html.DisplayFor(modelItem => item.end_date)</td>
                    <td class="center">@(item.counts-1)</td>
                    <td>@Html.ActionLink("編輯", action.Replace("List", "Edit").Replace("_ajax",""), new { id = item.group_id }, new { @class = "title" })｜@Html.ActionLink("檢視產品", action.Replace("List", "ProductList").Replace("_ajax",""), new { group_name = item.title }, new { @class = "title" })</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination pagination-centered">

        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount
        , new AjaxOptions { UpdateTargetId = "List_ajax", OnSuccess = "uniform" }).Options(o => o.Action(action.Replace("_ajax", "") + "_ajax").DisplayTemplate("BootstrapPagination")
            .MaxNrOfPages(10)
            .AlwaysAddFirstPageNumber().AddRouteValue("kw", ViewBag.kw))
    </div>

</div>
<!--pagination-->
