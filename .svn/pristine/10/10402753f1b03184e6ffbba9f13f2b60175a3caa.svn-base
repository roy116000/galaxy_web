@Html.Partial("template_list_fix") @*重要*@
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    var Q = (List<h365_web.Models.pharmacist_activity_data>)ViewData["Q"];


}


<script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
@Html.ValidationSummary(true)

<script type="text/javascript">
    function cbHandel(flag) {

        if ($("input[name='block_id']:checked").length == 0) { alert('請至少選擇一項'); return false; }
        var name = '刪除';
        switch (flag) { case 1: name = "啟用"; break; case 2: name = "停用"; break; }
        if (confirm('確定要' + name + '？')) {
            var arrVal = new Array();
            $("input[name='block_id']:checked").each(function (i) {
                arrVal[i] = this.value;
            });
        }

        $('#cb_flag').val(flag);
        $('#cb_id').val(arrVal.toString());

        $.post('@Url.Action("QuestionDel", controller)', { cb_flag: flag, cb_id: arrVal.toString() }, function (result) {
            window.location.reload(true); //強制重整
        });


        //location.href = '/NwDrug/PharmacistListDel?cb_flag=' + flag + '&cb_id=' + arrVal.toString();

        //$('#frmCheckbox').submit();

    }
</script>

<!--pagetitle-->
<div class="">
    <div class="">
        <!--widgetsource-->
        <div id="mail">
            <div class="msghead">
                @using (Html.BeginRouteForm("", FormMethod.Get))
                {
                    
                    <ul class="msghead_menu">
                        <li>
                            <a onclick="modal('')" data-toggle="modal" data-target="#myModal" class="btn"><span class="icon-pencil"></span>新增</a>
                            @*<a href="@Url.Action("QuestionAdd", controller, new { id = 0 })" class="btn"><span class="icon-pencil"></span>新增</a>*@
                            <div class="btn-group">
                                <span class="btn dropdown-toggle" data-toggle="dropdown"><span class="icon-check"></span>選擇設定<span class="caret"></span></span>
                                <ul class="dropdown-menu">
                                    <li><a onclick="cbHandel(1);" href="#"><span class="icon-ok-sign"></span>啟用</a></li>
                                    <li><a onclick="cbHandel(2);" href="#"><span class="icon-ban-circle"></span>停用</a></li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                }
                <span class="clearall"></span>
            </div>
            <!--msghead-->

            <br />

        </div>
        <!--#chat-->

        <div id="List_ajax">
            <table class="table table-bordered mailinbox">
                <colgroup>
                    <col class="width4" />
                    <col />
                    <col class="width8" />
                    <col class="width8" />
                    <col class="width8" />
                    <col class="width8" />
                    <col class="width6" />
                    <col class="width6" />
                    <col class="width6" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="center">
                            <input type="checkbox" name="del_id" class="checkall" /></th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().title)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().answer1)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().fraction1)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().answer2)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().fraction2)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().inx)</th>
                        <th class="center">@Html.DisplayNameFor(m => Q.First().visible)</th>

                        <th>&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Q != null)
                    {

                        foreach (var item in Q)
                        {
                            
                            int num = Array.IndexOf(Q.ToArray(), item);
                            
                        <tr class="@NW.echoBool(item.visible, "unread", "visible")">
                            <td class="center">
                                <input type="checkbox" name="block_id" class="block_check" value="@(item.question_id)" />
                            </td>
                            <td>@Html.DisplayFor(m => item.title)</td>
                            <td class="center">@Html.DisplayFor(m => item.answer1)</td>
                            <td class="center">@Html.DisplayFor(m => item.fraction1)</td>
                            <td class="center">@Html.DisplayFor(m => item.answer2)</td>
                            <td class="center">@Html.DisplayFor(m => item.fraction2)</td>
                            <td class="center">@Html.DisplayFor(m => item.inx)</td>
                            <td class="center">@Html.DisplayFor(m => item.visible)</td>
                            <td class="center">
                                <a onclick="modal('@(num)')" data-toggle="modal" data-target="#myModal">編輯</a>                              
                            </td>
                        </tr>       
                                                
                                                                  
                        }
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>



<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="display: none">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">編輯問卷題目</h4>
            </div>

            <form method="post" action="@(Url.Action("QuestionEditSave"))" >
                <div class="modal-body">


                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                    <input type="hidden" name="question_id" value="" />
                    <input type="hidden" name="activity_id" value="" />

                    <div style="width: 100%">
                        <span style="width: 20%">@Html.DisplayNameFor(m => Q.First().title)：</span>
                        <input style="width: 80%" name="title" value="" />

                    </div>

                    <br />
                    <div style="width: 100%">

                        <span style="width: 60%">
                            @Html.DisplayNameFor(m => Q.First().answer1)：
                            <input name="answer1" value="" />

                        </span>

                        <span style="width: 40%">
                            @Html.DisplayNameFor(m => Q.First().fraction1)：
                            <input class="span1" name="fraction1" value="" />
                        </span>

                    </div>

                    <br />
                    <div style="width: 100%">

                        <span style="width: 60%">
                            @Html.DisplayNameFor(m => Q.First().answer2)：
                            <input name="answer2" value="" />
                        </span>

                        <span style="width: 40%">
                            @Html.DisplayNameFor(m => Q.First().fraction2)：
                            <input name="fraction2" class="span1" value="" />
                        </span>

                    </div>

                    <br />
                    <div style="width: 100%">
                        @Html.DisplayNameFor(m => Q.First().inx)：
                        <input name="inx" value="@(Q.Any() ? Q.First().inx : 0)" />
                    </div>

                    <br />
                    <div style="width: 100%">
                        @Html.DisplayNameFor(m => Q.First().visible)：             
                        @Html.CheckBox("visible", Q.Any() ? Q.FirstOrDefault().visible : true)                                                                        
                    </div>

                </div>

                <div class="modal-footer">
                    @*<button class="btn btn-default" type="button" data-dismiss="modal">關閉</button>*@
                    <button class="btn btn-primary" type="submit">儲存</button>
                </div>
            </form>


        </div>
    </div>
</div>

@*列表*@
<script>
    function modal(o) {

        var C = JSON.parse('@Html.Raw(Json.Encode(Q))');

        var id = '@(ViewBag.id)';
        

        //$('#myModalLabel').html(C[o].title);
        $('input[name=activity_id]').val(id);
        if (o == "")
        {
            $('input[name=question_id]').val('');
            $('input[name=title]').val('');
            $('input[name=answer1]').val('');
            $('input[name=fraction1]').val('');
            $('input[name=answer2]').val('');
            $('input[name=fraction2]').val('');
            $('input[name=fraction2]').val('');
            $('input[name=inx]').val('');
        }
        else
        {
            $('input[name=question_id]').val(C[o].question_id);
            $('input[name=title]').val(C[o].title);
            $('input[name=answer1]').val(C[o].answer1);
            $('input[name=fraction1]').val(C[o].fraction1);
            $('input[name=answer2]').val(C[o].answer2);
            $('input[name=fraction2]').val(C[o].fraction2);
            $('input[name=fraction2]').val(C[o].fraction2);
            $('input[name=inx]').val(C[o].inx);

            //if (C[o].visible) {
            //    $('#myModal').find('span').addClass('checked');
            //} else {
            //    $('#myModal').find('span').removeClass('checked');
            //}
        }


    }
</script>
