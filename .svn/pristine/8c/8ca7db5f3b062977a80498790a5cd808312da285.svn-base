@using h365_web.Models;
@model MvcPaging.IPagedList<h365_web.Models.order_invoice2>
@{
    
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

}

<script type="text/javascript" src="~/Areas/newweb/Content/js/jquery.unobtrusive-ajax.min.js"></script>
@Html.ValidationSummary(true)

@using (Html.BeginForm("ListDel", controller, FormMethod.Post, new { @id = "frmCheckbox", @target = "" }))
{
    <input type="hidden" id="cb_flag" name="cb_flag" value="0" />
    <input type="hidden" id="cb_id" name="cb_id" value="" />
}

<!--pagetitle-->
<div class="maincontent">
    <div class="contentinner">
        <ul class="nav nav-pills">

            <form style="float:left" method="post" id="form2" name="form1" action="@(Url.Action("FinishList", "NwInvoice"))">

                <div>
                藥局店名：<input id="kw_name" name="kw_name" class="span2" />&nbsp;
                    
                
                結算月份：
                    <select name="kw_time" id="kw_time" class="in6">
                        <option>請選擇</option>
                        @for (var a = 0; a <= 11; a++)
                        {
                            //當月
                            DateTime dd = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 20).AddMonths(-a);

                            //選擇哪一個 顯示哪一個 語法
                            <option  value="@(dd)" @(dd.ToString("yyyy.MM") == ViewBag.yymm ? "selected=selected" : "") >@(dd.ToString("yyyy.MM"))月份</option>
                        }
                    </select>
                <input type="submit" value="查詢" class="btn btn-primary" />
                    @*&emsp;週期：<span id="cycle_time"></span>*@

                    </div>
                

                    
            </form>

           @* <form style="float: right"  method="post" id="form1" name="form1" action="@(Url.Action("Output", "NwInvoice"))">
                <input id="cler_date" name="cler_date" class="span2" value="" />
                <script type="text/javascript">$(function () { $('#cler_date').datepicker(); })</script>
                <input type="submit" value="產出當月發票" class="btn btn-primary" />
            </form>*@
        </ul>



