@using h365_web.Models
@model h365_web.Models.sys_power_data
@{
    int id = Convert.ToInt32(ViewContext.RouteData.Values["id"]);
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    _dbContext _DB = new _dbContext();
    var gData = _DB.sys_function_sub.OrderBy(m => m.function_id).ToList();
}
<div class="maincontent">
    <div class="contentinner">

        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.power_id)
            <div class="widgetcontent">
                <h4 class="widgettitle">基本資料</h4>

                @Html.EditorFor(model => model.label)

                @Html.EditorFor(model => model.controller)

                @Html.EditorFor(model => model.action)

                @Html.EditorFor(model => model.info)

                @Html.EditorFor(model => model.visible)

                <h4 class="widgettitle">設定菜單</h4>

                <div id="tabs">

                    <div class="m9">

                        <ul class="a6 a6-2">

                            @{ int function_id = 0; }

                            @foreach (var item in gData.OrderBy(m => m.function_id))
                            {

                                if (function_id != item.function_id)
                                { 
                                <li><a href="#tabs-@(item.function_id)">@(item.sys_function_data.label)</a></li>
                                }

                                function_id = item.function_id;
                            }

                        </ul>

                    </div>

                    

                    @{function_id = 0; }

                    @foreach (var item in gData.OrderBy(m => m.function_id).Select(m => m.function_id).Distinct())
                    {
                        
                        <div id="tabs-@(item)">

                            <table class="table table-bordered mailinbox">

                                <colgroup>
                                    <col class="width20" />
                                    <col class="width8" />
                                    <col class="width20" />
                                    <col class="width20" />
                                    <col class="" />
                                </colgroup>

                                <thead>
                                    <tr>
                                        <th>功能名稱 </th>
                                        <th>啟用</th>
                                        <th>子功能名稱 </th>
                                        <th>action </th>
                                        <th>說明 </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item2 in gData.Where(m => m.function_id == item))
                                    {
                                        var data = _DB.sys_power_sub.Where(m => m.power_id == id).Where(m => m.function_sub_id == item2.function_sub_id).FirstOrDefault();
                                        bool blnC = (data != null);
                                        <tr class="unread">
                                            <td class="right" style="text-align: right;">@if (item2.show_visible)
                                                                                         { <span class="icon-th-large"></span> }&nbsp;</td>
                                            <td class="center">
                                                <input type="checkbox" name="block_id" class="block_check" @(blnC ? "checked" : "") value="@item2.function_sub_id" /></td>
                                            <td>@(item2.label)</td>
                                            <td>@(item2.action)</td>
                                            <td>@Html.DisplayFor(modelItem => item2.info)&nbsp;</td>
                                        </tr>
                                    }

                                </tbody>


                            </table>

                        </div>
                    }

                </div>

                @*<table class="table table-bordered mailinbox">
                    <colgroup>
                        <col class="width20" />
                        <col class="width8" />
                        <col class="width20" />
                        <col class="width20" />
                        <col class="" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>功能名稱 </th>
                            <th>啟用</th>
                            <th>子功能名稱 </th>
                            <th>action </th>
                            <th>說明 </th>
                        </tr>
                    </thead>
                    <tbody>


                        @foreach (var item in gData)
                        {

                            if (function_id != item.function_id)
                            { 
                            <tr class="unread">
                                <td><span class="@(item.sys_function_data.icon)"></span>@(item.sys_function_data.label) [ @(item.sys_function_data.controll) ]</td>
                                <td>&nbsp;</td>
                                <td>&nbsp;</td>
                                <td>&nbsp;</td>
                                <td>@(item.sys_function_data.label)</td>
                            </tr>
                         
                                function_id = item.function_id;
                            }

                            var data = _DB.sys_power_sub.Where(m => m.power_id == id).Where(m => m.function_sub_id == item.function_sub_id).FirstOrDefault();
                            bool blnC = (data != null);
                            <tr class="unread">
                                <td class="right" style="text-align: right;">@if (item.show_visible)
                                                                             { <span class="icon-th-large"></span> }&nbsp;</td>
                                <td class="center">
                                    <input type="checkbox" name="block_id" class="block_check" @(blnC ? "checked" : "") value="@item.function_sub_id" /></td>
                                <td>@(item.label)</td>
                                <td>@(item.action)</td>
                                <td>@Html.DisplayFor(modelItem => item.info)&nbsp;</td>
                            </tr>
                            
                        }
                    </tbody>
                </table>*@


                <div class="control-group">
                    <div class="stdformbutton">
                        <button class="btn btn-primary">儲存</button>
                        <button type="reset" class="btn">取消</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            rules: {
                label: "required"
            },
            messages: {
                label: "[名稱]必填!!"
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').addClass('error');
            }
        });

    })
</script>
