        public ActionResult MonthlyListDel(int cb_flag, int year1, int mon = 0, int day = 0, string start = null, string end = null)   //cb_flag = 1 銷售報表  2 分潤報表 0 指定區段詳細報表
        {
            string[] jgrowl_msg = new string[] { "選擇匯出", "全部匯出", "作廢" };
            string msg = "匯出失敗，請洽系統工程師，謝謝!!";
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);
            string sql = "";
            string FileName = "";
            string downloadFileName = "";
            if (mon != 0 && cb_flag == 1)  //銷售月報表
            {
                FileName = Export(year1, cb_flag, mon);
                downloadFileName = DateTime.Today.ToString("yyyyMMdd") + "銷售月報表(" + year1 + "年" + mon + "月)";
            }
            else if (cb_flag == 1)  //銷售年報表
            {
                FileName = Export(year1, cb_flag);
                downloadFileName = DateTime.Today.ToString("yyyyMMdd") + "銷售年報表(" + year1 + "年)";
            }
            else if (cb_flag == 2)  //分潤報表
            {
                FileName = Export(year1, cb_flag, 0, start, end);
                downloadFileName = DateTime.Today.ToString("yyyyMMdd") + "分潤報表(" + year1 + "年)";
            }
            else if (cb_flag == 0)   //區間匯出
            {
                FileName = Export(year1, cb_flag, 0, start, end);
                start = start.Replace("/", "");
                end = end.Replace("/", "");
                downloadFileName = DateTime.Today.ToString("yyyyMMdd") + "銷售報表(" + start + "~" + end + ")";
            }

            if (!string.IsNullOrEmpty(FileName))
            {
                var admin = NW.admin(this.User.Identity.Name);
                //sql = "Update order_data set export_datetime = getDate(), export_info='網站匯入：" + this.User.Identity.Name + "' Where visible=1 and export_datetime is null  and flag=1 and company_id=" + admin.company_id.ToString();
                //1為全部匯出
                //if (cb_flag != 1) { sql += " And order_id in (" + cb_id + ")"; }

                // if (sql != "")
                //{
                //     _DB.Database.ExecuteSqlCommand(sql);
                // }
                return File(FileName, "application/vnd.ms-excel", downloadFileName);
                //Server.UrlPathEncode(DateTime.Today.ToString("yyyyMMdd") + "銷售報表.xlsx")
            }
            else
            {
                return Content(msg);
            }

            //TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
        }

        private string Export(int year1, int cb_flag, int mon = 0, string start = null, string end = null)
        {
            string value = "";
            string[] cols = "".Split(',');

            int year = year1;
            List<Order_All> Linq1 = new List<Order_All> { };
            List<order_m> order1 = new List<order_m> { };
            List<order_s> order0 = new List<order_s> { };

            if (cb_flag == 0 && !string.IsNullOrEmpty(start) && !string.IsNullOrEmpty(end))   //區間匯出報表
            {
                cols = "訂購時間,訂單編號,產品編號,產品名稱,收件人,貨號,廠商,購買數量,紅利,健康紅利,成本,售價".Split(',');
                DateTime st = Convert.ToDateTime(start);  //起始日 字串轉日期
                DateTime en = Convert.ToDateTime(end).AddHours(23).AddMinutes(59);      //結束日 
                var Order_Mon_S = new List<Order_All> { };
                var Linq = this._DB.order_data.Where(m => m.order_id > 0 && (m.order_datetime >= st && m.order_datetime <= en && m.finish_datetime != null && m.back_datetime == null)).OrderBy(m => m.order_datetime).ToList(); //區間內全部訂單
                foreach (var item in Linq)
                {
                    var data = this._DB.order_sub.Where(m => m.order_id == item.order_id).Select(m => new order_s { order_id = m.order_id, product_id = m.product_id, num = m.num, price = m.price, cost = m.cost, item_name = m.item_name, item_no = m.item_no }).ToList();

                    foreach (var item1 in data)
                    {
                        var data0 = this._DB.order_data.Where(m => m.order_id == item1.order_id).FirstOrDefault();
                        var data1 = this._DB.solt_data.Where(m => m.order_id == data0.order_id).FirstOrDefault();
                        item1.order_datetime = data0.order_datetime;
                        item1.bonus = data0.bonus;
                        item1.send_name = data0.send_name;
                        if (data1 != null)
                        {
                            item1.h_bonus = data1.prize;  //健康紅利
                        }
                        else { item1.h_bonus = 0; }
                        var Product = this._DB.product_data.Where(m => m.product_id == item1.product_id).FirstOrDefault();
                        if (Product != null)
                        {
                            var Com = this._DB.company_data.Where(m => m.company_id == Product.company_id).FirstOrDefault();
                            if (Com != null)
                            {
                                item1.name_company = Com.name;
                            }
                        }
                        order0.Add(item1);

                    }

                }

            }
            else if (mon != 0 && cb_flag == 1)  //銷售月報表
            {

                cols = "日,完成-訂單總計,完成-毛利總計,退貨-金額總計,退貨-訂單總數,作廢-金額總計,作廢-訂單總數".Split(',');
                DateTime sD = new DateTime(year, mon, 1); //起始日
                DateTime eD = sD.AddMonths(1); //結束日
                var Order_Mon_S = new List<Order_All> { };
                var Linq = this._DB.order_data.Where(m => m.order_id > 0 && (m.order_datetime >= sD && m.order_datetime < eD)); //當月全部訂單

                var Clear = Linq.Where(m => m.visible == false).OrderBy(m => m.order_id).ToList();
                var Back = Linq.Where(m => m.back_datetime != null).OrderBy(m => m.order_id).ToList();
                var Finish = Linq.Where(m => m.finish_datetime != null && m.back_datetime == null).OrderBy(m => m.order_id).ToList();
                foreach (var item in NW.EachDay(sD, eD.AddDays(-1))) //日期循環
                {
                    var Order_Mon = new NwReportController.Order_All { }; //建立新單

                    Order_Mon.year = item.Year; //年
                    Order_Mon.mon = item.Month; //月
                    Order_Mon.day = item.Day; //日

                    #region"取消訂單"

                    var Clear1 = Clear.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                    Order_Mon.clear_num = Clear1.Count();
                    Order_Mon.clear_total = Clear1.Select(m => m.total).DefaultIfEmpty(0).Sum();

                    #endregion

                    #region"退貨"

                    var Back1 = Back.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                    Order_Mon.back_num = Back1.Count();
                    Order_Mon.back_total = Back1.Select(m => m.total).DefaultIfEmpty(0).Sum();

                    #endregion

                    #region"完成交易"

                    var Finish1 = Finish.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                    Order_Mon.finish_num = Finish1.Count();
                    Order_Mon.finish_total = Finish1.Select(m => m.total).DefaultIfEmpty(0).Sum();
                    Order_Mon.gross_total = Math.Round(Finish1.Select(m => m.total).DefaultIfEmpty(0).Sum() - Finish1.Select(m => m.cost_total).DefaultIfEmpty(0).Sum()); //毛利總計

                    #endregion

                    Order_Mon_S.Add(Order_Mon);
                }

                Linq1 = Order_Mon_S;

            }
            else if (cb_flag == 1 && mon == 0)     //銷售年報表
            {
                cols = "月份,完成-訂單總計,完成-毛利總計,退貨-金額總計,退貨-訂單總數,作廢-金額總計,作廢-訂單總數".Split(',');

                Linq1 = Monthly_Public(year);
            }
            else if (cb_flag == 2)   //分潤報表
            {

                cols = "項次,訂單日期,訂單編號,商品名稱,訂單業績,藥局名稱,藥局分潤,加盟主分潤,加盟經銷分潤,業務經銷分潤,耐特分潤".Split(',');

                var a = 1; //項次
                var data = this._DB.partner_maori.Where(m => m.visible).FirstOrDefault(); //毛利分潤表
                var data1 = this._DB.order_data.Where(m => m.visible && m.pay_visible && m.flag == 5 && (m.order_name.Contains("XX") && m.order_phone.Contains("XX"))).OrderBy(m => m.order_id).ToList();

                if (!string.IsNullOrEmpty(start) && !string.IsNullOrEmpty(end))
                {
                    DateTime st = Convert.ToDateTime(start);  //起始日 字串轉日期
                    DateTime en = Convert.ToDateTime(end).AddHours(23).AddMinutes(59);      //結束日  因輸入日期會判定至當日凌晨0時 故+1日
                    data1 = data1.Where(m => m.order_datetime > st && m.order_datetime <= en).OrderBy(m => m.order_id).ToList();
                }

                foreach (var item in data1)
                {
                    var order = new order_m { }; //新位置

                    var data2 = this._DB.order_sub.Where(m => m.order_id == item.order_id).FirstOrDefault(); //訂單明細
                    var data3 = this._DB.solt_data.Where(m => m.order_id == item.order_id).FirstOrDefault(); //健康紅利
                    var data4 = this._DB.drugstore_data.Where(m => m.drugstore_id == item.drugstore_id).FirstOrDefault(); //藥局

                    if (data2 != null)
                    {
                        order.id = a;  //項次
                        order.order_datetime = item.order_datetime; //訂購時間
                        order.item_name = data2.item_name; //品名
                        order.sales_total = ((data2.price - data2.cost) * data2.num) - (data3 != null ? data3.prize : 0) - item.bonus; //訂單業績
                        order.order_id = item.order_id; //訂單編號
                        order.drugstore_name = data4 != null ? data4.name : ""; //藥局名稱

                        double maori_all = order.sales_total * data.netsourcer_num; //(*1.1)             
                        order.drugstore_num = Math.Floor(maori_all * (data.drugstore_num * 0.01));//藥局分潤
                        order.salesman_num = 0;//業務經銷分潤
                        order.partner_member_num = 0;//加盟主分潤
                        order.partner_sales_num = 0;//加盟經銷分潤

                        order.net_num = Math.Floor(maori_all - (order.drugstore_num + order.partner_member_num + order.partner_sales_num + order.salesman_num));//耐特分潤

                        order1.Add(order);
                        a++;
                    }
                }

            }



            sys_admin_data admin = NW.admin(User.Identity.Name);
            //if (admin.power_id > 2) { Linq1 = Linq1.Where(m => m.company_id == admin.company_id); }


            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("報表");
            int colIdx = 1;
            int rowIdx = 2;



            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            //sheet.Cell(1, 15).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            //sheet.Cell(1, 16).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            //sheet.Cell(1, 17).Style.Fill.BackgroundColor = XLColor.PastelYellow;
            //sheet.Cell(1, 18).Style.Fill.BackgroundColor = XLColor.PaleTurquoise;

            string p = "'";

            if (cb_flag == 1)
            {
                foreach (var item in Linq1)
                {

                    if (item.day != 0)
                    {
                        sheet.Cell(rowIdx, 1).Value = p + item.day;
                    }
                    else
                    {
                        sheet.Cell(rowIdx, 1).Value = p + item.mon;
                    }
                    sheet.Cell(rowIdx, 2).Value = p + item.finish_num;
                    sheet.Cell(rowIdx, 3).Value = p + item.gross_total;
                    sheet.Cell(rowIdx, 4).Value = p + item.back_total;
                    sheet.Cell(rowIdx, 5).Value = p + item.back_num;
                    sheet.Cell(rowIdx, 6).Value = p + item.clear_total;
                    sheet.Cell(rowIdx, 7).Value = p + item.clear_num;

                    rowIdx += 1;
                }
            }
            else if (cb_flag == 2)
            {
                foreach (var item in order1)
                {
                    sheet.Cell(rowIdx, 1).Value = p + "#" + item.id;
                    sheet.Cell(rowIdx, 2).Value = p + item.order_datetime;
                    sheet.Cell(rowIdx, 3).Value = p + item.order_id;
                    sheet.Cell(rowIdx, 4).Value = p + item.item_name;
                    sheet.Cell(rowIdx, 5).Value = p + item.sales_total;
                    sheet.Cell(rowIdx, 6).Value = p + item.drugstore_name;
                    sheet.Cell(rowIdx, 7).Value = p + item.drugstore_num;
                    sheet.Cell(rowIdx, 8).Value = p + item.partner_member_num;
                    sheet.Cell(rowIdx, 9).Value = p + item.partner_sales_num;
                    sheet.Cell(rowIdx, 10).Value = p + item.salesman_num;
                    sheet.Cell(rowIdx, 11).Value = p + item.net_num;

                    rowIdx += 1;
                }

            }
            else if (cb_flag == 0)
            {
                foreach (var item in order0)
                {
                    sheet.Cell(rowIdx, 1).Value = p + item.order_datetime;
                    sheet.Cell(rowIdx, 2).Value = p + item.order_id;
                    sheet.Cell(rowIdx, 3).Value = p + item.product_id;
                    sheet.Cell(rowIdx, 4).Value = p + item.item_name;
                    sheet.Cell(rowIdx, 5).Value = p + item.send_name;
                    sheet.Cell(rowIdx, 6).Value = p + item.item_no;
                    sheet.Cell(rowIdx, 7).Value = p + item.name_company;
                    sheet.Cell(rowIdx, 8).Value = p + item.num;
                    sheet.Cell(rowIdx, 9).Value = p + item.bonus;
                    sheet.Cell(rowIdx, 10).Value = p + item.h_bonus;
                    sheet.Cell(rowIdx, 11).Value = p + item.cost;
                    sheet.Cell(rowIdx, 12).Value = p + item.price;

                    rowIdx += 1;
                }
            }

            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }



            value = Server.MapPath("~/Content/files/" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }

        #endregion

    }
}
