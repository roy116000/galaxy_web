        public class drug_list
        {
            public int drugstore_id { get; set; }
            public string zip { get; set; }
            public string name { get; set; }
            public string drug_sales { get; set; }
            public DateTime? date_s { get; set; }
            public DateTime? date_e { get; set; }
            public int open_days { get; set; }
            public int open_num { get; set; }
            public int open_par { get; set; }
            public int order_num { get; set; }
            public int order_total { get; set; }
            public double order_cost { get; set; }
            public double gross_profit { get; set; }
            public double gross_margin { get; set; }

        }

        public IPagedList Public(int? page, string kw, DateTime? date)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;




            var Linq = from m in this._DB.drugstore_data.Where(m => m.visible && m.uid != null).Select(m => new { m.drugstore_id, m.name, m.sales_id, m.zip })//藥局
                       from mm in this._DB.drugstore_datao.Where(x => x.drugstore_id == m.drugstore_id).DefaultIfEmpty()
                       from m2 in this._DB.drugstore_sales.Where(x => x.sales_id == m.sales_id).DefaultIfEmpty() //藥局業務
                       from m3 in this._DB.zip_data.Where(z => z.zip == m.zip).DefaultIfEmpty()
                       join m4 in this._DB.drugstore_loging.Select(x => new { x.id, x.drugstore_id, x.loging_time }) on m.drugstore_id equals m4.drugstore_id into mm4
                       join m5 in this._DB.order_data on m.drugstore_id equals m5.drugstore_id into mm5
                       select new h365_web.Areas.newweb.Controllers.NwReportController.drug_list()
                       {
                           drugstore_id = m.drugstore_id, //藥局編號
                           zip = m3.city + "-" + m3.canton,
                           name = m.name, //藥局名稱
                           drug_sales = m2.name, //藥局業務
                           date_s = mm4.OrderBy(x => x.id).FirstOrDefault().loging_time,
                           date_e = mm4.OrderByDescending(x => x.id).FirstOrDefault().loging_time,
                           open_num = mm4.Select(x => x.loging_time.Value.Day).Distinct().Count(),
                           order_num = mm5.Count(),
                           order_total = mm5.Select(x => x.total).DefaultIfEmpty().Sum(),
                           order_cost = mm5.Select(x => x.cost_total).DefaultIfEmpty().Sum()
                       };


            #region"分類標籤"

            var gData = Linq.Where(m => m.date_e >= DateTime.Today);
            ViewBag.count = gData.AsEnumerable().Count();  //從queryable轉Enumerable 計數才正確     

            #endregion

            if (!string.IsNullOrEmpty(kw))
            {
                //var date1 = kw.Replace("-", "/");
                Linq = Linq.Where(m => m.name.Contains(kw));
                ViewBag.kw = kw;

            }
            else if (date != null)
            {
                Linq = gData;
                ViewBag.status = 1; //分類頁籤用
            }

            IPagedList data = Linq.OrderByDescending(m => m.date_s != null).ThenByDescending(m => m.order_total).ThenByDescending(m => m.drugstore_id).ToPagedList(currentPageIndex, 500);


            return data;

        }

        public ActionResult MList(string kw, DateTime? date)
        {

            IPagedList data = Public(null, kw, date);

            return View(data);
        }

        public ActionResult MList_ajax(int? page, string kw, DateTime? date)
        {

            IPagedList data = Public(page, kw, date);

            return PartialView(RouteData.Values["action"].ToString(), data);
        }

        public ActionResult MEdit(string kw0, int? status)   //報表匯出
        {
            string value = "";
            string Title = "";
            string Header = "";

            Title = "開機報表";
            Header = "地區,藥局名稱,業務,天數,開機-起,開機-結,開機次數,開機率,訂單數,訂單業績,訂單成本,毛利額,毛利率";

            var Linq = from m in this._DB.drugstore_data.Where(m => m.visible && m.uid != null).Select(m => new { m.drugstore_id, m.name, m.sales_id, m.zip })//藥局
                       from mm in this._DB.drugstore_datao.Where(x => x.drugstore_id == m.drugstore_id).DefaultIfEmpty()
                       from m2 in this._DB.drugstore_sales.Where(x => x.sales_id == m.sales_id).DefaultIfEmpty() //藥局業務
                       from m3 in this._DB.zip_data.Where(z => z.zip == m.zip).DefaultIfEmpty()
                       join m4 in this._DB.drugstore_loging.Select(x => new { x.id, x.drugstore_id, x.loging_time }) on m.drugstore_id equals m4.drugstore_id into mm4
                       join m5 in this._DB.order_data on m.drugstore_id equals m5.drugstore_id into mm5
                       select new h365_web.Areas.newweb.Controllers.NwReportController.drug_list()
                       {
                           drugstore_id = m.drugstore_id, //藥局編號
                           zip = m3.city + "-" + m3.canton,
                           name = m.name, //藥局名稱
                           drug_sales = m2.name, //藥局業務
                           date_s = mm4.OrderBy(x => x.id).FirstOrDefault().loging_time,
                           date_e = mm4.OrderByDescending(x => x.id).FirstOrDefault().loging_time,
                           open_num = mm4.Select(x => x.loging_time.Value.Day).Distinct().Count(),
                           order_num = mm5.Count(),
                           order_total = mm5.Select(x => x.total).DefaultIfEmpty().Sum(),
                           order_cost = mm5.Select(x => x.cost_total).DefaultIfEmpty().Sum()
                       };

            if (!string.IsNullOrEmpty(kw0))
            {
                Linq = Linq.Where(m => m.name.Contains(kw0));
            }
            else if (status == 1)
            {
                Linq = Linq.Where(m => m.date_e >= DateTime.Today);
            }

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add(Title);
            int colIdx = 1, rowIdx = 2, num = 0; //標頭、資料行、欄位

            //標頭
            string[] cols = Header.Split(',');
            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            //內容 
            string p = "'";
            int r = 1; //排名
            foreach (var item in Linq.OrderByDescending(m => m.date_s != null).ThenByDescending(m => m.order_total).ThenByDescending(m => m.drugstore_id))
            {
                num = 1; //從第一欄位開始

                item.order_cost = NW.Math_gRound(item.order_cost, 2);
                item.open_days = DateTime.Now.Subtract((item.date_s.HasValue) ? (DateTime)item.date_s : DateTime.Now).Days;
                item.open_par = (item.open_num != 0 && item.open_days != 0) ? (item.open_num * 100 / item.open_days) : 0;
                item.gross_profit = NW.Math_gRound(item.order_total - item.order_cost, 2); //毛利額
                item.gross_margin = item.gross_profit != 0 ? NW.Math_gRound((item.gross_profit * 100 / item.order_total), 2) : 0; //毛利率
                string s = NW.getDate(item.date_s);
                string e = NW.getDate(item.date_e);


                List<string> data = new List<string> { };

                data.Add(item.zip);
                data.Add(item.name);
                data.Add(item.drug_sales);
                data.Add(item.open_days.ToString("N0"));
                data.Add(s);
                data.Add(e);
                data.Add(item.open_num.ToString("N0"));
                data.Add(item.open_par.ToString("N0") + "%");
                data.Add(item.order_num.ToString("N0"));
                data.Add("$" + item.order_total.ToString("N0"));
                data.Add("$" + item.order_cost.ToString("N2"));
                data.Add("$" + item.gross_profit.ToString("N2"));
                data.Add(item.gross_margin.ToString("F2") + "%");

                foreach (var item2 in data)
                {

                    sheet.Cell(rowIdx, num).Value = p + item2;

                    num++;
                }
                rowIdx++; //下一筆資料
                r++;
            }

            //自動伸縮欄寬
            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
                sheet.Column(i).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMdd") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();


            return File(value, "application/vnd.ms-excel", DateTime.Now.ToString("yyyyMMdd") + Title + ".xlsx");

        }

        #endregion

        #region "監控列表"

        public ActionResult List()
        {
            var data = new drugstore_data();
            data.datetime = DateTime.Now;


            return View(data);
        }


        public ActionResult Edit(DateTime? datetime)  //監控匯出表
        {

            var data = this._DB.drugstore_loging.Where(m => DbFunctions.DiffDays(m.loging_time, datetime) == 0).OrderBy(m => m.drugstore_id).Select(m => m.drugstore_id).Distinct().ToList();
            var onlineddata = new List<drugstore_data>();
            foreach (var item in data)
            {
                var onlineddataget = this._DB.drugstore_data.Where(m => m.drugstore_id == item && m.uid != null && m.visible).OrderBy(m => m.drugstore_id).FirstOrDefault();
                if (onlineddataget != null)
                {

                    onlineddata.Add(onlineddataget);
                }

            }

            //判斷地址是否包含ZIP
            foreach (var item in onlineddata)
            {
                var data2 = this._DB.drugstore_loging.Where(m => m.drugstore_id == item.drugstore_id && DbFunctions.DiffDays(m.loging_time, datetime) == 0).OrderBy(m => m.drugstore_id).Select(m => m.loging_time.Value.Hour).Distinct().ToList();


                var zipdata = this._DB.zip_data.Where(m => m.zip == item.zip).FirstOrDefault();
                string city_canton = zipdata.city + zipdata.canton;
                item.address = city_canton + item.address.Replace(city_canton, "");






                //預設X
                item.a = "X";
                item.b = "X";
                item.c = "X";
                item.d = "X";
                item.e = "X";
                item.f = "X";
                item.g = "X";
                item.h = "X";
                item.i = "X";
