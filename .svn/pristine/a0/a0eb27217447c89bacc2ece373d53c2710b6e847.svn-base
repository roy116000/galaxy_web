        public List<drugstore> store()
        {
            int s = 1;
            var data = (from a in this._DB.zip_data.Where(m => m.visible)
                        join b in this._DB.drugstore_data.Where(m => m.visible && m.uid != null) on a.zip equals b.zip into mm
                        select new drugstore
                        {
                            city = a.city,
                            canton = a.canton,
                            num = mm.Count(),
                        }).OrderByDescending(m => m.num).ToList()
