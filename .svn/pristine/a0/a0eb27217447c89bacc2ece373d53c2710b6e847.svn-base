        public ActionResult DrugstoreswhereListDel(int total)   //報表匯出
        {
            string value = "";
            string Title = "";
            string Header = "";

            Title = "藥局分布排名";
            Header = "排名,縣市名稱,地區名稱,店家數,地區占比";

            var dr = store();

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add(Title);
