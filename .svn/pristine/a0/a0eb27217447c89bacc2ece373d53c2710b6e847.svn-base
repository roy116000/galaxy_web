        public ActionResult MemberBuyEditSave(search_data search_data)   //報表匯出
        {
            string value = "";
            string Title = "";
            string Header = "";

            Title = "會員購買分析報表";
            Header = "地區,藥局名稱,總人數,性別,18-24歲,25-34歲,35-44歲,45-54歲,55-64歲,總訂單數,不重複訂單數,購買率,地區購買率";

            var memberbuy = mem(search_data); //取得購買資料

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add(Title);
            int colIdx = 1, rowIdx = 2, num = 0; //標頭、資料行、欄位

            //標頭
            string[] cols = Header.Split(',');
            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            //內容 
            string p = "'";

            foreach (var item in memberbuy)
            {
                num = 1; //從第一欄位開始
                var orm = item.m_member != 0 ? (Math.Round((decimal)item.m_order_distinct / item.m_member, 2) * 100) : 0;
                var orf = item.f_member != 0 ? (Math.Round((decimal)item.f_order_distinct / item.f_member, 2) * 100) : 0;


                List<string> data = new List<string> { };

                data.Add(item.area);
                data.Add(item.drugstore);
                data.Add("男：" + item.m_member + "，女：" + item.f_member + "，未填性別：" + item.other_member);
                data.Add("男：" + item.m_num_20.ToString("N0") + "，女：" + item.f_num_20.ToString("N0"));
                data.Add("男：" + item.m_num_20_29.ToString("N0") + "，女：" + item.f_num_20_29.ToString("N0"));
                data.Add("男：" + item.m_num_30_39.ToString("N0") + "，女：" + item.f_num_30_39.ToString("N0"));
                data.Add("男：" + item.m_num_40_49.ToString("N0") + "，女：" + item.f_num_40_49.ToString("N0"));
                data.Add("男：" + item.m_num_50_59.ToString("N0") + "，女：" + item.f_num_50_59.ToString("N0"));
                data.Add("男：" + item.m_allorder + "，女：" + item.f_allorder);
                data.Add("男：" + item.m_order_distinct + "，女：" + item.f_order_distinct);
                data.Add("男：" + orm + "%，女：" + orf + "%");
                data.Add(item.area_buyrate.ToString("N0"));




                foreach (var item2 in data)
                {

                    sheet.Cell(rowIdx, num).Value = p + item2;

                    num++;
                }
                rowIdx++; //下一筆資料
            }

            //自動伸縮欄寬
            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
                sheet.Column(i).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMdd") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();


            return File(value, "application/vnd.ms-excel", DateTime.Now.ToString("yyyyMMdd") + Title + ".xlsx");

        }

        public List<Member_Buy> mem(search_data search_data)
        {
            //var data2 = this._DB.member_data.Where(m => m.create_datetime >= search_data.start_date && m.create_datetime <= search_data.end_date && m.visible).ToList();
            var data2 = this._DB.member_data.Where(m => m.visible && m.member_id != 0);
            // var data = this._DB.member_data.Where(m => && m.visible).GroupBy(m => m.zip).ToList();
            int year = DateTime.Now.Year;

            data2 = data2.Where(m => m.group_id == 1);



            var drugstore = this._DB.drugstore_data.Where(m => m.visible).ToList();
            var zip = this._DB.zip_data.Where(m => m.visible);
            var order = this._DB.order_data.Where(m => m.visible && m.flag == 5);
            var memberbuy = new List<Member_Buy>();

            foreach (var item in drugstore)
            {
                var zz = zip.Where(m => m.zip == item.zip).FirstOrDefault();  //地區
                var orders = order.Where(m => m.drugstore_id == item.drugstore_id && m.member_id != 0 && m.order_name.IndexOf("XX") == -1 && m.order_datetime >= search_data.start_date && m.order_datetime <= search_data.end_date);
                //var orders_distinct = order.Where(m => m.drugstore_id == item.drugstore_id).Select(m => m.send_name).Distinct();
                string ct = "";
                var mdata = new Member_Buy();

                var mem = data2.Where(m => m.drugstore_id == item.drugstore_id && m.visible).ToList();  //會員數

                mdata.area_total_member = mem.Count();
                mdata.m_member = mem.Where(m => m.sex == "男").Count();
                mdata.f_member = mem.Where(m => m.sex == "女").Count();
                mdata.other_member = mem.Where(m => string.IsNullOrEmpty(m.sex)).Count();


                if (orders != null)
                {
                    foreach (var t in mem)
                    {
                        var b = t.birthday.ToString().Substring(0, 4);
                        var c = Convert.ToInt32(b);


                        if (!string.IsNullOrEmpty(t.birthday.ToString()))
                        {

                            if (year - c >= 18 && year - c <= 24)
                            {
                                if (t.sex == "男")
                                {
                                    mdata.m_num_20++;
                                }
                                else if (t.sex == "女")
                                {
                                    mdata.f_num_20++;
                                }
                                else { break; }
                            }
                            if (year - c >= 25 && year - c <= 34)
                            {
                                if (t.sex == "男")
                                {
                                    mdata.m_num_20_29++;
                                }
                                else if (t.sex == "女")
                                {
                                    mdata.f_num_20_29++;
                                }
                                else { break; }
                            }
                            if (year - c >= 35 && year - c <= 44)
                            {
                                if (t.sex == "男")
                                {
                                    mdata.m_num_30_39++;
                                }
                                else if (t.sex == "女")
                                {
                                    mdata.f_num_30_39++;
                                }
                                else { break; }
                            }
                            if (year - c >= 45 && year - c <= 54)
                            {
                                if (t.sex == "男")
                                {
                                    mdata.m_num_40_49++;
                                }
                                else if (t.sex == "女")
                                {
                                    mdata.f_num_40_49++;
                                }
                                else { break; }
                            }
                            if (year - c >= 55 && year - c <= 64)
                            {
                                if (t.sex == "男")
                                {
                                    mdata.m_num_50_59++;
                                }
                                else if (t.sex == "女")
                                {
                                    mdata.f_num_50_59++;
                                }
                                else { break; }
                            }

                        }

                        mdata.m_allorder = orders.Where(m => m.order_sex == "男").Count();
                        mdata.f_allorder = orders.Where(m => m.order_sex == "女").Count();

                        mdata.m_order_distinct = orders.Where(m => m.order_sex == "男").Select(m => m.send_name).Distinct().Count();  //以收件人名 過濾重複
                        mdata.f_order_distinct = orders.Where(m => m.order_sex == "女").Select(m => m.send_name).Distinct().Count();


                        var f = (mdata.area_total_member != 0 ? Math.Round((mdata.m_order_distinct + mdata.f_order_distinct) / Convert.ToDouble(mdata.area_total_member), 2) : 0) * 100;
                        mdata.area_buyrate = f;
                    }
                }


                mdata.drugstore = !string.IsNullOrEmpty(item.name) ? item.name : "";   //加入藥局名稱
                if (ct != zz.city)
                {
                    mdata.area = zz.city + zz.canton;
                    memberbuy.Add(mdata);
                }
                ct = zz.city;

            }


            return memberbuy;
        }




