            public double cost { get; set; }
            public double maori_rate { get; set; }
            public double maori { get; set; }
            public int bonus { get; set; }
            public int bonus_p { get; set; }
            public double net_maori { get; set; }
            public string name_company { get; set; }
            public int pro_flag { get; set; }
