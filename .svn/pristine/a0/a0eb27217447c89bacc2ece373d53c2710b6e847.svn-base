        public List<equip_use> equ(DateTime start_date, DateTime end_date)
        {
            var all = new List<equip_use> { };

            var tmpdata = this._DB.drugstore_loging;
            //var days = new TimeSpan(end_date.Value.Ticks - start_date.Value.Ticks).Days;    //計算相距天數

            //找出輸入區間日有開機的藥局資料(id)
            var data = tmpdata.Where(m => start_date < m.loging_time && m.loging_time <= end_date).OrderBy(m => m.drugstore_id).Select(m => m.drugstore_id).Distinct().ToList();

            var open_time = this._DB.drugstore_time.Where(m => m.time_id > 0);
            var store = this._DB.drugstore_data.Where(m => m.drugstore_id > 0 && m.visible).ToList();

            var onlineddata = new List<drugstore_data>();
            foreach (var item in data)
            {
                var onlineddataget = store.Where(m => m.drugstore_id == item && m.uid != null && m.visible).OrderBy(m => m.drugstore_id).FirstOrDefault();
                if (onlineddataget != null)
                {
                    onlineddata.Add(onlineddataget);
                }

            }

            foreach (var item in onlineddata)
            {


                int ts = new TimeSpan().Hours;

                var one = new equip_use { };

                //var data2 = this._DB.drugstore_loging.Where(m => m.drugstore_id == item.drugstore_id && DbFunctions.DiffDays(m.loging_time, end_date) == days).Select(m => m.loging_time.Value.Hour).Distinct().ToList();
                var open = open_time.Where(m => m.drugstore_id == item.drugstore_id).FirstOrDefault();
                TimeSpan? day = end_date - start_date;    //相差幾天
                DateTime? start = start_date;

                one.id = item.drugstore_id;
                one.name = item.name;  //塞藥局名稱

                if (open != null)
                {
                    for (int a = 0; a <= day.Value.Days; a++)  //起始日開始加
                    {
                        var dd = (int)start.Value.DayOfWeek;   //星期幾  數字顯示  星期日為0
                        if (!string.IsNullOrEmpty(open.day_a))
                        {
                            var h = open.day_a.IndexOf(dd.ToString());  //搜尋星期幾
                            if (h != -1)  //如果這天的上午時段有營業
                            {
                                DateTime a1 = DateTime.ParseExact(open.time_as, "HHmm", System.Globalization.CultureInfo.InvariantCulture); //開店時間  (早上)
                                DateTime a2 = DateTime.ParseExact(open.time_ae == "2400" ? "2359" : open.time_ae, "HHmm", System.Globalization.CultureInfo.InvariantCulture);  //關店時間
                                TimeSpan ts1 = a2 - a1;   //時間相減
                                ts += ts1.Hours;
                            }
                        }
                        if (!string.IsNullOrEmpty(open.day_p))
                        {
                            var k = open.day_p.IndexOf(dd.ToString());  //搜尋星期幾
                            if (k != -1)  //如果這天的中午時段有營業
                            {
                                DateTime p1 = DateTime.ParseExact(open.time_ps, "HHmm", System.Globalization.CultureInfo.InvariantCulture); //開店時間  (下午)
                                DateTime p2 = DateTime.ParseExact(open.time_pe == "2400" ? "2359" : open.time_pe, "HHmm", System.Globalization.CultureInfo.InvariantCulture);  //關店時間
                                TimeSpan ts2 = p2 - p1;   //時間相減
                                ts += ts2.Hours;
                            }
                        }
                        if (!string.IsNullOrEmpty(open.day_n))
                        {
                            var l = open.day_n.IndexOf(dd.ToString());  //搜尋星期幾
                            if (l != -1)  //如果這天的晚上時段有營業
                            {
                                DateTime n1 = DateTime.ParseExact(open.time_ns, "HHmm", System.Globalization.CultureInfo.InvariantCulture); //開店時間  (晚上)
                                DateTime n2 = DateTime.ParseExact(open.time_ne == "2400" ? "2359" : open.time_ne, "HHmm", System.Globalization.CultureInfo.InvariantCulture);  //關店時間
                                TimeSpan ts3 = n2 - n1;   //時間相減
                                ts += ts3.Hours;
                            }
                        }

                        var data2 = new List<int> { };
                        var da2 = tmpdata.Where(m => m.drugstore_id == item.drugstore_id && DbFunctions.DiffDays(m.loging_time, start) == 0).Select(m => m.loging_time.Value.Hour).Distinct().ToList();
                        start = start.Value.AddDays(1);
                        one.act_time += da2.Count();

                    }
                    one.total_time = ts;
                }

                one.rate = one.total_time == 0 ? 0 : (one.act_time / one.total_time) * 100;

                all.Add(one);
            }

            return all;
        }


