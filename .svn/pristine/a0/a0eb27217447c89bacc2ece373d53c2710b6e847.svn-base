        public ActionResult IrrigationList(string kw, DateTime? start_date, DateTime? end_date)
        {

            ViewBag.start = start_date;
            ViewBag.end = end_date;
            ViewBag.kw = kw;
            var order = IrrigationEx(null, kw, start_date, end_date);
            IPagedList order1 = order.OrderBy(m => m.id).ToPagedList(0, 20);
            // IPagedList order2 = order1.ToPagedList(0, 20);



            return View(order1);
        }

        public ActionResult IrrigationList_ajax(int page, string kw, DateTime? start_date, DateTime? end_date)
        {
            ViewBag.start = start_date;
            ViewBag.end = end_date;
            ViewBag.kw = kw;
            var order = IrrigationEx(page, kw, start_date, end_date);

            IPagedList order1 = order.OrderBy(m => m.id).ToPagedList(page - 1, 20);
            // IPagedList order2 = order1.ToPagedList(currentPageIndex, 20);



            return PartialView(RouteData.Values["action"].ToString(), order1);
        }

        public List<order_m> IrrigationEx(int? page, string k, DateTime? start, DateTime? end)
        {


            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            DateTime eD = DateTime.Today.AddDays(-10); //10天前


            int id = 1;

            var data = this._DB.partner_maori.Where(m => m.visible).FirstOrDefault(); //毛利分潤表

            var data0 = this._DB.order_data.Where(m => m.visible && m.pay_visible && m.flag == 5);
            var sub = this._DB.order_sub.Where(m => m.order_id > 0);
            var solt = this._DB.solt_data.Where(m => m.order_id > 0);
            var drug = this._DB.drugstore_data.Where(m => m.drugstore_id > 0);

            var orderz = data0.Where(m => m.goods_datetime < eD && (m.order_name.Contains("XX") && m.order_phone.Contains("XX")));

            if (start.HasValue && end.HasValue)
            {
                end = end.Value.AddHours(23).AddMinutes(59);
                orderz = orderz.Where(m => m.order_datetime > start && m.order_datetime <= end);
            }

            var order1 = new List<order_m> { };

            foreach (var item in orderz.ToList())
            {
                var order = new order_m { }; //新位置

                var data2 = sub.Where(m => m.order_id == item.order_id).FirstOrDefault(); //訂單明細
                var data3 = solt.Where(m => m.order_id == item.order_id).FirstOrDefault(); //健康紅利
                var data4 = drug.Where(m => m.drugstore_id == item.drugstore_id).FirstOrDefault(); //藥局

                if (data2 != null)
                {
                    order.order_datetime = item.order_datetime; //訂購時間
                    order.item_name = data2 != null ? data2.item_name : ""; //品名
                    order.sales_total = ((data2.price - data2.cost) * data2.num) - (data3 != null ? data3.prize : 0) - item.bonus;
                    order.order_id = item.order_id; //訂單編號
                    order.drugstore_name = data4.name; //藥局名稱

                    double maori_all = order.sales_total * data.netsourcer_num; //(*1.1)             
                    order.drugstore_num = Math.Floor(maori_all * (data.drugstore_num * 0.01));
                    order.salesman_num = 0;
                    order.partner_member_num = 0;
                    order.partner_sales_num = 0;

                    //order.partner_member_num = Math.Floor(maori_all * (data.partner_member_num * 0.01));
                    //order.partner_sales_num = Math.Floor(maori_all * (data.partner_sales_num * 0.01));
                    //order.salesman_num = Math.Floor(maori_all * (data.salesman_num * 0.01));
                    order.net_num = Math.Floor(maori_all - (order.drugstore_num + order.partner_member_num + order.partner_sales_num + order.salesman_num));

                    order1.Add(order);
                }
            }
            var order2 = order1.OrderByDescending(m => m.order_datetime);
            foreach (var item in order2)
            {
                item.id = id;
                id++;
            }


            if (!string.IsNullOrEmpty(k))
            {
                order1.Where(m => m.item_name.Contains(k) || m.drugstore_name.Contains(k) || m.order_id.ToString().Contains(k));
            }

            return order1;
        }

