            return View(data);
        }

        public ActionResult MonthlyEdit(int year, int mon, int day)
        {
            var data = Monthly_Public(year, mon, day);

            return View(data);
        }


        public class order_s
        {
            public int order_id { get; set; }
            public int product_id { get; set; }
            public int num { get; set; }
            public int price { get; set; }
            public int bonus { get; set; }
            public int h_bonus { get; set; }
            public DateTime? order_datetime { get; set; }
            public string send_name { get; set; }
            public double cost { get; set; }
            public string item_name { get; set; }
            public string item_no { get; set; }
            public string name_company { get; set; }
        }

        [HttpPost]
        public ActionResult MonthlyEditSave(int id) //日報表詳細內容
        {
            int status = 0;
            string msg = null;

            var data = this._DB.order_sub.Where(m => m.order_id == id).OrderBy(m => m.sub_id).Select(m => new order_s { order_id = m.order_id, product_id = m.product_id, num = m.num, price = m.price, cost = m.cost, item_name = m.item_name, item_no = m.item_no }).ToList();



            //var data = this._DB.order_sub.Where(m => m.order_id == id).OrderBy(m => m.sub_id).ToList();

            foreach (var item in data)
            {
                var data0 = this._DB.order_data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                var data1 = this._DB.solt_data.Where(m => m.order_id == data0.order_id).FirstOrDefault();
                item.order_datetime = data0.order_datetime;
                item.bonus = data0.bonus;
                item.send_name = data0.send_name;
                if (data1 != null)
                {
                    item.h_bonus = data1.prize;  //健康紅利
                }
                else { item.h_bonus = 0; }
                var Product = this._DB.product_data.Where(m => m.product_id == item.product_id).FirstOrDefault();
                if (Product == null) { msg = "查無商品"; }
                else
                {
                    var Com = this._DB.company_data.Where(m => m.company_id == Product.company_id).FirstOrDefault();
                    if (Com == null) { msg = "查無廠商"; }
                    else
                    {
                        item.name_company = Com.name;
                    }
                }

            }

            return Json(new { data = data, msg = msg }, JsonRequestBehavior.AllowGet);

        }

