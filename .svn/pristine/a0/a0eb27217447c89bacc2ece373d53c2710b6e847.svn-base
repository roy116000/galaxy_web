        public List<hits_rate> rate(DateTime? start_date, DateTime? end_date)
        {
            var data = this._DB.adv_data.Where(m => m.adv_id > 0 && m.start_date > start_date && m.start_date <= end_date).ToList();
            var group = this._DB.adv_group.Where(m => m.group_id > 0).ToList();
            var drugstore = this._DB.drugstore_data.Where(m => m.drugstore_id > 0).ToList();
            var rank = 1;
            var all_adv = new List<hits_rate> { };

            foreach (var item in data)
            {

                var sg_name = data.Where(m => m.g_id == item.adv_id);  //分類名
                var g_name = group.Where(m => m.group_id == item.group_id);  //分區名
                var adv = new hits_rate { };
                if (!string.IsNullOrEmpty(item.drugstore_id))
                {
                    var na = item.drugstore_id.Split(',');

                    foreach (var item0 in na)
                    {

                        var drugstore_name = drugstore.Where(m => m.drugstore_id == Convert.ToInt32(item0)).FirstOrDefault();

                        adv.drugstore = drugstore_name == null ? "" : adv.drugstore + "," + drugstore_name.name;        //顯示藥局
                    }
                }



                adv.impressions = item.impressions; //曝光數
                adv.hit = item.hits;  //點擊數
                adv.rate = adv.impressions != 0 ? (adv.hit / adv.impressions) : (adv.hit / 1);  //曝光率
                adv.group = g_name.Count() == 0 ? "" : g_name.FirstOrDefault().name; //分區名
                adv.subgroup = sg_name.Count() == 0 ? "" : sg_name.FirstOrDefault().info;  //分類名
                adv.info = item.info;  //廣告標題
                adv.url = item.url;     //連結    
                adv.start_date = item.start_date;    //啟用日
                adv.end_date = item.end_date;        //停用日


                all_adv.Add(adv);

            }
            all_adv = all_adv.OrderByDescending(m => m.rate).ToList();
            foreach (var item in all_adv)
            {
                item.rank = rank;
                rank++;
            }

            return all_adv;
        }

        public ActionResult AdhitsListDel(DateTime? start_date, DateTime? end_date)   //報表匯出
        {
            string value = "";
            string Title = "";
            string Header = "";



            Title = "廣告曝光排名";
            Header = "排名,廣告曝光次數,點擊數,點擊率,廣告分區,廣告分類,文字說明,連結網址,啟用日期,停用日期,顯示藥局";

            var all_adv = rate(start_date, end_date);

            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add(Title);
            int colIdx = 1, rowIdx = 2, num = 0; //標頭、資料行、欄位

            //標頭
            string[] cols = Header.Split(',');
            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            //內容 
            string p = "'";

            foreach (var item in all_adv)
            {
                num = 1; //從第一欄位開始

                List<string> data = new List<string> { };

                data.Add(item.rank.ToString());
                data.Add(item.impressions.ToString("N0"));
                data.Add(item.hit.ToString("N0"));
                data.Add(item.rate.ToString("F2"));
                data.Add(item.group);
                data.Add(item.subgroup);
                data.Add(item.info);
                data.Add(item.url);
                data.Add(NW.getDate(item.start_date));
                data.Add(NW.getDate(item.end_date));
                data.Add(item.drugstore);


                foreach (var item2 in data)
                {

                    sheet.Cell(rowIdx, num).Value = p + item2;

                    num++;
                }
                rowIdx++; //下一筆資料
            }

            //自動伸縮欄寬
            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
                sheet.Column(i).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMdd") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();


            return File(value, "application/vnd.ms-excel", DateTime.Now.ToString("yyyyMMdd") + Title + ".xlsx");

        }


