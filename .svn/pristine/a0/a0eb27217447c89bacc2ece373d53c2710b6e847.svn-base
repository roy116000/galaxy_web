        public class Order
        {
            public List<order_data> Clear { get; set; }
            public List<order_data> Back { get; set; }
            public List<order_data> Finish { get; set; }

        }

        //報表共用
        public List<Order_All> Monthly_Public(int year, int mon = 0, int day = 0)
        {

            List<Order_All> Order_All_s = new List<Order_All> { };

            year = year != 0 ? year : DateTime.Today.Year; //年分
            int[] month = mon == 0 ? Enumerable.Range(1, 12).ToArray() : Enumerable.Range((int)mon, 1).ToArray(); //月份
            foreach (var item in month)
            {

                DateTime sD = new DateTime(year, item, 1); //起始日
                DateTime eD = sD.AddMonths(1); //結束日

                var Order_All = new NwReportController.Order_All { }; //建立新單
                var Order = new List<order_data> { };

                Order_All.year = year;
                Order_All.mon = item;

                var Linq = this._DB.order_data.Where(m => m.order_id > 0 && (m.order_datetime >= sD && m.order_datetime < eD)); //當月全部訂單

                #region"取消訂單"

                var Clear = Linq.Where(m => m.visible == false).OrderBy(m => m.order_id).ToList();
                Order_All.clear_num = Clear.Count(); //訂單數量
                Order_All.clear_total = Clear.Select(m => m.total).DefaultIfEmpty(0).Sum(); //訂單總計

                //if (month.Count() == 1)
                //{
                //    Order = new List<order_data> { };

                //    Order.AddRange(Clear);
                //    ViewData["Clear"] = Order;
                //}

                #endregion

                #region"退貨"

                var Back = Linq.Where(m => m.back_datetime != null).OrderBy(m => m.order_id).ToList();
                Order_All.back_num = Back.Count(); //訂單數量
                Order_All.back_total = Back.Select(m => m.total).DefaultIfEmpty(0).Sum(); //訂單總計

                //if (month.Count() == 1)
                //{
                //    Order = new List<order_data> { };
                //    Order.AddRange(Back);
                //    ViewData["Back"] = Order;
                //}

                #endregion

                #region"完成交易"

                var Finish = Linq.Where(m => m.finish_datetime != null && m.back_datetime == null).OrderBy(m => m.order_id).ToList();
                Order_All.finish_num = Finish.Count(); //訂單數量
                Order_All.finish_total = Finish.Select(m => m.total).DefaultIfEmpty(0).Sum(); //訂單總計
                Order_All.gross_total = Math.Round(Finish.Select(m => m.total).DefaultIfEmpty(0).Sum() - Finish.Select(m => m.cost_total).DefaultIfEmpty(0).Sum()); //毛利總計

                //if (month.Count() == 1)
                //{
                //    Order = new List<order_data> { };
                //    Order.AddRange(Finish);
                //    ViewData["Finish"] = Order;
                //}

                #endregion

                if (month.Count() == 1) //月報表
                {
                    var Or = new Order();
                    Or.Clear = Clear;
                    Or.Back = Back;
                    Or.Finish = Finish;

                    Monthly_mon(day, sD, eD, Or); //月報表 + 日報表
                }

                Order_All_s.Add(Order_All);
            }

            return Order_All_s;
        }

        //月報表 + 日報表
        public void Monthly_mon(int day, DateTime sD, DateTime eD, Order Order)
        {
            var Order_Mon_S = new List<Order_All> { };

            if (day != 0)
            {
                sD = new DateTime(sD.Year, sD.Month, day);
                eD = sD.AddDays(1);
            }

            foreach (var item in NW.EachDay(sD, eD.AddDays(-1))) //日期循環
            {
                var Order_Mon = new NwReportController.Order_All { }; //建立新單

                Order_Mon.year = item.Year; //年
                Order_Mon.mon = item.Month; //月
                Order_Mon.day = item.Day; //日

                #region"取消訂單"

                var Clear = Order.Clear.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                Order_Mon.clear_num = Clear.Count();
                Order_Mon.clear_total = Clear.Select(m => m.total).DefaultIfEmpty(0).Sum();

                #endregion

                #region"退貨"

                var Back = Order.Back.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                Order_Mon.back_num = Back.Count();
                Order_Mon.back_total = Back.Select(m => m.total).DefaultIfEmpty(0).Sum();

                #endregion

                #region"完成交易"

                var Finish = Order.Finish.Where(m => (m.order_datetime >= item && m.order_datetime < item.AddDays(1))).ToList();
                Order_Mon.finish_num = Finish.Count();
                Order_Mon.finish_total = Finish.Select(m => m.total).DefaultIfEmpty(0).Sum();
                Order_Mon.gross_total = Finish.Select(m => m.total).DefaultIfEmpty(0).Sum() - Finish.Select(m => m.cost_total).DefaultIfEmpty(0).Sum(); //毛利總計

                #endregion

                if (item.Day == day) //日報表
                {
                    var Order_Day = new Order();
                    Order_Day.Clear = Clear;
                    Order_Day.Back = Back;
                    Order_Day.Finish = Finish;
                    ViewData["Order_Day"] = Order_Day;
                }

                Order_Mon_S.Add(Order_Mon);
            }

            ViewData["Order_Mon_S"] = Order_Mon_S;
        }

        public ActionResult MonthlyList(int year = 0)
        {
            var data = Monthly_Public(year);

            ViewBag.year = year;

            return View(data);
        }

        public ActionResult MonthlyAdd(int year, int mon)
