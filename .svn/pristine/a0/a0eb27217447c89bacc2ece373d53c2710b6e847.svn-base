                data.end_date = drugstore_data.end_date;
                //data.note = drugstore_data.note;
                data.drugstore_sn = drugstore_data.drugstore_sn;
                data.full_name = drugstore_data.full_name;
                data.open_time = drugstore_data.open_time;

                //data.uid = drugstore_data.uid;
                data.pwd = "0000";
                //data.inx = drugstore_data.inx;
                data.mail = drugstore_data.mail;
                //data.login_pwd = drugstore_data.pwd;
                //string pwdmd5 = NW.MD5(data.login_pwd);
                //data.login_pwd_md5 = pwdmd5;
                data.create_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;

                data.pay_flag = 1;
                data.visible = false;

                //data.change_datetime = DateTime.Now.AddDays(10);
                //data.change_user = User.Identity.Name;                

                _DB.drugstore_data.Add(data);
                this._DB.SaveChanges();

                #region "現場勘查(圖片)"

                // inx 1 藥局外觀 2 招牌 3 內部環境 4 藥師照片 5 預計安裝位置

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new drug_image();
                        imgData.drugstore_id = data.drugstore_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = i + 1;
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.drug_image.Add(imgData);
                            _DB.SaveChanges();
                        }
                    }
                    else
                    {
                        //編輯
                        //var imgData = _DB.drug_image.Find(imgs.img_id[i]);
                        var imgData = _DB.drug_image.Where(m => m.imgs_id == imgs.img_id[i] && m.img_inx == imgs.img_inx[i]).FirstOrDefault();
                        if (imgData != null)
                        {
                            if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                            {
                                _DB.drug_image.Remove(imgData);
                            }
                            else
                            {
                                imgData.drugstore_id = drugstore_data.drugstore_id;
                                imgData.s_img = imgs.s_img[i].ToString();
                                imgData.b_img = imgs.b_img[i].ToString();
                                imgData.img_info = imgs.img_info[i].ToString();
                                //imgData.img_inx = imgs.img_inx[i];
                            }
                            _DB.SaveChanges();
                        }
                    }
                }


                _DB.SaveChanges();

                #endregion

                #region "營業時間"

                for (int i = 0; i < times.tdrugstore_id.Count; i++)
                {
                    if (times.tdrugstore_id[i] == 0)
                    {
                        var timeData = new durg_time();
                        timeData.drugstore_id = data.drugstore_id;
                        timeData.time_interval = times.time_interval[i];
                        timeData.sHM_hour = times.sHM_hour[i];
                        timeData.sHM_minute = times.sHM_minute[i];
                        timeData.eHM_hour = times.eHM_hour[i];
                        timeData.eHM_minute = times.eHM_minute[i];

                        timeData.inx = times.inx[i];

                        switch (timeData.inx)
                        {
                            case 1:
                                if (times.day1 != null)
                                {
                                    timeData.day = string.Join(",", times.day1);
                                }
                                break;

                            case 2:
                                if (times.day2 != null)
                                {
                                    timeData.day = string.Join(",", times.day2);
                                }
                                break;

                            case 3:
                                if (times.day3 != null)
                                {
                                    timeData.day = string.Join(",", times.day3);
                                }
                                break;
                        }

                        if (timeData.drugstore_id != 0)
                        {
                            //新增
                            _DB.durg_time.Add(timeData);
                            _DB.SaveChanges();
                        }
                    }
                    else
                    {
                        //編輯
                        var timeData = _DB.durg_time.Find(times.time_id[i]);
                        if (times.tdrugstore_id[i] != 0)
                        {

                            timeData.time_interval = times.time_interval[i];
                            timeData.sHM_hour = times.sHM_hour[i];
                            timeData.sHM_minute = times.sHM_minute[i];
                            timeData.eHM_hour = times.eHM_hour[i];
                            timeData.eHM_minute = times.eHM_minute[i];
                            timeData.inx = times.inx[i];

                            switch (timeData.inx)
                            {
                                case 1:
                                    if (times.day1 != null)
                                    {
                                        timeData.day = string.Join(",", times.day1);
                                    }
                                    break;

                                case 2:
                                    if (times.day2 != null)
                                    {
                                        timeData.day = string.Join(",", times.day2);
                                    }
                                    break;

                                case 3:
                                    if (times.day3 != null)
                                    {
                                        timeData.day = string.Join(",", times.day3);
                                    }
                                    break;
                            }

                            _DB.SaveChanges();
                        }

                    }

                }

                #endregion

                drugstore_data.drugstore_id = data.drugstore_id;

            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = drugstore_data.drugstore_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update drugstore_data set visible = 1 Where drugstore_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update drugstore_data set visible = 0 Where drugstore_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    //sql = "Delete From news_image Where news_id in (" + cb_id + ")";
                    //_DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From drugstore_data Where drugstore_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

