        public ActionResult Salesrank(string kw, DateTime? start_date, DateTime? end_date)
        {
            var salesall = sale(kw, start_date, end_date);

            ViewBag.start = start_date;
            ViewBag.end = end_date;
            ViewBag.kw = kw;

            IPagedList sales_data = salesall.OrderByDescending(m => m.num).ToPagedList(0, 20);

            return View(sales_data);
        }

        public ActionResult Salesrank_ajax(string kw, int? page, DateTime? start_date, DateTime? end_date)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            ViewBag.start = start_date;
            ViewBag.end = end_date;
            ViewBag.kw = kw;

            var salesall = sale(kw, start_date, end_date);

            IPagedList sales_data = salesall.OrderByDescending(m => m.num).ToPagedList(currentPageIndex, 20);

            return PartialView(RouteData.Values["action"].ToString(), sales_data);
        }

        public List<rank_detail> sale(string kw, DateTime? start_date, DateTime? end_date)
        {
            //int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var pro_data = this._DB.product_data.Where(m => m.product_id != 0); //抓出所有商品
            var pro_g = this._DB.product_group.Where(m => m.group_id != 0);
            var data = this._DB.order_sub.Where(m => m.order_id > 0); //先抓出所有商品訂單明細

            var order = start_date != null && end_date != null ? this._DB.order_data.Where(m => m.order_id > 0 && m.send_name.IndexOf("XX") == -1 && m.flag == 5 && m.order_datetime <= end_date && m.order_datetime > start_date) : this._DB.order_data.Where(m => m.order_id > 0 && m.send_name.IndexOf("XX") == -1 && m.flag == 5);

            var com = this._DB.company_data.Where(m => m.company_id > 0);
            var city = this._DB.zip_data.Where(m => m.zip > 0);
            var drugs = this._DB.drugstore_data.Where(m => m.drugstore_id > 0);
            int rank = 1;

            var salesall = new List<rank_detail> { };

            foreach (var item in order.ToList())
            {
                var sales = new rank_detail { };

                var ordata = data.Where(m => m.order_id == item.order_id).FirstOrDefault();
                var pro = ordata == null ? null : pro_data.Where(m => m.product_id == ordata.product_id).FirstOrDefault();
                var group = pro == null ? null : pro_g.Where(m => m.group_id == pro.group_id).FirstOrDefault();
                var drug = drugs.Where(m => m.drugstore_id == item.drugstore_id).FirstOrDefault();
                var zip = drug == null ? null : city.Where(m => m.zip == drug.zip).FirstOrDefault();
                var com_name = com.Where(m => m.company_id == item.company_id).FirstOrDefault();


                sales.city = zip == null ? "" : zip.city + zip.canton;   //藥局地址XX市XX區  
                sales.drugstore = drug == null ? "" : drug.name;  //藥局名稱
                sales.group = group == null ? "" : group.name;  //銷售分類
                sales.item_no = pro == null ? "" : pro.item_no; //商品貨號
                sales.item_name = pro == null ? "" : pro.item_name;  //商品名稱
                sales.num = ordata == null ? 0 : ordata.num;  //銷售數量
                sales.price = ordata == null ? 0 : sales.num * ordata.price;  //銷售業績
                sales.cost = ordata == null ? 0 : sales.num * ordata.cost;   //成本
                sales.maori_rate = (sales.price - sales.cost) / sales.price;   //毛利率
                sales.maori = sales.price - sales.cost;  //毛利
                sales.bonus = item.bonus;    //紅利
                sales.bonus_p = sales.bonus / sales.price;   //紅利佔比
                sales.net_maori = sales.maori - Convert.ToDouble(sales.bonus);  //淨毛利
                sales.name_company = com_name == null ? "" : com_name.name;   //供貨廠商名
                sales.pro_flag = pro == null ? 0 : pro.status_flag;
                sales.order_date = item.order_datetime;  //查詢區間用  訂單日期

                salesall.Add(sales);



            }

            //if (start_date != null && end_date != null)
            //{

            //    salesall = salesall.Where(m => m.order_date <= end_date && m.order_date > start_date).ToList();
            //}

            if (!(string.IsNullOrEmpty(kw)))
            {
                salesall = salesall.Where(m => m.drugstore.Contains(kw) || m.name_company.Contains(kw) || m.group.Contains(kw) || m.item_no.Contains(kw) || m.item_name.Contains(kw)).ToList();
                ViewBag.kw = kw;
            }

            //IPagedList sales_data = .ToPagedList(currentPageIndex, 20);

            salesall = salesall.OrderByDescending(m => m.num).ToList();
            foreach (var item in salesall)
            {
                item.rank = rank;
                rank++;
            }
            // ViewData["salesall"] = salesall;


            return salesall;

        }

        public ActionResult SalesrankListDel(int cb_flag, string k, DateTime? start, DateTime? end)   //報表匯出
        {
            string value = "";
            string Title = "";
            string Header = "";



            Title = "銷售排名";
            Header = "排名,縣市地區,藥局名稱,銷售分類,貨號,品名,銷售數量,銷售業績,成本,毛利率,毛利額,紅利點數,紅利點數占比,淨毛利額(扣除紅利),供貨廠商,商品狀態";

            var salesall = sale(k, start, end);



            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add(Title);
            int colIdx = 1, rowIdx = 2, num = 0; //標頭、資料行、欄位

            //標頭
            string[] cols = Header.Split(',');
            foreach (string colName in cols)
            {
                sheet.Cell(1, colIdx++).Value = colName;
            }

            //內容 
            string p = "'";

            foreach (var item in salesall)
            {
                num = 1; //從第一欄位開始

                List<string> data = new List<string> { };

                data.Add(item.rank.ToString());
                data.Add(item.city);
                data.Add(item.drugstore);
                data.Add(item.group);
                data.Add(item.item_no);
                data.Add(item.item_name);
                data.Add(item.num.ToString());
                data.Add(item.price.ToString("F2"));
                data.Add(item.cost.ToString("F2"));
                data.Add(item.maori_rate.ToString("F2"));
                data.Add(item.maori.ToString("F2"));
                data.Add(item.bonus.ToString("F2"));
                data.Add(item.bonus_p.ToString("F2"));
                data.Add(item.net_maori.ToString("F2"));
                data.Add(item.name_company);
                data.Add(item.pro_flag == 3 ? "上架中" : "下架中");

                foreach (var item2 in data)
                {

                    sheet.Cell(rowIdx, num).Value = p + item2;

                    num++;
                }
                rowIdx++; //下一筆資料
            }

            //自動伸縮欄寬
            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
                sheet.Column(i).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }

            value = Server.MapPath("~/Content/files/export/" + DateTime.Now.ToString("yyyyMMdd") + ".xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();


            return File(value, "application/vnd.ms-excel", DateTime.Now.ToString("yyyyMMdd") + Title + ".xlsx");

        }

