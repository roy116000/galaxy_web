    public class NwContactdrugstoreController : _BaseController
    {
        #region "聯絡列表"

        public ActionResult List(int? gid, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.contact_drugstore
                           orderby m.create_datetime descending
                           select new data_list()
                           {
                               data_id=m.contact_id,
                               name = m.name,
                               drug_name = m.drug_name,
                               drug_tel = m.drug_tel,
                               mail = m.mail,
                               address = m.address,
                               visible = m.visible
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw) || m.drug_tel.Contains(kw) || m.mail.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.contact_drugstore
                           orderby m.create_datetime descending
                           select new data_list()
                           {

                               data_id = m.contact_id,
                               name = m.name,
                               drug_name = m.drug_name,
                               drug_tel = m.drug_tel,
                               mail = m.mail,
                               address = m.address,
                               visible = m.visible
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw) || m.tel.Contains(kw) || m.mail.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


