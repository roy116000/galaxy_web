        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(contact_drugstore contact_drugstore, VmImage imgs)
        {
            var data = this._DB.contact_drugstore.Find(contact_drugstore.contact_id);

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                data.contact_id = contact_drugstore.contact_id;
                data.name = contact_drugstore.name;
                data.sex = contact_drugstore.sex;
                data.mail = contact_drugstore.mail;
                data.inv_sn = contact_drugstore.inv_sn;
                data.drug_name = contact_drugstore.drug_name;
                data.drug_tel = contact_drugstore.drug_tel;
                data.drug_phone = contact_drugstore.drug_phone;
                data.zip = contact_drugstore.zip;
                data.address = contact_drugstore.address;
                data.snormal_hour = contact_drugstore.snormal_hour;
                data.snormal_minute = contact_drugstore.snormal_minute;
                data.enormal_hour = contact_drugstore.enormal_hour;
                data.enormal_minute = contact_drugstore.enormal_minute;
                data.sholiday_hour = contact_drugstore.sholiday_hour;
                data.sholiday_minute = contact_drugstore.sholiday_minute;
                data.eholiday_hour = contact_drugstore.eholiday_hour;
                data.eholiday_minute = contact_drugstore.eholiday_minute;
                data.drug_holiday = contact_drugstore.drug_holiday;
                data.isholiday = contact_drugstore.isholiday;


                data.visible = contact_drugstore.visible;
                data.change_datetime = DateTime.Now;
                data.change_user = User.Identity.Name;
                data.reply = contact_drugstore.reply;



       
                this._DB.SaveChanges();

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = contact_drugstore.contact_id });
        }

