<script>
    function gocheck(o) {
        if ($('#set').find('span').eq(o).attr('class') == 'checked') {
            $('#set').find('span').eq(o).removeClass('checked');
            $('#set').find('span').eq(o).find('input').removeClass('checked')
        }
        else {
            $('#set').find('span').eq(o).addClass('checked');
            $('#set').find('span').eq(o).find('input').addClass('checked')
        }
    }

</script>


<script>

    function checkthis() {
        var myqe = '';
        var block = $('#set span');
        var block2 = '';
        var block3 = '';
        var goval = '';

        for (var key in block) {


            block2 = block.eq(key).find('input').attr('class');


            if (block2 == 'checked') {
                block3 += block.eq(key).find('input').attr('value') + ',';
            }

            if (isNaN(key) == true) {
                break;
            }
        }
        $('#grouptag').attr('value', block3);




    }


</script>*@
