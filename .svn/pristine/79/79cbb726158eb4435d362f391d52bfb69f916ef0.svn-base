        public ActionResult GroupList(string kw)
        {


            int currentPageIndex = 0;

            var tmpData = (from m in this._DB.product_group2
                           where m.parent_id == 0
                           join m2 in this._DB.product_group2 on m.group_id equals m2.parent_id into mm
                           orderby m.freight_id, m.inx, m.create_datetime descending
                           select new data_group
                           {
                               group_id = m.group_id,
                               name = m.name,
                               inx = m.inx,
                               visible = m.visible,
                               counts = mm.Count(),
                               change_user = m.freight_id.ToString()
                           }
                        );



            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            IPagedList data = tmpData.ToPagedList(currentPageIndex, 1000);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

