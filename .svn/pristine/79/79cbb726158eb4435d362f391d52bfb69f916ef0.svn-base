                //data.cont2 = news_data.cont2;
                data.inx = news_data.inx;
                data.hits = news_data.hits;
                data.start_date = news_data.start_date;
                data.end_date = news_data.end_date;
                if (data.start_date <= DateTime.Today && data.end_date >= DateTime.Today && data.hits < data.inx)
                {
                    data.visible = true;
                }
                else
                {
                    data.visible = false;
                }

                //data.visible = news_data.visible;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news_data.create_user;
                //data.create_datetime = news_data.create_datetime;

                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new product_service_image2();
                        imgData.news_id = data.news_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.product_service_image2.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.product_service_image2.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.product_service_image2.Remove(imgData);
                        }
                        else
                        {
                            imgData.news_id = news_data.news_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = news_data.news_id });
        }

