        #region "優惠券"

        public ActionResult ServiceList(string kw)
        {
            int currentPageIndex = 0;

            var Linq = this._DB.product_service2.Where(m => m.news_id > 0).OrderBy(m => m.start_date);

            if (!String.IsNullOrEmpty(kw))
            {
                Linq = Linq.Where(m => m.title.Contains(kw)).OrderBy(m => m.start_date);
            }

            foreach (var item in Linq.ToList())
            {
                if ((item.start_date <= DateTime.Today && item.end_date >= DateTime.Today))
                {
                    if (item.hits >= item.inx)
                    {
                        item.visible = false;
                        this._DB.SaveChanges();
                    }
                    else
                    {
                        item.visible = true;
                        this._DB.SaveChanges();
                    }

                }
                else
                {
                    item.visible = false;
                    this._DB.SaveChanges();

                }

            }

            IPagedList data = Linq.OrderByDescending(m => m.start_date).ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);



            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

