        [HttpPost]
        public ActionResult ServiceListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update product_service set visible = 1 Where news_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update product_service set visible = 0 Where news_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From product_service_image Where news_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From product_service Where news_id in (" + cb_id + ")";
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        #endregion

        #region "匯出優惠券報表"

        public ActionResult ServiceReportList()
        {

            return View();
        }

        [HttpPost]
        public ActionResult ServiceReportAddSave(DateTime start_date, DateTime end_date)
        {
            string dt = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");

            string FileName = Export(dt, start_date, end_date);

            string[] _dt = dt.Split(' ');
            dt = _dt[0].Replace("/", "") + _dt[1].Replace(":", "");

            return File(FileName, "application/vnd.ms-excel", dt + "匯出優惠券.xlsx");
        }

        private string Export(string dt, DateTime start_date, DateTime end_date)
        {
            string value = "";
            string[] cols = "".Split(',');

            cols = "貨號,品名,銷售數量,銷售額,成本,毛利率,已領取折扣券,限領數量,啟用日期,停用日期".Split(',');

            DateTime sD = end_date.AddDays(0);
            var data2 = (from t in this._DB.order_sub
                         where
                              t.freight_id <= 2 &&
                             (from t0 in this._DB.order_data
                              where
                                (t0.order_datetime >= start_date &&
                                t0.order_datetime <= sD &&
                                t0.visible == true) &&
                                (t0.pay_visible == true || t0.pay_id == 4)
                              select new
                              {
                                  t0.order_id
                              }).Contains(new { t.order_id })
                         group t by new
                         {
                             t.item_no,
                             t.item_name,
                             t.freight_id
                         } into g
                         select new order_report2
                         {
                             item_no = g.Key.item_no,
                             item_name = g.Key.item_name,
                             num = g.Sum(p => p.num),
                             price = g.Sum(p => p.price * p.num),
                             cost = g.Sum(p => p.cost * (double)p.num),
                             freight_id = g.Key.freight_id
                         }).ToList();


            XLWorkbook workbook = new XLWorkbook();
            var sheet = workbook.Worksheets.Add("商品資料");
            int colIdx = 1;
            int rowIdx = 6;

            var data = this._DB.product_service2.Where(m => (m.start_date >= start_date || m.start_date <= start_date && m.end_date >= start_date) && m.start_date <= sD).OrderBy(m => m.start_date).ToList();


            sheet.Cell(2, 1).Value = "匯出日期:" + dt;
            sheet.Range("A2:B2").Row(1).Merge();

            sheet.Cell(3, 1).Value = "查詢日期:" + start_date.ToString("yyyy/MM/dd") + "~" + end_date.ToString("yyyy/MM/dd");
            sheet.Range("A3:B3").Row(1).Merge();

            foreach (string colName in cols)
            {
                sheet.Cell(5, colIdx).Style.Fill.BackgroundColor = XLColor.Yellow;
                sheet.Cell(5, colIdx).Value = colName;
                colIdx++;
            }

            foreach (var item in data)
            {
                if (data2.Where(m => m.item_no == item.title).ToList().Count == 0)
                {
                    sheet.Cell(rowIdx, 3).Value = 0;
                    sheet.Cell(rowIdx, 4).Value = 0;
                    sheet.Cell(rowIdx, 5).Value = "'" + 0;
                    sheet.Cell(rowIdx, 6).Value = "'" + 0;
                }
                else
                {
                    foreach (var item2 in data2.Where(m => m.item_no == item.title).ToList())
                    {
                        sheet.Cell(rowIdx, 3).Value = item2.num;
                        sheet.Cell(rowIdx, 4).Value = item2.price;
                        sheet.Cell(rowIdx, 5).Value = "'" + item2.cost;
                        sheet.Cell(rowIdx, 6).Value = "'" + Math.Round(((item2.price - item2.cost) / item2.price) * 100, 2).ToString() + "%";

                    }

                }


                sheet.Cell(rowIdx, 1).Value = "'" + item.title;
                sheet.Cell(rowIdx, 2).Value = item.cont;
                sheet.Cell(rowIdx, 7).Value = item.hits;
                sheet.Cell(rowIdx, 8).Value = item.inx;
                sheet.Cell(rowIdx, 9).Value = item.start_date;
                sheet.Cell(rowIdx, 10).Value = item.end_date;

                rowIdx++;
            }

            for (int i = 1; i <= cols.Length; i++)
            {
                sheet.Column(i).AdjustToContents();
            }

            string[] _dt = dt.Split(' ');
            dt = _dt[0].Replace("/", "") + _dt[1].Replace(":", "");

            value = Server.MapPath("~/Content/files/" + dt + "匯出優惠券.xlsx");

            workbook.SaveAs(value);
            workbook.Dispose();

            return value;
        }




        #endregion


        #region 組合各區TAG
        //[HttpPost]
        public ActionResult iconmarkajax(int gid,int pid)
        {
            string tag = "";
            var data = this._DB.product_group2.Where(m => m.group_id == gid).FirstOrDefault();

            var pdata = this._DB.product_data2.Where(m => m.product_id == pid).FirstOrDefault();

            string cls = "";
            //html += "<div class=\"control-group\">";
            tag += "<label for=\"iconmark\" class=\"control-label\">前台顯示標籤</label>";
            tag += "<div class=\"field\">";
            int value = 0;


            if (pdata != null)
            {

                if (!string.IsNullOrEmpty(data.s_img))
                {
                    foreach (var item in data.s_img.Split(','))
                    {
                        if (pdata.iconmark.Contains(item))
                        {
                            cls = "checked";
                        }

                        tag += "<div class=\"checker\" id=\"uniform-undefined\"><span class=\"" + cls + "\" onclick=\"gocheck(" + value + ")\"><input class=\"" + cls + "\" type=\"checkbox\" value=" + value + " name=\"iconmark\" style=\"opacity: 0;\"></span></div>" + item;
                        value++;
                        cls = "";
                    }
                }

            }
            else
            {

                foreach (var item in data.s_img.Split(','))
                {  
                    tag += "<div class=\"checker\" id=\"uniform-undefined\"><span class=\"" + cls + "\" onclick=\"gocheck(" + value + ")\"><input class=\"" + cls + "\" type=\"checkbox\" value=" + value + " name=\"iconmark\" style=\"opacity: 0;\"></span></div>" + item;
                    value++;     
                }  
            
            }

            tag += "</div>";
            //html += "</div>";


            var model = new { tag = tag };
            return Json(model, JsonRequestBehavior.AllowGet);


        }
        #endregion



        #region 撈多層分類

        //add
        public ActionResult getmanygroup(int? group_id, int? flag)
        {
            string test = "";




            if (flag.HasValue && group_id.HasValue)
            {

              test+=  "<div class=\"control-group\">";
              test += "<div class=\"field\">";

                switch (flag)
                {
                    case 3:
                        test += "<select name=\"group_id2\" id=\"group_id2\" class=\"span2 valid\">";
                        break;
                    case 4:
                        test += "<select name=\"group_id3\" id=\"group_id3\" class=\"span2 valid\">";
                        break;
                }      


                test += "<option value=\"\" class=\"0\"> 請選擇 </option>";

                var data = this._DB.product_group2.Where(m => m.parent_id == group_id).ToList();

                foreach (var item in data)
                {
                    int g_id = item.group_id;

                    if (flag != 4)
                    {
                        test += "<option  value=\"" + g_id + "\" class=\"2\" onclick=\"test(" + item.group_id + ")\">";
                    }
                    else
                    {
                        test += "<option  value=\"" + g_id + "\" class=\"2\"  onclick=\"set(" + item.group_id + ") \">";
                    
                    }
                    test += item.name;
                    test += "</option>";

                }

                test += "</select>";
                test += "</div>";
                test += "</div>";

            }
            var model = new { test = test };
            return Json(model, JsonRequestBehavior.AllowGet);
        
        }


        //edit

        public ActionResult getmanygroup2(int? group_id)
        {
            string test = "";


            
            //倒數第二層
            //var gdata2 = this._DB.product_group2.Where(m=>m.)


            if (group_id.HasValue)
            {

                var gdata = this._DB.product_group2.Where(m => m.group_id == group_id).FirstOrDefault();

                //最後一層
                var gdatalist = this._DB.product_group2.Where(m => m.parent_id == gdata.parent_id).ToList();

                //到底數第二層
                int gid = gdatalist.FirstOrDefault().group_id;
                var gdata2 = this._DB.product_group2.Where(m => m.group_id == gid).FirstOrDefault().parent_id;
                var gdatalist2 = this._DB.product_group2.Where(m => m.group_id == gdata2).FirstOrDefault();
                var gdatalist3 = this._DB.product_group2.Where(m => m.parent_id == gdatalist2.parent_id).ToList();
                


                test += "<div class=\"control-group\">";
                test += "<div class=\"field\">";


                test += "<select name=\"group_id2\" id=\"group_id2\" class=\"span2 valid\">";
                test += "<option value=\"\" class=\"0\"> 請選擇 </option>";

                foreach (var item in gdatalist3)
                {
                    int g_id = item.group_id;

                    if (g_id == gdatalist2.group_id) {
                        test += "<option  value=\"" + g_id + "\"  selected=\"selected\"  onclick=\"test(" + item.group_id + ") \">";
                    } else {
                        test += "<option  value=\"" + g_id + "\" class=\"2\"  onclick=\"test(" + item.group_id + ") \">";
                    }

                    
                    test += item.name;
                    test += "</option>";
                }


                test += "</select>";

                test += "<select name=\"group_id3\" id=\"group_id3\" class=\"span2 valid\">";    
                test += "<option value=\"\" class=\"0\"> 請選擇 </option>";

                foreach (var item in gdatalist)
                {
                   
                    int g_id = item.group_id;
                    
                    if(g_id == gdata.group_id){
                    test += "<option  value=\"" + g_id + "\"  selected=\"selected\"  onclick=\"set(" + item.group_id + ") \">";         
                    }else{                    
                    test += "<option  value=\"" + g_id + "\" class=\"2\"  onclick=\"set(" + item.group_id + ") \">";        
                    }
                    test += item.name;
                    test += "</option>";
                }

                test += "</select>";



                test += "</div>";
                test += "</div>";

            }
            var model = new { test = test };
            return Json(model, JsonRequestBehavior.AllowGet);

        }


