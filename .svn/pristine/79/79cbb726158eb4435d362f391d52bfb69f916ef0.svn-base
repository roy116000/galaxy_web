                data.style_name = product_data.style_name;
                data.freight_id = product_data.freight_id;
                data.freight_visible = product_data.freight_visible;
                data.order_style = product_data.order_style;
                //data.start_date = product_data.start_date;
                //data.end_date = product_data.end_date;
                //data.payment = product_data.payment;
                data.tax_flag = product_data.tax_flag;

                data.isdrive = product_data.isdrive;

                // data.change_user = User.Identity.Name;
                // data.change_datetime = DateTime.Now;
                data.create_user = User.Identity.Name;
                data.create_datetime = DateTime.Now;
                data.visible_index = product_data.visible_index;
                data.piece = product_data.piece;
                data.cost = product_data.cost;
                data.place_origin = product_data.place_origin;
                data.barcode = product_data.barcode;
                //if (iconmark == null)
                //{
                //    data.iconmark = "";
                //}
                //else
                //{
                //    var gdata = this._DB.product_group2.ToList();
                //    List<string> tag = NW.get_tag(gdata);
                //    string savtag = "";
                //    foreach (var item in iconmark)
                //    {
                //        int number = Convert.ToInt32(item);
                //        savtag += tag[number] + ",";

                //    }

                //    savtag = savtag.TrimEnd(',');
                //    data.iconmark = string.Join(",", savtag);
                //}


                //if (grouptag == null)
                //{
                //    data.iconmark = "";
                //}
                //else
                //{

                //    var gdata = this._DB.product_group2.Where(m => m.group_id == data.group_id).ToList();
                //    List<string> tag = NW.get_tag(gdata);
                //    string savtag = "";
                //    foreach (var item in grouptag.TrimEnd(',').Split(','))
                //    {
                //        int number = Convert.ToInt32(item);
                //        savtag += tag[number] + ",";

                //    }

                //    savtag = savtag.TrimEnd(',');
                //    data.iconmark = string.Join(",", savtag);
                //}

                data.limit = product_data.limit;
                data.stock_visible = product_data.stock_visible;
                data.stock = product_data.stock;

                _DB.product_data2.Add(data);
                this._DB.SaveChanges();

                product_data.product_id = data.product_id;

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new product_image2();
                        imgData.product_id = data.product_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.product_image2.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.product_image2.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.product_image2.Remove(imgData);
                        }
                        else
                        {
                            imgData.product_id = product_data.product_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion
            }

            //更新
            TempData["jgrowl"] = "資料新增成功!!";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("AddSave", "Edit"), new { id = product_data.product_id });
        }

        [HttpPost]
        public ActionResult ListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用", "首頁顯示", "首頁停用" };
            //int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = "Update product_data2 set visible = 1 Where product_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = "Update product_data2 set visible = 0 Where product_id in (" + cb_id + ")";
                    break;
                case 3: //首頁啟用
                    sql = "Update product_data2 set visible_index = 1 Where product_id in (" + cb_id + ")";
                    break;
                case 4: //首頁停用
                    sql = "Update product_data2 set visible_index = 0 Where product_id in (" + cb_id + ")";
                    break;
                case 0: //刪除
                    //圖片刪除
                    sql = "Delete From product_image2 Where product_id in (" + cb_id + ")";
                    _DB.Database.ExecuteSqlCommand(sql);

                    sql = " Delete From product_data2 Where product_id in (" + cb_id + ")";
                    break;
                default:
                    cb_flag -= 999;
                    product_price2 product_price = this._DB.product_price2.Find(cb_flag);
                    if (product_price != null)
                    {
                        foreach (string s in cb_id.Split(','))
                        {
                            int product_id = Convert.ToInt32(s);
                            product_data2 pdata = this._DB.product_data2.Find(product_id);
                            product_price2 ppdata = this._DB.product_price2.Where(m => m.product_id == product_id && m.group_name == product_price.group_name).FirstOrDefault();
                            if (pdata != null && ppdata == null)
                            {
                                double cal = pdata.sprice * product_price.price / 100;
                                int price = product_price.fix_price > 0 ? product_price.fix_price : Convert.ToInt32(Math.Floor(cal));

                                product_price2 data = new product_price2 { };
                                //data.price_id = product_price.price_id;
                                data.group_name = product_price.group_name;
                                data.subject = product_price.subject;
                                data.product_id = product_id;
                                data.product_name = pdata.web_name;
                                data.price = price;
                                data.stock = product_price.stock;
                                data.limit = product_price.limit;
                                data.start_date = product_price.start_date;
                                data.end_date = product_price.end_date;
                                data.countback_visible = product_price.countback_visible;

                                data.cost = pdata.cost;
                                data.org_cost = pdata.cost;
                                data.org_price = pdata.sprice;

                                data.iconmark = "9";

                                //data.inx = product_price.inx;

                                // data.change_user = User.Identity.Name;
                                // data.change_datetime = DateTime.Now;
                                data.create_user = User.Identity.Name;
                                data.create_datetime = DateTime.Now;

                                this._DB.product_price2.Add(data);
                                this._DB.SaveChanges();
                            }
                        }
                    }
                    cb_flag = 1;
                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        [HttpPost]
        public ActionResult ComboSave(int combo_id, int combo_num)
        {

            var product_id = 0;
            var data = this._DB.product_data2.Where(m => m.product_id == combo_id).FirstOrDefault();
            string tail = "-" + (combo_num > 0 ? combo_num.ToString() : DateTime.Now.Millisecond.ToString());
            if (data != null)
            {
                this._DB.Entry(data).State = System.Data.Entity.EntityState.Detached;

                //小魚等於0  則是複製
                if (combo_num > 0)
                {
                    //新增單品
                    data.price *= combo_num;
                    data.sprice *= combo_num;
                    data.item_no += "-" + combo_num.ToString();
                    data.web_name += "(" + combo_num.ToString() + "入)";
                    data.item_name += "(" + combo_num.ToString() + "入)";
                }
                else
                {
                    data.item_no = "XXX";
                }
                data.visible = false;
                this._DB.product_data2.Add(data);
                this._DB.SaveChanges();
                product_id = data.product_id;

                var img_data = this._DB.product_image2.Where(m => m.product_id == combo_id).ToList();
                if (img_data.Count > 0)
                {
                    foreach (var item in img_data)
                    {
                        this._DB.Entry(item).State = System.Data.Entity.EntityState.Detached;
                        string source = Server.MapPath("/Content/images/product/" + item.b_img);
                        string source2 = Server.MapPath("/Content/images/product/" + item.s_img);
                        if (System.IO.File.Exists(source) && System.IO.File.Exists(source2))
                        {
                            string ext = System.IO.Path.GetExtension(source);
                            string target = source.Replace(ext, tail + ext);
                            System.IO.File.Copy(source, target, true);
                            item.b_img = item.b_img.Replace(ext, tail + ext);

                            string ext2 = System.IO.Path.GetExtension(source2);
                            string target2 = source2.Replace(ext2, tail + ext2);
                            System.IO.File.Copy(source2, target2, true);
                            item.s_img = item.s_img.Replace(ext2, tail + ext2);

                            item.product_id = product_id;
                            this._DB.product_image2.Add(item);
                            this._DB.SaveChanges();
                        }
                    }
                }
                TempData["jgrowl"] = "組合商品複製功能，設定成功";
                return RedirectToAction("Edit", new { @id = product_id });
            }
            else
            {
                TempData["jgrowl"] = "組合商品複製功能，設定失敗";
                return RedirectToAction("List");
            }


            //TempData["jgrowl"] = "組合商品複製功能，設定成功";
            //return RedirectToAction("Edit", new { @id = combo_id });

        }

