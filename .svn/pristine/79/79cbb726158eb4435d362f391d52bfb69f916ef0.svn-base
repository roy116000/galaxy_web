        #region "活動列表"

        public ActionResult ActList(string kw)
        {

            int currentPageIndex = 0;

            var tmpData = (from m in _DB.product_price2
                           join m2 in _DB.product_price2 on m.group_name equals m2.group_name into mm
                           where m.product_id == 0
                           orderby m.start_date descending
                           select new data_list()
                           {
                               group_id = m.price_id,
                               title = m.group_name,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               counts = mm.Count()
                           });


            // var tmpData = this._DB.product_price.Where(m => m.product_id == 0);

            if (!String.IsNullOrEmpty(kw))
            {
                var data2 = (from m in _DB.product_data2
                             join m2 in _DB.product_price2 on m.product_id equals m2.product_id
                             where m.item_name.Contains(kw)
                             select new
                             {
                                 m2.price_id
                             }
                                 ).ToList();

                int[] price_id = new int[data2.Count()]; ;
                for (int ii = 0; ii < price_id.Count(); ii++)
                {
                    price_id[ii] = data2[ii].price_id;
                }

                tmpData = tmpData.Where(m => price_id.Contains(m.group_id));

                //tmpData = tmpData.Where(m => m.name.Contains(kw));
            }

            //tmpData= tmpData.OrderByDescending(m=>m.start_date);

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }

        public ActionResult ActList_ajax(int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;
            var tmpData = this._DB.product_price2.Where(m => m.product_id == 0);

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.group_name.Contains(kw));
            }

            tmpData = tmpData.OrderByDescending(m => m.start_date);

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


