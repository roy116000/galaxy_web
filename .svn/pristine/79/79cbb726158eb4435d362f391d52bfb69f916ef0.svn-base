        #region "產品列表"

        public ActionResult List(int? gid, int? pstatus, string kw)
        {
            int currentPageIndex = 0;

            var tmpData = (from m in _DB.product_data2
                           join m2 in _DB.product_group2 on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.product_id,
                               group_id = m.group_id,
                               title = m.item_name,
                               cont = m.item_no,
                               info = m.web_name,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               visible_index = m.visible_index,
                               g_name = mm.FirstOrDefault().name
                           });

            if (pstatus.HasValue)
            {
                switch (pstatus)
                {
                    case 1:
                        tmpData = tmpData.Where(m => m.visible);
                        break;
                    case 2:
                        tmpData = tmpData.Where(m => m.visible == false);
                        break;

                }

                ViewBag.pstatus = pstatus;

            }

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw) || m.info.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id.Equals(gid.Value)); }
            ViewBag.gid = gid;

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            var data3 = this._DB.product_group2.Where(m => m.parent_id == 0).OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime).ToList();
            var data33 = this._DB.product_group2.Where(m => m.parent_id > 0).OrderBy(m => m.inx).ThenByDescending(m => m.create_datetime).ToList();
            var data4 = this._DB.product_data2.Where(m => m.product_id > 0).ToList();
            if (pstatus.HasValue)
            {
                switch (pstatus)
                {
                    case 1:
                        data4 = data4.Where(m => m.visible).ToList();
                        break;
                    case 2:
                        data4 = data4.Where(m => m.visible == false).ToList();
                        break;

                }
            }

            ViewData["data3"] = data3;
            ViewData["data33"] = data33;
            ViewData["data4"] = data4;

            //List<data_group2> data2 = (from m in this._DB.product_group
            //                           where m.parent_id.Equals(0)
            //                           orderby m.inx, m.create_datetime descending
            //                           select new data_group2()
            //                           {
            //                               group_id = m.group_id,
            //                               name = m.name
            //                           }).ToList();

            //foreach (var rs in data2)
            //{
            //    List<data_group> data22 = (from m in this._DB.product_group
            //                               where m.parent_id.Equals(rs.group_id)
            //                               orderby m.inx, m.create_datetime descending
            //                               select new data_group()
            //                               {
            //                                   group_id = m.group_id,
            //                                   name = m.name,
            //                                   counts = m.product_data.Count()

            //                               }).ToList();
            //    if (data22.Count > 0)
            //    {
            //        rs.data_group = data22;
            //    }
            //}

            var ppdata = this._DB.product_price2.Where(m => m.product_id == 0 && m.end_date >= DateTime.Today).OrderByDescending(m => m.start_date).ToList();
            ViewData["product_price"] = ppdata;

            //ViewData["product_group2"] = data2;
            ViewBag.kw = kw;
            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        public ActionResult List_ajax(int? gid, int? page, string kw)
        {
            int currentPageIndex = page.HasValue ? page.Value - 1 : 0;

            var tmpData = (from m in _DB.product_data2
                           join m2 in _DB.product_group2 on m.group_id equals m2.group_id into mm
                           orderby m.inx, m.start_date descending
                           select new data_list()
                           {
                               data_id = m.product_id,
                               group_id = m.group_id,
                               title = m.item_name,
                               cont = m.item_no,
                               info = m.web_name,
                               hits = m.hits,
                               start_date = m.start_date,
                               end_date = m.end_date,
                               visible = m.visible,
                               inx = m.inx,
                               visible_index = m.visible_index,
                               g_name = mm.FirstOrDefault().name
                           });

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.title.Contains(kw) || m.cont.Contains(kw) || m.info.Contains(kw));
            }

            if (gid.HasValue) { tmpData = tmpData.Where(m => m.group_id == gid.Value); }
            ViewBag.gid = gid;
            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);


            ViewBag.kw = kw;
            return PartialView(RouteData.Values["action"].ToString(), data);
        }


        public ActionResult Edit(int id)
        {

            var data = this._DB.product_data2.Find(id);
            //int p_id = data.product_group2 == null ? 0 : data.product_group2.parent_id;
            var p_id1 = this._DB.product_group2.Where(m => m.group_id == data.group_id).FirstOrDefault().parent_id;

            var p_id2 = this._DB.product_group2.Where(m => m.group_id == p_id1).FirstOrDefault();

            //分區id
            int p_id = this._DB.product_group2.Where(m => m.group_id == p_id2.parent_id).FirstOrDefault().parent_id;

            //圖片
            var image = _DB.product_image2.Where(m => m.product_id.Equals(id)).ToList();
            List<images_data> imgData = new List<images_data>();
            foreach (var item in image)
            {
                images_data imgs_data = new images_data();
                imgs_data.imgs_id = item.imgs_id;
                imgs_data.s_img = item.s_img;
                imgs_data.b_img = item.b_img;
                imgs_data.img_info = item.img_info;
                imgs_data.img_inx = item.img_inx;
                imgData.Add(imgs_data);
            }
            ViewData["uploadimage2"] = imgData;

            //下拉選單
            var gData = (from m in _DB.product_group2 where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == data.group_id));
            }
            ViewData["group_id"] = ListItems;

            //配送方式
            ListItems = new List<ListItem> { };
            var fData = (from m in _DB.product_freight2 orderby m.freight_id select m).ToList();
            foreach (var item in fData)
            {
                ListItems.Add(new ListItem(item.freight_id.ToString(), item.name + "(滿" + item.total + "元，免運費" + item.price + "元)", item.freight_id == data.freight_id));
            }
            ViewData["freight_id"] = ListItems;

            //獲利%數
            ListItems = new List<ListItem> { };
            for (var i = 0; i < 101; i++)
            {
                ListItems.Add(new ListItem(i.ToString(), i.ToString(), i == data.payment));
            }
            ViewData["payment"] = ListItems;

            //稅別
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("0", "0.應稅", 0 == data.tax_flag));
            ListItems.Add(new ListItem("1", "1.免稅", 1 == data.tax_flag));
            ListItems.Add(new ListItem("2", "2.零稅率", 2 == data.tax_flag));
            ViewData["tax_flag"] = ListItems;

            //購常狀況
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("0", "銷售中", 0 == data.order_style));
            ListItems.Add(new ListItem("1", "預購(產品選擇預購，前台會跑獨立結帳)", 1 == data.order_style));
            ListItems.Add(new ListItem("2", "已售完，下回請早", 2 == data.order_style));
            ListItems.Add(new ListItem("3", "已售完，貨到通知我", 3 == data.order_style));
            ListItems.Add(new ListItem("4", "到店購買", 4 == data.order_style));
            ViewData["order_style"] = ListItems;

            //取分區
            ListItems = new List<ListItem> { };
            var cData = (from m in _DB.product_group2
                         where m.parent_id == 0
                         select new { group_id = m.group_id, name = m.name });
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in cData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == p_id));
            }
            ViewData["group_id_chained"] = ListItems;

            //取分類
            ListItems = new List<ListItem> { };
            var cData2 = (from m in _DB.product_group2
                          where m.parent_id > 0
                          select new { group_id = m.group_id, parent_id = m.parent_id, name = m.name });
            ListItems.Add(new ListItem("", "請選擇", false, "0"));
            foreach (var item in cData2)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, item.group_id == p_id2.parent_id, item.parent_id.ToString()));
            }
            ViewData["group_id"] = ListItems;

            
            ////取所有子分類標籤
            //var gdata = this._DB.product_group2.ToList();
            //List<ListItem> ListItems2 = new List<ListItem> { };
            //List<string> tag = NW.get_tag(gdata);
            //for (int i = 0; i < tag.Count(); i++)
            //{
            //    bool icon = false;
            //    if (!string.IsNullOrEmpty(data.iconmark))
            //    {
            //        icon = (data.iconmark.Any(s => tag[i].Contains(s)));
            //    }
            //    ListItems2.Add(new ListItem(i.ToString(), tag[i].ToString(), icon));
            //}

            //ViewData["iconmark"] = ListItems2;
            //多選
            //List<ListItem> ListItems2 = new List<ListItem> { };
            //for (int i = 1; i < NW.iconMark.Length; i++)
            //{
            //    bool icon = false;
            //    if (!string.IsNullOrEmpty(data.iconmark))
            //    {
            //        icon = (data.iconmark.IndexOf(i.ToString()) > -1);
            //    }
            //    ListItems2.Add(new ListItem(i.ToString(), NW.iconMark[i].ToString(), icon));
            //}

            //欄位名稱[id]
           


            ViewBag.jgrowl = TempData["jgrowl"];

            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult EditSave(product_data2 product_data, VmImage imgs,string grouptag, IEnumerable<string> iconmark,int? group_id4)
        {
            var data = this._DB.product_data2.Find(product_data.product_id);
            //var data1 = this._DB.product_data.Where(m => m.product_id.Equals(product_data.product_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                if (string.IsNullOrEmpty(product_data.item_no))
                {
                    string Num = "NW" + NW.spliteDate(DateTime.Now, 2);
                    var xx = _DB.product_data2.OrderByDescending(x => x.item_no).Where(x => x.item_no.Contains(Num))
                            .Select(x => new { x.product_id, x.item_no }).FirstOrDefault();
                    if (xx == null)
                    {
                        product_data.item_no = Num + "001";
                    }
                    else
                    {
                        var tmp = xx.item_no.Split('-')[0].ToString().Replace(Num, "");
                        var Chk_Value = Convert.ToInt64(tmp) + 1;
                        string kk = "000" + Chk_Value;
                        kk = kk.Substring(kk.Length - 3);
                        product_data.item_no = Num + kk;
                    }
                };

                #region "同貨號的一併修改"
                var data2 = this._DB.product_data2.Where(m => m.item_no == data.item_no && m.visible).OrderBy(m => m.product_id).ToList();
                foreach (var item in data2)
                {
                    item.info = product_data.info;
                    item.introduce = product_data.introduce;

                    item.change_user = User.Identity.Name;
                    item.change_datetime = DateTime.Now;

                    this._DB.SaveChanges();

                }

                #endregion

                // data.product_id = product_data.product_id;
                //data.group_id = product_data.group_id;
                data.group_id = Convert.ToInt32(group_id4);
                data.drug_company = product_data.drug_company;

                data.item_no = product_data.item_no;
                data.item_name = product_data.item_name;
                data.web_name = product_data.web_name;
                data.inx = product_data.inx;
                data.price = product_data.price;
                data.sprice = product_data.sprice;
                data.info = product_data.info;
                data.introduce = product_data.introduce;
                data.visible = product_data.visible;
                data.style_name = product_data.style_name;
                data.freight_id = product_data.freight_id;
                data.freight_visible = product_data.freight_visible;
                data.order_style = product_data.order_style;
                //data.start_data = product_data.start_data;
                //data.end_data = product_data.end_data;
                data.payment = product_data.payment;
                data.tax_flag = product_data.tax_flag;

                data.isdrive = product_data.isdrive;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                data.visible_index = product_data.visible_index;
                data.piece = product_data.piece;
                data.cost = product_data.cost;
                data.place_origin = product_data.place_origin;
                data.barcode = product_data.barcode;
                
                
                //if (iconmark == null)
                //{
                //    data.iconmark = "";
                //}
                //else
                //{
                //    var gdata = this._DB.product_group2.ToList();
                //    List<string> tag = NW.get_tag(gdata);
                //    string savtag ="";
                //    foreach (var item in iconmark)
                //    {
                //        int number = Convert.ToInt32(item);
                //        savtag += tag[number] + ",";
                   
                //    }

                //    savtag = savtag.TrimEnd(',');
                //    data.iconmark = string.Join(",", savtag);
                //}

                //if (grouptag == null)
                //{
                //    data.iconmark = "";
                //}
                //else {

                //    var gdata = this._DB.product_group2.Where(m=>m.group_id == data.group_id).ToList();
                //    List<string> tag = NW.get_tag(gdata);
                //    string savtag = "";
                //    foreach (var item in grouptag.TrimEnd(',').Split(','))
                //    {
                //        int number = Convert.ToInt32(item);
                //        savtag += tag[number] + ",";

                //    }

                //    savtag = savtag.TrimEnd(',');
                //    data.iconmark = string.Join(",", savtag);
                //}


                data.limit = product_data.limit;
                data.stock_visible = product_data.stock_visible;
                data.stock = product_data.stock;

                //data.create_user = product_data.create_user;
                //data.create_datetime = product_data.create_datetime;

                this._DB.SaveChanges();

                #region "圖片處理"

                for (int i = 0; i < imgs.img_id.Count; i++)
                {
                    if (imgs.img_id[i] == 0)
                    {
                        var imgData = new product_image2();
                        imgData.product_id = data.product_id;
                        imgData.s_img = imgs.s_img[i].ToString();
                        imgData.b_img = imgs.b_img[i].ToString();
                        imgData.img_info = imgs.img_info[i].ToString();
                        imgData.img_inx = imgs.img_inx[i];
                        imgData.img_visible = true;

                        if (imgs.s_img[i].ToString() != "" && imgs.s_img[i].ToString() != null)
                        {
                            //新增
                            _DB.product_image2.Add(imgData);
                        }
                    }
                    else
                    {
                        //編輯
                        var imgData = _DB.product_image2.Find(imgs.img_id[i]);
                        if (imgs.s_img[i].ToString() == "" || imgs.s_img[i].ToString() == null)
                        {
                            _DB.product_image2.Remove(imgData);
                        }
                        else
                        {
                            imgData.product_id = product_data.product_id;
                            imgData.s_img = imgs.s_img[i].ToString();
                            imgData.b_img = imgs.b_img[i].ToString();
                            imgData.img_info = imgs.img_info[i].ToString();
                            imgData.img_inx = imgs.img_inx[i];
                        }
                        _DB.SaveChanges();
                    }
                }


                _DB.SaveChanges();

                #endregion

            }

            //更新
            TempData["jgrowl"] = "資料更新成功";

            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = product_data.product_id });
        }

        public ActionResult Add(int id)
        {
            product_data2 data = new product_data2();
            data.inx = 9999;
            data.start_date = DateTime.Now;
            data.end_date = DateTime.Now.AddYears(10);
            data.visible = false;
            data.freight_visible = true;

            //圖片
            ViewData["UploadImage2"] = new List<images_data>();

            //下拉選單
            var gData = (from m in _DB.product_group2 where m.group_id > 0 orderby m.inx, m.create_datetime descending select new { m.group_id, m.name }).ToList();
            List<ListItem> ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in gData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id"] = ListItems;

            //配送方式
            ListItems = new List<ListItem> { };
            var fData = (from m in _DB.product_freight2 orderby m.freight_id select m).ToList();
            foreach (var item in fData)
            {
                ListItems.Add(new ListItem(item.freight_id.ToString(), item.name + "(滿" + item.total + "元，免運費" + item.price + "元)", false));
            }
            ViewData["freight_id"] = ListItems;

            //獲利%數
            ListItems = new List<ListItem> { };
            for (var i = 0; i < 101; i++)
            {
                ListItems.Add(new ListItem(i.ToString(), i.ToString(), false));
            }
            ViewData["payment"] = ListItems;

            //稅別
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("0", "0.應稅", true));
            ListItems.Add(new ListItem("1", "1.免稅", false));
            ListItems.Add(new ListItem("2", "2.零稅率", false));
            ViewData["tax_flag"] = ListItems;

            //購常狀況
            ListItems = new List<ListItem> { };
            ListItems.Add(new ListItem("0", "銷售中", true));
            ListItems.Add(new ListItem("1", "預購(產品選擇預購，前台會跑獨立結帳)", false));
            ListItems.Add(new ListItem("2", "已售完，下回請早", false));
            ListItems.Add(new ListItem("3", "已售完，貨到通知我", false));
            ListItems.Add(new ListItem("4", "到店購買", false));
            ViewData["order_style"] = ListItems;

            //取分區
            ListItems = new List<ListItem> { };
            var cData = (from m in _DB.product_group2
                         where m.parent_id == 0
                         select new { group_id = m.group_id, name = m.name });
            ListItems.Add(new ListItem("", "請選擇", false));
            foreach (var item in cData)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false));
            }
            ViewData["group_id_chained"] = ListItems;

            //取分類
            ListItems = new List<ListItem> { };
            var cData2 = (from m in _DB.product_group2
                          where m.parent_id > 0
                          select new { group_id = m.group_id, parent_id = m.parent_id, name = m.name });
            ListItems.Add(new ListItem("", "請選擇", false, "0"));
            foreach (var item in cData2)
            {
                ListItems.Add(new ListItem(item.group_id.ToString(), item.name, false, item.parent_id.ToString()));
            }
            ViewData["group_id"] = ListItems;



          



            //取所有子分類標籤
            var gdata = this._DB.product_group2.ToList();
            List<ListItem> ListItems2 = new List<ListItem> { };
            List<string> tag = NW.get_tag(gdata);
            for (int i = 0; i < tag.Count(); i++)
            {
                bool icon = false;
                if (!string.IsNullOrEmpty(data.iconmark))
                {
                    icon = (data.iconmark.Any(s => tag[i].Contains(s)));
                }
                ListItems2.Add(new ListItem(i.ToString(), tag[i].ToString(), icon));
            }

            ViewData["iconmark"] = ListItems2;

            //多選
            //List<ListItem> ListItems2 = new List<ListItem> { };
            //for (int i = 1; i < NW.iconMark.Length; i++)
            //{
            //    bool icon = false;
            //    //if (!string.IsNullOrEmpty(data.iconmark))
            //    //{
            //    //    icon = (data.iconmark.IndexOf(i.ToString()) > -1);
            //    //}
            //    ListItems2.Add(new ListItem(i.ToString(), NW.iconMark[i].ToString(), icon));
            //}

            //欄位名稱[id]
           



            return View(data);
        }

        [HttpPost, ValidateInput(false)]
        public ActionResult AddSave(product_data2 product_data, VmImage imgs,string grouptag, IEnumerable<string> iconmark,int? group_id4)
        {
            //var data = this._DB.product_data.Find(product_data.product_id);
            //var data1 = this._DB.product_data.Where(m => m.product_id.Equals(product_data.product_id)).Select(m => m).SingleOrDefault();
            var data = new product_data2 { };

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                if (product_data.item_no == null)
                {
                    string Num = "NW" + NW.spliteDate(DateTime.Now, 2);
                    var xx = _DB.product_data.OrderByDescending(x => x.item_no).Where(x => x.item_no.Contains(Num))
                            .Select(x => new { x.product_id, x.item_no }).FirstOrDefault();
                    if (xx == null)
                    {
                        product_data.item_no = Num + "001";
                    }
                    else
                    {
                        var tmp = xx.item_no.Split('-')[0].ToString().Replace(Num, "");
                        var Chk_Value = Convert.ToInt64(tmp) + 1;
                        string kk = "000" + Chk_Value;
                        kk = kk.Substring(kk.Length - 3);
                        product_data.item_no = Num + kk;
                    }
                };

                // data.product_id = product_data.product_id;


                data.group_id = Convert.ToInt32(group_id4);
                data.drug_company = product_data.drug_company;

                data.item_no = product_data.item_no;
                data.item_name = product_data.item_name;
                data.web_name = product_data.web_name;
                data.inx = product_data.inx;
                data.price = product_data.price;
                data.sprice = product_data.sprice;
