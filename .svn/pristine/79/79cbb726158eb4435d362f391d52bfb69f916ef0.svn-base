        [HttpPost]
        public ActionResult ActListDel(int cb_flag, string cb_id)
        {
            string[] jgrowl_msg = new string[] { "刪除", "啟用", "停用" };
            int[] strArray = Array.ConvertAll<string, int>(NW.Split(cb_id, ","), int.Parse);

            var data = this._DB.product_price2.Where(m => strArray.Contains(m.price_id)).ToList();

            string sql = "";
            switch (cb_flag)
            {
                case 1: //啟用
                    sql = " Update news_group2 Set visible = 1 Where group_id in (" + cb_id + ")";
                    break;
                case 2: //停用
                    sql = " Update news_group2 Set visible = 0 Where group_id in (" + cb_id + ")";
                    break;
                case 0: //刪除 
                    foreach (var item in data)
                    {
                        sql = " Delete From product_price2 Where group_name = '" + item.group_name + "'";
                        _DB.Database.ExecuteSqlCommand(sql);
                    }
                    sql = " Delete From product_price2 Where price_id in (" + cb_id + ")";

                    break;
            }

            if (sql != "")
            {
                _DB.Database.ExecuteSqlCommand(sql);
            }

            TempData["jgrowl"] = jgrowl_msg[cb_flag] + "功能，設定成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Del", ""));
        }

        [HttpPost]
        public ActionResult ActExecl(HttpPostedFileBase file_name)
        {
            string group = "";
            if (file_name != null && file_name.ContentLength > 0 && NW.getFileType(file_name, 3))
            {

                try
                {
                    // 建立一個工作簿 Office 2007 flag = 0 訂單資料

                    //辯別是2007還是2003
                    IWorkbook excel = WorkbookFactory.Create(file_name.InputStream);

                    ////2007
                    //XSSFWorkbook workbook = new XSSFWorkbook(FileUpload1.FileContent);
                    ////2003
                    //HSSFWorkbook workbook = new HSSFWorkbook(FileUpload1.FileContent);

                    //設定cell格式
                    //ICellStyle ct = excel.CreateCellStyle();
                    //IDataFormat format = excel.CreateDataFormat();
                    //ct.DataFormat=format.GetFormat("@");

                    //XSSFWorkbook excel = new XSSFWorkbook(file_name.InputStream);
                    NPOI.SS.UserModel.ISheet sheet = excel.GetSheetAt(0);
                    DateTime create_datetime = DateTime.Now;
                    List<int> arrOrder_id = new List<int>(new[] { 0 });



                    string no = "";
                    string gname = "";
                    for (int row = 1; row <= sheet.LastRowNum; row++) // 使用For 走訪所有的資料列
                    {
                        string p = "";

                        if (sheet.GetRow(row) != null) // 驗證是不是空白列
                        {
                            for (int c = 0; c <= sheet.GetRow(row).LastCellNum; c++) // 使用For 走訪資料欄
                            {

                                if (sheet.GetRow(row).GetCell(c) != null)
                                {

                                    if (sheet.GetRow(0).GetCell(c).ToString() == "貨號" && (sheet.GetRow(row).GetCell(c).ToString().Contains("NW") || sheet.GetRow(row).GetCell(c).ToString().Split('-').Count() == 2))
                                    {
                                        p += sheet.GetRow(row).GetCell(c).ToString() + ",";
                                    }
                                    else if (sheet.GetRow(0).GetCell(c).ToString() == "貨號")
                                    {
                                        p += sheet.GetRow(row).GetCell(c).ToString().PadLeft(8, '0') + ",";
                                    }
                                    else
                                    {
                                        p += sheet.GetRow(row).GetCell(c).ToString() + ",";
                                    }
                                    //string x2 = sheet.GetRow(row).GetCell(c).ToString();

                                }
                            }

                            p = p.TrimEnd(',');
                            no = p.Split(',')[0];
                            gname = p.Split(',')[1];

                            var pdata = this._DB.product_data2.Where(m => m.visible && m.item_no == no).OrderBy(m => m.product_id).ToList();
                            var ppdata = this._DB.product_price2.Where(m => m.group_name == gname && m.product_id == 0).FirstOrDefault();

                            double cal;
                            int price;
                            //product_data pdata = this._DB.product_data.Find(product_id);
                            //product_price ppdata = this._DB.product_price.Where(m => m.product_id == product_id && m.group_name == product_price.group_name).FirstOrDefault();
                            if (pdata.Count != 0 && ppdata != null)
                            {

                                foreach (var item in pdata)
                                {


                                    cal = item.sprice * ppdata.price / 100;
                                    price = ppdata.fix_price > 0 ? ppdata.fix_price : Convert.ToInt32(Math.Floor(cal));

                                    price = Convert.ToInt32(p.Split(',')[3]);

                                    product_price2 data = new product_price2 { };
                                    //data.price_id = product_price.price_id;
                                    data.group_name = ppdata.group_name;
                                    data.subject = ppdata.subject;
                                    data.product_id = item.product_id;
                                    data.product_name = item.web_name;
                                    data.price = price;
                                    data.stock = ppdata.stock;
                                    data.limit = ppdata.limit;
                                    data.start_date = ppdata.start_date;
                                    data.end_date = ppdata.end_date;
                                    data.countback_visible = ppdata.countback_visible;

                                    data.cost = Convert.ToDouble(p.Split(',')[4]);
                                    data.org_cost = Convert.ToDouble(p.Split(',')[4]);
                                    data.org_price = item.sprice;

                                    data.iconmark = "9";

                                    //data.inx = product_price.inx;

                                    // data.change_user = User.Identity.Name;
                                    // data.change_datetime = DateTime.Now;
                                    data.create_user = User.Identity.Name;
                                    data.create_datetime = DateTime.Now;

                                    this._DB.product_price2.Add(data);
                                    this._DB.SaveChanges();

                                    if (string.IsNullOrEmpty(group))
                                    {
                                        group = ppdata.group_name;
                                    }

                                }


                            }


                        }
                    }

                    TempData["jgrowl"] = "產品匯入成功！";

                }
                catch
                {
                    TempData["jgrowl"] = "資料匯入失敗-格式錯誤";
                }


            }
            else
            {
                TempData["jgrowl"] = "資料匯入失敗--請選擇Execl檔案";
            }

            return RedirectToAction("ActProductList", new { group_name = group });
        }


        //產品列表

        public ActionResult ActProductList(string kw, string group_name)
        {

            int currentPageIndex = 0;
            var tmpData = this._DB.product_price2.Where(m => m.product_id > 0);

            if (!String.IsNullOrEmpty(kw))
            {
                tmpData = tmpData.Where(m => m.product_name.Contains(kw));
            }

            if (!String.IsNullOrEmpty(group_name))
            {
                tmpData = tmpData.Where(m => m.group_name == group_name);
            }

            tmpData = tmpData.OrderByDescending(m => m.start_date);

            IPagedList data = tmpData.ToPagedList(currentPageIndex, NW.GetParam(RouteData.Values["controller"].ToString().Replace("Nw", "").ToLower()).Pages);

            ViewBag.kw = kw;
            ViewBag.group_name = group_name;
            ViewBag.jgrowl = TempData["jgrowl"];
            return View(data);
        }


