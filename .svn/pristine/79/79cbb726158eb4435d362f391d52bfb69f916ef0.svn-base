        [HttpPost, ValidateInput(false)]
        public ActionResult ActEditSave(product_price2 product_price)
        {
            var data = this._DB.product_price2.Find(product_price.price_id);
            //var data1 = this._DB.news_group.Where(m => m.zz_id.Equals(news_group.zz_id)).Select(m => m).SingleOrDefault();

            if (data == null)
            {
                ModelState.AddModelError("", "查無此筆資料");
            }
            else
            {
                string[] tmp;
                tmp = product_price.start_time.Split(':');
                DateTime start_date = new DateTime(product_price.start_date.Value.Year, product_price.start_date.Value.Month, product_price.start_date.Value.Day, Convert.ToInt32(tmp[0]), Convert.ToInt32(tmp[1]), 0);

                tmp = product_price.end_time.Split(':');
                DateTime end_date = new DateTime(product_price.end_date.Value.Year, product_price.end_date.Value.Month, product_price.end_date.Value.Day, Convert.ToInt32(tmp[0]), Convert.ToInt32(tmp[1]), 0);

                //檔期時間修改後，檔期內的商品連動修改
                if (start_date != data.start_date || end_date != data.end_date)
                {
                    string cstart = Convert.ToDateTime(start_date).ToString("u").TrimEnd('Z');
                    string cend = Convert.ToDateTime(end_date).ToString("u").TrimEnd('Z');

                    string sql = " Update product_price2 Set start_date ='" + cstart + "' ,end_date='" + cend + "' Where group_name ='" + data.group_name + "' and product_id > 0";

                    _DB.Database.ExecuteSqlCommand(sql);
                }

                //data.price_id = product_price.price_id;
                data.group_name = product_price.group_name;
                data.subject = product_price.subject;
                //data.product_id = product_price.product_id;
                data.price = product_price.price;
                data.stock = product_price.stock;
                data.limit = product_price.limit;
                data.start_date = start_date;
                data.end_date = end_date;
                data.countback_visible = product_price.countback_visible;
                data.inx = product_price.inx;

                data.change_user = User.Identity.Name;
                data.change_datetime = DateTime.Now;
                //data.create_user = news_group.create_user;
                //data.create_datetime = news_group.create_datetime;

                this._DB.SaveChanges();
            }

            //更新
            TempData["jgrowl"] = "資料更新成功";
            return RedirectToAction(RouteData.Values["action"].ToString().Replace("Save", ""), new { id = product_price.price_id });
        }

