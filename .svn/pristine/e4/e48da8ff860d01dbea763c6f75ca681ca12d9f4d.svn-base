                                        您目前所在的網址無法上傳此資料，如需上傳請<a href="@(NW.ph_url)" target="_blank" >【至此】</a>
                                    </div>
                                </div>
                            }

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">&nbsp;</h3>

                            <div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <span class="label label-important">圖片建議：寬:300px 高:240px
                                    </span>
                                </div>
                            </div>

                           
                            @if (!NW.isAf(url))
                            {
                                @Html.EditorFor(model => model.uploadimage2)
                            }
                            else
                            {
                                <div class="control-group">
                                    @Html.LabelFor(model => model.uploadimage2)
                                    <div class="field" style="padding: 5px 5px;">
                                        您目前所在的網址無法上傳此資料，如需上傳請<a href="@(NW.ph_url)" target="_blank" >【至此】</a>
                                    </div>
                                </div>
                            }

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">&nbsp;</h3>

                            <div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <span class="label label-important">圖片建議：一律橫式
                                    </span>
                                </div>
                            </div>

                           
                            @if (!NW.isAf(url))
                            {
                                @Html.EditorFor(model => model.uploadimage3)
                            }
                            else
                            {
                                <div class="control-group">
                                    @Html.LabelFor(model => model.uploadimage3)
                                    <div class="field" style="padding: 5px 5px;">
                                        您目前所在的網址無法上傳此資料，如需上傳請<a href="@(NW.ph_url)" target="_blank" >【至此】</a>
                                    </div>
                                </div>
                            }

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">&nbsp;</h3>

                            <div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <span class="label label-important">圖片建議：一律橫式
                                    </span>
                                </div>
                            </div>

                           
                            @if (!NW.isAf(url))
                            {
                                @Html.EditorFor(model => model.uploadimage4)
                            }
                            else
                            {
                                <div class="control-group">
                                    @Html.LabelFor(model => model.uploadimage4)
                                    <div class="field" style="padding: 5px 5px;">
                                        您目前所在的網址無法上傳此資料，如需上傳請<a href="@(NW.ph_url)" target="_blank" >【至此】</a>
                                    </div>
                                </div>
                            }

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">&nbsp;</h3>

                            <div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <span class="label label-important">圖片建議：一律橫式
                                    </span>
                                </div>
                            </div>

                            
                            @if (!NW.isAf(url))
                            {
                                @Html.EditorFor(model => model.uploadimage5)
                            }
                            else
                            {
                                <div class="control-group">
                                    @Html.LabelFor(model => model.uploadimage5)
                                    <div class="field" style="padding: 5px 5px;">
                                        您目前所在的網址無法上傳此資料，如需上傳請<a href="@(NW.ph_url)" target="_blank" >【至此】</a>
                                    </div>
                                </div>
                            }

                            @*@Html.EditorFor(model => model.uploadimage22)*@
                            @*<div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <h4>所需勘查圖片：藥局外觀、招牌、內部、藥師照片、預計安裝位置。
                                    </h4>

                                </div>
                            </div>*@

                        </div>

                        <div id="tab4" class="tab_content">

                            @Html.EditorFor(model => model.program_flag)
                        </div>


                    </div>
                </div>
                <div class="control-group">
                    <div class="stdformbutton">
                        <button class="btn btn-primary">儲存</button>
                        <button type="reset" class="btn">取消</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // With Form Validation
        $("#form1").validate({
            ignore: "",
            rules: {
                drug_sn: "required",
                sales_id: "required",
                sales_id_chained: "required",
                name: "required",
                boss: "required",
                mail: "required",
                zip: "required",
                address: "required",
                tel: "required"
            },
            messages: {
                drug_sn: "機構代碼必須填寫!",
                sales_id: "必須填寫!",
                sales_id_chained: "必須填寫!",
                name: "名稱必需填寫!",
                boss: "負責人必需填寫!",
                mail: "帳號(郵件)必須填寫!",
                zip: "地址必須填寫!",
                address: "地址必須填寫!",
                tel: "電話必須填寫!"
            },
            highlight: function (label) {
                jQuery(label).closest('.control-group').removeClass('success').addClass('error');
            }
        });
    })
</script>

<script type="text/javascript">
    $(function () {
        var _showTab = 0;
        var $defaultLi = $('ul.tabs li').eq(_showTab).addClass('active');

        $($defaultLi.find('a').attr('href')).siblings().hide();

        $('ul.tabs li').click(function () {
            var $this = $(this),
                _clickTab = $this.find('a').attr('href');

            $this.addClass('active').siblings('.active').removeClass('active');

            $(_clickTab).stop(false, true).fadeIn().siblings().hide();
            return false;
        }).find('a').focus(function () {
            this.blur();
        });

    });
</script>

