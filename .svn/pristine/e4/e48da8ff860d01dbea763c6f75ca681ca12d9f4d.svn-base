@model h365_web.Models.drugstore_data
@{
    string id = ViewContext.RouteData.Values["id"].ToString();
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string action = ViewContext.RouteData.Values["action"].ToString();

    var admindata = NW.admin(User.Identity.Name);

    List<h365_web.Models.drugstore_sales> sdata = (List<h365_web.Models.drugstore_sales>)ViewData["sdata"];
    h365_web.Models.drugstore_dealer pdata = (h365_web.Models.drugstore_dealer)ViewData["pdata"];
    h365_web.Models.drugstore_sales sales_data = (h365_web.Models.drugstore_sales)ViewData["sales_data"];

    string url = Request.Url.Authority;
}

<div class="maincontent">
    <div class="contentinner">

        @using (Html.BeginForm(action + "Save", controller, FormMethod.Post, new { @class = "stdform", @id = "form1", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
            @Html.HiddenFor(model => model.drugstore_id)
            <div class="widgetcontent">
                <h4 class="widgettitle">基本資料</h4>


                @*@Html.EditorFor(model => model.group_id)*@

                @* @Html.EditorFor(model => model.sales_id)*@

                @if (admindata.power_id == 10)
                {
                    <div class="control-group">
                        <label class="control-label">所屬業務</label>
                        <div class="field" style="padding: 5px 5px;">
                            @(pdata.name)-
                            <select class="span2" id="sales_id" name="sales_id">
                                <option value="">請選擇 </option>
                                @foreach (var sd in sdata)
                                {
                                    <option value="@(sd.sales_id)">@(sd.name)</option>
                                }

                            </select>
                        </div>
                    </div>
                       
                }
                else if (admindata.power_id == 9)
                {
                    <div class="control-group">
                        <label class="control-label">所屬業務</label>
                        <div class="field" style="padding: 5px 5px;">
                            @(pdata.name)-@(sales_data.name)
                            <input id="sales_id" name="sales_id" type="hidden" value="@(sales_data.sales_id)"  />
                        </div>
                    </div>
                }
                else
                {
                    
                    @Html.EditorFor(model => model.sales_id)

                }


                @Html.EditorFor(model => model.name)


                <div class="abgne_tab">
                    <ul class="tabs">
                        <li><a href="#tab1">藥局資訊</a></li>
                        <li><a href="#tab2">營業時間</a></li>
                        <li><a href="#tab3">現場勘查</a></li>
                        <li><a href="#tab4">方案選擇</a></li>
                        @*<li><a href="#tab4">合約下載/簽約審核</a></li>*@
                        @*                       <li><a href="#tab5">藥局設定</a></li>
                        <li><a href="#tab6">藥局圖檔</a></li>
                        <li><a href="#tab7">稅籍、發票設定</a></li>
                        <li><a href="#tab8">簽約文件</a></li>*@

                    </ul>
                    <div>
                        <div id="tab1" class="tab_content">

                            @*@Html.EditorFor(model => model.hos_flag)*@

                            @Html.EditorFor(model => model.ishealth)

                            @Html.EditorFor(model => model.drug_type)

                            @Html.EditorFor(model => model.drug_sn)

                            <div class="control-group">
                                <label>&nbsp;</label>
                                <div class="field" style="padding: 5px 5px;">
                                    <a href="http://www.nhi.gov.tw/Query/query3.aspx?menu=20&menu_id=712&WD_ID=828" target="_blank">【查詢機構代碼】</a>&nbsp;
                                </div>
                            </div>

                            @Html.EditorFor(model => model.boss)

                            @*@Html.EditorFor(model => model.mail)*@
                            @*  <div class="control-group">
                                <label class="control-label">密碼</label>
                                <input type="password" id="pwd" name="pwd" class="field" style="padding: 5px 5px; width: 195px" />

                                <span>確認密碼</span>
                                <input type="password" id="checkpwd" name="checkpwd" class="field" style="padding: 5px 5px; width: 195px" />
                            </div>*@
                            @Html.EditorFor(model => model.tel)

                            @Html.EditorFor(model => model.fax)

                            @Html.EditorFor(model => model.zip)

                            @Html.EditorFor(model => model.address)

                            @Html.EditorFor(model => model.info)

                            @Html.EditorFor(model => model.holidays)

                            @Html.EditorFor(model => model.business_project)

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">聯絡資訊：</h3>

                            @Html.EditorFor(model => model.contact_name)

                            @Html.EditorFor(model => model.contact_tel)

                            @Html.EditorFor(model => model.contact_fax)

                            @Html.EditorFor(model => model.contact_phone)

                            @Html.EditorFor(model => model.contact_mail)

                            @*@Html.EditorFor(model => model.contact_title)*@

                            <h3 style="padding-left: 10px; border-top: 1px dashed #ccc;">稅籍資料：</h3>

                            @*@Html.EditorFor(model => model.index_visible)*@

                            @*@Html.EditorFor(model => model.start_date)*@

                            @*@Html.EditorFor(model => model.end_date)*@

                            @Html.EditorFor(model => model.taxes)
                            @Html.EditorFor(model => model.uniform_numbers)
                            @Html.EditorFor(model => model.invoice_title)
                            @Html.EditorFor(model => model.invoice_type)
                            @Html.EditorFor(model => model.facebook)

                            @Html.EditorFor(model => model.url)

                        </div>

                        <div id="tab2" class="tab_content">

                            @Html.EditorFor(m => m.times)

                        </div>


                        <div id="tab3" class="tab_content">

                            <div class="control-group">
                                <label for="" class="control-label"></label>
                                <div class="controls">
                                    <span class="label label-important">圖片建議：寬:620px 高:415px
                                    </span>
                                </div>
                            </div>
                            
                            @if (!NW.isAf(url))
