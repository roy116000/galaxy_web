        [UIHint("Html")]
        [DisplayName("適應症(民眾)")]
        public string sick_people { get; set; }

        [DisplayName("劑型")]
        public string medicine { get; set; }

        [DisplayName("包裝")]
        public string pack { get; set; }

        [DisplayName("藥品類別")]
        public string medicine_group { get; set; }

        [DisplayName("管制藥品分類級別")]
        public string medicine_level { get; set; }

        [UIHint("Html")]
        [DisplayName("主成分略述")]
        public string introduce { get; set; }

        [DisplayName("申請商名稱")]
        public string apply_name { get; set; }

        [DisplayName("申請商地址")]
        public string apply_address { get; set; }

        [DisplayName("申請商統一編號")]
        public string apply_inv_sn { get; set; }

        [DisplayName("製造商名稱")]
