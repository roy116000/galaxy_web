        [DisplayName("製造廠國別")]
        public string made_country { get; set; }

        [DisplayName("製程")]
        public string made_step { get; set; }

        [DisplayName("用法")]
        public string use_method { get; set; }

        [DisplayName("劑量")]
        public string barcode { get; set; }

        [UIHint("Html")]
        [DisplayName("副作用")]
        public string side_effect { get; set; }

        [UIHint("Html")]
        [DisplayName("注意事項")]
        public string notes { get; set; }

        [DisplayName("啟用")]
        public Boolean visible { get; set; }

        [DisplayName("create_user")]
        public string create_user { get; set; }

        [DisplayName("create_datetime")]
        public DateTime? create_datetime { get; set; }

        [DisplayName("change_user")]
        public string change_user { get; set; }

        [DisplayName("change_datetime")]
        public DateTime? change_datetime { get; set; }


